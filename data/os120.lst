 12266                          ; ***************************************************************************************
 12267                          ; ***************************************************************************************
 12268                          ;
 12269                          ; Chapter 14: Star commands
 12270                          ;
 12271                          ; ***************************************************************************************
 12272                          ; ***************************************************************************************
 12273                          
 12274                          ; ***************************************************************************************
 12275                          ;
 12276                          ; Clear four consecutive bytes in the OSFILE block
 12277                          ;
 12278                          ; The data required by the OSFILE call is stored at .osfileBlockStart, is 18 bytes long, and
 12279                          ; is as follows:
 12280                          ;
 12281                          ;       byte      description
 12282                          ;       0-1       address of filename
 12283                          ;       2-5       load address
 12284                          ;       6-9       execution address
 12285                          ;       10-13     start address (or length)
 12286                          ;       14-17     end address (or file attributes)
 12287                          ;
 12288                          ; This call clears one of these 4 byte addresses.
 12289                          ;
 12290                          ; On Entry:
 12291                          ;       X is the start offset within the OSFILE block
 12292                          ; On Exit:
 12293                          ;       Preserves A,X,Y
 12294                          ; ***************************************************************************************
 12295                          .clearOSFILEAddress
 12296  e20e 48                     PHA                                                 ; push A
 12297  e20f a900                   LDA #0                                              ; A=0
 12298  e211 9dee02                 STA .osfileBlockStart + 0,X                         ; clear osfile control block workspace
 12299  e214 9def02                 STA .osfileBlockStart + 1,X                         ;
 12300  e217 9df002                 STA .osfileBlockStart + 2,X                         ;
 12301  e21a 9df102                 STA .osfileBlockStart + 3,X                         ;
 12302  e21d 68                     PLA                                                 ; get back A
 12303  e21e 60                     RTS                                                 ;
 12304                          
 12305                          ; ***************************************************************************************
 12306                          ;
 12307                          ; Shift one hex digit into an OSFILE address
 12308                          ;
 12309                          ; Used as part of .readOSFILEAddress
 12310                          ;
 12311                          ; On Entry:
 12312                          ;       A contains hex digit 0-15
 12313                          ;       X contains the offset into the .osfileBlockStart for the address to be updated
 12314                          ; On Exit:
 12315                          ;       The four byte address at .osfileBlockStart+X is shifted four binary bits and the new
 12316                          ;       digit is inserted at the least significant end.
 12317                          ;       Preserves Y
 12318                          ; ***************************************************************************************
 12319                          .shiftDigitIntoAddress
 12320  e21f 84e6                   STY .tempWorkspaceE6                                ; remember Y
 12321  e221 2a                     ROL                                                 ; A=A*2
 12322  e222 2a                     ROL                                                 ; *4
 12323  e223 2a                     ROL                                                 ; *8
 12324  e224 2a                     ROL                                                 ; *16
 12325  e225 a004                   LDY #4                                              ; Y=loop counter
 12326                          -
 12327  e227 2a                     ROL                                                 ; A=A*32
 12328  e228 3eee02                 ROL .osfileBlockStart + 0,X                         ; shift bit 7 of A into shift register
 12329  e22b 3eef02                 ROL .osfileBlockStart + 1,X                         ; and
 12330  e22e 3ef002                 ROL .osfileBlockStart + 2,X                         ; shift
 12331  e231 3ef102                 ROL .osfileBlockStart + 3,X                         ; along
 12332  e234 b031                   BCS .brkBadAddress                                  ; if (carry set on exit, i.e. register has overflowed) then branch ('Bad address' error)
 12333  e236 88                     DEY                                                 ; decrement Y
 12334  e237 d0ee                   BNE -                                               ; if (Y > 0) then branch (do another shift)
 12335                          
 12336  e239 a4e6                   LDY .tempWorkspaceE6                                ; recall original Y
 12337  e23b 60                     RTS                                                 ;
 12338                          
 12339                          
 12340                          ; ***************************************************************************************
 12341                          ;
 12342                          ;   *LOAD
 12343                          ;
 12344                          ; On Entry:
 12345                          ;       XY = address of rest of command line
 12346                          ;
 12347                          ; ***************************************************************************************
 12348                          .starLoad
 12349  e23c a9ff                   LDA #$FF                                            ; signal that load is being performed
 12350                              ; fall through...
 12351                          
 12352                          ; ***************************************************************************************
 12353                          ;
 12354                          ;   *SAVE Entry (and *LOAD continued)
 12355                          ;
 12356                          ; On Entry:
 12357                          ;       A=0         for *SAVE
 12358                          ;       A=non-zero  for *LOAD
 12359                          ;       XY = address of rest of command line
 12360                          ;
 12361                          ; ***************************************************************************************
 12362                          .starLoadSave
 12363  e23e 86f2                   STX .stringInputBufferAddressLow                    ; store address of rest of command line
 12364  e240 84f3                   STY .stringInputBufferAddressHigh                   ;
 12365  e242 8eee02                 STX .osfileFilenameAddressLow                       ; X and Y are stored in OSfile control block
 12366  e245 8cef02                 STY .osfileFilenameAddressHigh                      ;
 12367  e248 48                     PHA                                                 ; Push A
 12368  e249 a202                   LDX #.osfileLoadAddressLow - .osfileBlockStart      ; X=2
 12369  e24b 200ee2                 JSR .clearOSFILEAddress                             ; clear the load address
 12370  e24e a0ff                   LDY #$FF                                            ; Y=255
 12371  e250 8cf402                 STY .osfileExecAddressLow                           ; store $FF in exec address low byte
 12372                          
 12373                              ; For a *LOAD (A=$FF) this byte (.osfileExecAddressLow) is used as a flag (it's available
 12374                              ; since we don't need the executable address when just loading a file). Zero means use the
 12375                              ; specified load address. Non-zero means use the load address from the file. This is
 12376                              ; OSFILE behaviour.
 12377                          
 12378  e253 c8                     INY                                                 ; increment Y
 12379  e254 201dea                 JSR .gsinitForFilenameParsing                       ; and call GSINIT to prepare for reading text line
 12380                          -
 12381  e257 202fea                 JSR .gsreadEntryPoint                               ; read a byte from text line
 12382  e25a 90fb                   BCC -                                               ; until end of line reached
 12383  e25c 68                     PLA                                                 ; recall original A
 12384  e25d 48                     PHA                                                 ;
 12385  e25e f062                   BEQ .starSave                                       ; if (A=0, i.e. *SAVE) then branch
 12386                          
 12387                              ; loading
 12388  e260 20ade2                 JSR .readOSFILEAddress                              ; read hex byte into start address
 12389  e263 b03b                   BCS .checkForErrorAndLoadFile                       ; if (success) then branch (load using OSFILE)
 12390  e265 f03e                   BEQ .callOSFILEWithParameterBlockForLoadSave        ; if (end of line found) then branch
 12391                              ; fall through...
 12392                          
 12393                          ; ***************************************************************************************
 12394                          .brkBadAddress
 12395  e267 00                     BRK                                                 ;
 12396  e268 fc                     !byte $FC                                           ;
 12397  e269 4261642061646472...    !text "Bad address", 0                              ; error
 12398                          
 12399                          
 12400                          ; ***************************************************************************************
 12401                          ;
 12402                          ; OSBYTE 119 - Close Spool / Exec files
 12403                          ;
 12404                          ; ***************************************************************************************
 12405                          .osbyte119EntryPoint
 12406  e275 a210                   LDX #.romServiceCallSpoolExecClosureWarning         ; } let the paged ROMs know about
 12407  e277 2068f1                 JSR .osbyte143EntryPoint                            ; } the closure of SPOOL/EXEC file
 12408  e27a f023                   BEQ .exit19                                         ; if (a ROM accepts and closes it) then branch (return)
 12409  e27c 208bf6                 JSR .closeSpoolOrExecFile                           ; close the current file
 12410  e27f a900                   LDA #0                                              ; A=0
 12411                              ; fall through...
 12412                          
 12413                          ; ***************************************************************************************
 12414                          ;
 12415                          ;   *SPOOL
 12416                          ;
 12417                          ; On Entry:
 12418                          ;       A = 0 (and carry clear) to close the currently SPOOLed file, OR
 12419                          ;       A = file handle to start SPOOLing
 12420                          ; On Exit:
 12421                          ;       if closing a spooled file:
 12422                          ;           A, X and Y are preserved
 12423                          ;       if opening a spooled file:
 12424                          ;          A = Y = file handle for spooled file
 12425                          ;
 12426                          ; ***************************************************************************************
 12427                          .starSpool
 12428  e281 08                     PHP                                                 ; push flags
 12429  e282 84e6                   STY .tempWorkspaceE6                                ; remember Y
 12430  e284 ac5702                 LDY .spoolFileHandle                                ; get file handle
 12431  e287 8d5702                 STA .spoolFileHandle                                ; store A as file handle
 12432  e28a f003                   BEQ +                                               ; if (Y is zero) then branch (skip forward)
 12433  e28c 20ceff                 JSR .OSFIND                                         ; close the file using OSFIND
 12434                          +
 12435  e28f a4e6                   LDY .tempWorkspaceE6                                ; recall Y
 12436  e291 28                     PLP                                                 ; pull flags
 12437  e292 f00b                   BEQ .exit19                                         ; if (A = 0 on entry) then branch (exit, we are done)
 12438  e294 a980                   LDA #$80                                            ; A is value for 'open file for output'
 12439  e296 20ceff                 JSR .OSFIND                                         ; open file XY for output using OSFIND
 12440  e299 a8                     TAY                                                 ; Y=A=file handle for *SPOOLed file
 12441  e29a f074                   BEQ .badCommandError                                ; if (result is zero) then branch ('Bad command' error)
 12442  e29c 8d5702                 STA .spoolFileHandle                                ; store new file handle
 12443                          .exit19
 12444  e29f 60                     RTS                                                 ;
 12445                          
 12446                          ; ***************************************************************************************
 12447                          .checkForErrorAndLoadFile
 12448  e2a0 d06e                   BNE .badCommandError                                ; if (not end of command line) then branch (show 'Bad command' error)
 12449  e2a2 eef402                 INC .osfileExecAddressLow                           ; increment execution address low
 12450                                                                                  ; byte to zero (when A=255 as OSFILE
 12451                                                                                  ; parameter, zero means use specified
 12452                                                                                  ; address)
 12453                          
 12454                          .callOSFILEWithParameterBlockForLoadSave
 12455  e2a5 a2ee                   LDX #<.osfileBlockStart                             ; }
 12456  e2a7 a002                   LDY #>.osfileBlockStart                             ; } XY = address of OSFILE parameter block
 12457  e2a9 68                     PLA                                                 ; get back A
 12458  e2aa 4cddff                 JMP .OSFILE                                         ; and JUMP to OSFILE
 12459                          
 12460                          ; ***************************************************************************************
 12461                          ;
 12462                          ; Read hex bytes into OSFILE address (start / end / load / exec address)
 12463                          ;
 12464                          ; On Entry:
 12465                          ;       X is the offset to the address to write to
 12466                          ;
 12467                          ; On Exit:
 12468                          ;       C set on success
 12469                          ;       Z set if end of line found
 12470                          ; ***************************************************************************************
 12471                          .readOSFILEAddress
 12472  e2ad 203ae0                 JSR .skipSpacesAndCheckForCRInStringInput           ; look for NEWline
 12473  e2b0 208fe0                 JSR .readHexDigit                                   ; carry is set if it finds hex digit
 12474  e2b3 900c                   BCC .exit20                                         ; so exit
 12475  e2b5 200ee2                 JSR .clearOSFILEAddress                             ; clear start address in OSFILE block
 12476                          -
 12477  e2b8 201fe2                 JSR .shiftDigitIntoAddress                          ; shift lower nybble of A into shift register
 12478  e2bb 208fe0                 JSR .readHexDigit                                   ; then check for Hex digit
 12479  e2be b0f8                   BCS -                                               ; if (found digit) then branch (do it again)
 12480  e2c0 38                     SEC                                                 ; set carry
 12481                          .exit20
 12482  e2c1 60                     RTS                                                 ;
 12483                          
 12484                          
 12485                          ; ***************************************************************************************
 12486                          .starSave
 12487  e2c2 a20a                   LDX #.osfileStartAddressLow - .osfileBlockStart     ; X=offset into OSFILE block to clear start address
 12488  e2c4 20ade2                 JSR .readOSFILEAddress                              ;
 12489  e2c7 9047                   BCC .badCommandError                                ; if (no start address found) then branch (exit via 'Bad command' error)
 12490  e2c9 b8                     CLV                                                 ; clear bit 6
 12491                          
 12492                              ;
 12493                              ; check for '+' to indicate a length rather than the end address
 12494                              ;
 12495  e2ca b1f2                   LDA (.stringInputBufferAddressLow),Y                ; read next byte from text line
 12496  e2cc c92b                   CMP #.charPLUS                                      ; is it '+'
 12497  e2ce d004                   BNE +                                               ; if (not '+') then branch (it's the end address)
 12498  e2d0 2cb7d9                 BIT .allBitsSet                                     ; set V flag (it's the length)
 12499  e2d3 c8                     INY                                                 ; increment Y to point to hex group
 12500                          +
 12501                          
 12502                              ;
 12503                              ; read file length/end address from command line string
 12504                              ;
 12505  e2d4 a20e                   LDX #.osfileEndAddressLow - .osfileBlockStart       ; X=offset into OSFILE block for end address
 12506  e2d6 20ade2                 JSR .readOSFILEAddress                              ;
 12507  e2d9 9035                   BCC .badCommandError                                ; if (carry clear, i.e. no hex byte found) then branch ('Bad command' error)
 12508  e2db 08                     PHP                                                 ; save flags
 12509  e2dc 500f                   BVC .explicitEndAddressFound                        ; if (V clear; i.e. explicit end address found; i.e. no '+') then branch
 12510                          
 12511                              ; add start address and length, and store as end address
 12512  e2de a2fc                   LDX #$FC                                            ; X=loop counter, from $FC incrementing to $00 (4 bytes copied)
 12513  e2e0 18                     CLC                                                 ; clear carry
 12514                          -
 12515  e2e1 bdfc01                 LDA .osfileStartAddressLow - $FC,X                  ; Get start address
 12516  e2e4 7d0002                 ADC .page2Start,X                                   ; add length
 12517  e2e7 9d0002                 STA .page2Start,X                                   ; store as end address
 12518  e2ea e8                     INX                                                 ;
 12519  e2eb d0f4                   BNE -                                               ; loop until X=0
 12520                          
 12521                          .explicitEndAddressFound
 12522  e2ed a203                   LDX #3                                              ; X=loop counter
 12523                          -
 12524  e2ef bdf802                 LDA .osfileStartAddressLow,X                        ; }
 12525  e2f2 9df402                 STA .osfileExecAddressLow,X                         ; }
 12526  e2f5 9df002                 STA .osfileLoadAddressLow,X                         ; } copy start adddress to load and execution addresses
 12527  e2f8 ca                     DEX                                                 ; }
 12528  e2f9 10f4                   BPL -                                               ; }
 12529                          
 12530  e2fb 28                     PLP                                                 ; get back flag
 12531  e2fc f0a7                   BEQ .callOSFILEWithParameterBlockForLoadSave        ; if (end of command line reached) then branch to do OSFILE
 12532                          
 12533                              ;
 12534                              ; read command line for execution address
 12535                              ;
 12536  e2fe a206                   LDX #.osfileExecAddressLow - .osfileBlockStart      ; X=offset into OSFILE block for execution address
 12537  e300 20ade2                 JSR .readOSFILEAddress                              ;
 12538  e303 900b                   BCC .badCommandError                                ; if (error) then branch ('Bad command' error)
 12539  e305 f09e                   BEQ .callOSFILEWithParameterBlockForLoadSave        ; if (end of line reached) then branch (do OSFILE)
 12540                          
 12541                              ;
 12542                              ; read command line for load address
 12543                              ;
 12544  e307 a202                   LDX #.osfileLoadAddressLow - .osfileBlockStart      ; X=offset into OSFILE block for load address
 12545  e309 20ade2                 JSR .readOSFILEAddress                              ;
 12546  e30c 9002                   BCC .badCommandError                                ; if (error) then branch ('Bad command' error)
 12547  e30e f095                   BEQ .callOSFILEWithParameterBlockForLoadSave        ; if (end of line) then branch (do OSFILE)
 12548                              ; fall through... (anything else is an error!)
 12549                          
 12550                          ; ***************************************************************************************
 12551                          .badCommandError
 12552  e310 00                     BRK                                                 ;
 12553  e311 fe                     !byte $FE                                           ; error number
 12554  e312 42616420636f6d6d...    !text "Bad command"                                 ; error string. The following BRK
 12555                                                                                  ; instruction is also the zero
 12556                                                                                  ; terminator for this string.
 12557                          
 12558                          .badKeyError
 12559  e31d 00                     BRK                                                 ;
 12560  e31e fb                     !byte $FB                                           ; error number
 12561  e31f 426164206b657900       !text "Bad key",0                                   ; string with zero terminator
 12562                          
 12563                          ; ***************************************************************************************
 12564                          ;
 12565                          ; *KEY
 12566                          ;
 12567                          ; The *KEY <number> <string> command defines one of 16 strings. These strings are associated
 12568                          ; with keys on the keyboard. When the key is pressed, the contents of the string are entered
 12569                          ; into the input buffer ('expanded'). These are also known as 'soft key' definitions.
 12570                          ;
 12571                          ;       *KEY number     Definition
 12572                          ;           0-9         Function keys f0-f9
 12573                          ;            10         When BREAK is pressed, the contents of the string are played
 12574                          ;            11         COPY key
 12575                          ;            12         LEFT key
 12576                          ;            13         RIGHT key
 12577                          ;            14         DOWN key
 12578                          ;            15         UP key
 12579                          ;
 12580                          ; Whether the soft keys are expanded is controlled by OSBYTE 225 (See .functionAndCursorKeyCodes)
 12581                          ; For the COPY key and cursor keys to be expanded, they must also be enabled using OSBYTE 4
 12582                          ; with X = 2 (see .osbyte4EntryPoint) which is translated into a call to OSBYTE 237, which
 12583                          ; updates memory location .cursorEditingType. (See .cursorEditingType)
 12584                          ;
 12585                          ; Memory
 12586                          ; Soft key definitions are stored in $0B00-$0BFF (See .softKeyPage). The first 16 bytes
 12587                          ; ($0B00-$0B0F) are a table of byte offsets from $0B01 to the start of the string definition
 12588                          ; for that soft key.
 12589                          ;
 12590                          ; The seventeenth byte (at $0B10) is the offset from $0B01 to the first free byte after all
 12591                          ; soft key definitions (See .softKeysCurrentEndOffset). If a key has no definition, it's
 12592                          ; offset also points to the first free byte.
 12593                          ;
 12594                          ; The string definitions follow (with no terminators).
 12595                          ;
 12596                          ; When a new key is defined (or undefined using *KEY <number>) the existing strings are
 12597                          ; compacted (shuffled down in memory to leave no gaps) with the old definition removed so the
 12598                          ; new definition can be added on the end. (See .compactStarKeyStrings). Thus the string
 12599                          ; definitions always appear in memory in the order they are defined, with the latest *KEY
 12600                          ; definition showing last.
 12601                          ;
 12602                          ; On Entry:
 12603                          ;   Y = offset to source string of command line
 12604                          ;
 12605                          ; ***************************************************************************************
 12606                          .starKey
 12607  e327 204ee0                 JSR .parseDecimalNumberFromString                   ; set up key number in A
 12608  e32a 90f1                   BCC .badKeyError                                    ; if (not valid number) then branch ('Bad key' error)
 12609  e32c e010                   CPX #16                                             ; compare key number with 16
 12610  e32e b0ed                   BCS .badKeyError                                    ; if (key number is 16 or more) then branch ('Bad key' error)
 12611  e330 2045e0                 JSR .skipSpacesAndCommaValid                        ; skip commas, and check for CR
 12612  e333 08                     PHP                                                 ; save flags for later (remember Z = CR found)
 12613  e334 ae100b                 LDX .softKeysCurrentEndOffset                       ; get pointer to top of existing key strings
 12614  e337 98                     TYA                                                 ; }
 12615  e338 48                     PHA                                                 ; } save Y to preserve text pointer
 12616  e339 20d1e3                 JSR .compactStarKeyStrings                          ; compact soft key definitions
 12617  e33c 68                     PLA                                                 ; }
 12618  e33d a8                     TAY                                                 ; } restore Y
 12619  e33e 28                     PLP                                                 ; restore flags (recalls Z = CR found)
 12620  e33f d036                   BNE .addStarKeyString                               ; if (CR not found) then branch (to set up new string)
 12621  e341 60                     RTS                                                 ; return (sets empty string)
 12622                          
 12623                          
 12624                          ; ***************************************************************************************
 12625                          ;
 12626                          ; *FX
 12627                          ;
 12628                          ; This is the entry point for the OSCLI call to execute "*FX <A>,<X>,<Y>". We parse the first
 12629                          ; numeric parameter ('A') then fall through to the version that parses a range of other star
 12630                          ; commands with 'X' and 'Y' parameters, each implemented with an OSBYTE call.
 12631                          ;
 12632                          ; ***************************************************************************************
 12633                          .fxEntryPoint
 12634  e342 204ee0                 JSR .parseDecimalNumberFromString                   ; convert the number to binary
 12635  e345 90c9                   BCC .badCommandError                                ; if (bad number) then branch ('Bad command' error)
 12636  e347 8a                     TXA                                                 ; put the parsed first parameter in A
 12637                              ; fall through...
 12638                          
 12639                          ; ***************************************************************************************
 12640                          ;
 12641                          ; Handle a range of star commands
 12642                          ;
 12643                          ; On Entry:
 12644                          ;       A = $88     *CODE
 12645                          ;       A = $89     *MOTOR
 12646                          ;       A = $8B     *OPT
 12647                          ;       A = $8C     *TAPE
 12648                          ;       A = $8D     *ROM
 12649                          ;       A = $90     *TV
 12650                          ;       A = any     *FX     (when falling through from .fxEntryPoint above)
 12651                          ;
 12652                          ; Parses star commands with one or two numeric (0-255) parameters 'X' and 'Y' (space and/or
 12653                          ; comma separated) then calls OSBYTE with A as above.
 12654                          ;
 12655                          ; ***************************************************************************************
 12656                          .starCommandsForSpecificOSBYTEs
 12657  e348 48                     PHA                                                 ; save A
 12658  e349 a900                   LDA #0                                              ; }
 12659  e34b 85e5                   STA .starCommandXParameter                          ; } clear the X/Y parameters for the upcoming OSBYTE call
 12660  e34d 85e4                   STA .starCommandYParameter                          ; }
 12661  e34f 2043e0                 JSR .skipSpacesAndComma                             ; skip commas and check for newline (CR)
 12662  e352 f018                   BEQ .parsedParameters                               ; if (CR found) then branch (to call appropriate OSBYTE)
 12663                          
 12664  e354 204ee0                 JSR .parseDecimalNumberFromString                   ; parse first parameter (X Parameter for OSBYTE)
 12665  e357 90b7                   BCC .badCommandError                                ; if (bad character) then branch (to give bad command error)
 12666  e359 86e5                   STX .starCommandXParameter                          ; store as X parameter for OSBYTE
 12667  e35b 2045e0                 JSR .skipSpacesAndCommaValid                        ; skip comma and check CR
 12668  e35e f00c                   BEQ .parsedParameters                               ; if (CR found) then branch (to call appropriate OSBYTE)
 12669                          
 12670  e360 204ee0                 JSR .parseDecimalNumberFromString                   ; parse second parameter (Y Parameter for OSBYTE)
 12671  e363 90ab                   BCC .badCommandError                                ; if (error) then branch ('Bad command' error)
 12672  e365 86e4                   STX .starCommandYParameter                          ; store as Y parameter for OSBYTE
 12673  e367 203ae0                 JSR .skipSpacesAndCheckForCRInStringInput           ; now we must have a CR
 12674  e36a d0a4                   BNE .badCommandError                                ; if (no CR) then branch ('Bad command' error)
 12675                          
 12676                          .parsedParameters
 12677  e36c a4e4                   LDY .starCommandYParameter                          ; Y = OSBYTE parameter
 12678  e36e a6e5                   LDX .starCommandXParameter                          ; X = OSBYTE parameter
 12679  e370 68                     PLA                                                 ; A = OSBYTE parameter
 12680  e371 20f4ff                 JSR .OSBYTE                                         ; call OSBYTE
 12681  e374 709a                   BVS .badCommandError                                ; if (V set on return) then branch ('Bad command' error)
 12682  e376 60                     RTS                                                 ;
 12683                          
 12684                          ; ***************************************************************************************
 12685                          ;
 12686                          ; Add a new *KEY string
 12687                          ; See .starKey.
 12688                          ;
 12689                          ; ***************************************************************************************
 12690                          .addStarKeyString
 12691  e377 38                     SEC                                                 ; set carry (meaning: check for '"' marks around string)
 12692  e378 201eea                 JSR .gsinitEntryPoint                               ; start reading string
 12693                          
 12694                              ; copy string into *KEY buffer
 12695                          -
 12696  e37b 202fea                 JSR .gsreadEntryPoint                               ; read string
 12697  e37e b008                   BCS +                                               ; if (end of string reached) then branch (deal with end of string)
 12698  e380 e8                     INX                                                 ; point to first byte of new key definition
 12699  e381 f09a                   BEQ .badKeyError                                    ; if (X=0, i.e. buffer overflow) then branch (exit with 'Bad Key' error)
 12700  e383 9d000b                 STA .softKeyPage,X                                  ; store character
 12701  e386 90f3                   BCC -                                               ; if (not end of line) then branch (loop to copy next byte)
 12702                          
 12703                          +
 12704  e388 d093                   BNE .badKeyError                                    ; if (parsing error) then branch (show 'Bad Key' error)
 12705  e38a 08                     PHP                                                 ; save flags
 12706  e38b 78                     SEI                                                 ; disable interrupts
 12707  e38c 20d1e3                 JSR .compactStarKeyStrings                          ; compact *KEY definitions with the stored string definition
 12708                          
 12709                              ; Update the array of offsets that point to the start of each string
 12710  e38f a210                   LDX #$10                                            ; set loop counter
 12711                          -
 12712  e391 e4e6                   CPX .tempWorkspaceE6                                ; check for key already being defined
 12713  e393 f00e                   BEQ .skipRestOfLoop                                 ; if (key already being defined) then branch (skip rest of loop)
 12714  e395 bd000b                 LDA .softKeyPage,X                                  ; get start of string X
 12715  e398 d9000b                 CMP .softKeyPage,Y                                  ; compare with start of string Y
 12716  e39b d006                   BNE .skipRestOfLoop                                 ; if (not the same) then branch (skip rest of loop)
 12717  e39d ad100b                 LDA .softKeysCurrentEndOffset                       ; store top of string definition
 12718  e3a0 9d000b                 STA .softKeyPage,X                                  ; in designated key pointer
 12719                          .skipRestOfLoop
 12720  e3a3 ca                     DEX                                                 ; decrement loop pointer X
 12721  e3a4 10eb                   BPL -                                               ; and do it all again
 12722  e3a6 28                     PLP                                                 ; get back flags
 12723  e3a7 60                     RTS                                                 ;
 12724                          
 12725                          
 12726                          ; ***************************************************************************************
 12727                          ;
 12728                          ; Get *KEY string length
 12729                          ;
 12730                          ; Get the length of a soft key definition. See .starKey.
 12731                          ;
 12732                          ; On Entry:
 12733                          ;       Y = *KEY number
 12734                          ;
 12735                          ; On Exit:
 12736                          ;       A = string length
 12737                          ;       Preserves X
 12738                          ;
 12739                          ; ***************************************************************************************
 12740                          .getStarKeyStringLength
 12741  e3a8 08                     PHP                                                 ; push flags
 12742  e3a9 78                     SEI                                                 ; disable interrupts
 12743  e3aa ad100b                 LDA .softKeysCurrentEndOffset                       ; get top of currently defined strings
 12744  e3ad 38                     SEC                                                 ;
 12745  e3ae f9000b                 SBC .softKeyPage,Y                                  ; subtract to get the number of bytes in strings above end of string Y
 12746  e3b1 85fb                   STA .tempStoreFB                                    ; store this
 12747  e3b3 8a                     TXA                                                 ; save X
 12748  e3b4 48                     PHA                                                 ;
 12749  e3b5 a210                   LDX #$10                                            ; and X=16
 12750                          
 12751                          -
 12752  e3b7 bd000b                 LDA .softKeyPage,X                                  ; get start offset (from .softKeyPage) of key string X
 12753  e3ba 38                     SEC                                                 ;
 12754  e3bb f9000b                 SBC .softKeyPage,Y                                  ; subtract offset of string we are working on
 12755  e3be 9008                   BCC +                                               ; if (carry clear, i.e. .softKeyPage+Y > .softKeyPage+X) then branch (forward)
 12756  e3c0 f006                   BEQ +                                               ; if (result in A=0) then branch (forward)
 12757  e3c2 c5fb                   CMP .tempStoreFB                                    ; check against number of bytes above string we are working on
 12758  e3c4 b002                   BCS +                                               ; if (>= number of bytes above string we are working on) then branch
 12759  e3c6 85fb                   STA .tempStoreFB                                    ; store A in .tempStoreFB
 12760                          +
 12761  e3c8 ca                     DEX                                                 ; point to next lower key offset
 12762  e3c9 10ec                   BPL -                                               ; if (not negative) then branch (loop back and do it again)
 12763                          
 12764  e3cb 68                     PLA                                                 ; get back value of X
 12765  e3cc aa                     TAX                                                 ;
 12766  e3cd a5fb                   LDA .tempStoreFB                                    ; get back latest value of A
 12767  e3cf 28                     PLP                                                 ; pull flags
 12768  e3d0 60                     RTS                                                 ;
 12769                          
 12770                          ; ***************************************************************************************
 12771                          ;
 12772                          ; Compact *KEY strings
 12773                          ;
 12774                          ; Remove an existing definition, and move the remaining definitions down in memory (so that
 12775                          ; we can add a new definition on the end).
 12776                          ; See .starKey.
 12777                          ;
 12778                          ; On Entry:
 12779                          ;       .tempWorkspaceE6 = key number
 12780                          ; On Exit:
 12781                          ;       X is preserved
 12782                          ;
 12783                          ; ***************************************************************************************
 12784                          .compactStarKeyStrings
 12785  e3d1 08                     PHP                                                 ; push flags
 12786  e3d2 78                     SEI                                                 ; disable interrupts
 12787  e3d3 8a                     TXA                                                 ; save X
 12788  e3d4 48                     PHA                                                 ; push A
 12789  e3d5 a4e6                   LDY .tempWorkspaceE6                                ; get key number
 12790  e3d7 20a8e3                 JSR .getStarKeyStringLength                         ; and set up .tempStoreFB to length of existing string
 12791  e3da b9000b                 LDA .softKeyPage,Y                                  ; get start of string Y
 12792  e3dd a8                     TAY                                                 ; put it in Y
 12793  e3de 18                     CLC                                                 ; clear carry
 12794  e3df 65fb                   ADC .tempStoreFB                                    ; add number of bytes for existing string
 12795  e3e1 aa                     TAX                                                 ; X = new end position
 12796  e3e2 85fa                   STA .tempStoreFA                                    ; and store it in .tempStoreFA
 12797  e3e4 ad6802                 LDA .softKeyStringLength                            ; check to see if we are already defining a *KEY string
 12798  e3e7 f00d                   BEQ +                                               ; if (key is not already being defined) branch
 12799                          .keyInUseError
 12800  e3e9 00                     BRK                                                 ; definition expanded) so error.  This stops *KEY 1 "*key1 FRED" etc.
 12801  e3ea fa                     !byte $FA                                           ; error number
 12802  e3eb 4b657920696e2075...    !text "Key in use",0                                ;
 12803                          
 12804                          +
 12805  e3f6 ce8402                 DEC .softKeyConsistencyFlag                         ; decrement consistency flag to $FF to warn that key definitions are being changed
 12806  e3f9 68                     PLA                                                 ; pull A
 12807  e3fa 38                     SEC                                                 ;
 12808  e3fb e5fa                   SBC .tempStoreFA                                    ; subtract .tempStoreFA
 12809  e3fd 85fa                   STA .tempStoreFA                                    ; and re store it
 12810  e3ff f00c                   BEQ +                                               ; if (zero) then branch
 12811                          
 12812                              ; move string from offset X to offset Y
 12813                          -
 12814  e401 bd010b                 LDA .softKeyPage + 1,X                              ; read byte from offset X
 12815  e404 99010b                 STA .softKeyPage + 1,Y                              ; write character to offset Y
 12816  e407 c8                     INY                                                 ; increment pointer
 12817  e408 e8                     INX                                                 ; increment pointer
 12818  e409 c6fa                   DEC .tempStoreFA                                    ; decrement loop counter
 12819  e40b d0f4                   BNE -                                               ; if (not done yet) then branch (loop back)
 12820                          
 12821                          +
 12822  e40d 98                     TYA                                                 ; store end of moved string(s)
 12823  e40e 48                     PHA                                                 ;
 12824  e40f a4e6                   LDY .tempWorkspaceE6                                ; get back key number
 12825                          
 12826                              ; adjust the offset to each KEY now we have moved one
 12827  e411 a210                   LDX #$10                                            ; point at top of last string
 12828                          -
 12829  e413 bd000b                 LDA .softKeyPage,X                                  ; get this value
 12830  e416 d9000b                 CMP .softKeyPage,Y                                  ; compare it with start of new or re defined key
 12831  e419 9007                   BCC +                                               ; if (less) then branch
 12832  e41b f005                   BEQ +                                               ; if (equal) then branch
 12833  e41d e5fb                   SBC .tempStoreFB                                    ; shift key definitions accordingly
 12834  e41f 9d000b                 STA .softKeyPage,X                                  ; store new offset to KEY X
 12835                          +
 12836  e422 ca                     DEX                                                 ; point to next lowest string def
 12837  e423 10ee                   BPL -                                               ; if (X=>0) then branch (loop back and do it again)
 12838                          
 12839  e425 ad100b                 LDA .softKeysCurrentEndOffset                       ; make top of key definitions
 12840  e428 99000b                 STA .softKeyPage,Y                                  ; the start of our key def
 12841  e42b 68                     PLA                                                 ; get new end of strings
 12842  e42c 8d100b                 STA .softKeysCurrentEndOffset                       ; and store it
 12843  e42f aa                     TAX                                                 ; put A in X
 12844  e430 ee8402                 INC .softKeyConsistencyFlag                         ; reset consistency flag
 12845  e433 28                     PLP                                                 ; restore flags
 12846  e434 60                     RTS                                                 ;
 12847                          
 12848                          
 12849                          ; ***************************************************************************************
 12850                          .bufferAddressesHigh
 12851  e435 03                     !byte >(.keyboardInputBuffer - .keyboardInputBufferOffset)       ; 0 = Keyboard
 12852  e436 0a                     !byte >(.tapeOrRS423InputBuffer - .tapeOrRS423InputBufferOffset) ; 1 = tape/RS-423 Input
 12853  e437 08                     !byte >(.tapeOrRS423OutputBuffer - .rs423OutputBufferOffset)     ; 2 = RS-423 output
 12854  e438 07                     !byte >(.printerBuffer - .printerBufferOffset)                   ; 3 = printer
 12855  e439 07                     !byte >(.soundChannel0Buffer - .soundChannel0BufferOffset)       ; 4 = sound channel 0
 12856  e43a 07                     !byte >(.soundChannel1Buffer - .soundChannel1BufferOffset)       ; 5 = sound channel 1
 12857  e43b 07                     !byte >(.soundChannel2Buffer - .soundChannel2BufferOffset)       ; 6 = sound channel 2
 12858  e43c 07                     !byte >(.soundChannel3Buffer - .soundChannel3BufferOffset)       ; 7 = sound channel 3
 12859  e43d 09                     !byte >(.speechBuffer - .speechBufferOffset)                     ; 8 = speech
 12860                          
 12861                          ; ***************************************************************************************
 12862                          .bufferAddressesLow
 12863  e43e 00                     !byte <(.keyboardInputBuffer - .keyboardInputBufferOffset)       ; 0 = Keyboard
 12864  e43f 00                     !byte <(.tapeOrRS423InputBuffer - .tapeOrRS423InputBufferOffset) ; 1 = tape/RS-423 Input
 12865  e440 c0                     !byte <(.tapeOrRS423OutputBuffer - .rs423OutputBufferOffset)     ; 2 = RS-423 output
 12866  e441 c0                     !byte <(.printerBuffer - .printerBufferOffset)                   ; 3 = printer
 12867  e442 50                     !byte <(.soundChannel0Buffer - .soundChannel0BufferOffset)       ; 4 = sound channel 0
 12868  e443 60                     !byte <(.soundChannel1Buffer - .soundChannel1BufferOffset)       ; 5 = sound channel 1
 12869  e444 70                     !byte <(.soundChannel2Buffer - .soundChannel2BufferOffset)       ; 6 = sound channel 2
 12870  e445 80                     !byte <(.soundChannel3Buffer - .soundChannel3BufferOffset)       ; 7 = sound channel 3
 12871  e446 00                     !byte <(.speechBuffer - .speechBufferOffset)                     ; 8 = speech
 12872                          
 12873                          ; ***************************************************************************************
 12874                          .emptyBufferStartOffset
 12875  e447 e0                     !byte .keyboardInputBufferOffset                    ; 0 = Keyboard
 12876  e448 00                     !byte .tapeOrRS423InputBufferOffset                 ; 1 = tape/RS-423 Input
 12877  e449 40                     !byte .rs423OutputBufferOffset                      ; 2 = RS-423 output
 12878  e44a c0                     !byte .printerBufferOffset                          ; 3 = printer
 12879  e44b f0                     !byte .soundChannel0BufferOffset                    ; 4 = sound channel 0
 12880  e44c f0                     !byte .soundChannel1BufferOffset                    ; 5 = sound channel 1
 12881  e44d f0                     !byte .soundChannel2BufferOffset                    ; 6 = sound channel 2
 12882  e44e f0                     !byte .soundChannel3BufferOffset                    ; 7 = sound channel 3
 12883  e44f c0                     !byte .speechBufferOffset                           ; 8 = speech
 12884                          
 12885                          ; ***************************************************************************************
 12886                          ;
 12887                          ; Get buffer address
 12888                          ;
 12889                          ; For buffer numbers, see .bufferNumberKeyboard.
 12890                          ;
 12891                          ; On Entry:
 12892                          ;       X=buffer number
 12893                          ;
 12894                          ; ***************************************************************************************
 12895                          .getBufferAddress
 12896  e450 bd3ee4                 LDA .bufferAddressesLow,X                           ; get buffer base address low
 12897  e453 85fa                   STA .tempStoreFA                                    ; store it
 12898  e455 bd35e4                 LDA .bufferAddressesHigh,X                          ; get buffer base address high
 12899  e458 85fb                   STA .tempStoreFB                                    ; store it
 12900  e45a 60                     RTS                                                 ;
 12901                          
 12902                          ; ***************************************************************************************
 12903                          ;
 12904                          ; OSBYTE 152 - Examine buffer status
 12905                          ;
 12906                          ; On Entry:
 12907                          ;       X = buffer number
 12908                          ; On Exit:
 12909                          ;       X preserved
 12910                          ;       if buffer is empty C=1, Y is preserved
 12911                          ;                     else C=0, Y is offset to next character in buffer at $FA/B
 12912                          ;
 12913                          ; ***************************************************************************************
 12914                          .osbyte152EntryPoint
 12915  e45b 2cb7d9                 BIT .allBitsSet                                     ; set V flag (meaning examine buffer)
 12916  e45e 7001                   BVS .remJumper                                      ; ALWAYS branch (see .remEntryPoint
 12917                                                                                  ; for default entry point)
 12918                          
 12919                          ; ***************************************************************************************
 12920                          ;
 12921                          ; OSBYTE 145 - Get byte from buffer
 12922                          ;
 12923                          ; On Entry:
 12924                          ;       X = buffer number
 12925                          ; On Exit:
 12926                          ;       X preserved
 12927                          ;       Y = character extracted
 12928                          ;       if buffer is empty C=1, else C=0
 12929                          ;
 12930                          ; ***************************************************************************************
 12931                          .osbyte145EntryPoint
 12932  e460 b8                     CLV                                                 ; clear V
 12933                          .remJumper
 12934  e461 6c2c02                 JMP (.vectorREMV)                                   ; Jump via REMV. Default destination
 12935                                                                                  ; is .remEntryPoint below
 12936                          
 12937                          ; ***************************************************************************************
 12938                          ;
 12939                          ; REMV - default entry point for remove from/examine buffer vector
 12940                          ;
 12941                          ; On Entry:
 12942                          ;       X = buffer number
 12943                          ;       V = 1 if only examination is requested
 12944                          ; On Exit:
 12945                          ;       Examination Only:   A = next byte to be removed
 12946                          ;                           X preserved
 12947                          ;                           Y = offset to next character in buffer at $FA/B
 12948                          ;
 12949                          ;       Removal:            A undefined
 12950                          ;                           X preserved
 12951                          ;                           Y = value of the byte removed
 12952                          ;
 12953                          ;       if buffer was already empty C=1
 12954                          ;                              else C=0
 12955                          ;
 12956                          ; Used by: OSBYTE 152 - examine buffer status
 12957                          ;      and OSBYTE 145 - get byte from buffer
 12958                          ;
 12959                          ; ***************************************************************************************
 12960                          .remEntryPoint
 12961  e464 08                     PHP                                                 ; push flags
 12962  e465 78                     SEI                                                 ; disable interrupts
 12963  e466 bdd802                 LDA .bufferStartIndices,X                           ; get output pointer for buffer X
 12964  e469 dde102                 CMP .bufferEndIndices,X                             ; compare to input pointer
 12965  e46c f072                   BEQ .pullSetCarryAndExit                            ; if (equal, i.e. buffer is empty) then branch (exit)
 12966  e46e a8                     TAY                                                 ; Y = buffer start position
 12967  e46f 2050e4                 JSR .getBufferAddress                               ; and get buffer pointer into .tempStoreFA/B
 12968  e472 b1fa                   LDA (.tempStoreFA),Y                                ; read byte from buffer
 12969  e474 701b                   BVS .pullClearCarryAndExit                          ; if (V is set, i.e. only examination) then branch (exit with CARRY clear)
 12970                                                                                  ; OSBYTE 152 has been done
 12971  e476 48                     PHA                                                 ; must be OSBYTE 145 so save byte
 12972  e477 c8                     INY                                                 ; increment Y
 12973  e478 98                     TYA                                                 ; A=Y
 12974  e479 d003                   BNE +                                               ; if (end of buffer not reached) then branch
 12975  e47b bd47e4                 LDA .emptyBufferStartOffset,X                       ; get pointer start from offset table
 12976                          +
 12977  e47e 9dd802                 STA .bufferStartIndices,X                           ; set buffer output pointer
 12978  e481 e002                   CPX #2                                              ;
 12979  e483 900a                   BCC .recallAndExit                                  ; if (buffer is input; 0=keyboard or 1=RS-423 input) then branch
 12980                          
 12981  e485 dde102                 CMP .bufferEndIndices,X                             ; for output buffers compare with buffer start
 12982  e488 d005                   BNE .recallAndExit                                  ; if (not the same, i.e. buffer is not empty) then branch
 12983                          
 12984  e48a a000                   LDY #.eventOutputBufferBecomesEmpty                 ; buffer is empty so Y=0
 12985  e48c 2094e4                 JSR .eventEntryPoint                                ; and enter EVENT routine to signal EVENT 0 - buffer becoming empty
 12986                          
 12987                          .recallAndExit
 12988  e48f 68                     PLA                                                 ; get back byte from buffer
 12989  e490 a8                     TAY                                                 ; put it in Y
 12990                          .pullClearCarryAndExit
 12991  e491 28                     PLP                                                 ; get back flags
 12992  e492 18                     CLC                                                 ; clear carry to indicate success
 12993  e493 60                     RTS                                                 ;
 12994                          
 12995                          ; ***************************************************************************************
 12996                          ;
 12997                          ; Trigger an event
 12998                          ;
 12999                          ; Events
 13000                          ;
 13001                          ; Events are a slightly simpler way for users to use an interrupt. Events are disabled by
 13002                          ; default, but can be enabled via OSBYTE 14 (see .osbyte14EntryPoint). Different event types
 13003                          ; can be individually enabled or disabled. For the list of different event types,
 13004                          ; see .eventOutputBufferBecomesEmpty.
 13005                          ;
 13006                          ; Most events are generated from the default IRQ handling code. When a relevant interrupt
 13007                          ; happens .eventEntryPoint is called with the event type. If enabled, this calls the EVNTV
 13008                          ; vector with the event type in the accumulator. The default implementation of the EVNTV
 13009                          ; vector does nothing, but the user can intercept this vector and do their own processing.
 13010                          ;
 13011                          ; This provides a simpler (and more limited) interface to handling interrupts than
 13012                          ; intercepting the IRQ1 or IRQ2 vectors directly. Events can't override the default interrupt
 13013                          ; handling, but are executed in addition.
 13014                          ;
 13015                          ; As with regular interrupt code, event handling code must not enable interrupts, and should
 13016                          ; be brief (The Acorn User Guide suggests "one millisecond maximum", 2000 clock cycles,
 13017                          ; whereas the New Advanced User Guide suggests it should "not last for more than about 2ms").
 13018                          ;
 13019                          ; The user can generate their own events by calling .OSEVEN with A=9 (.eventUserEvent)
 13020                          ;
 13021                          ; (See NAUG Section 7, Page 119)
 13022                          ;
 13023                          ; On Entry:
 13024                          ;       A = parameter to pass into EVENV vector in Y
 13025                          ;       X = parameter to pass into EVENV vector in X
 13026                          ;       Y = event type
 13027                          ; On Exit:
 13028                          ;       A is preserved.
 13029                          ;       Flags are preserved except for carry:
 13030                          ;       Carry clear indicates the event was called successfully because it was enabled.
 13031                          ;
 13032                          ; ***************************************************************************************
 13033                          .eventEntryPoint
 13034  e494 08                     PHP                                                 ; push flags
 13035  e495 78                     SEI                                                 ; disable interrupts
 13036  e496 48                     PHA                                                 ; push A
 13037  e497 85fa                   STA .tempStoreFA                                    ; .tempStoreFA = A
 13038  e499 b9bf02                 LDA .eventEnabledFlags,Y                            ; get enable event flag
 13039  e49c f041                   BEQ .pullTwiceSetCarryAndExit                       ; if (event is not enabled) then branch (exit with carry set)
 13040  e49e 98                     TYA                                                 ; Y = event enabled flag
 13041  e49f a4fa                   LDY .tempStoreFA                                    ; Y = original A
 13042  e4a1 20a5f0                 JSR .eventJumper                                    ; call the EVENV vector
 13043  e4a4 68                     PLA                                                 ; get back A
 13044  e4a5 28                     PLP                                                 ; get back flags
 13045  e4a6 18                     CLC                                                 ; clear carry for success
 13046  e4a7 60                     RTS                                                 ;
 13047                          
 13048                          ; ***************************************************************************************
 13049                          .generateEventAndPutByteIntoBuffer
 13050  e4a8 98                     TYA                                                 ; A=Y
 13051  e4a9 a002                   LDY #.eventCharacterEnteringInputBuffer             ; Y=2
 13052  e4ab 2094e4                 JSR .eventEntryPoint                                ; send event
 13053  e4ae a8                     TAY                                                 ; Y=A
 13054                              ; fall through...
 13055                          
 13056                          ; ***************************************************************************************
 13057                          ;
 13058                          ; OSBYTE 138 - Put byte into buffer
 13059                          ;
 13060                          ; On Entry:
 13061                          ;       X is buffer number
 13062                          ;       Y is character to be written
 13063                          ;
 13064                          ; ***************************************************************************************
 13065                          .osbyte138EntryPoint
 13066  e4af 98                     TYA                                                 ; A=Y
 13067                          .insJumper
 13068  e4b0 6c2a02                 JMP (.vectorINSV)                                   ; jump to INSV
 13069                          
 13070                          
 13071                          ; ***************************************************************************************
 13072                          ;
 13073                          ; INSV - insert value into buffer - default handler
 13074                          ;
 13075                          ; On Entry:
 13076                          ;       A is value to write
 13077                          ;       X is buffer number
 13078                          ; On Exit:
 13079                          ;       A preserved
 13080                          ;       X preserved
 13081                          ;       C clear on success
 13082                          ;
 13083                          ; ***************************************************************************************
 13084                          .insEntryPoint
 13085  e4b3 08                     PHP                                                 ; save flags
 13086  e4b4 78                     SEI                                                 ; disable interrupts
 13087  e4b5 48                     PHA                                                 ; save A
 13088  e4b6 bce102                 LDY .bufferEndIndices,X                             ; get buffer input pointer
 13089  e4b9 c8                     INY                                                 ; increment Y to next byte
 13090  e4ba d003                   BNE +                                               ; if (not reached the end index) then branch (skip forward)
 13091  e4bc bc47e4                 LDY .emptyBufferStartOffset,X                       ; set back to the start index
 13092                          +
 13093  e4bf 98                     TYA                                                 ; put it in A
 13094  e4c0 ddd802                 CMP .bufferStartIndices,X                           ; compare it with input pointer
 13095  e4c3 f00f                   BEQ .insertIntoFullBuffer                           ; if (buffer is full) then branch
 13096  e4c5 bce102                 LDY .bufferEndIndices,X                             ; get buffer end in Y
 13097  e4c8 9de102                 STA .bufferEndIndices,X                             ; set new offset
 13098  e4cb 2050e4                 JSR .getBufferAddress                               ; and point .tempStoreFA/B at it
 13099  e4ce 68                     PLA                                                 ; get back value to write
 13100  e4cf 91fa                   STA (.tempStoreFA),Y                                ; write it in buffer
 13101  e4d1 28                     PLP                                                 ; pull flags
 13102  e4d2 18                     CLC                                                 ; clear carry for success
 13103  e4d3 60                     RTS                                                 ;
 13104                          
 13105                          .insertIntoFullBuffer
 13106  e4d4 68                     PLA                                                 ; get back byte
 13107  e4d5 e002                   CPX #2                                              ; }
 13108  e4d7 b007                   BCS .pullSetCarryAndExit                            ; } if we are working on output buffer then branch
 13109                          
 13110  e4d9 a001                   LDY #.eventInputBufferBecomesFull                   ; input buffer is full
 13111  e4db 2094e4                 JSR .eventEntryPoint                                ; to service input buffer full event
 13112  e4de 48                     PHA                                                 ; push A
 13113                          
 13114                          .pullTwiceSetCarryAndExit
 13115  e4df 68                     PLA                                                 ; restore A
 13116                          .pullSetCarryAndExit
 13117  e4e0 28                     PLP                                                 ; restore flags
 13118  e4e1 38                     SEC                                                 ; set carry
 13119  e4e2 60                     RTS                                                 ;
 13120                          
 13121                          ; ***************************************************************************************
 13122                          ;
 13123                          ; Check for a letter (A-Z or a-z)
 13124                          ;
 13125                          ; On Entry:
 13126                          ;       A = character to check
 13127                          ; On Exit:
 13128                          ;       Preserves A
 13129                          ;       Carry clear if character is an upper or lower case letter (A-Z or a-z)
 13130                          ;       otherwise carry set
 13131                          ;
 13132                          ; ***************************************************************************************
 13133                          .isLetter
 13134  e4e3 48                     PHA                                                 ; save A
 13135  e4e4 29df                   AND #$DF                                            ; convert lower to upper case
 13136  e4e6 c941                   CMP #.charA                                         ; compare with 'A'
 13137  e4e8 9004                   BCC .noLetter                                       ; if (lower than 'A') then branch (exit routine with carry set)
 13138  e4ea c95b                   CMP #.charZ + 1                                     ; compare with 'Z' + 1
 13139  e4ec 9001                   BCC .yesLetter                                      ; if (no larger than 'Z') then branch (exit with carry clear)
 13140                          .noLetter
 13141  e4ee 38                     SEC                                                 ; set carry
 13142                          .yesLetter
 13143  e4ef 68                     PLA                                                 ; restore original value of A
 13144  e4f0 60                     RTS                                                 ;
 13145                          
 13146                          ; [ Alternatively this would use four fewer bytes...
 13147                          ; .isLetter
 13148                          ;    PHA                                                ; Save A
 13149                          ;    AND #$DF                                           ; convert lower to upper case
 13150                          ;    SEC                                                ;
 13151                          ;    SBC #.charA                                        ; 'A'-'Z' maps to 0-25
 13152                          ;    CMP #26                                            ; check if in range 0-25
 13153                          ;    PLA                                                ;
 13154                          ;    RTS                                                ; ]
 13155                          
 13156                          ; ***************************************************************************************
 13157                          .insertByteIntoKeyboardBuffer
 13158  e4f1 a200                   LDX #0                                              ; X=0 to indicate keyboard buffer
 13159                              ; fall through...
 13160                          
 13161                          ; ***************************************************************************************
 13162                          ;
 13163                          ; OSBYTE 153 - Put byte in input buffer
 13164                          ;
 13165                          ; On Entry:
 13166                          ;       X is buffer number:
 13167                          ;           1 is RS-423 input
 13168                          ;           0 is Keyboard
 13169                          ;       Y is character to be written
 13170                          ;
 13171                          ; On Exit:
 13172                          ;       Carry clear
 13173                          ;
 13174                          ; ***************************************************************************************
 13175                          .osbyte153EntryPoint
 13176  e4f3 8a                     TXA                                                 ; A=buffer number
 13177  e4f4 2d4502                 AND .rs423Mode                                      ; AND with RS-423 mode:
 13178                                                                                  ; (0 = treat as keyboard;
 13179                                                                                  ;  1 = ignore Escapes, no events, no soft keys)
 13180  e4f7 d0b6                   BNE .osbyte138EntryPoint                            ; if (RS-423 input buffer) AND (RS-423 in normal mode) then branch (enter byte into buffer)
 13181  e4f9 98                     TYA                                                 ; Y=character to write
 13182  e4fa 4d6c02                 EOR .asciiCodeThatGeneratesESCAPEAction             ; compare with current escape ASCII code (0=match)
 13183  e4fd 0d7502                 ORA .escapeAction                                   ; or with current ESCAPE status (0=ESC, 1=ASCII)
 13184  e500 d0a6                   BNE .generateEventAndPutByteIntoBuffer              ; if (not ESCAPE character) OR (ESCAPE action says ASCII) then branch (to enter byte in buffer)
 13185  e502 ad5802                 LDA .escapeAndBreakEffect                           ; get ESCAPE/BREAK effect byte
 13186  e505 6a                     ROR                                                 ; Rotate to get ESCAPE bit into carry
 13187  e506 98                     TYA                                                 ; get character back in A
 13188  e507 b00a                   BCS .exitWithCarryClear                             ; if (escape effect disabled) then branch (exit with carry clear)
 13189  e509 a006                   LDY #.eventESCAPEConditionDetected                  ; signal event "Escape condition detected"
 13190  e50b 2094e4                 JSR .eventEntryPoint                                ;
 13191  e50e 9003                   BCC .exitWithCarryClear                             ; if (event handles ESCAPE) then branch (exit with carry clear)
 13192  e510 2074e6                 JSR .osbyte125EntryPoint                            ; set ESCAPE flag
 13193                          
 13194                          .exitWithCarryClear
 13195  e513 18                     CLC                                                 ; clear carry
 13196  e514 60                     RTS                                                 ;
 13197                          
 13198                          ; ***************************************************************************************
 13199                          ;
 13200                          ; Handle cursor, COPY and soft keys for non-zero cursor editing type
 13201                          ;
 13202                          ; On Entry:
 13203                          ;       A = cursor editing type
 13204                          ;           1 = return $87 - $8B (codes for COPY, LEFT, RIGHT, DOWN, UP)
 13205                          ;           2 = use cursor keys as soft keys 11-15
 13206                          ;
 13207                          ; ***************************************************************************************
 13208                          .handleCursorKeysAndCOPY
 13209  e515 6a                     ROR                                                 ; get bit 0 of cursor editing type
 13210                                                                                  ; into carry
 13211                          
 13212                              ; carry is set means cursor keys return codes $87-$8B
 13213                              ; carry  clear means cursor keys and COPY key are soft keys 11=COPY,12=LEFT,13=RIGHT,
 13214                              ;                                                           14=DOWN,15=UP
 13215                          
 13216  e516 68                     PLA                                                 ; get back character A
 13217  e517 b079                   BCS .exitWithCarryClear2                            ; if (carry set) then branch (exit)
 13218                          
 13219                              ; cursor keys are 'soft'
 13220                          .handleFunctionKeyPress
 13221  e519 98                     TYA                                                 ; A=Y get back original key code ($80-$FF)
 13222  e51a 48                     PHA                                                 ; PUSH A
 13223  e51b 4a                     LSR                                                 ; }
 13224  e51c 4a                     LSR                                                 ; }
 13225  e51d 4a                     LSR                                                 ; } shift high nybble down into low nybble
 13226  e51e 4a                     LSR                                                 ; }
 13227                                                                                  ; A=$08 - $0F
 13228  e51f 4904                   EOR #4                                              ; invert bit 2
 13229                                                                                  ; $08 becomes $0C
 13230                                                                                  ; $09 becomes $0D
 13231                                                                                  ; $0A becomes $0E
 13232                                                                                  ; $0B becomes $0F
 13233                                                                                  ; $0C becomes $08
 13234                                                                                  ; $0D becomes $09
 13235                                                                                  ; $0E becomes $0A
 13236                                                                                  ; $0F becomes $0B
 13237  e521 a8                     TAY                                                 ;
 13238  e522 b96502                 LDA .functionAndCursorKeyCodes - 8,Y                ; read key interpretation
 13239                          
 13240                              ; Key interpretation:
 13241                              ;
 13242                              ;     0 = ignore key
 13243                              ;     1 = expand as 'soft' key
 13244                              ; 2-$FF = add this to base for 'ASCII' code note that provision is made for keypad
 13245                              ; operation as codes $C0-$FF cannot be generated from keyboard but are recognised
 13246                              ; by OS
 13247                          
 13248  e525 c901                   CMP #1                                              ; is it 1
 13249  e527 f06b                   BEQ .expandSoftKey                                  ; if (expand as 'soft' key required)
 13250                                                                                  ; then branch (expand as 'soft' key)
 13251  e529 68                     PLA                                                 ; get back original byte
 13252  e52a 900d                   BCC .readFromInputBufferX                           ; if (zero, i.e. ignore key) then
 13253                                                                                  ; branch
 13254                          
 13255                              ; add base value to get 'ASCII' code
 13256  e52c 290f                   AND #$0F                                            ; add ASCII to BASE key number so
 13257                                                                                  ; clear high nybble
 13258  e52e 18                     CLC                                                 ; clear carry
 13259  e52f 796502                 ADC .functionAndCursorKeyCodes - 8,Y                ; add ASCII base
 13260  e532 18                     CLC                                                 ; clear carry
 13261  e533 60                     RTS                                                 ;
 13262                          
 13263                          ; ***************************************************************************************
 13264                          .errorOnReadingCharacterFromScreen
 13265  e534 206fe8                 JSR .vdu7EntryPoint                                 ; produce bell
 13266  e537 68                     PLA                                                 ; get back A, buffer number
 13267  e538 aa                     TAX                                                 ; X=buffer number
 13268                              ; fall through...
 13269                          
 13270                          ; ***************************************************************************************
 13271                          ;
 13272                          ; Read from input buffer X (0 = keyboard; 1 = RS-423)
 13273                          ;
 13274                          ; ***************************************************************************************
 13275                          .readFromInputBufferX
 13276  e539 2060e4                 JSR .osbyte145EntryPoint                            ; get byte from buffer X
 13277  e53c b055                   BCS .exit21                                         ; if (buffer is empty) then branch (return)
 13278  e53e 48                     PHA                                                 ; push byte received
 13279  e53f e001                   CPX #.bufferNumberRS423Input                        ; check for RS-423 Input buffer
 13280  e541 d006                   BNE +                                               ; if (not RS-423 input buffer) then branch
 13281                          
 13282  e543 2073e1                 JSR .setRS423Active                                 ;
 13283  e546 a201                   LDX #.bufferNumberRS423Input                        ; X=RS-423 input buffer
 13284  e548 38                     SEC                                                 ; set carry
 13285                          +
 13286  e549 68                     PLA                                                 ; get back original byte
 13287  e54a 9005                   BCC +                                               ; if (carry clear, i.e. X=0, the keyboard buffer) then branch forward
 13288  e54c ac4502                 LDY .rs423Mode                                      ; Y=RS-423 mode
 13289                                                                                  ;   0 means treat RS-423 input same as keyboard
 13290                                                                                  ;   1 means ESCAPE is ignored; soft keys are not expanded; no events are triggered
 13291  e54f d041                   BNE .exitWithCarryClear2                            ; if (normal RS-423 mode) then branch (exit)
 13292                          
 13293                          +
 13294  e551 a8                     TAY                                                 ; Y=original character to add to buffer
 13295  e552 103e                   BPL .exitWithCarryClear2                            ; if (code is less than $80) then branch (it's simple, so exit)
 13296  e554 290f                   AND #%00001111                                      ; clear high nybble
 13297  e556 c90b                   CMP #11                                             ; compare with 11
 13298  e558 90bf                   BCC .handleFunctionKeyPress                         ; if (less than 11, i.e. function key) then branch
 13299  e55a 697b                   ADC #$7B                                            ; add $7C ($7B+Carry) to convert codes $0B-$0F to $87-$8B
 13300  e55c 48                     PHA                                                 ; Push A
 13301  e55d ad7d02                 LDA .cursorEditingType                              ; get cursor editing type
 13302  e560 d0b3                   BNE .handleCursorKeysAndCOPY                        ; if (standard cursor key editing is disabled) then branch
 13303  e562 ad7c02                 LDA .characterDestinationsAvailableFlags            ; get character destination status
 13304                          
 13305                                                                                  ; bit 0 - enable RS-423 driver
 13306                                                                                  ; bit 1 - disable VDU driver
 13307                                                                                  ; bit 2 - disable printer driver
 13308                                                                                  ; bit 3 - enable printer, independent of CTRL-B/C
 13309                                                                                  ; bit 4 - disable SPOOLed output
 13310                                                                                  ; bit 5 - not used
 13311                                                                                  ; bit 6 - disable printer driver (unless preceded by VDU 1)
 13312                                                                                  ; bit 7 - not used
 13313                          
 13314  e565 6a                     ROR                                                 ; get bit 1 into carry
 13315  e566 6a                     ROR                                                 ;
 13316  e567 68                     PLA                                                 ;
 13317  e568 b0cf                   BCS .readFromInputBufferX                           ; if (carry is set, i.e. VDU disabled) then branch
 13318  e56a c987                   CMP #.charCOPY                                      ; check for COPY key
 13319  e56c f038                   BEQ .handleCOPYkeyToReadCharacterFromScreen         ; if (COPY key pressed) then branch (handle COPY key)
 13320                          
 13321  e56e a8                     TAY                                                 ; Y=A
 13322  e56f 8a                     TXA                                                 ; A=X
 13323  e570 48                     PHA                                                 ; Push X
 13324  e571 98                     TYA                                                 ; get back Y
 13325  e572 20ced8                 JSR .splitIntoTwoCursors                            ; Split into the WRITE and READ cursors
 13326                          
 13327  e575 68                     PLA                                                 ; restore X
 13328  e576 aa                     TAX                                                 ;
 13329                          
 13330                          .readFromEconetOrSoftKeyOrInputBufferA
 13331  e577 2c5f02                 BIT .econetReadCharacterInterceptionFlag            ; check Econet RDCH flag
 13332  e57a 1005                   BPL .readFromSoftKeyOrInputBufferA                  ; if (not set) then branch
 13333  e57c a906                   LDA #6                                              ; Econet function 6
 13334                          .netvJumper
 13335  e57e 6c2402                 JMP (.vectorNETV)                                   ; to the Econet vector
 13336                          
 13337                          .readFromSoftKeyOrInputBufferA
 13338  e581 ad6802                 LDA .softKeyStringLength                            ; get length of *KEY string
 13339  e584 f0b3                   BEQ .readFromInputBufferX                           ; if (no soft key) then branch (get a character from the buffer)
 13340  e586 acc902                 LDY .softKeyExpansionPointer                        ; get soft key expansion pointer
 13341  e589 b9010b                 LDA .softKeyPage + 1,Y                              ; get character from string
 13342  e58c eec902                 INC .softKeyExpansionPointer                        ; increment pointer
 13343  e58f ce6802                 DEC .softKeyStringLength                            ; decrement length
 13344                          .exitWithCarryClear2
 13345  e592 18                     CLC                                                 ;
 13346                          .exit21
 13347  e593 60                     RTS                                                 ;
 13348                          
 13349                          ; ***************************************************************************************
 13350                          ;
 13351                          ; Expand Soft Key (*KEY expansion)
 13352                          ;
 13353                          ; On Entry:
 13354                          ;       Y=pointer to string number
 13355                          ;
 13356                          ; ***************************************************************************************
 13357                          .expandSoftKey
 13358  e594 68                     PLA                                                 ; restore original code
 13359  e595 290f                   AND #$0F                                            ; get low nybble (key string number)
 13360  e597 a8                     TAY                                                 ; Y=A
 13361  e598 20a8e3                 JSR .getStarKeyStringLength                         ; get string length in A
 13362  e59b 8d6802                 STA .softKeyStringLength                            ; store it
 13363  e59e b9000b                 LDA .softKeyPage,Y                                  ; get start point
 13364  e5a1 8dc902                 STA .softKeyExpansionPointer                        ; store it
 13365  e5a4 d0d1                   BNE .readFromEconetOrSoftKeyOrInputBufferA          ; ALWAYS branch (get byte and exit)
 13366                          
 13367                          ; ***************************************************************************************
 13368                          .handleCOPYkeyToReadCharacterFromScreen
 13369  e5a6 8a                     TXA                                                 ; A=X
 13370  e5a7 48                     PHA                                                 ; Push A
 13371  e5a8 2005d9                 JSR .readCharacterFromScreenAndCursorRight          ; read a character from the screen
 13372  e5ab a8                     TAY                                                 ; Y=A
 13373  e5ac f086                   BEQ .errorOnReadingCharacterFromScreen              ; if (A=0, i.e. not valid) then branch (beep)
 13374  e5ae 68                     PLA                                                 ; restore X
 13375  e5af aa                     TAX                                                 ;
 13376  e5b0 98                     TYA                                                 ; and Y
 13377  e5b1 18                     CLC                                                 ; clear carry
 13378  e5b2 60                     RTS                                                 ;
 13379                          
 13380                          ; ***************************************************************************************
 13381                          ; ***************************************************************************************
 13382                          ;
 13383                          ; Chapter 15: OSBYTE and OSWORD
 13384                          ;
 13385                          ; ***************************************************************************************
 13386                          ; ***************************************************************************************
 13387                          
 13388                          ; ***************************************************************************************
 13389                          ;
 13390                          ; OSBYTE/OSWORD lookup table
 13391                          ;
 13392                          ; Valid OSBYTEs are in the arbitrary ranges 0-21, 117-160, 166-255. The range 166-255 reads
 13393                          ; and writes to a contiguous range of memory locations, and are implemented by a single
 13394                          ; routine. Otherwise the reasoning behind these ranges is unclear. Perhaps 0-21 were
 13395                          ; anticipated (erroneously or otherwise) to be the more commonly used OSBYTEs?
 13396                          ;
 13397                          ; Valid OSWORDs are in the range 0-13, and OSWORDs 224-255 are sent through USERV.
 13398                          ;
 13399                          ; ***************************************************************************************
 13400                          .osbyteAndOSWORDRoutineTable
 13401  e5b3 21e8                   !word .osbyte0EntryPoint        ; OSBYTE   0 - Generate error message/return version number
 13402  e5b5 88e9                   !word .osbyte1EntryPoint        ; OSBYTE   1 - Read/Write user flag
 13403  e5b7 d3e6                   !word .osbyte2EntryPoint        ; OSBYTE   2 - select input stream
 13404  e5b9 97e9                   !word .osbyte3EntryPoint        ; OSBYTE   3 - Select output stream
 13405  e5bb 97e9                   !word .osbyte4EntryPoint        ; OSBYTE   4 - Enable / disable cursor editing
 13406  e5bd 76e9                   !word .osbyte5EntryPoint        ; OSBYTE   5 - Select printer type
 13407  e5bf 88e9                   !word .osbyte6EntryPoint        ; OSBYTE   6 - Set printer ignore character
 13408  e5c1 8be6                   !word .osbyte7EntryPoint        ; OSBYTE   7 - Set RS-423 baud rate for receiving data
 13409  e5c3 89e6                   !word .osbyte8EntryPoint        ; OSBYTE   8 - Set RS-423 baud rate for transmitting data
 13410  e5c5 b0e6                   !word .osbyte9EntryPoint        ; OSBYTE   9 - Duration of first colour
 13411  e5c7 b2e6                   !word .osbyte10EntryPoint       ; OSBYTE  10 - Duration of second colour
 13412  e5c9 95e9                   !word .osbyte11EntryPoint       ; OSBYTE  11 - Set keyboard autorepeat delay
 13413  e5cb 8ce9                   !word .osbyte12EntryPoint       ; OSBYTE  12 - Set keyboard autorepeat rate
 13414  e5cd f9e6                   !word .osbyte13EntryPoint       ; OSBYTE  13 - Disable events
 13415  e5cf fae6                   !word .osbyte14EntryPoint       ; OSBYTE  14 - Enable events
 13416  e5d1 a8f0                   !word .osbyte15EntryPoint       ; OSBYTE  15 - Flush selected buffer class
 13417  e5d3 06e7                   !word .osbyte16EntryPoint       ; OSBYTE  16 - Select ADC channels
 13418  e5d5 8cde                   !word .osbyte17EntryPoint       ; OSBYTE  17 - Start ADC conversions
 13419  e5d7 c8e9                   !word .osbyte18EntryPoint       ; OSBYTE  18 - Reset soft keys
 13420  e5d9 b6e9                   !word .osbyte19EntryPoint       ; OSBYTE  19 - Wait for vertical sync
 13421  e5db 07cd                   !word .osbyte20EntryPoint       ; OSBYTE  20 - 'Explode' soft character definitions
 13422  e5dd b4f0                   !word .osbyte21EntryPoint       ; OSBYTE  21 - Flush specific buffer
 13423                          
 13424  e5df 6ce8                   !word .osbyte117EntryPoint      ; OSBYTE 117 - Read VDU status
 13425  e5e1 d9e9                   !word .osbyte118EntryPoint      ; OSBYTE 118 - Set keyboard LEDs based on keyboard status
 13426  e5e3 75e2                   !word .osbyte119EntryPoint      ; OSBYTE 119 - Close Spool / Exec files
 13427  e5e5 45f0                   !word .osbyte120EntryPoint      ; OSBYTE 120 - Write key pressed data
 13428  e5e7 cff0                   !word .osbyte121EntryPoint      ; OSBYTE 121 - Keyboard scan from value in X
 13429  e5e9 cdf0                   !word .osbyte122EntryPoint      ; OSBYTE 122 - Keyboard scan from 16 decimal
 13430  e5eb 97e1                   !word .osbyte123EntryPoint      ; OSBYTE 123 - Warn OS about printer going dormant
 13431  e5ed 73e6                   !word .osbyte124EntryPoint      ; OSBYTE 124 - Clear ESCAPE condition
 13432  e5ef 74e6                   !word .osbyte125EntryPoint      ; OSBYTE 125 - Set ESCAPE condition
 13433  e5f1 5ce6                   !word .osbyte126EntryPoint      ; OSBYTE 126 - Acknowledge detection of ESCAPE condition
 13434  e5f3 35e0                   !word .osbyte127EntryPoint      ; OSBYTE 127 - Check for EOF on open file
 13435  e5f5 4fe7                   !word .osbyte128EntryPoint      ; OSBYTE 128 - Read ADC Channel / get buffer status
 13436  e5f7 13e7                   !word .osbyte129EntryPoint      ; OSBYTE 129 - Read key within time limit
 13437  e5f9 29e7                   !word .osbyte130EntryPoint      ; OSBYTE 130 - Read machine high order address
 13438  e5fb 85f0                   !word .osbyte131EntryPoint      ; OSBYTE 131 - Read OSHWM (OS High Water Mark)
 13439  e5fd 23d9                   !word .osbyte132EntryPoint      ; OSBYTE 132 - Read HIMEM (start of screen memory)
 13440  e5ff 26d9                   !word .osbyte133EntryPoint      ; OSBYTE 133 - Read start of screen memory for given MODE
 13441  e601 47d6                   !word .osbyte134EntryPoint      ; OSBYTE 134 - Read text cursor position
 13442  e603 c2d7                   !word .osbyte135EntryPoint      ; OSBYTE 135 - Read character at text cursor position
 13443  e605 57e6                   !word .osbyte136EntryPoint      ; OSBYTE 136 - Execute code via User Vector (*CODE)
 13444  e607 7fe6                   !word .osbyte137EntryPoint      ; OSBYTE 137 - Turn on tape motor
 13445  e609 afe4                   !word .osbyte138EntryPoint      ; OSBYTE 138 - Put byte into buffer
 13446  e60b 34e0                   !word .osbyte139EntryPoint      ; OSBYTE 139 - Select file options (*OPT)
 13447  e60d 35f1                   !word .osbyte140EntryPoint      ; OSBYTE 140 - Select TAPE file system
 13448  e60f 35f1                   !word .osbyte141EntryPoint      ; OSBYTE 141 - Select ROM file system
 13449  e611 e7db                   !word .osbyte142EntryPoint      ; OSBYTE 142 - Enter language ROM (at $8000)
 13450  e613 68f1                   !word .osbyte143EntryPoint      ; OSBYTE 143 - Pass service commands to sideways ROMs
 13451  e615 e3ea                   !word .osbyte144EntryPoint      ; OSBYTE 144 - *TV
 13452  e617 60e4                   !word .osbyte145EntryPoint      ; OSBYTE 145 - Get byte from buffer
 13453  e619 aaff                   !word .osbyte146EntryPoint      ; OSBYTE 146 - Read a byte from FRED
 13454  e61b f4ea                   !word .osbyte147EntryPoint      ; OSBYTE 147 - Write a byte to FRED
 13455  e61d aeff                   !word .osbyte148EntryPoint      ; OSBYTE 148 - Read a byte from JIM
 13456  e61f f9ea                   !word .osbyte149EntryPoint      ; OSBYTE 149 - Write a byte to JIM
 13457  e621 b2ff                   !word .osbyte150EntryPoint      ; OSBYTE 150 - Read a byte from SHEILA
 13458  e623 feea                   !word .osbyte151EntryPoint      ; OSBYTE 151 - Write a byte to SHEILA
 13459  e625 5be4                   !word .osbyte152EntryPoint      ; OSBYTE 152 - Examine buffer status
 13460  e627 f3e4                   !word .osbyte153EntryPoint      ; OSBYTE 153 - Put byte in input buffer
 13461  e629 ffe9                   !word .osbyte154EntryPoint      ; OSBYTE 154 - Write to Video ULA's Video Control Register
 13462  e62b 10ea                   !word .osbyte155EntryPoint      ; OSBYTE 155 - Set palette value
 13463  e62d 7ce1                   !word .osbyte156EntryPoint      ; OSBYTE 156 - Update ACIA Control Register and OS Copy
 13464  e62f a7ff                   !word .osbyte157EntryPoint      ; OSBYTE 157 - Fast Tube BPUT
 13465  e631 6dee                   !word .osbyte158EntryPoint      ; OSBYTE 158 - Read byte from speech processor
 13466  e633 7fee                   !word .osbyte159EntryPoint      ; OSBYTE 159 - Write byte to speech processor
 13467  e635 c0e9                   !word .osbyte160EntryPoint      ; OSBYTE 160 - Read VDU Variable
 13468                          
 13469  e637 9ce9                   !word .osbyte166to255EntryPoint ; OSBYTE 166 to 255 - Implemented via table lookup
 13470  e639 59e6                   !word .uservJumper              ; OSWORD 224-255 (unknown OSWORDs sent through USERV)
 13471                          
 13472                          ;
 13473                          ; OSWORD lookup table - effectively a continuation of the same table as above
 13474                          ;
 13475  e63b 02e9                   !word .osword0EntryPoint        ; OSWORD   0 - Read line from current input into memory
 13476  e63d d5e8                   !word .osword1EntryPoint        ; OSWORD   1 - Read system clock
 13477  e63f e8e8                   !word .osword2EntryPoint        ; OSWORD   2 - Write system clock
 13478  e641 d1e8                   !word .osword3EntryPoint        ; OSWORD   3 - Read interval timer
 13479  e643 e4e8                   !word .osword4EntryPoint        ; OSWORD   4 - Write interval timer
 13480  e645 03e8                   !word .osword5EntryPoint        ; OSWORD   5 - Read a byte from I/O memory
 13481  e647 0be8                   !word .osword6EntryPoint        ; OSWORD   6 - Write a byte to I/O memory
 13482  e649 2de8                   !word .osword7EntryPoint        ; OSWORD   7 - Make a sound
 13483  e64b aee8                   !word .osword8EntryPoint        ; OSWORD   8 - Define an envelope
 13484  e64d 35c7                   !word .osword9EntryPoint        ; OSWORD   9 - Read a pixel
 13485  e64f f3cb                   !word .osword10EntryPoint       ; OSWORD  10 - Read character definition
 13486  e651 48c7                   !word .osword11EntryPoint       ; OSWORD  11 - Read palette
 13487  e653 e0c8                   !word .osword12EntryPoint       ; OSWORD  12 - Write Palette
 13488  e655 ced5                   !word .osword13EntryPoint       ; OSWORD  13 - Read last two graphic cursor positions
 13489                          
 13490                          
 13491                          ; ***************************************************************************************
 13492                          ;
 13493                          ; OSBYTE 136 - Execute code via User Vector (*CODE)
 13494                          ;
 13495                          ; ***************************************************************************************
 13496                          .osbyte136EntryPoint
 13497  e657 a900                   LDA #0                                              ; A=0
 13498                              ; fall through...
 13499                          
 13500                          ; ***************************************************************************************
 13501                          ;
 13502                          ; Jumps to the User vector
 13503                          ;
 13504                          ; This is called in response to *CODE, *LINE, or an OSWORD in the range 224-255. By default
 13505                          ; this does nothing, but user code can intercept the USERV vector to provide new functionality
 13506                          ; for these calls.
 13507                          ;
 13508                          ; On Entry:
 13509                          ;       A=0         called from *CODE / *FX 136         .osbyteX / .osbyteY are parameters
 13510                          ;       A=1         called from *LINE                   XY = address of string
 13511                          ;       A=224-255   called from OSWORD 224-255          .oswordX / .oswordY are parameters
 13512                          ;
 13513                          ; ***************************************************************************************
 13514                          .uservJumper
 13515  e659 6c0002                 JMP (.vectorUSERV)                                  ; Jump via USERV
 13516                          
 13517                          
 13518                          ; ***************************************************************************************
 13519                          ;
 13520                          ; OSBYTE 126 - Acknowledge detection of ESCAPE condition
 13521                          ;
 13522                          ; If an ESCAPE condition has occurred, then this acknowledges (clears) it, informing the
 13523                          ; second processor of it via the Tube if present.
 13524                          ;
 13525                          ; ***************************************************************************************
 13526                          .osbyte126EntryPoint
 13527  e65c a200                   LDX #0                                              ; X=0
 13528  e65e 24ff                   BIT .escapeFlag                                     ; check for ESCAPE flag
 13529  e660 1011                   BPL .osbyte124EntryPoint                            ; if (no ESCAPE flag) then branch
 13530                                                                                  ; (just clear the ESCAPE condition)
 13531  e662 ad7602                 LDA .escapeEffects                                  ; get ESCAPE effects
 13532  e665 d00a                   BNE +                                               ; if (escape effects is non-zero)
 13533                                                                                  ; then branch (no effects)
 13534                          
 13535                                                                                  ; reset VDU paging counter
 13536                                                                                  ; close EXEC files
 13537                                                                                  ; purge all buffers
 13538                                                                                  ; Clear ESCAPE condition
 13539                          
 13540  e667 58                     CLI                                                 ; allow interrupts
 13541  e668 8d6902                 STA .pagedModeCounter                               ; zero the number of lines printed since last halt in paged mode
 13542  e66b 208df6                 JSR .closeAndOptionallyOpenANewEXECFile             ; close any open EXEC file (A=0, Z=0)
 13543  e66e 20aaf0                 JSR .flushAllBuffers                                ; clear all buffers
 13544                          +
 13545  e671 a2ff                   LDX #$FF                                            ; X=$FF to indicate ESCAPE acknowledged
 13546                              ; fall through...
 13547                          
 13548                          ; ***************************************************************************************
 13549                          ;
 13550                          ; OSBYTE 124 - Clear ESCAPE condition
 13551                          ;
 13552                          ; ***************************************************************************************
 13553                          .osbyte124EntryPoint
 13554  e673 18                     CLC                                                 ; clear carry
 13555                              ; fall through...
 13556                          
 13557                          ; ***************************************************************************************
 13558                          ;
 13559                          ; OSBYTE 125 - Set ESCAPE condition
 13560                          ;
 13561                          ; On Entry:
 13562                          ;       The regular OSBYTE entry sets carry (meaning set the ESCAPE condition).
 13563                          ;       If falling through from OSBYTE 124 above then carry is clear (meaning clear the ESCAPE
 13564                          ;       condition).
 13565                          ;
 13566                          ; ***************************************************************************************
 13567                          .osbyte125EntryPoint
 13568  e674 66ff                   ROR .escapeFlag                                     ; set/clear bit 7 of ESCAPE flag
 13569  e676 2c7a02                 BIT .tubePresentFlag                                ; check if Tube is present
 13570  e679 3001                   BMI +                                               ; if (Tube present) then branch
 13571  e67b 60                     RTS                                                 ;
 13572                          +
 13573  e67c 4c0304                 JMP .tubeCopyESCAPEFlagToSecondProcessor            ; Jumps into a Tube entry point
 13574                          
 13575                          ; ***************************************************************************************
 13576                          ;
 13577                          ; OSBYTE 137 - Turn on/off tape motor
 13578                          ;
 13579                          ; On Entry:
 13580                          ;       X = 0 to turn the motor off; otherwise turn the motor on
 13581                          ;
 13582                          ; ***************************************************************************************
 13583                          .osbyte137EntryPoint
 13584  e67f ad8202                 LDA .serialULARegisterCopy                          ; get serial ULA control setting
 13585  e682 a8                     TAY                                                 ; Y=A
 13586  e683 2a                     ROL                                                 ; rotate left (shifts bit 7 into carry)
 13587  e684 e001                   CPX #1                                              ; if (X>=1, i.e. turn on motor) then set carry
 13588  e686 6a                     ROR                                                 ; rotate carry back in serialULA copy (bit 7)
 13589  e687 501e                   BVC .setSerialULADirectly                           ; ALWAYS branch
 13590                          
 13591                          
 13592                          ; ***************************************************************************************
 13593                          ;
 13594                          ; OSBYTE 8 - Set RS-423 baud rate for transmitting data
 13595                          ;
 13596                          ; On Entry:
 13597                          ;       X = baud rate
 13598                          ;
 13599                          ; ***************************************************************************************
 13600                          .osbyte8EntryPoint
 13601  e689 a938                   LDA #%00111000                                      ; Once it's EOR'd with the next instruction,
 13602                                                                                  ; this value becomes %00000111 (set transmit baud rate)
 13603                              ; fall through...
 13604                          
 13605                          ; ***************************************************************************************
 13606                          ;
 13607                          ; OSBYTE 7 - Set RS-423 baud rate for receiving data
 13608                          ;
 13609                          ; On Entry:
 13610                          ;       X = baud rate
 13611                          ;
 13612                          ; ***************************************************************************************
 13613                          .osbyte7EntryPoint
 13614  e68b 493f                   EOR #%00111111                                      ; converts 7 -> $38 = %00111000 (set receive baud rate)
 13615                                                                                  ; converts $38 -> 7 = %00000111 (set transmit baud rate)
 13616  e68d 85fa                   STA .tempStoreFA                                    ; store result
 13617  e68f ac8202                 LDY .serialULARegisterCopy                          ; get serial ULA control register setting
 13618  e692 e009                   CPX #9                                              ; }
 13619  e694 b017                   BCS .putNewSettingYInXAndReturn                     ; } is it 9 or more then branch (exit)
 13620  e696 3dade9                 AND .bufferTypeAndSerialBaudRatesTable,X            ; and with byte from look up table
 13621  e699 85fb                   STA .tempStoreFB                                    ; store it
 13622  e69b 98                     TYA                                                 ; put Y in A
 13623  e69c 05fa                   ORA .tempStoreFA                                    ; set the transmit or receive baud rate bits to 1
 13624  e69e 45fa                   EOR .tempStoreFA                                    ; zero the transmit or receive baud rate bits to 0
 13625  e6a0 05fb                   ORA .tempStoreFB                                    ; set baud rate from value read from table lookup
 13626  e6a2 0940                   ORA #$40                                            ; set bit 6
 13627  e6a4 4d5d02                 EOR .tapeRS423SelectionFlag                         ; clear bit 6 if tape active (0=RS-423 or $40=TAPE)
 13628                          .setSerialULADirectly
 13629  e6a7 8d8202                 STA .serialULARegisterCopy                          ; store serial ULA flag
 13630  e6aa 8d10fe                 STA .serialULAControlRegister                       ; and write to control register
 13631                          .putNewSettingYInXAndReturn
 13632  e6ad 98                     TYA                                                 ; put Y in A to save old contents
 13633                          .setXAndReturn
 13634  e6ae aa                     TAX                                                 ; write new setting to X
 13635  e6af 60                     RTS                                                 ;
 13636                          
 13637                          ; ***************************************************************************************
 13638                          ;
 13639                          ; OSBYTE 9 - Duration of first colour
 13640                          ;
 13641                          ; On Entry:
 13642                          ;      Y = 0
 13643                          ;      X = new value (in 1/50 of a second)
 13644                          ;
 13645                          ; ***************************************************************************************
 13646                          .osbyte9EntryPoint
 13647  e6b0 c8                     INY                                                 ; Y=1
 13648  e6b1 18                     CLC                                                 ; clear carry
 13649                              ; fall through...
 13650                          
 13651                          ; ***************************************************************************************
 13652                          ;
 13653                          ; OSBYTE 10 - Duration of second colour
 13654                          ;
 13655                          ; On Entry:
 13656                          ;       Y = 0 (or 1 if falling through from OSBYTE 9 call above)
 13657                          ;       X = new value (in 1/50 of a second)
 13658                          ;
 13659                          ; ***************************************************************************************
 13660                          .osbyte10EntryPoint
 13661  e6b2 b95202                 LDA .videoULAFirstFlashingColourInterval,Y          ; get mark period count
 13662  e6b5 48                     PHA                                                 ; push it
 13663  e6b6 8a                     TXA                                                 ; get new count
 13664  e6b7 995202                 STA .videoULAFirstFlashingColourInterval,Y          ; store it
 13665  e6ba 68                     PLA                                                 ; get back original value
 13666  e6bb a8                     TAY                                                 ; put it in Y
 13667  e6bc ad5102                 LDA .videoULAFlashingColourIntervalCount            ; get value of flash counter
 13668  e6bf d010                   BNE +                                               ; if (not zero) then branch
 13669  e6c1 8e5102                 STX .videoULAFlashingColourIntervalCount            ; restore old value
 13670  e6c4 ad4802                 LDA .videoULAVideoControlRegisterCopy               ; get current video ULA control register setting
 13671  e6c7 08                     PHP                                                 ; push flags
 13672  e6c8 6a                     ROR                                                 ; rotate bit 0 into carry, carry into bit 7
 13673  e6c9 28                     PLP                                                 ; get back flags
 13674  e6ca 2a                     ROL                                                 ; rotate back carry into bit 0
 13675  e6cb 8d4802                 STA .videoULAVideoControlRegisterCopy               ; store it in RAM copy
 13676  e6ce 8d20fe                 STA .videoULAControlRegister                        ; and ULA control register
 13677                          +
 13678  e6d1 50da                   BVC .putNewSettingYInXAndReturn                     ; ALWAYs branch
 13679                          
 13680                          ; ***************************************************************************************
 13681                          ;
 13682                          ; OSBYTE 2 - Select input stream
 13683                          ;
 13684                          ; On Entry:
 13685                          ;       X contains stream number
 13686                          ;       X = 0 (keyboard selected, RS-423 disabled)
 13687                          ;       X = 1 (RS-423 selected and enabled)
 13688                          ;       X = 2 (keyboard selected, RS-423 enabled)
 13689                          ;
 13690                          ; ***************************************************************************************
 13691                          .osbyte2EntryPoint
 13692  e6d3 8a                     TXA                                                 ; A=X
 13693  e6d4 2901                   AND #1                                              ; blank out bits 1 - 7
 13694  e6d6 48                     PHA                                                 ; push A
 13695  e6d7 ad5002                 LDA .rs423ControlRegisterCopy                       ; and get current ACIA control setting
 13696  e6da 2a                     ROL                                                 ; Bit 7 into carry
 13697  e6db e001                   CPX #1                                              ; }
 13698  e6dd 6a                     ROR                                                 ; } if (X>=1, i.e. RS-423 enabled) then set bit 7 of A, otherwise clear it
 13699  e6de cd5002                 CMP .rs423ControlRegisterCopy                       ; compare this with ACIA control setting
 13700  e6e1 08                     PHP                                                 ; push flags
 13701  e6e2 8d5002                 STA .rs423ControlRegisterCopy                       ; put A into ACIA control setting
 13702  e6e5 8d08fe                 STA .acia6850ControlRegister                        ; and write to control register
 13703  e6e8 2073e1                 JSR .setRS423Active                                 ; set up RS-423 buffer
 13704  e6eb 28                     PLP                                                 ; get back P
 13705  e6ec f003                   BEQ +                                               ; if (new setting different from old) then branch
 13706  e6ee 2c09fe                 BIT .acia6850DataRegister                           ; set bit 6 and 7
 13707                          
 13708                          +
 13709  e6f1 ae4102                 LDX .currentInputBuffer                             ; get current input buffer number
 13710  e6f4 68                     PLA                                                 ; get back A
 13711  e6f5 8d4102                 STA .currentInputBuffer                             ; store it
 13712  e6f8 60                     RTS                                                 ;
 13713                          
 13714                          
 13715                          ; ***************************************************************************************
 13716                          ;
 13717                          ; OSBYTE 13 - Disable events
 13718                          ;
 13719                          ; For information on Events, see .eventEntryPoint
 13720                          ;
 13721                          ; On Entry:
 13722                          ;       X contains event number 0-9 to disable
 13723                          ;
 13724                          ; ***************************************************************************************
 13725                          .osbyte13EntryPoint
 13726  e6f9 98                     TYA                                                 ; Y=0; A=0
 13727                              ; fall through...
 13728                          
 13729                          ; ***************************************************************************************
 13730                          ;
 13731                          ; OSBYTE 14 - Enable events
 13732                          ;
 13733                          ; For information on Events, see .eventEntryPoint
 13734                          ;
 13735                          ; On Entry:
 13736                          ;       A contains zero for disabling the event, or non-zero to enable the event.
 13737                          ;           This value is 14 if entry by OSBYTE 14 (which enables the event), or zero if
 13738                          ;           falling through from OSBYTE 13 above (which disables the event).
 13739                          ;       X contains event number 0-9 to enable
 13740                          ; On Exit:
 13741                          ;       Y contains previous value
 13742                          ;
 13743                          ; ***************************************************************************************
 13744                          .osbyte14EntryPoint
 13745  e6fa e00a                   CPX #10                                             ; }
 13746  e6fc b0b0                   BCS .setXAndReturn                                  ; } if X>9 then branch (set X from A and return)
 13747  e6fe bcbf02                 LDY .eventEnabledFlags,X                            ; get old event enable flag
 13748  e701 9dbf02                 STA .eventEnabledFlags,X                            ; store new value in flag
 13749  e704 50a7                   BVC .putNewSettingYInXAndReturn                     ; and exit
 13750                          
 13751                          
 13752                          ; ***************************************************************************************
 13753                          ;
 13754                          ; OSBYTE 16 - Select ADC channels
 13755                          ;
 13756                          ; Selects the range of channels for analogue to digital conversion (0-4)
 13757                          ; See .osbyte17EntryPoint
 13758                          ;
 13759                          ; On Entry:
 13760                          ;       X contains channel number (1-4) or 0 to disable conversions
 13761                          ;       Y = 0
 13762                          ;
 13763                          ; ***************************************************************************************
 13764                          .osbyte16EntryPoint
 13765  e706 f003                   BEQ +                                               ; if (X=0) then branch
 13766  e708 208cde                 JSR .osbyte17EntryPoint                             ; start conversion
 13767                          +
 13768  e70b ad4d02                 LDA .maximumADCChannelNumber                        ; get current maximum ADC channel number
 13769  e70e 8e4d02                 STX .maximumADCChannelNumber                        ; store new value
 13770  e711 aa                     TAX                                                 ; put old value in X
 13771  e712 60                     RTS                                                 ;
 13772                          
 13773                          
 13774                          ; ***************************************************************************************
 13775                          ;
 13776                          ; OSBYTE 129 - Read key within time limit
 13777                          ;
 13778                          ; On Entry:
 13779                          ;       X and Y contains either:
 13780                          ;           time limit in centi-seconds (Y=$7F max)
 13781                          ;       or Y=$FF and X=-ve INKEY value for an instant read of a specific key
 13782                          ;       or Y=$FF and X=0 to read the machine type (see NAUG Section 24.4.1 Page 428)
 13783                          ;
 13784                          ; ***************************************************************************************
 13785                          .osbyte129EntryPoint
 13786  e713 98                     TYA                                                 ; A=Y
 13787  e714 300b                   BMI .readNegativeKeyNumber                          ; if (Y negative) then branch
 13788  e716 58                     CLI                                                 ; allow interrupts
 13789  e717 20bbde                 JSR .osbyte129Timed                                 ; and go to timed routine
 13790  e71a b003                   BCS +                                               ; if (carry set) then branch
 13791  e71c aa                     TAX                                                 ; then X=A
 13792  e71d a900                   LDA #0                                              ; A=0
 13793                          +
 13794  e71f a8                     TAY                                                 ; Y=A
 13795  e720 60                     RTS                                                 ;
 13796                          
 13797                          .readNegativeKeyNumber
 13798  e721 8a                     TXA                                                 ; A=X
 13799  e722 497f                   EOR #$7F                                            ; convert to keyboard input
 13800  e724 aa                     TAX                                                 ; X=A
 13801  e725 2068f0                 JSR .keyJumper                                      ; then scan keyboard
 13802  e728 2a                     ROL                                                 ; put bit 7 into carry
 13803                          
 13804                              ; if (carry is set) then return $FFFF else return $0000
 13805                          .setXYAndExit
 13806                              ; fall through...
 13807                          
 13808                          ; ***************************************************************************************
 13809                          ;
 13810                          ; OSBYTE 130 - Read 'machine high order address'
 13811                          ;
 13812                          ; Filing systems use 32 bit addresses, where $FF,$FF is used in the top two bytes to
 13813                          ; indicate the address is in the main (I/O processor) memory as opposed to the second
 13814                          ; processor memory. This routine returns the two values used for this purpose, namely $FF,$FF.
 13815                          ;
 13816                          ; On Entry:
 13817                          ;       Carry set if entry is via OSBYTE 130
 13818                          ;       Carry may be clear if falling through from routines above,
 13819                          ;       either reading a key (.readNegativeKeyNumber) or doing an ADC conversion (.setXYAndExit).
 13820                          ;
 13821                          ; ***************************************************************************************
 13822                          .osbyte130EntryPoint
 13823  e729 a2ff                   LDX #$FF                                            ; X=$FF
 13824  e72b a0ff                   LDY #$FF                                            ; Y=$FF
 13825  e72d b002                   BCS +                                               ; if (carry set, depends on entry point) then branch (exit)
 13826  e72f e8                     INX                                                 ; X=0
 13827  e730 c8                     INY                                                 ; Y=0
 13828                          +
 13829  e731 60                     RTS                                                 ;
 13830                          
 13831                          
 13832                          ; ***************************************************************************************
 13833                          ;
 13834                          ; Get free space from an input buffer, or used space from an output buffer
 13835                          ;
 13836                          ; For buffer numbers, see .bufferNumberKeyboard.
 13837                          ;
 13838                          ; On Entry:
 13839                          ;       X=255 - buffer number
 13840                          ;
 13841                          ; ***************************************************************************************
 13842                          .countNegativeBuffer
 13843  e732 8a                     TXA                                                 ; buffer number in A
 13844  e733 49ff                   EOR #$FF                                            ; invert it
 13845  e735 aa                     TAX                                                 ; X=A
 13846  e736 e002                   CPX #2                                              ; is X>=2 (C set if output buffer, get bytes used)
 13847                          .countBufferStartup
 13848  e738 b8                     CLV                                                 ; clear V flag (meaning count buffer)
 13849  e739 5003                   BVC .countOrPurgeBuffer                             ; ALWAYS branch (count buffer)
 13850                          
 13851                          .purgeBuffer
 13852  e73b 2cb7d9                 BIT .allBitsSet                                     ; set V flag (meaning purge buffer) (N flag also set)
 13853                          .countOrPurgeBuffer
 13854  e73e 6c2e02                 JMP (.vectorCNPV)                                   ; See .cnpEntryPoint for default
 13855                                                                                  ; implementation
 13856                          
 13857                          
 13858                          ; ***************************************************************************************
 13859                          ;
 13860                          ; Get free bytes from RS-423 Input Buffer
 13861                          ;
 13862                          ; On Exit:
 13863                          ;   carry set, all is OK
 13864                          ;   carry clear, free space in buffer is low
 13865                          ;
 13866                          ; ***************************************************************************************
 13867                          .getRS423InputBufferFreeBytes
 13868  e741 38                     SEC                                                 ; to check for free bytes
 13869  e742 a201                   LDX #1                                              ; X=1 to point to RS-423 input buffer
 13870  e744 2038e7                 JSR .countBufferStartup                             ; and count it
 13871  e747 c001                   CPY #1                                              ; check the high byte of the length
 13872  e749 b003                   BCS +                                               ; if (one or more) then branch (exit)
 13873  e74b ec5b02                 CPX .rs423HandshakeExtent                           ; compare with minimum buffer space free
 13874                          +
 13875  e74e 60                     RTS                                                 ;
 13876                          
 13877                          
 13878                          ; ***************************************************************************************
 13879                          ;
 13880                          ; OSBYTE 128 - Read ADC Channel, or get buffer status
 13881                          ;
 13882                          ; On Entry:              On Exit:
 13883                          ; X=0                    Y contains number of last channel converted (1-4); X = fire buttons
 13884                          ; X=channel number (1-4) X,Y contain 16 bit value read from ADC channel (See .osbyte17EntryPoint)
 13885                          ; X<0 Y=$FF              X returns information about various buffers
 13886                          ; X=$FF (keyboard)       X = number of characters in buffer
 13887                          ; X=$FE (RS-423 input)   X = number of characters in buffer
 13888                          ; X=$FD (RS-423 output)  X = number of empty spaces in buffer
 13889                          ; X=$FC (printer)        X = number of empty spaces in buffer
 13890                          ; X=$FB (sound 0)        X = number of empty spaces in buffer
 13891                          ; X=$FA (sound 1)        X = number of empty spaces in buffer
 13892                          ; X=$F9 (sound 2)        X = number of empty spaces in buffer
 13893                          ; X=$F8 (sound 3)        X = number of empty spaces in buffer
 13894                          ; X=$F7 (Speech)         X = number of empty spaces in buffer
 13895                          ;
 13896                          ; ***************************************************************************************
 13897                          .osbyte128EntryPoint
 13898  e74f 30e1                   BMI .countNegativeBuffer                            ; if (X is -ve) then branch (count space free/used)
 13899  e751 f00c                   BEQ .lastChannelConverted                           ; if (X is zero) then branch
 13900  e753 e005                   CPX #5                                              ; }
 13901  e755 b0d2                   BCS .setXYAndExit                                   ; } if channel is not valid then branch (set X and Y to 255 and exit)
 13902  e757 bcb902                 LDY .highByteLastByteFromADCChannel1 - 1,X          ; get last value read for channel of interest (high byte)
 13903  e75a bdb502                 LDA .lowByteLastByteFromADCChannel1 - 1,X           ; get last value read for channel of interest (low byte)
 13904  e75d aa                     TAX                                                 ; X=low byte
 13905  e75e 60                     RTS                                                 ;
 13906                          
 13907                          .lastChannelConverted
 13908  e75f ad40fe                 LDA .systemVIARegisterB                             ; read system VIA port B
 13909  e762 6a                     ROR                                                 ; move high nybble to low
 13910  e763 6a                     ROR                                                 ;
 13911  e764 6a                     ROR                                                 ;
 13912  e765 6a                     ROR                                                 ;
 13913  e766 49ff                   EOR #$FF                                            ; and invert it
 13914  e768 2903                   AND #3                                              ; isolate the FIRE buttons
 13915  e76a acbe02                 LDY .adcLastChannelRead                             ; read last channel read
 13916  e76d 8ebe02                 STX .adcLastChannelRead                             ; store zero in last channel read
 13917  e770 aa                     TAX                                                 ; A=X bits 0 and 1 indicate fire buttons
 13918  e771 60                     RTS                                                 ;
 13919                          
 13920                          
 13921                          ; ***************************************************************************************
 13922                          ;
 13923                          ; OSBYTE - default entry point
 13924                          ;
 13925                          ; This entry point is executed for all OSBYTE calls. It routes the call through to one of the
 13926                          ; individual OSBYTE entry points by means of a table (see .osbyteAndOSWORDRoutineTable).
 13927                          ;
 13928                          ; Note: OSBYTEs 0-127 only return a value in the X register, whereas OSBYTEs 128-255 can
 13929                          ; return values in X,Y and carry. This fact is used to speed up access via the Tube.
 13930                          ;
 13931                          ; ***************************************************************************************
 13932                          .osbyteEntryPoint
 13933  e772 48                     PHA                                                 ; save A
 13934  e773 08                     PHP                                                 ; save Processor flags
 13935  e774 78                     SEI                                                 ; disable interrupts
 13936  e775 85ef                   STA .osbyteA                                        ; }
 13937  e777 86f0                   STX .osbyteX                                        ; } copy A,X,Y into zero page
 13938  e779 84f1                   STY .osbyteY                                        ; }
 13939  e77b a207                   LDX #.romServiceCallUnrecognisedOSBYTE              ; set X so that (if necessary) we can signal to ROMs that an unrecognised osbyte is being attempted
 13940  e77d c975                   CMP #117                                            ;
 13941  e77f 9041                   BCC .osbyte0to116                                   ; if (A < 117) then branch
 13942  e781 c9a1                   CMP #161                                            ;
 13943  e783 9009                   BCC .osbyte117To160                                 ; if (A < 161) then branch
 13944  e785 c9a6                   CMP #166                                            ;
 13945  e787 903f                   BCC .unknownOSBYTEOrOSWORD                          ; if (A < 166) then branch (with carry clear)
 13946  e789 18                     CLC                                                 ; clear carry
 13947                              ; at this point OSBYTE number in A >= 166
 13948                              ; fall through...
 13949                          
 13950                          ; ***************************************************************************************
 13951                          .osbyte166to255orOSWORD224to255
 13952                              ; NOTE: Entry 161 and 162 in the table have special meanings, which are used here
 13953                              ; if entry is via OSBYTE, then carry is clear and we look up entry 161 in table
 13954                              ; if entry is via OSWORD, then carry is  set  and we look up entry 162 in table
 13955  e78a a9a1                   LDA #161                                            ; A = 161
 13956  e78c 6900                   ADC #0                                              ; Add carry
 13957                          
 13958                          .osbyte117To160
 13959  e78e 38                     SEC                                                 ; set carry
 13960  e78f e95f                   SBC #95                                             ; if OSBYTE, converts A into range
 13961                                                                                  ; (22-66); if OSWORD then A=67
 13962                          
 13963                          .indexToTable
 13964  e791 0a                     ASL                                                 ; double A to get offset into table
 13965  e792 38                     SEC                                                 ; set carry
 13966                          
 13967                          .osbyteOrOSWORDTableLookup
 13968  e793 84f1                   STY .osbyteY                                        ; store Y
 13969  e795 a8                     TAY                                                 ; Y=A
 13970                          
 13971                              ; check for Econet intercept
 13972                              ; [There's a quirk here:
 13973                              ;
 13974                              ;  The following instruction sets V if bit 6 of .econetOSCallInterceptionFlag is
 13975                              ;  set. If bit 7 is clear as well, then we call whatever OSBYTE routine with V set,
 13976                              ;  which has some unexpected side effects. A few OSBYTE routines rely on V being clear,
 13977                              ;  So for example:
 13978                              ;
 13979                              ;       *FX 206,64      - sets the .econetOSCallInterceptionFlag to 64
 13980                              ;       *FX 10,1        - set the flashing colour time
 13981                              ;
 13982                              ;  This unexpectedly turns on RS-423 output, meaning you can't type at the keyboard
 13983                              ;  any more!
 13984                              ;
 13985                              ;  However, practically speaking there's no real reason you would need to set
 13986                              ;  .econetOSCallInterceptionFlag to anything other than either zero or something with
 13987                              ;  the top bit set so this probably never occurs in the wild.
 13988                              ; ]
 13989  e796 2c5e02                 BIT .econetOSCallInterceptionFlag                   ; check Econet intercept flag (bit 7)
 13990                                                                                  ; we expect bit 6 to be clear!
 13991  e799 1007                   BPL .skipEconetCall                                 ; if (no Econet intercept required) then branch (skip Econet check)
 13992                          
 13993  e79b 8a                     TXA                                                 ; A=X
 13994  e79c b8                     CLV                                                 ; V=0
 13995  e79d 207ee5                 JSR .netvJumper                                     ; to JMP via ECONET vector
 13996  e7a0 701a                   BVS .finishUpOSBYTEOrOSWORD                         ; if (returned with V set) then branch (finish up and exit)
 13997                          
 13998                          .skipEconetCall
 13999                              ; read routine address from table and store in .tempStoreFA/B
 14000  e7a2 b9b4e5                 LDA .osbyteAndOSWORDRoutineTable + 1,Y              ; get address from table (high byte)
 14001  e7a5 85fb                   STA .tempStoreFB                                    ; store as high byte
 14002  e7a7 b9b3e5                 LDA .osbyteAndOSWORDRoutineTable,Y                  ; get address from table (low byte)
 14003  e7aa 85fa                   STA .tempStoreFA                                    ; store as low byte
 14004  e7ac a5ef                   LDA .osbyteA                                        ; restore A
 14005  e7ae a4f1                   LDY .osbyteY                                        ; restore Y
 14006  e7b0 b004                   BCS .setCarryXAndJumpOSBYTE                         ; if (carry is set, i.e. an OSBYTE call) then branch
 14007                          
 14008                              ; OSWORD call. Set A to the value in the first byte of the parameter block
 14009  e7b2 a000                   LDY #0                                              ;
 14010  e7b4 b1f0                   LDA (.osbyteX),Y                                    ; read first byte from parameter address block (XY)
 14011                          
 14012                          .setCarryXAndJumpOSBYTE
 14013  e7b6 38                     SEC                                                 ; set carry
 14014  e7b7 a6f0                   LDX .osbyteX                                        ; restore X
 14015                          
 14016                              ; Finally, call the OSBYTE / OSWORD routine address
 14017                              ;
 14018                              ; For an OSBYTE call:
 14019                              ;   A,X,Y are set to the three parameters sent to .OSBYTE. These are also stored in
 14020                              ;         .osbyteA, .osbyteX and .osbyteY.
 14021                              ;   Carry is set.
 14022                              ;   Zero flag is set if X is zero.
 14023                              ;   Negative flag is set if X has it's top bit set.
 14024                              ;   V is clear. (But see .osbyteOrOSWORDTableLookup above for a 'bug')
 14025                              ;
 14026                              ; For an OSWORD call:
 14027                              ;   .oswordA hold the OSWORD number.
 14028                              ;   A is set to the first byte of the parameter block at the address held in .oswordX/.oswordY
 14029                              ;   X is set to .oswordX, the lower byte of the address
 14030                              ;   Y is set to zero.
 14031                              ;   Carry is set.
 14032                              ;   Zero flag is set if X is zero.
 14033                              ;   Negative flag is set if X has it's top bit set.
 14034                              ;
 14035  e7b9 2058f0                 JSR .osbyteOrOSWORDJumper                           ; call OSBYTE/OSWORD routine address
 14036                                                                                  ; stored in (.tempStoreFA/B)
 14037                          
 14038                          .finishUpOSBYTEOrOSWORD
 14039  e7bc 6a                     ROR                                                 ; C=bit 0
 14040  e7bd 28                     PLP                                                 ; get back flags
 14041  e7be 2a                     ROL                                                 ; bit 0=Carry
 14042  e7bf 68                     PLA                                                 ; get back A
 14043  e7c0 b8                     CLV                                                 ; clear V
 14044  e7c1 60                     RTS                                                 ;
 14045                          
 14046                          ; ***************************************************************************************
 14047                          .osbyte0to116
 14048  e7c2 a000                   LDY #0                                              ; Y=0
 14049  e7c4 c916                   CMP #22                                             ;
 14050  e7c6 90c9                   BCC .indexToTable                                   ; if (A < 22) then branch
 14051                              ; OSBYTE 22 to 116: these are unknown OSBYTE calls
 14052                              ; fall through with carry set...
 14053                          
 14054                          ; ***************************************************************************************
 14055                          ;
 14056                          ; Unknown OSBYTE or OSWORD command. Pass it onto ROMs for servicing.
 14057                          ;
 14058                          ; ***************************************************************************************
 14059                          .unknownOSBYTEOrOSWORD
 14060  e7c8 08                     PHP                                                 ; push flags
 14061  e7c9 08                     PHP                                                 ; push flags
 14062                          
 14063                          .pullTwiceAndOfferCallToROMs
 14064  e7ca 68                     PLA                                                 ; pull flags
 14065  e7cb 68                     PLA                                                 ; pull flags
 14066  e7cc 2068f1                 JSR .osbyte143EntryPoint                            ; offer paged ROMs service 7/8 unrecognised osbyte/word
 14067  e7cf d005                   BNE .romsDontRecogniseUnknownCommand                ; if (ROMs don't recognise it) then branch
 14068  e7d1 a6f0                   LDX .osbyteX                                        ; restore X
 14069  e7d3 4cbce7                 JMP .finishUpOSBYTEOrOSWORD                         ; finish up
 14070                          
 14071                          .romsDontRecogniseUnknownCommand
 14072  e7d6 28                     PLP                                                 ; pull flags
 14073  e7d7 68                     PLA                                                 ; and A
 14074  e7d8 2cb7d9                 BIT .allBitsSet                                     ; set N and V flags
 14075  e7db 60                     RTS                                                 ;
 14076                          
 14077                          ; ***************************************************************************************
 14078                          ;
 14079                          ; Check if it's ok to print a message
 14080                          ;
 14081                          ; Checks if the cassette filing system is in a critical (busy) state
 14082                          ; Check the catalogue status (are we currently doing a *CAT or equivalent)
 14083                          ; Checks the bits that allow printing short or long messages
 14084                          ;
 14085                          ; On Exit:
 14086                          ;       A = 0  (and therefore Z set)   means don't print messages
 14087                          ;       A != 0 (and therefore Z clear) means messages can be printed
 14088                          ;
 14089                          ; ***************************************************************************************
 14090                          .shouldPrintMessage
 14091  e7dc a5eb                   LDA .tapeCritical                                   ; read cassette critical flag bit 7 = busy
 14092  e7de 3032                   BMI .zeroAAndExit                                   ; if (tape critically busy) then branch (exit)
 14093  e7e0 a908                   LDA #%00001000                                      ; check current catalogue status bit
 14094  e7e2 25e2                   AND .fsStatusByte                                   ; check tape filing system status byte has the catalogue status bit set
 14095  e7e4 d004                   BNE +                                               ; if (catalogue bit set) then branch (exit)
 14096  e7e6 a988                   LDA #%10001000                                      ; A=%10001000 (these are the bits
 14097                                                                                  ; set if a message is required)
 14098  e7e8 25bb                   AND .tapeCurrentOptionsByte                         ; AND with filing system options (short/long message bits)
 14099                          +
 14100  e7ea 60                     RTS                                                 ;
 14101                          
 14102                          
 14103                          ; ***************************************************************************************
 14104                          ;
 14105                          ; OSWORD - Default entry point
 14106                          ;
 14107                          ; This entry point is executed for all OSWORD calls. It routes the call through to one of
 14108                          ; the individual OSWORD entry points by means of a table (see .osbyteAndOSWORDRoutineTable,
 14109                          ; at the end of which is the list of OSWORD entry points).
 14110                          ;
 14111                          ; ***************************************************************************************
 14112                          .oswordEntryPoint
 14113  e7eb 48                     PHA                                                 ; Push A
 14114  e7ec 08                     PHP                                                 ; Push flags
 14115  e7ed 78                     SEI                                                 ; disable interrupts
 14116  e7ee 85ef                   STA .oswordA                                        ; store A,X,Y
 14117  e7f0 86f0                   STX .oswordX                                        ;
 14118  e7f2 84f1                   STY .oswordY                                        ;
 14119  e7f4 a208                   LDX #.romServiceCallUnrecognisedOSWORD              ; set X so that if necessary, we can
 14120                                                                                  ; signal to ROMs that an unrecognised
 14121                                                                                  ; OSWORD is being attempted
 14122  e7f6 c9e0                   CMP #224                                            ;
 14123  e7f8 b090                   BCS .osbyte166to255orOSWORD224to255                 ; if (A >= 224) then branch (OSWORDs
 14124                                                                                  ; 224-255 call USERV)
 14125  e7fa c90e                   CMP #14                                             ;
 14126  e7fc b0ca                   BCS .unknownOSBYTEOrOSWORD                          ; if (A >= 14) then branch (unknown
 14127                                                                                  ; OSWORD)
 14128                          
 14129                              ; OSWORD 0-13
 14130  e7fe 6944                   ADC #68                                             ; add 68 to form pointer to table (68 to 81)
 14131  e800 0a                     ASL                                                 ; double it to form low byte of pointer ($88 to $A2)
 14132  e801 9090                   BCC .osbyteOrOSWORDTableLookup                      ; ALWAYS branch
 14133                          
 14134                          
 14135                          ; ***************************************************************************************
 14136                          ;
 14137                          ; OSWORD 5 - Read a byte from I/O memory
 14138                          ;
 14139                          ; This allows the second processor to access main (first processor) memory across the Tube.
 14140                          ;
 14141                          ; On Entry:
 14142                          ;       .oswordX/Y is the address of the five bytes of parameters:
 14143                          ;           byte 0-3: 32 bit address of byte
 14144                          ;           byte 4  : on exit byte read
 14145                          ;       A is the LSB of the 32 bit address
 14146                          ;
 14147                          ; ***************************************************************************************
 14148                          .osword5EntryPoint
 14149  e803 2015e8                 JSR .setUpDataBlock                                 ; set up address of data block
 14150  e806 a1f9                   LDA (.tempStoreFA - 1,X)                            ; get byte
 14151  e808 91f0                   STA (.oswordX),Y                                    ; store it
 14152  e80a 60                     RTS                                                 ;
 14153                          
 14154                          ; ***************************************************************************************
 14155                          ;
 14156                          ; OSWORD 6 - Write a byte to I/O memory
 14157                          ;
 14158                          ; This allows the second processor to access main (first processor) memory across the Tube.
 14159                          ;
 14160                          ; On Entry:
 14161                          ;       .oswordX/Y is the address of the five bytes of parameters:
 14162                          ;           byte 0-3: 32 bit address of byte
 14163                          ;           byte 4  : byte to be written
 14164                          ;       A is the LSB of the 32 bit address
 14165                          ;
 14166                          ; ***************************************************************************************
 14167                          .osword6EntryPoint
 14168  e80b 2015e8                 JSR .setUpDataBlock                                 ; set up address
 14169  e80e b1f0                   LDA (.oswordX),Y                                    ; get byte to write
 14170  e810 81f9                   STA (.tempStoreFA - 1,X)                            ; write byte
 14171                          .zeroAAndExit
 14172  e812 a900                   LDA #0                                              ; A=0
 14173  e814 60                     RTS                                                 ;
 14174                          
 14175                          ; ***************************************************************************************
 14176                          .setUpDataBlock
 14177  e815 85fa                   STA .tempStoreFA                                    ; .tempStoreFA=A=low byte of address
 14178  e817 c8                     INY                                                 ; Y=1
 14179  e818 b1f0                   LDA (.oswordX),Y                                    ; get byte from block
 14180  e81a 85fb                   STA .tempStoreFB                                    ; .tempStoreFB=high byte of address
 14181  e81c a004                   LDY #4                                              ; Y=4
 14182                          .exitWithX1
 14183  e81e a201                   LDX #1                                              ; X=1
 14184  e820 60                     RTS                                                 ;
 14185                          
 14186                          ; ***************************************************************************************
 14187                          ;
 14188                          ; OSBYTE 0 - Generate error message containing OS version information, or return OS version
 14189                          ;
 14190                          ; See fx0.png
 14191                          ; If X is zero on entry, this generates an error message containing the OS version.
 14192                          ; Control is passed to the current BRK handler which by convention will print the error
 14193                          ; message and return control back to the current language. The calling program will not
 14194                          ; continue.
 14195                          ;
 14196                          ; If X is non-zero on entry, the OS version number is returned in X.
 14197                          ;
 14198                          ; ***************************************************************************************
 14199                          .osbyte0EntryPoint
 14200  e821 d0fb                   BNE .exitWithX1                                     ; if (X is not zero) then branch (exit with X = 1 meaning OS 1.20)
 14201  e823 00                     BRK                                                 ; generate error message
 14202  e824 f7                     !byte $F7                                           ; error number
 14203  e825 4f5320312e323000       !text "OS 1.20",0                                   ; error string with zero terminator
 14204                          
 14205                          ; ***************************************************************************************
 14206                          ;
 14207                          ; OSWORD 7 - Make a sound
 14208                          ;
 14209                          ; On Entry:
 14210                          ;       .oswordX/Y is the address of eight bytes of parameters:
 14211                          ;           byte 0-1:  Channel ($HSFC as in the BASIC SOUND command)
 14212                          ;           byte 2-3:  Amplitude
 14213                          ;           byte 4-5:  Pitch
 14214                          ;           byte 6-7:  Duration
 14215                          ;
 14216                          ; Channel
 14217                          ; -------
 14218                          ; H = hold bit (0-1) ensures that the existing sound currently playing on the given channel
 14219                          ;     continues until the release phase of the envelope is totally finished before the next
 14220                          ;     sound plays. Otherwise the sound is considered complete at the start of the release
 14221                          ;     phase.
 14222                          ;     The other sound parameters are then ignored.
 14223                          ; S = sync bits (0-2) is the number of future notes to be queued on other channels that are
 14224                          ;     required before all the queued sounds start to play together at the same time.
 14225                          ; F = flush bit (0-1) stops any currently playing sound on the channel, forcing the new sound
 14226                          ;     to play instead.
 14227                          ; C = channel (0-3). Channel 0 is the noise channel.
 14228                          ;
 14229                          ; If the high byte of the channel is $FF, then this is interpreted as a Speech command.
 14230                          ;
 14231                          ; Amplitude
 14232                          ; ---------
 14233                          ; The amplitude (loudness) is specified by a value in the range -15 (loudest) to 0 (silent).
 14234                          ; This is not a linear scale, with larger differences in volume between the louder sounds.
 14235                          ; Alternatively an envelope number can be specified (0-15).
 14236                          ;
 14237                          ; Pitch
 14238                          ; -----
 14239                          ; Given a pitch number in the range 0-255, the range of playable musical notes is from
 14240                          ; B2 to D8 in scientific notation (C4 being middle C). This is a range of 63 notes, over five
 14241                          ; octaves. See https://en.wikipedia.org/wiki/Scientific_pitch_notation.
 14242                          ;
 14243                          ; [Personally, I think one octave lower would have been nice. We basically only have one
 14244                          ; octave below middle C and over four octaves above. The range of notes is a little too
 14245                          ; much on the high end]
 14246                          ;
 14247                          ; The notes on the musical scale can be best approximated by the values in the following
 14248                          ; table. This table is similar to one in the original User Guide, but with more accurate
 14249                          ; values. Be aware that the pitch you hear also depends on the channel you play it on.
 14250                          ; See .soundPitchOffsetByChannelTable. The table below gives the best pitch value to use to
 14251                          ; most accurately achieve the musical note, and for each channel
 14252                          ; (Channel 1 / Channel 2 / Channel 3) where they differ.
 14253                          ;
 14254                          ;                                  Octave
 14255                          ; Note    2     3      4      5               6               7               8
 14256                          ; ---------------------------------------------------------------------------------------
 14257                          ;  C      -     4      52     100             147/148/149     195/196/197     242/244/246
 14258                          ;  C#     -     8      56     104             152/152/153     200/201/202     246/249/251
 14259                          ;  D      -     12     60     108             155/156/157     203/204/206     249/251/254
 14260                          ;  D#     -     16     64     112             160/160/161     207/209/210     -
 14261                          ;  E      -     20     68     115/116/116     163/164/165     211/213/214     -
 14262                          ;  F      -     24     72     120             168/168/169     214/216/217     -
 14263                          ;  F#     -     28     76     124             172/172/173     219/221/222     -
 14264                          ;  G      -     32     80     128             175/176/177     222/224/226     -
 14265                          ;  G#     -     36     84     131/132/132     179/180/181     226/228/229     -
 14266                          ;  A      -     40     88     135/136/136     183/184/185     229/231/233     -
 14267                          ;  A#     -     44     92     139/140/140     187/188/189     233/235/237     -
 14268                          ;  B      0     48     96     144/144/145     192/193/194     237/240/242     -
 14269                          ;
 14270                          ; Pitch is ultimately passed to the sound chip as a 10 bit integer (0-1023), so by directly
 14271                          ; accessing the sound chip more accurate pitch can be achieved. This is done by sending data
 14272                          ; to the System VIA. See NAUG Section 21.2 Page 375 for a detailed description of the format
 14273                          ; required by the sound chip, and example code. Then see .setPitchNotNoise and
 14274                          ; see .sendToSoundChip for code to send the pitch.
 14275                          ;
 14276                          ; See .pitchLookupTableLow for the relationship between the 10-bit pitch and frequency.
 14277                          ;
 14278                          ; The best chip values for each musical note are as below:
 14279                          ;
 14280                          ;         10 bit
 14281                          ;         Chip
 14282                          ;         Value         Frequency           Note = Ideal Frequency       Error
 14283                          ;         ----------------------------------------------------------------------
 14284                          ;           27          4629.63 Hz           D8  = 4698.64 Hz           69.01 Hz
 14285                          ;           28          4464.29 Hz           C#8 = 4434.92 Hz           29.36 Hz
 14286                          ;           30          4166.67 Hz           C8  = 4186.01 Hz           19.34 Hz
 14287                          ;           32          3906.25 Hz           B7  = 3951.07 Hz           44.82 Hz
 14288                          ;           34          3676.47 Hz           A#7 = 3729.31 Hz           52.84 Hz
 14289                          ;           36          3472.22 Hz           A7  = 3520.00 Hz           47.78 Hz
 14290                          ;           38          3289.47 Hz           G#7 = 3322.44 Hz           32.96 Hz
 14291                          ;           40          3125.00 Hz           G7  = 3135.96 Hz           10.96 Hz
 14292                          ;           42          2976.19 Hz           F#7 = 2959.96 Hz           16.24 Hz
 14293                          ;           45          2777.78 Hz           F7  = 2793.83 Hz           16.05 Hz
 14294                          ;           47          2659.57 Hz           E7  = 2637.02 Hz           22.55 Hz
 14295                          ;           50          2500.00 Hz           D#7 = 2489.02 Hz           10.98 Hz
 14296                          ;           53          2358.49 Hz           D7  = 2349.32 Hz            9.17 Hz
 14297                          ;           56          2232.14 Hz           C#7 = 2217.46 Hz           14.68 Hz
 14298                          ;           60          2083.33 Hz           C7  = 2093.00 Hz            9.67 Hz
 14299                          ;           63          1984.13 Hz           B6  = 1975.53 Hz            8.59 Hz
 14300                          ;           67          1865.67 Hz           A#6 = 1864.66 Hz            1.02 Hz
 14301                          ;           71          1760.56 Hz           A6  = 1760.00 Hz            0.56 Hz
 14302                          ;           75          1666.67 Hz           G#6 = 1661.22 Hz            5.45 Hz
 14303                          ;           80          1562.50 Hz           G6  = 1567.98 Hz            5.48 Hz
 14304                          ;           84          1488.10 Hz           F#6 = 1479.98 Hz            8.12 Hz
 14305                          ;           89          1404.49 Hz           F6  = 1396.91 Hz            7.58 Hz
 14306                          ;           95          1315.79 Hz           E6  = 1318.51 Hz            2.72 Hz
 14307                          ;          100          1250.00 Hz           D#6 = 1244.51 Hz            5.49 Hz
 14308                          ;          106          1179.25 Hz           D6  = 1174.66 Hz            4.59 Hz
 14309                          ;          113          1106.19 Hz           C#6 = 1108.73 Hz            2.54 Hz
 14310                          ;          119          1050.42 Hz           C6  = 1046.50 Hz            3.92 Hz
 14311                          ;          127           984.25 Hz           B5  =  987.77 Hz            3.51 Hz
 14312                          ;          134           932.84 Hz           A#5 =  932.33 Hz            0.51 Hz
 14313                          ;          142           880.28 Hz           A5  =  880.00 Hz            0.28 Hz
 14314                          ;          150           833.33 Hz           G#5 =  830.61 Hz            2.72 Hz
 14315                          ;          159           786.16 Hz           G5  =  783.99 Hz            2.17 Hz
 14316                          ;          169           739.64 Hz           F#5 =  739.99 Hz            0.34 Hz
 14317                          ;          179           698.32 Hz           F5  =  698.46 Hz            0.13 Hz
 14318                          ;          190           657.89 Hz           E5  =  659.26 Hz            1.36 Hz
 14319                          ;          201           621.89 Hz           D#5 =  622.25 Hz            0.36 Hz
 14320                          ;          213           586.85 Hz           D5  =  587.33 Hz            0.48 Hz
 14321                          ;          225           555.56 Hz           C#5 =  554.37 Hz            1.19 Hz
 14322                          ;          239           523.01 Hz           C5  =  523.25 Hz            0.24 Hz
 14323                          ;          253           494.07 Hz           B4  =  493.88 Hz            0.19 Hz
 14324                          ;          268           466.42 Hz           A#4 =  466.16 Hz            0.25 Hz
 14325                          ;          284           440.14 Hz           A4  =  440.00 Hz            0.14 Hz
 14326                          ;          301           415.28 Hz           G#4 =  415.30 Hz            0.02 Hz
 14327                          ;          319           391.85 Hz           G4  =  392.00 Hz            0.15 Hz
 14328                          ;          338           369.82 Hz           F#4 =  369.99 Hz            0.17 Hz
 14329                          ;          358           349.16 Hz           F4  =  349.23 Hz            0.07 Hz
 14330                          ;          379           329.82 Hz           E4  =  329.63 Hz            0.19 Hz
 14331                          ;          402           310.95 Hz           D#4 =  311.13 Hz            0.18 Hz
 14332                          ;          426           293.43 Hz           D4  =  293.66 Hz            0.24 Hz
 14333                          ;          451           277.16 Hz           C#4 =  277.18 Hz            0.02 Hz
 14334                          ;          478           261.51 Hz           C4  =  261.63 Hz            0.12 Hz
 14335                          ;          506           247.04 Hz           B3  =  246.94 Hz            0.09 Hz
 14336                          ;          536           233.21 Hz           A#3 =  233.08 Hz            0.13 Hz
 14337                          ;          568           220.07 Hz           A3  =  220.00 Hz            0.07 Hz
 14338                          ;          602           207.64 Hz           G#3 =  207.65 Hz            0.01 Hz
 14339                          ;          638           195.92 Hz           G3  =  196.00 Hz            0.07 Hz
 14340                          ;          676           184.91 Hz           F#3 =  185.00 Hz            0.09 Hz
 14341                          ;          716           174.58 Hz           F3  =  174.61 Hz            0.03 Hz
 14342                          ;          758           164.91 Hz           E3  =  164.81 Hz            0.09 Hz
 14343                          ;          804           155.47 Hz           D#3 =  155.56 Hz            0.09 Hz
 14344                          ;          851           146.89 Hz           D3  =  146.83 Hz            0.05 Hz
 14345                          ;          902           138.58 Hz           C#3 =  138.59 Hz            0.01 Hz
 14346                          ;          956           130.75 Hz           C3  =  130.81 Hz            0.06 Hz
 14347                          ;         1012           123.52 Hz           B2  =  123.47 Hz            0.05 Hz
 14348                          ;
 14349                          ; ***************************************************************************************
 14350                          .osword7EntryPoint
 14351  e82d c8                     INY                                                 ; increment Y to read byte 1 of block
 14352  e82e b1f0                   LDA (.oswordX),Y                                    ; read channel high byte 'HS'
 14353  e830 c9ff                   CMP #$FF                                            ; check if it's $FF
 14354  e832 f059                   BEQ .osword7Speech                                  ; if (high byte of channel is $FF) then branch (handle speech command)
 14355  e834 c920                   CMP #$20                                            ; if (channel high byte is $20 or more) then set carry
 14356  e836 a208                   LDX #.romServiceCallUnrecognisedOSWORD              ; X = paged ROM service request 'unrecognised OSWORD call'
 14357  e838 b090                   BCS .pullTwiceAndOfferCallToROMs                    ; if (channel >= $2000) then branch (offer it to ROMs as unknown OSWORD)
 14358  e83a 88                     DEY                                                 ; point at start of block
 14359  e83b 20c9e8                 JSR .getChannelNumberAndFlush                       ; returns with carry set if flush is required, and A=channel number (0-3)
 14360  e83e 0904                   ORA #4                                              ; convert channel number to buffer number (4-7)
 14361  e840 aa                     TAX                                                 ; X = buffer number
 14362  e841 9005                   BCC +                                               ; if (carry clear) then branch
 14363  e843 20aee1                 JSR .flushSoundBufferX                              ; flush buffer
 14364  e846 a001                   LDY #1                                              ; Y=1
 14365                          +
 14366  e848 20c9e8                 JSR .getSyncNumberAndHold                           ; get sync number (0-3) (carry set if hold is required)
 14367  e84b 85fa                   STA .tempStoreFA                                    ; .tempStoreFA = sync number
 14368  e84d 08                     PHP                                                 ; save flags
 14369  e84e a006                   LDY #6                                              ; }
 14370  e850 b1f0                   LDA (.oswordX),Y                                    ; } get duration (low byte)
 14371  e852 48                     PHA                                                 ; push it
 14372  e853 a004                   LDY #4                                              ; }
 14373  e855 b1f0                   LDA (.oswordX),Y                                    ; } get pitch (low byte)
 14374  e857 48                     PHA                                                 ; push it
 14375  e858 a002                   LDY #2                                              ; }
 14376  e85a b1f0                   LDA (.oswordX),Y                                    ; } get amplitude (low byte) in the range -15 to 0 (static volume) or 1 to 4 (envelope controlled)
 14377                          
 14378                              ; At this point carry contains the 'hold' bit
 14379                              ; and .tempStoreFA contains the two 'sync' bits
 14380                          
 14381  e85c 2a                     ROL                                                 ; multiply amplitude by two, and add carry into bit zero = hold bit
 14382  e85d 38                     SEC                                                 ;
 14383  e85e e902                   SBC #2                                              ; subtract 2
 14384  e860 0a                     ASL                                                 ; }
 14385  e861 0a                     ASL                                                 ; } multiply by 4
 14386  e862 05fa                   ORA .tempStoreFA                                    ; add sync value (0-3)
 14387                          
 14388                              ;
 14389                              ; To illustrate the changes made by the last six instructions, here is a table showing
 14390                              ; the changes at each step. Each row is a different value for the amplitude (values > 0
 14391                              ; are the envelope number 1-4), and the columns show the result after each subsequent
 14392                              ; instruction.
 14393                              ;
 14394                              ; Amplitude   Binary       ROL           SEC;SBC#2    ASL; ASL     ORA .tempStoreFA
 14395                              ;                          h=hold bit                              ss=sync bits
 14396                              ; ---------------------------------------------------------------------------------
 14397                              ;     4       %00000100    %0000100h     %0000011h    %00011h00    %00011hss
 14398                              ;     3       %00000011    %0000011h     %0000010h    %00010h00    %00010hss
 14399                              ;     2       %00000010    %0000010h     %0000001h    %00001h00    %00001hss
 14400                              ;     1       %00000001    %0000001h     %0000000h    %00000h00    %00000hss
 14401                              ;     0       %00000000    %0000000h     %1111111h    %11111h00    %11111hss
 14402                              ;    -1       %11111111    %1111111h     %1111110h    %11110h00    %11110hss
 14403                              ;    -2       %11111110    %1111110h     %1111101h    %11101h00    %11101hss
 14404                              ;    -3       %11111101    %1111101h     %1111100h    %11100h00    %11100hss
 14405                              ;    -4       %11111100    %1111100h     %1111011h    %11011h00    %11011hss
 14406                              ;    -5       %11111011    %1111011h     %1111010h    %11010h00    %11010hss
 14407                              ;    -6       %11111010    %1111010h     %1111001h    %11001h00    %11001hss
 14408                              ;    -7       %11111001    %1111001h     %1111000h    %11000h00    %11000hss
 14409                              ;    -8       %11111000    %1111000h     %1110111h    %10111h00    %10111hss
 14410                              ;    -9       %11110111    %1110111h     %1110110h    %10110h00    %10110hss
 14411                              ;   -10       %11110110    %1110110h     %1110101h    %10101h00    %10101hss
 14412                              ;   -11       %11110101    %1110101h     %1110100h    %10100h00    %10100hss
 14413                              ;   -12       %11110100    %1110100h     %1110011h    %10011h00    %10011hss
 14414                              ;   -13       %11110011    %1110011h     %1110010h    %10010h00    %10010hss
 14415                              ;   -14       %11110010    %1110010h     %1110001h    %10001h00    %10001hss
 14416                              ;   -15       %11110001    %1110001h     %1110000h    %10000h00    %10000hss
 14417                              ;
 14418                              ; At this point:
 14419                              ;
 14420                              ; bit 7     = 0 for an envelope number
 14421                              ; bits 3-6  = envelope number - 1 (0-3), or volume in range (15 to 0)
 14422                              ; bit 2     = h, the hold bit
 14423                              ; bits 0-1  = ss, the sync bits (0-3)
 14424                              ;
 14425                          
 14426  e864 20f8e1                 JSR .addByteToBuffer                                ; transfer byte to the sound buffer
 14427  e867 901e                   BCC .markAsUsedAndSendToBuffer                      ; if (byte successfully added to buffer) then branch (send to buffer)
 14428                          .finishUpSound
 14429  e869 68                     PLA                                                 ; }
 14430  e86a 68                     PLA                                                 ; } failed to add to buffer, so pull the values off and fall through to exit via OSBYTE 117
 14431  e86b 28                     PLP                                                 ; }
 14432                              ; fall through...
 14433                          
 14434                          ; ***************************************************************************************
 14435                          ;
 14436                          ; OSBYTE 117 - Read VDU status
 14437                          ;
 14438                          ; ***************************************************************************************
 14439                          .osbyte117EntryPoint
 14440  e86c a6d0                   LDX .vduStatusByte                                  ; get VDU status byte in X
 14441  e86e 60                     RTS                                                 ;
 14442                          
 14443                          ; ***************************************************************************************
 14444                          ;
 14445                          ; VDU 7 (.charBELL)
 14446                          ;
 14447                          ; See beep.mp3
 14448                          ; Generates a short tone.
 14449                          ;
 14450                          ; By default this plays a Treble C as a square wave for 0.3 seconds on channel 3. The
 14451                          ; frequency is as close as the sound chip can get to Treble C. It produces a 523.013Hz tone
 14452                          ; compared to the theoretical ideal 523.251Hz, and so is very close to the ideal pitch.
 14453                          ;
 14454                          ; The 523.013Hz figure for the frequency achieved takes into account that the OS changes the
 14455                          ; pitch slightly depending on the channel number (see .soundPitchOffsetByChannelTable). If
 14456                          ; it were played on channel 1 or 2, the frequency would not be as close to Treble C.
 14457                          ;
 14458                          ; ***************************************************************************************
 14459                          .vdu7EntryPoint
 14460  e86f 08                     PHP                                                 ; push flags
 14461  e870 78                     SEI                                                 ; disable interrupts
 14462  e871 ad6302                 LDA .soundBELLChannel                               ; get bell channel number in A
 14463  e874 2907                   AND #%00000111                                      ; clear all except bits 0-2
 14464  e876 0904                   ORA #%00000100                                      ; set bit 2 (=channel number + 4)
 14465  e878 aa                     TAX                                                 ; X=A=channel number+4=buffer number
 14466  e879 ad6402                 LDA .soundBELLAmplitudeEnvelope                     ; get bell amplitude/envelope number
 14467  e87c 20b0e4                 JSR .insJumper                                      ; store it in buffer X
 14468  e87f ad6602                 LDA .soundBELLDuration                              ; get bell duration
 14469  e882 48                     PHA                                                 ; save it
 14470  e883 ad6502                 LDA .soundBELLPitch                                 ; get bell pitch
 14471  e886 48                     PHA                                                 ; save it
 14472                          .markAsUsedAndSendToBuffer
 14473  e887 38                     SEC                                                 ; set carry
 14474  e888 7e0008                 ROR .channel0Occupancy - .bufferNumberSound0,X      ; and pass into bit 7 to indicate that channel is active
 14475  e88b 3017                   BMI .addPitchAndDurationToSoundBuffer               ; ALWAYS branch
 14476                          
 14477                          ; ***************************************************************************************
 14478                          .osword7Speech
 14479  e88d 08                     PHP                                                 ; push flags
 14480  e88e c8                     INY                                                 ; Y=2
 14481  e88f b1f0                   LDA (.oswordX),Y                                    ; get byte at offset 2
 14482  e891 48                     PHA                                                 ; store it
 14483  e892 c8                     INY                                                 ; Y=3
 14484  e893 b1f0                   LDA (.oswordX),Y                                    ; get byte at offset 3
 14485  e895 48                     PHA                                                 ; store it
 14486                          
 14487                              ; The stack now holds the two bytes of the SOUND command that normally specify amplitude
 14488                              ; These are the last two of three bytes we are going to add to the buffer. The first
 14489                              ; byte we add to the buffer is byte 0 from the sound command
 14490                          
 14491  e896 a000                   LDY #0                                              ; Y=0
 14492  e898 b1f0                   LDA (.oswordX),Y                                    ; get byte
 14493  e89a a208                   LDX #.bufferNumberSpeech                            ; X=8
 14494  e89c 20f8e1                 JSR .addByteToBuffer                                ; select speech buffer and pass A
 14495  e89f b0c8                   BCS .finishUpSound                                  ; if (carry set, i.e. failed to add to buffer) then branch (restore stack and exit)
 14496  e8a1 6ed702                 ROR .speechBufferEmptyFlag                          ; clear bit 7 of buffer empty flag to show buffer is not empty
 14497                              ; fall through...
 14498                          
 14499                          ; ***************************************************************************************
 14500                          .addPitchAndDurationToSoundBuffer
 14501  e8a4 68                     PLA                                                 ; pull pitch
 14502  e8a5 20b0e4                 JSR .insJumper                                      ; enter it in buffer X
 14503  e8a8 68                     PLA                                                 ; pull duration
 14504  e8a9 20b0e4                 JSR .insJumper                                      ; enter it in buffer X
 14505  e8ac 28                     PLP                                                 ; pull flags
 14506  e8ad 60                     RTS                                                 ;
 14507                          
 14508                          ; ***************************************************************************************
 14509                          ;
 14510                          ; OSWORD 8 - Define an envelope
 14511                          ;
 14512                          ; On Entry:
 14513                          ;       A = envelope number
 14514                          ;       Y = 0
 14515                          ;
 14516                          ;   .oswordX/Y is the address of 14 bytes of parameters:
 14517                          ;       byte 0:   envelope number (also in A)
 14518                          ;       byte 1:   bits 0-6 length of each step in centi-seconds
 14519                          ;                 bit 7 clear means auto repeat
 14520                          ;       byte 2:   change of Pitch per step in section 1 (-128 to +127)
 14521                          ;       byte 3:   change of Pitch per step in section 2 (-128 to +127)
 14522                          ;       byte 4:   change of Pitch per step in section 3 (-128 to +127)
 14523                          ;       byte 5:   number of steps in section 1 (0 to 255)
 14524                          ;       byte 6:   number of steps in section 2 (0 to 255)
 14525                          ;       byte 7:   number of steps in section 3 (0 to 255)
 14526                          ;       byte 8:   change of amplitude per step during attack  phase (-127 to +127)
 14527                          ;       byte 9:   change of amplitude per step during decay   phase (-127 to +127)
 14528                          ;       byte 10:  change of amplitude per step during sustain phase (-127 to +127)
 14529                          ;       byte 11:  change of amplitude per step during release phase (-127 to +127)
 14530                          ;       byte 12:  target level at end of attack phase (0 to 126)
 14531                          ;       byte 13:  target level at end of decay  phase (0 to 126)
 14532                          ;
 14533                          ; ***************************************************************************************
 14534                          .osword8EntryPoint
 14535  e8ae e901                   SBC #1                                              ; }
 14536  e8b0 0a                     ASL                                                 ; }
 14537  e8b1 0a                     ASL                                                 ; } set up appropriate displacement to storage area
 14538  e8b2 0a                     ASL                                                 ; } A=(A-1)*16 OR 15
 14539  e8b3 0a                     ASL                                                 ; }
 14540  e8b4 090f                   ORA #%00001111                                      ; }
 14541  e8b6 aa                     TAX                                                 ; X=A (destination offset)
 14542  e8b7 a900                   LDA #0                                              ; A=0 (value to write)
 14543  e8b9 a010                   LDY #16                                             ; Y = loop counter
 14544                          .copyEnvelopeLoop
 14545  e8bb c00e                   CPY #14                                             ;
 14546  e8bd b002                   BCS +                                               ; if (Y >= 14) then branch (don't read from block, just store zero in envelope buffer)
 14547  e8bf b1f0                   LDA (.oswordX),Y                                    ; get byte from parameter block
 14548                          +
 14549  e8c1 9dc008                 STA .envelopeBuffer,X                               ; and store it in appropriate area
 14550  e8c4 ca                     DEX                                                 ; decrement X
 14551  e8c5 88                     DEY                                                 ; decrement Y
 14552  e8c6 d0f3                   BNE .copyEnvelopeLoop                               ; if (not zero) then branch (loop back and do it again)
 14553  e8c8 60                     RTS                                                 ;
 14554                              ; Note that envelope number is NOT transferred. The envelope number is not needed in
 14555                              ; the buffer since the address in the buffer determines the envelope number.
 14556                          
 14557                          
 14558                          ; ***************************************************************************************
 14559                          ; On Exit:
 14560                          ;   When Y = 0:
 14561                          ;       A = channel number (0-3)
 14562                          ;       C set if channel low byte > 15, i.e. if flush is required
 14563                          ;
 14564                          ;   When Y = 1:
 14565                          ;       A = Sync number (0-3)
 14566                          ;       C set if channel low byte > 15, i.e. if hold is required
 14567                          ;
 14568                          .getChannelNumberAndFlush
 14569                          .getSyncNumberAndHold
 14570  e8c9 b1f0                   LDA (.oswordX),Y                                    ; get byte (channel parameter low byte or sync parameter low byte)
 14571  e8cb c910                   CMP #$10                                            ; is it greater than 15, if so set carry
 14572  e8cd 2903                   AND #3                                              ; get hardware channel number
 14573  e8cf c8                     INY                                                 ; increment Y to point to byte 1 of the parameters
 14574  e8d0 60                     RTS                                                 ;
 14575                          
 14576                          
 14577                          ; ***************************************************************************************
 14578                          ;
 14579                          ; OSWORD 3 - Read interval timer
 14580                          ;
 14581                          ; The interval timer is centi-seconds and 5 bytes long.
 14582                          ;
 14583                          ; On Entry:
 14584                          ;       .oswordX/Y is the address for the five byte result
 14585                          ;
 14586                          ; ***************************************************************************************
 14587                          .osword3EntryPoint
 14588  e8d1 a20f                   LDX #.countdownIntervalTimer - (.timeClockA - 5)    ; X is the offset from (clockA-5) to countdown timer
 14589  e8d3 d003                   BNE .readFiveBytesIntoBlock                         ; ALWAYS branch
 14590                          
 14591                          ; ***************************************************************************************
 14592                          ;
 14593                          ; OSWORD 1 - Read system clock
 14594                          ;
 14595                          ; The system clock counts in centi-seconds since boot and is 5 bytes long.
 14596                          ;
 14597                          ; On Entry:
 14598                          ;       .oswordX/Y is the address for the five byte result
 14599                          ;
 14600                          ; ***************************************************************************************
 14601                          .osword1EntryPoint
 14602  e8d5 ae8302                 LDX .timeClockSwitch                                ; X=current system clock store pointer
 14603                          .readFiveBytesIntoBlock
 14604  e8d8 a004                   LDY #4                                              ; Y = loop counter
 14605                          -
 14606  e8da bd8d02                 LDA .timeClockA - 5,X                               ; read byte
 14607  e8dd 91f0                   STA (.oswordX),Y                                    ; store it in parameter block
 14608  e8df e8                     INX                                                 ; X = X + 1
 14609  e8e0 88                     DEY                                                 ; Y = Y - 1
 14610  e8e1 10f7                   BPL -                                               ; if (Y >= 0) then branch (loop back and do it again)
 14611                          .exit22
 14612  e8e3 60                     RTS                                                 ;
 14613                          
 14614                          ; ***************************************************************************************
 14615                          ;
 14616                          ; OSWORD 4 - Write interval timer
 14617                          ;
 14618                          ; On Entry:
 14619                          ;       .oswordX/Y is the address of the five byte value to set
 14620                          ;
 14621                          ; ***************************************************************************************
 14622                          .osword4EntryPoint
 14623  e8e4 a90f                   LDA #.countdownIntervalTimer - (.timeClockA - 5)    ; A=15 is the offset from clockA to countdown timer
 14624  e8e6 d006                   BNE .writeFiveBytesFromBlock                        ; ALWAYS branch
 14625                          
 14626                          ; ***************************************************************************************
 14627                          ;
 14628                          ; OSWORD 2 - Write system clock
 14629                          ;
 14630                          ; On Entry:
 14631                          ;       .oswordX/Y is the address of the five byte value to set
 14632                          ;
 14633                          ; ***************************************************************************************
 14634                          .osword2EntryPoint
 14635  e8e8 ad8302                 LDA .timeClockSwitch                                ; get current clock store pointer
 14636  e8eb 490f                   EOR #15                                             ; and invert to get inactive clock (toggle between 5 and 10)
 14637  e8ed 18                     CLC                                                 ; clear carry (indicates write system clock)
 14638                              ; fall through...
 14639                          
 14640                          ; ***************************************************************************************
 14641                          ;
 14642                          ; Write system clock or interval timer
 14643                          ;
 14644                          ; On Entry:
 14645                          ;       carry clear indicates write system clock
 14646                          ;       carry set indicates write interval timer
 14647                          ;
 14648                          ; ***************************************************************************************
 14649                          .writeFiveBytesFromBlock
 14650  e8ee 48                     PHA                                                 ; store A
 14651  e8ef aa                     TAX                                                 ; X=A
 14652  e8f0 a004                   LDY #4                                              ; Y=loop counter
 14653                          .writeClockLoop
 14654  e8f2 b1f0                   LDA (.oswordX),Y                                    ; transfer 5 bytes from out parameter block
 14655  e8f4 9d8d02                 STA .timeClockA - 5,X                               ; to the clock or timer
 14656  e8f7 e8                     INX                                                 ;
 14657  e8f8 88                     DEY                                                 ;
 14658  e8f9 10f7                   BPL .writeClockLoop                                 ; if (Y >= 0) then branch (loop)
 14659  e8fb 68                     PLA                                                 ; restore A
 14660  e8fc b0e5                   BCS .exit22                                         ; if (carry set, i.e. write to interval timer requested) then branch (exit)
 14661  e8fe 8d8302                 STA .timeClockSwitch                                ; write back current clock (5 or 10) into switch variable
 14662  e901 60                     RTS                                                 ;
 14663                          
 14664                          ; ***************************************************************************************
 14665                          ;
 14666                          ; OSWORD 0 - Read line from current input into memory
 14667                          ;
 14668                          ; On Entry:
 14669                          ;       .oswordX/.oswordY - address of parameter block:
 14670                          ;           byte 0: address of input buffer for result (low)
 14671                          ;           byte 1: address of input buffer for result (high)
 14672                          ;           byte 2: maximum line length
 14673                          ;           byte 3: minimum acceptable ASCII code
 14674                          ;           byte 4: maximum acceptable ASCII code
 14675                          ;
 14676                          ; ***************************************************************************************
 14677                          .osword0EntryPoint
 14678  e902 a004                   LDY #4                                              ; Y=4
 14679                          -
 14680  e904 b1f0                   LDA (.oswordX),Y                                    ; copy bytes 2,3,4 to absolute addresses .osword0MaxLineLength,+1,+2
 14681  e906 99b102                 STA .osword0MaxLineLength-2,Y                       ;
 14682  e909 88                     DEY                                                 ; decrement Y
 14683  e90a c002                   CPY #2                                              ; until Y=1
 14684  e90c b0f6                   BCS -                                               ;
 14685                          
 14686  e90e b1f0                   LDA (.oswordX),Y                                    ; get address of input buffer (high byte)
 14687  e910 85e9                   STA .osword0BufferAddressHigh                       ; store it in temporary buffer
 14688  e912 88                     DEY                                                 ; decrement Y
 14689  e913 8c6902                 STY .pagedModeCounter                               ; Y=0 store in print line counter for paged mode
 14690  e916 b1f0                   LDA (.oswordX),Y                                    ; get address of input buffer (low byte)
 14691  e918 85e8                   STA .osword0BufferAddressLow                        ; and store in temporary buffer
 14692  e91a 58                     CLI                                                 ; allow interrupts
 14693  e91b 9007                   BCC .readInputCharacter                             ; ALWAYS branch
 14694                          
 14695                          ; ***************************************************************************************
 14696                          .readLineInputBufferFull
 14697  e91d a907                   LDA #.charBELL                                      ; A=7
 14698                          .retryReadWithoutIncrementingPosition
 14699  e91f 88                     DEY                                                 ; decrement Y
 14700                          .retryReadIncrementingPosition
 14701  e920 c8                     INY                                                 ; increment Y
 14702                          .outputCharacterAndReadAgain
 14703  e921 20eeff                 JSR .OSWRCH                                         ; and call OSWRCH
 14704                              ; fall through...
 14705                          
 14706                          ; ***************************************************************************************
 14707                          .readInputCharacter
 14708  e924 20e0ff                 JSR .OSRDCH                                         ; read character from input stream
 14709  e927 b049                   BCS .exitWithNegativeAndCarryFlagsSet               ; if (error occurred) then branch (exit)
 14710  e929 aa                     TAX                                                 ; X=A
 14711  e92a ad7c02                 LDA .characterDestinationsAvailableFlags            ; get character destination status
 14712  e92d 6a                     ROR                                                 ; rotate the status twice to make
 14713  e92e 6a                     ROR                                                 ; carry reflect the 'disable VDU driver' bit
 14714  e92f 8a                     TXA                                                 ; restore character read
 14715  e930 b005                   BCS +                                               ; if (vdu disabled) then branch (skip forward)
 14716  e932 ae6a02                 LDX .twosComplimentOfNumberOfBytesInVDUQueue        ; get number of items in VDU queue
 14717  e935 d0ea                   BNE .outputCharacterAndReadAgain                    ; if (not zero) then branch (output character and read again)
 14718                          +
 14719  e937 c97f                   CMP #.charDELETE                                    ;
 14720  e939 d007                   BNE +                                               ; if (character is not DELETE) then branch forward
 14721  e93b c000                   CPY #0                                              ;
 14722  e93d f0e5                   BEQ .readInputCharacter                             ; if (Y is zero, i.e. first character) then branch (read next character)
 14723  e93f 88                     DEY                                                 ; decrement Y (position in buffer decrements)
 14724  e940 b0df                   BCS .outputCharacterAndReadAgain                    ; ALWAYS branch back to otput the DELETE and read again
 14725                          +
 14726  e942 c915                   CMP #.charDisableVDUOrDeleteLine                    ; is it delete line (CTRL-U)
 14727  e944 d00d                   BNE +                                               ; if (not CTRL-U) then branch forward
 14728  e946 98                     TYA                                                 ; Y=A
 14729  e947 f0db                   BEQ .readInputCharacter                             ; if (we are still reading first character) then branch back the read character
 14730  e949 a97f                   LDA #.charDELETE                                    ;
 14731                          -
 14732  e94b 20eeff                 JSR .OSWRCH                                         ; }
 14733  e94e 88                     DEY                                                 ; } output DELETE until Y=0
 14734  e94f d0fa                   BNE -                                               ; }
 14735  e951 f0d1                   BEQ .readInputCharacter                             ; ALWAYS branch (read character again)
 14736                          +
 14737  e953 91e8                   STA (.osword0BufferAddressLow),Y                    ; store character in designated buffer
 14738  e955 c90d                   CMP #.charRETURN                                    ;
 14739  e957 f013                   BEQ .outputNewlineAndExit                           ; if (carriage return entered) then branch
 14740  e959 ccb302                 CPY .osword0MaxLineLength                           ; check the line length
 14741  e95c b0bf                   BCS .readLineInputBufferFull                        ; if (buffer full) then branch (loop to ring bell)
 14742  e95e cdb402                 CMP .osword0MinASCIICharacter                       ; check minimum character
 14743  e961 90bc                   BCC .retryReadWithoutIncrementingPosition           ; if (less than minimum character) then branch (read at existing position)
 14744  e963 cdb502                 CMP .osword0MaxASCIICharacter                       ; check maximum character
 14745  e966 f0b8                   BEQ .retryReadIncrementingPosition                  ; if (equal to maximum character) then accept the character and move on
 14746  e968 90b6                   BCC .retryReadIncrementingPosition                  ; if (less than maximum character) then accept the character and move on
 14747  e96a b0b3                   BCS .retryReadWithoutIncrementingPosition           ; ALWAYS branch (reject character and continue)
 14748                          
 14749                          .outputNewlineAndExit
 14750  e96c 20e7ff                 JSR .OSNEWL                                         ; output CR/LF
 14751  e96f 207ee5                 JSR .netvJumper                                     ; call Econet vector
 14752                          .exitWithNegativeAndCarryFlagsSet
 14753  e972 a5ff                   LDA .escapeFlag                                     ; A=ESCAPE FLAG
 14754  e974 2a                     ROL                                                 ; put bit 7 into carry
 14755  e975 60                     RTS                                                 ;
 14756                          
 14757                          
 14758                          ; ***************************************************************************************
 14759                          ;
 14760                          ; OSBYTE 5 - Select printer type
 14761                          ;
 14762                          ; On Entry:
 14763                          ;       X=0       ignore printer output
 14764                          ;       X=1       parallel output
 14765                          ;       X=2       RS-423 output (will act as sink if RS-423 is enabled using OSBYTE with A=3)
 14766                          ;       X=3       user printer
 14767                          ;       X=4       Econet printer
 14768                          ;       X=5-255   user printer
 14769                          ;
 14770                          ; ***************************************************************************************
 14771                          .osbyte5EntryPoint
 14772  e976 58                     CLI                                                 ; allow interrupts briefly
 14773  e977 78                     SEI                                                 ; disable interrupts
 14774  e978 24ff                   BIT .escapeFlag                                     ; check if ESCAPE is pending
 14775  e97a 3030                   BMI .exit23                                         ; if (ESCAPE is pending) then branch (exit)
 14776  e97c 2cd202                 BIT .printerBufferEmptyFlag                         ; check bit 7 for printer buffer empty
 14777  e97f 10f5                   BPL .osbyte5EntryPoint                              ; if (bit 7=0, not empty) then branch back and try again (wait until buffer is empty)
 14778  e981 20a4e1                 JSR .selectPrinterType                              ; check for user defined routine
 14779  e984 a000                   LDY #0                                              ; Y=0
 14780  e986 84f1                   STY .osbyteY                                        ; F1=0
 14781                              ; fall through...
 14782                          
 14783                          ; ***************************************************************************************
 14784                          ;
 14785                          ; OSBYTE 1 - Read/Write user flag; OSBYTE 6 - Set printer ignore character
 14786                          ;
 14787                          ; On Entry:
 14788                          ;       OSBYTE 1:
 14789                          ;           To read the user flag:  Y=$00
 14790                          ;           To write the user flag: X=value to write, Y=$FF
 14791                          ;       OSBYTE 6:
 14792                          ;           X = value to write
 14793                          ; On Exit:
 14794                          ;       X contains the previous value
 14795                          ;
 14796                          ; ***************************************************************************************
 14797                          .osbyte1EntryPoint
 14798                          .osbyte6EntryPoint
 14799  e988 09f0                   ORA #$0280 - .mosVariablesMinus166                  ; A set to read/write locations:
 14800                          
 14801                              ; At this point, A depends on the entry point. A is set up to affect a particular
 14802                              ; system variable:
 14803                              ;
 14804                              ; Entry via OSBYTE 1: $0281 (user flag)                - .mosVariablesMinus166
 14805                              ; Entry via OSBYTE 5: $0285 (printer destination)      - .mosVariablesMinus166
 14806                              ; Entry via OSBYTE 6: $0286 (printer ignore character) - .mosVariablesMinus166
 14807                              ;
 14808  e98a d00e                   BNE .readWriteSystemVariable                        ; ALWAYS branch
 14809                          
 14810                          
 14811                          ; ***************************************************************************************
 14812                          ;
 14813                          ; OSBYTE 12 - Set keyboard autorepeat rate
 14814                          ;
 14815                          ; ***************************************************************************************
 14816                          .osbyte12EntryPoint
 14817  e98c d007                   BNE .osbyte11EntryPoint                             ; if (.osbyteX != 0; i.e. not resetting to defaults) then branch
 14818  e98e a232                   LDX #50                                             ; reset default delay and rate
 14819  e990 8e5402                 STX .keyboardAutoRepeatDelay                        ; set keyboard autorepeat delay
 14820  e993 a208                   LDX #8                                              ; set X=8 for default autorepeat rate
 14821                              ; fall through...
 14822                          
 14823                          ; ***************************************************************************************
 14824                          ;
 14825                          ; OSBYTE 11 - Set keyboard autorepeat delay
 14826                          ;
 14827                          ; ***************************************************************************************
 14828                          .osbyte11EntryPoint
 14829  e995 69cf                   ADC #$CF                                            ; A=A+208 (carry set)
 14830                                                                                  ; So...
 14831                                                                                  ; A=219 if entered from OSBYTE 11
 14832                                                                                  ; A=220 if entered from OSBYTE 12
 14833                              ; fall through...
 14834                          
 14835                          ; ***************************************************************************************
 14836                          ;
 14837                          ; OSBYTE 3 - Select output stream; OSBYTE 4 - Enable/disable cursor editing
 14838                          ;
 14839                          ; ***************************************************************************************
 14840                          .osbyte3EntryPoint
 14841                          .osbyte4EntryPoint
 14842  e997 18                     CLC                                                 ; clear carry
 14843  e998 69e9                   ADC #$E9                                            ; A = A + 233
 14844                                                                                  ; So...
 14845                                                                                  ; A=236 if entered from OSBYTE 3
 14846                                                                                  ; A=237 if entered from OSBYTE 4
 14847                                                                                  ; A=196 if entered from OSBYTE 11
 14848                                                                                  ; A=197 if entered from OSBYTE 12
 14849                          .readWriteSystemVariable
 14850  e99a 86f0                   STX .osbyteX                                        ; store X
 14851                              ; fall through...
 14852                          
 14853                          ; ***************************************************************************************
 14854                          ;
 14855                          ; OSBYTE 166 to 255 - read/write system variable
 14856                          ;
 14857                          ; Set newValue = (oldValue AND .osbyteY) EOR .osbyteX
 14858                          ;
 14859                          ; On Entry:
 14860                          ;       A = offset from .mosVariablesMinus166 of variable to read/write
 14861                          ;       .osbyteX = X parameter from entry to OSBYTE
 14862                          ;       .osbyteY = Y parameter from entry to OSBYTE
 14863                          ; On Exit:
 14864                          ;       X = oldValue
 14865                          ;       Y = value of next system variable
 14866                          ;
 14867                          ; ***************************************************************************************
 14868                          .osbyte166to255EntryPoint
 14869  e99c a8                     TAY                                                 ; Y=A
 14870  e99d b99001                 LDA .mosVariablesMinus166,Y                         ; read current value
 14871  e9a0 aa                     TAX                                                 ; preserve this in X
 14872  e9a1 25f1                   AND .osbyteY                                        ; }
 14873  e9a3 45f0                   EOR .osbyteX                                        ; } new value = (old value AND Y) EOR X
 14874  e9a5 999001                 STA .mosVariablesMinus166,Y                         ; store it
 14875  e9a8 b99101                 LDA .mosVariablesMinus166+1,Y                       ; get value of next byte into A
 14876  e9ab a8                     TAY                                                 ; Y=A
 14877                          .exit23
 14878  e9ac 60                     RTS                                                 ;
 14879                          
 14880                          
 14881                          ; ***************************************************************************************
 14882                          ;
 14883                          ; Table of buffer types and serial baud rates
 14884                          ;
 14885                          ; This table has dual use. It is used to set the serial baud rate (using bits 0-5), and
 14886                          ; also to identify a buffer as being a sound buffer (bit 7):
 14887                          ;
 14888                          ;   - bit 7 is set if buffer X is a sound buffer
 14889                          ;   - bit 6 is not used (always set)
 14890                          ;   - bits 3,4,5 indicate the serial receive baud rate
 14891                          ;   - bits 0,1,2 indicate the serial transmit baud rate
 14892                          ;
 14893                          ;       111 =    75 baud
 14894                          ;       011 =   150 baud
 14895                          ;       101 =   300 baud
 14896                          ;       001 =  1200 baud
 14897                          ;       110 =  2400 baud
 14898                          ;       010 =  4800 baud
 14899                          ;       100 =  9600 baud
 14900                          ;       000 = 19200 baud
 14901                          ;
 14902                          ; ***************************************************************************************
 14903                          .bufferTypeAndSerialBaudRatesTable
 14904  e9ad 64                     !byte %01100100                                     ; Keyboard           9600 baud (default)
 14905  e9ae 7f                     !byte %01111111                                     ; RS-423 Input         75 baud
 14906  e9af 5b                     !byte %01011011                                     ; RS-423 output       150 baud
 14907  e9b0 6d                     !byte %01101101                                     ; serial printer      300 baud
 14908  e9b1 c9                     !byte %11001001                                     ; sound0             1200 baud
 14909  e9b2 f6                     !byte %11110110                                     ; sound1             2400 baud
 14910  e9b3 d2                     !byte %11010010                                     ; sound2             4800 baud
 14911  e9b4 e4                     !byte %11100100                                     ; sound3             9600 baud
 14912  e9b5 40                     !byte %01000000                                     ; speech            19200 baud
 14913                          
 14914                          
 14915                          ; ****************************************************************************************
 14916                          ;
 14917                          ; OSBYTE 19 - Wait for vertical sync
 14918                          ;
 14919                          ; ****************************************************************************************
 14920                          .osbyte19EntryPoint
 14921  e9b6 ad4002                 LDA .verticalSyncCounter                            ; Read vertical sync counter
 14922                          -
 14923  e9b9 58                     CLI                                                 ; allow interrupts briefly
 14924  e9ba 78                     SEI                                                 ; disable interrupts again
 14925  e9bb cd4002                 CMP .verticalSyncCounter                            ; has the vertical sync counter changed yet?
 14926  e9be f0f9                   BEQ -                                               ; if (the values are the same) then branch (loop back)
 14927                              ; fall through...
 14928                          
 14929                          ; ****************************************************************************************
 14930                          ;
 14931                          ; OSBYTE 160 - Read VDU Variable
 14932                          ;
 14933                          ; ****************************************************************************************
 14934                          .osbyte160EntryPoint
 14935  e9c0 bc0103                 LDY .vduVariablesStart + 1,X                        ; get VDU variable (often the high byte)
 14936  e9c3 bd0003                 LDA .vduVariablesStart,X                            ; get VDU variable (often the low byte)
 14937  e9c6 aa                     TAX                                                 ;
 14938  e9c7 60                     RTS                                                 ;
 14939                          
 14940                          ; ****************************************************************************************
 14941                          ;
 14942                          ; OSBYTE 18 - Reset soft keys
 14943                          ;
 14944                          ; ****************************************************************************************
 14945                          .osbyte18EntryPoint
 14946  e9c8 a910                   LDA #$10                                            ; set consistency flag
 14947  e9ca 8d8402                 STA .softKeyConsistencyFlag                         ;
 14948  e9cd a200                   LDX #0                                              ; X=0
 14949                          -
 14950  e9cf 9d000b                 STA .softKeyPage,X                                  ; and wipe clean
 14951  e9d2 e8                     INX                                                 ; soft key buffer
 14952  e9d3 d0fa                   BNE -                                               ; until X=0 again
 14953  e9d5 8e8402                 STX .softKeyConsistencyFlag                         ; zero consistency flag
 14954  e9d8 60                     RTS                                                 ;
 14955                          
 14956                          ; ***************************************************************************************
 14957                          ;
 14958                          ; OSBYTE 118 - Set keyboard LEDs based on keyboard status
 14959                          ;
 14960                          ; On Exit:
 14961                          ;       carry is set if CTRL pressed
 14962                          ;       N is set if SHIFT is pressed
 14963                          ;
 14964                          ; ***************************************************************************************
 14965                          .osbyte118EntryPoint
 14966  e9d9 08                     PHP                                                 ; remember flags
 14967  e9da 78                     SEI                                                 ; disable interrupts
 14968  e9db a940                   LDA #$40                                            ; switch on CAPS and SHIFT LOCK lights
 14969  e9dd 20eae9                 JSR .turnOnKeyboardLightsAndTestEscape              ; via subroutine
 14970  e9e0 3005                   BMI .popRollAndExit                                 ; if (negative, i.e. ESCAPE condition exists) then branch
 14971  e9e2 18                     CLC                                                 ; clear V and C
 14972  e9e3 b8                     CLV                                                 ; calling main keyboard routine to
 14973  e9e4 2068f0                 JSR .keyJumper                                      ; switch on lights as required
 14974                          .popRollAndExit
 14975  e9e7 28                     PLP                                                 ; recall flags
 14976  e9e8 2a                     ROL                                                 ; and rotate carry into bit 0
 14977  e9e9 60                     RTS                                                 ;
 14978                          
 14979                          ; ***************************************************************************************
 14980                          .turnOnKeyboardLightsAndTestEscape
 14981  e9ea 9009                   BCC .skipKeyboardLights                             ; if (carry clear) then branch
 14982  e9ec a007                   LDY #7                                              ; switch on SHIFT LOCK light
 14983  e9ee 8c40fe                 STY .systemVIARegisterB                             ;
 14984  e9f1 88                     DEY                                                 ; Y=6
 14985  e9f2 8c40fe                 STY .systemVIARegisterB                             ; switch on CAPS LOCK light
 14986                          
 14987                          .skipKeyboardLights
 14988  e9f5 24ff                   BIT .escapeFlag                                     ; check bit 7 of escape flag indicating
 14989                                                                                  ; that ESCAPE condition exists
 14990  e9f7 60                     RTS                                                 ;
 14991                          
 14992                          ; ***************************************************************************************
 14993                          .writeAToSystemVIARegisterB
 14994  e9f8 08                     PHP                                                 ; push flags
 14995  e9f9 78                     SEI                                                 ; disable interupts
 14996  e9fa 8d40fe                 STA .systemVIARegisterB                             ; write register B from Accumulator
 14997  e9fd 28                     PLP                                                 ; get back flags
 14998  e9fe 60                     RTS                                                 ;
 14999                          
 15000                          ; ***************************************************************************************
 15001                          ;
 15002                          ; OSBYTE 154 - Write to Video ULA's Video Control Register
 15003                          ;
 15004                          ; bit
 15005                          ;   0 - Flash colour select (which of the flashing colours is displayed)
 15006                          ;   1 - Teletext select
 15007                          ;   2 - } These two bits determine the number of characters per row
 15008                          ;   3 - } from this table:
 15009                          ;        00 = 10 characters per row
 15010                          ;        01 = 20 characters per row
 15011                          ;        10 = 40 characters per row
 15012                          ;        11 = 80 characters per row
 15013                          ;   4 - CRTC clock rate select:
 15014                          ;         0 = low frequency clock for MODEs 4-7
 15015                          ;         1 = high frequency clock for MODEs 0-3
 15016                          ;   5 - }
 15017                          ;   6 - } These three bits determine the width of cursor in bytes:
 15018                          ;   7 - }
 15019                          ;
 15020                          ;       000 = 0 cursor off
 15021                          ;       010 = 1 (for MODE 7)
 15022                          ;       100 = 1 (for MODEs 0,3,4,6)
 15023                          ;       110 = 2 (for MODEs 1,5)
 15024                          ;       111 = 4 (for MODE 2)
 15025                          ;
 15026                          ; ***************************************************************************************
 15027                          .osbyte154EntryPoint
 15028  e9ff 8a                     TXA                                                 ;
 15029                          .setVideoULA
 15030  ea00 08                     PHP                                                 ; save flags
 15031  ea01 78                     SEI                                                 ; disable interrupts
 15032  ea02 8d4802                 STA .videoULAVideoControlRegisterCopy               ; save RAM copy of new parameter
 15033  ea05 8d20fe                 STA .videoULAControlRegister                        ; write to control register
 15034  ea08 ad5302                 LDA .videoULASecondFlashingColourInterval           ; get second flashing colour interval
 15035  ea0b 8d5102                 STA .videoULAFlashingColourIntervalCount            ; set flash counter to this value
 15036  ea0e 28                     PLP                                                 ; get back status
 15037  ea0f 60                     RTS                                                 ;
 15038                          
 15039                          
 15040                          ; ***************************************************************************************
 15041                          ;
 15042                          ; OSBYTE 155 - Set palette value
 15043                          ;
 15044                          ; On Entry:
 15045                          ;       X contains value to write
 15046                          ;
 15047                          ; ***************************************************************************************
 15048                          .osbyte155EntryPoint
 15049  ea10 8a                     TXA                                                 ; A = X
 15050                          .osbyte155Internal
 15051  ea11 4907                   EOR #7                                              ; convert to palette format required for video ULA register
 15052  ea13 08                     PHP                                                 ; remember flags (including interrupt disable flag)
 15053  ea14 78                     SEI                                                 ; prevent interrupts
 15054  ea15 8d4902                 STA .videoULAPaletteValue                           ; store as current palette setting
 15055  ea18 8d21fe                 STA .videoULAPaletteRegister                        ; store actual colour in register
 15056  ea1b 28                     PLP                                                 ; restore flags (including interrupt disable flag)
 15057  ea1c 60                     RTS                                                 ;
 15058                          
 15059                          ; ***************************************************************************************
 15060                          .gsinitForFilenameParsing
 15061  ea1d 18                     CLC                                                 ; clear carry
 15062                              ; fall through...
 15063                          
 15064                          ; ***************************************************************************************
 15065                          ;
 15066                          ; GSINIT - Initialise parsing of a string
 15067                          ;
 15068                          ; Initialises the parsing of a given string (the 'input' string). Usually the string is part
 15069                          ; of an OSCLI command line where a string is expected (e.g. the filename in a *LOAD or the
 15070                          ; definition of a function key in *KEY).
 15071                          ;
 15072                          ; Leading spaces are ignored. The input string can be surrounded by double quotation marks.
 15073                          ; The string is terminated by a carriage return, or the second double quotation mark, or
 15074                          ; (optionally) a space character (useful for filename parsing).
 15075                          ;
 15076                          ; Once initialised, the parsing occurs using multiple calls to GSREAD. Each call produces one
 15077                          ; character result based on the input string.
 15078                          ;
 15079                          ; Control codes are disallowed in the input string. However the bar character '|' can be
 15080                          ; used to introduce control codes into the parsed output of GSREAD, and the '|!' combination
 15081                          ; is used to introduce top bit set characters.
 15082                          ;
 15083                          ; '|' followed by a character (see exceptions below) gives the ASCII value minus 64.
 15084                          ;       e.g. |G = control code 7  (bell)
 15085                          ;            |M = control code 13 (carriage return)
 15086                          ; '|!' adds 128 to the following character.
 15087                          ; '||' is parsed as a single bar character.
 15088                          ; '|"' is parsed as double quotes.
 15089                          ; '|?' is parsed as the DELETE character (character 127).
 15090                          ;
 15091                          ; These can be combined, e.g. '|!|A' results in character 129 being parsed.
 15092                          ;
 15093                          ; On Entry:
 15094                          ;       Address for string stored at .stringInputBufferAddressLow/High
 15095                          ;       Y = offset into string
 15096                          ;       C = 0: string is terminated by a space (used for filename parsing)
 15097                          ;       C = 1: otherwise (used e.g. for defining a soft key with *KEY)
 15098                          ;
 15099                          ; On Exit:
 15100                          ;       .stringInputOptions bit 7 = double-quote character found at start
 15101                          ;                           bit 6 = don't stop on space character
 15102                          ;       Y = offset of the first non-blank character
 15103                          ;       A = first non-blank character
 15104                          ;       Z is set if string is empty
 15105                          ;
 15106                          ; ***************************************************************************************
 15107                          .gsinitEntryPoint
 15108  ea1e 66e4                   ROR .stringInputOptions                             ; Move carry into top bit of options
 15109  ea20 203ae0                 JSR .skipSpacesAndCheckForCRInStringInput           ; get character from text
 15110  ea23 c8                     INY                                                 ; increment Y to point at next character
 15111  ea24 c922                   CMP #.charDOUBLEQUOTE                               ; check for double quotes (") character
 15112  ea26 f002                   BEQ +                                               ; if (double quotes) then branch
 15113  ea28 88                     DEY                                                 ; decrement Y
 15114  ea29 18                     CLC                                                 ; clear carry
 15115                          +
 15116  ea2a 66e4                   ROR .stringInputOptions                             ; bit 7 = double quote character found
 15117                                                                                  ; bit 6 = space is not a terminator
 15118  ea2c c90d                   CMP #.charRETURN                                    ; set Z flag if CR found
 15119  ea2e 60                     RTS                                                 ;
 15120                          
 15121                          
 15122                          ; ***************************************************************************************
 15123                          ;
 15124                          ; GSREAD - Read one character by parsing the input string
 15125                          ;
 15126                          ; Parses a character from the input string previously set up by GSINIT.
 15127                          ; See .gsinitEntryPoint
 15128                          ;
 15129                          ; On Entry:
 15130                          ;       Address for string stored at .stringInputBufferAddressLow/High
 15131                          ;       Y = offset into string
 15132                          ; On Exit:
 15133                          ;       A = character read
 15134                          ;       X is preserved
 15135                          ;       Y = index of next character to be read
 15136                          ;       Carry is set if end of string reached
 15137                          ;       Overflow (V flag) is set if the character read was interpreted as a control code
 15138                          ;
 15139                          ; ***************************************************************************************
 15140                          .gsreadEntryPoint
 15141  ea2f a900                   LDA #0                                              ; A=0
 15142                          .gsreadInternal
 15143  ea31 85e5                   STA .stringInputPlingFlag                           ; store A ($80 if previous character is '!', zero otherwise)
 15144  ea33 b1f2                   LDA (.stringInputBufferAddressLow),Y                ; read first character
 15145  ea35 c90d                   CMP #.charRETURN                                    ; check for CR
 15146  ea37 d006                   BNE .notRETURN                                      ; if (not CR) then branch
 15147                          
 15148                              ; deal with RETURN character
 15149  ea39 24e4                   BIT .stringInputOptions                             ; check options
 15150  ea3b 3052                   BMI .brkBadString                                   ; if (second quotation mark needed) then branch ('Bad string' message)
 15151  ea3d 101b                   BPL .finishedString                                 ; ALWAYS branch (string ok, finished)
 15152                          
 15153                          .notRETURN
 15154  ea3f c920                   CMP #.charSPACE                                     ; check for SPACE
 15155  ea41 904c                   BCC .brkBadString                                   ; if (less then space, i.e. a control character) then branch ('Bad string' message)
 15156  ea43 d006                   BNE .notSPACE                                       ; if (it's not a space) then branch
 15157                          
 15158                              ; Deal with ' ' SPACE character
 15159  ea45 24e4                   BIT .stringInputOptions                             ; check bit 6 and 7 of .stringInputOptions
 15160  ea47 3040                   BMI .finishUpReadClearV                             ; if (double-quote character found) then branch
 15161  ea49 500f                   BVC .finishedString                                 ; if (space character is a terminator) then branch (finished string)
 15162                          
 15163                          .notSPACE
 15164  ea4b c922                   CMP #.charDOUBLEQUOTE                               ; check for DOUBLE QUOTE
 15165  ea4d d010                   BNE .notDOUBLEQUOTE                                 ; if (not double quote) then branch
 15166                          
 15167                              ; Deal with '"' DOUBLE QUOTE character
 15168  ea4f 24e4                   BIT .stringInputOptions                             ; check options
 15169  ea51 1036                   BPL .finishUpReadClearV                             ; if (string didn't start with a double quote) then branch
 15170                          
 15171                              ; We have found a string surrounded by double quotes.
 15172                              ; Check the next character isn't also a double quote, as that's an error.
 15173  ea53 c8                     INY                                                 ; point at next character
 15174  ea54 b1f2                   LDA (.stringInputBufferAddressLow),Y                ; get it
 15175  ea56 c922                   CMP #.charDOUBLEQUOTE                               ; check for double quotes (") character
 15176  ea58 f02f                   BEQ .finishUpReadClearV                             ; if (third double quote character found) then branch
 15177                          
 15178                          .finishedString
 15179  ea5a 203ae0                 JSR .skipSpacesAndCheckForCRInStringInput           ; skip past any final SPACEs
 15180  ea5d 38                     SEC                                                 ; carry set
 15181  ea5e 60                     RTS                                                 ;
 15182                          
 15183                          .notDOUBLEQUOTE
 15184  ea5f c97c                   CMP #.charBAR                                       ; check for bar '|' character
 15185  ea61 d026                   BNE .finishUpReadClearV                             ; if (not bar) then branch
 15186                          
 15187                              ; deal with '|' vertical BAR character
 15188  ea63 c8                     INY                                                 ; increase Y to point to next character
 15189  ea64 b1f2                   LDA (.stringInputBufferAddressLow),Y                ; get next character
 15190  ea66 c97c                   CMP #.charBAR                                       ; check for '|' again
 15191  ea68 f01f                   BEQ .finishUpReadClearV                             ; if (bar found) then branch
 15192                          
 15193  ea6a c922                   CMP #.charDOUBLEQUOTE                               ; check for double quotes (") character
 15194  ea6c f01b                   BEQ .finishUpReadClearV                             ; if (double quotes) then branch
 15195                          
 15196  ea6e c921                   CMP #.charEXCLAMATIONMARK                           ; check for '!' character
 15197  ea70 d005                   BNE +                                               ; if (not '!') then branch
 15198                          
 15199                              ; deal with '|!' characters
 15200  ea72 c8                     INY                                                 ; increment Y to next character
 15201  ea73 a980                   LDA #$80                                            ; set bit 7
 15202  ea75 d0ba                   BNE .gsreadInternal                                 ; loop back (sets bit 7 in next character)
 15203                          
 15204                              ; deal with remaining possible characters after the '|' BAR character
 15205                          +
 15206  ea77 c920                   CMP #.charSPACE                                     ; check for ' '
 15207  ea79 9014                   BCC .brkBadString                                   ; if (less than space, i.e. a control code) then branch ('Bad string' message)
 15208                          
 15209  ea7b c93f                   CMP #.charQUESTIONMARK                              ; check for '|?'
 15210  ea7d f008                   BEQ +                                               ; if ('|?') then branch (set delete character)
 15211                          
 15212                              ; Remaining '|' followed by a character is treated as a control code
 15213  ea7f 20bfea                 JSR .implementCTRLCodes                             ; modify code as if CTRL pressed
 15214  ea82 2cb7d9                 BIT .allBitsSet                                     ; Set V flag
 15215  ea85 7003                   BVS .finishUpReadX                                  ; ALWAYS branch (finish up with V set)
 15216                          
 15217                          +
 15218  ea87 a97f                   LDA #.charDELETE                                    ; delete character
 15219                          
 15220                          .finishUpReadClearV
 15221  ea89 b8                     CLV                                                 ; clear V
 15222                          .finishUpReadX
 15223  ea8a c8                     INY                                                 ; increment Y
 15224  ea8b 05e5                   ORA .stringInputPlingFlag                           ;
 15225  ea8d 18                     CLC                                                 ; clear carry
 15226  ea8e 60                     RTS                                                 ;
 15227                          
 15228                          ; ***************************************************************************************
 15229                          .brkBadString
 15230  ea8f 00                     BRK                                                 ;
 15231  ea90 fd                     !byte $FD                                           ; error number
 15232  ea91 4261642073747269...    !text "Bad string",0                                ; message (with zero terminator)
 15233                          
 15234                          ; ***************************************************************************************
 15235                          ;
 15236                          ; Apply SHIFT to character in A
 15237                          ;
 15238                          ; Modify character in A as if the SHIFT key is being pressed
 15239                          ;
 15240                          ; ***************************************************************************************
 15241                          .implementSHIFT
 15242  ea9c c930                   CMP #.charZERO                                      ;
 15243  ea9e f01e                   BEQ .exit24                                         ; if ('0' character found) then branch (return) (SHIFT '0' = '0')
 15244  eaa0 c940                   CMP #.charAT                                        ;
 15245  eaa2 f01a                   BEQ .exit24                                         ; if ('@' character found) then branch (return) (SHIFT '@' = '@')
 15246  eaa4 9012                   BCC .flipBitFourIfNotCtrlCharacter                  ; if (A < '@') then branch
 15247                                                                                  ; the branch converts characters
 15248                                                                                  ;       !"#$%&`()*+,-./ 123456789:;<=>?
 15249                                                                                  ; into  123456789:;<=>? !"#$%&`()*+,-./
 15250  eaa6 c97f                   CMP #.charDELETE                                    ;
 15251  eaa8 f014                   BEQ .exit24                                         ; if (DELETE character found) then branch (return) (SHIFT DELETE = DELETE)
 15252  eaaa b010                   BCS .flipBitFourOnly                                ; if (greater than $7F) then branch (toggle bit 4 and exit)
 15253                          
 15254                              ; At this point A>64 and A<127
 15255                              ; The following code converts the following characters:
 15256                              ;        ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_£ abcdefghijklmnopqrstuvwxyz{|}~
 15257                              ; into   abcdefghijklmnopqrstuvwxyz{|}~£_ ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^
 15258                          
 15259                          .flipBitsForShift
 15260  eaac 4930                   EOR #%00110000                                      ; flip bits 4 and 5
 15261  eaae c96f                   CMP #(.charUNDERSCORE XOR %00110000)                ; }
 15262  eab0 f004                   BEQ +                                               ; } if (it was originally underscore '_') then branch
 15263                          
 15264  eab2 c950                   CMP #(.charPOUND XOR %00110000)                     ; }
 15265  eab4 d002                   BNE .flipBitFourIfNotCtrlCharacter                  ; } if (it was NOT originally pound '£') then branch
 15266                          +
 15267  eab6 491f                   EOR #$1F                                            ; EOR for converting pound symbol (which will become
 15268                                                                                  ; underscore when the EOR at .flipBitFourOnly is done)
 15269                          .flipBitFourIfNotCtrlCharacter
 15270  eab8 c921                   CMP #.charSPACE + 1                                 ; }
 15271  eaba 9002                   BCC .exit24                                         ; } if (control code) then branch (return)
 15272                          .flipBitFourOnly
 15273  eabc 4910                   EOR #%00010000                                      ; flip bit 4
 15274                          .exit24
 15275  eabe 60                     RTS                                                 ;
 15276                          
 15277                          ; ***************************************************************************************
 15278                          ;
 15279                          ; Modify character in A as if the CTRL key is being pressed
 15280                          ;
 15281                          ; This is used both when the CTRL key is being pressed, and for parsing strings using
 15282                          ; GSINIT / GSREAD. See .gsinitEntryPoint.
 15283                          ;
 15284                          ;     Input     Output      Notes
 15285                          ;     ASCII      CTRL
 15286                          ;     Code       Code
 15287                          ;     ----------------------------------------------------------------------
 15288                          ;     32-63     32-63       VDU 32-63 (unchanged)
 15289                          ;     '@'         0         VDU 0
 15290                          ;     'A'         1         VDU 1
 15291                          ;           ...
 15292                          ;     'Z'        26         VDU 26
 15293                          ;     '['        27         VDU 27
 15294                          ;     '\'        28         VDU 28
 15295                          ;     ']'        29         VDU 29
 15296                          ;     '^'        30         VDU 30
 15297                          ;     '_'        31         VDU 31
 15298                          ;     '£'        31         VDU 31 this is treated as a special case.
 15299                          ;                                  it would otherwise result in VDU 0 [why the special case?]
 15300                          ;     'a'         1         VDU 1
 15301                          ;           ...
 15302                          ;     'z'        26         VDU 26
 15303                          ;     '{'        27         VDU 27
 15304                          ;     '|'        28         VDU 28
 15305                          ;     '}'        29         VDU 29
 15306                          ;     '~'        30         VDU 30
 15307                          ;     127       127         DELETE
 15308                          ;     128-255   flip bit 5  flip bit 5 [it's not clear why this is useful?]
 15309                          ;
 15310                          ; ***************************************************************************************
 15311                          .implementCTRLCodes
 15312  eabf c97f                   CMP #.charDELETE                                    ; check for DELETE
 15313  eac1 f00e                   BEQ ++                                              ; if (DELETE found) then branch (exit)
 15314  eac3 b0e7                   BCS .flipBitsForShift                               ; if (greater than $7F) then branch (process top bit characters)
 15315  eac5 c960                   CMP #.charPOUND                                     ; }
 15316  eac7 d002                   BNE +                                               ; } if (A is not '£') then branch
 15317  eac9 a95f                   LDA #.charUNDERSCORE                                ; A='_'
 15318                          +
 15319  eacb c940                   CMP #.charAT                                        ; }
 15320  eacd 9002                   BCC ++                                              ; } if (A < '@') then branch (return unchanged)
 15321  eacf 291f                   AND #%00011111                                      ; at this point     A is between 64 to 126 inclusive
 15322                                                                                  ; zero bits 5 to 7  A is between  0 to  31 inclusive
 15323                          ++
 15324  ead1 60                     RTS                                                 ;
 15325                          
 15326                          ; ***************************************************************************************
 15327                          .runBootString
 15328  ead2 2f21424f4f540d         !text "/!BOOT",13
 15329                          
 15330                          ; ***************************************************************************************
 15331                          ;
 15332                          ; OSBYTE 247 - Intercept BREAK
 15333                          ;
 15334                          ; On Exit:
 15335                          ;           Z clear if no user BREAK intercept code
 15336                          ; otherwise Z is set or cleared by user BREAK code
 15337                          ;
 15338                          ; ***************************************************************************************
 15339                          .osbyte247EntryPoint
 15340  ead9 ad8702                 LDA .breakInterceptJMPInstruction                  ; get first byte of user BREAK code (looking for 'JMP address')
 15341  eadc 494c                   EOR #$4C                                           ; produces 0 if JMP absolute instruction is present
 15342  eade d013                   BNE +                                              ; if (not zero) then branch (return)
 15343  eae0 4c8702                 JMP .breakInterceptJMPInstruction                  ; jump to user BREAK code
 15344                          
 15345                          ; ***************************************************************************************
 15346                          ;
 15347                          ; OSBYTE 144 - *TV
 15348                          ;
 15349                          ; On Entry:
 15350                          ;       X=vertical shift of display
 15351                          ;       Y=interlace disable flag
 15352                          ; On Exit:
 15353                          ;       X=old vertical shift of display
 15354                          ;       Y=old interlace disable flag
 15355                          ;
 15356                          ; ***************************************************************************************
 15357                          .osbyte144EntryPoint
 15358  eae3 ad9002                 LDA .vduVerticalAdjust                              ; VDU vertical adjustment
 15359  eae6 8e9002                 STX .vduVerticalAdjust                              ; store new value
 15360  eae9 aa                     TAX                                                 ; put old value in X
 15361  eaea 98                     TYA                                                 ; put interlace flag in A
 15362  eaeb 2901                   AND #1                                              ; maximum value =1
 15363  eaed ac9102                 LDY .vduInterlaceValue                              ; get old value into Y
 15364  eaf0 8d9102                 STA .vduInterlaceValue                              ; put new value into A
 15365                          +
 15366  eaf3 60                     RTS                                                 ;
 15367                          
 15368                          
 15369                          ; ***************************************************************************************
 15370                          ;
 15371                          ; OSBYTE 147 - Write a byte to FRED
 15372                          ;
 15373                          ; X is offset within page
 15374                          ; Y is byte to write;
 15375                          ;
 15376                          ; ***************************************************************************************
 15377                          .osbyte147EntryPoint
 15378  eaf4 98                     TYA                                                 ;
 15379  eaf5 9d00fc                 STA .fredPage,X                                     ;
 15380  eaf8 60                     RTS                                                 ;
 15381                          
 15382                          ; ***************************************************************************************
 15383                          ;
 15384                          ; OSBYTE 149 - Write a byte to JIM
 15385                          ;
 15386                          ; X is offset within page
 15387                          ; Y is byte to write
 15388                          ;
 15389                          ; ***************************************************************************************
 15390                          .osbyte149EntryPoint
 15391  eaf9 98                     TYA                                                 ;
 15392  eafa 9d00fd                 STA .jimPage,X                                      ;
 15393  eafd 60                     RTS                                                 ;
 15394                          
 15395                          ; ***************************************************************************************
 15396                          ;
 15397                          ; OSBYTE 151 - Write a byte to SHEILA
 15398                          ;
 15399                          ; X is offset within page
 15400                          ; Y is byte to write
 15401                          ;
 15402                          ; ***************************************************************************************
 15403                          .osbyte151EntryPoint
 15404  eafe 98                     TYA                                                 ;
 15405  eaff 9d00fe                 STA .sheilaPage,X                                   ;
 15406  eb02 60                     RTS                                                 ;
 15407                          
 15408                          
 15409                          ; ***************************************************************************************
 15410                          ; ***************************************************************************************
 15411                          ;
 15412                          ; Chapter 16: Sound and Speech
 15413                          ;
 15414                          ; ***************************************************************************************
 15415                          ; ***************************************************************************************
 15416                          
 15417                          ; ***************************************************************************************
 15418                          ;
 15419                          ; Introduction
 15420                          ;
 15421                          ; The sound chip has three channels that produce square waves tones, and one noise channel.
 15422                          ; The OS enhances this basic functionality with OSWORD 7 - Make a sound, and OSWORD 8 -
 15423                          ; Define an envelope. These correspond to the BASIC commands SOUND and ENVELOPE. The SOUND
 15424                          ; command simplifies the process of playing regular notes and noises, and adds the ability
 15425                          ; to store a queue of notes to play in advance. The ENVELOPE command allows a wide variety
 15426                          ; of sound effects to be played by varying the pitch and amplitude of a sound every 100th
 15427                          ; of a second as it plays.
 15428                          ; See .osword7EntryPoint.
 15429                          ; See .osword8EntryPoint.
 15430                          ;
 15431                          ; Sound durations are specified in 1/20ths of a second allowing a single byte to sustain a
 15432                          ; long note up to 12.75 seconds.
 15433                          ;
 15434                          ; In addition sound is produced by VDU 7 BELL - a surprisingly accurately pitched Treble C.
 15435                          ; See .vdu7EntryPoint.
 15436                          ;
 15437                          ; Finally, a percussive sound can (in extremis) be produced by setting and resetting the
 15438                          ; cassette relay. See .osbyte137EntryPoint. This is a mechanically generated sound, not
 15439                          ; produced via the internal loudspeaker.
 15440                          ;
 15441                          ; Many games such as Arcadians (Aardvark, 1983) and Zalaga (Acornsoft, 1982) that sought to
 15442                          ; emulate arcade games used the sound capabilities to create 'musical stings' and other
 15443                          ; effects.
 15444                          ; See arcadians.mp3
 15445                          ; See zalaga1.mp3
 15446                          ; See zalaga2.mp3
 15447                          ;
 15448                          ; ***************************************************************************************
 15449                          
 15450                          ; ***************************************************************************************
 15451                          ;
 15452                          ; Silence a sound channel
 15453                          ;
 15454                          ; On Entry:
 15455                          ;       X = buffer number (4-7) for channel (0-3)
 15456                          ;
 15457                          ; ***************************************************************************************
 15458                          .silenceChannelX
 15459  eb03 a904                   LDA #4                                              ; mark end of release phase
 15460  eb05 9d0808                 STA .channel0PhaseCounter - .bufferNumberSound0,X   ; to channel X
 15461  eb08 a9c0                   LDA #$C0                                            ; code for zero volume
 15462                              ; fall through...
 15463                          
 15464                          ; ***************************************************************************************
 15465                          ;
 15466                          ; Set volume for channel X
 15467                          ;
 15468                          ; On Entry:
 15469                          ;       A = volume, where $3F (loudest) to $C0 (silent) - see table below
 15470                          ;       X = buffer number (4-7) for channel (0-3)
 15471                          ;
 15472                          ; ***************************************************************************************
 15473                          .setChannelXVolume
 15474  eb0a 9d0408                 STA .channel0Volume - .bufferNumberSound0,X         ; store A to give basic sound level
 15475  eb0d ac6202                 LDY .soundDisableFlag                               ; get sound output/enable flag
 15476  eb10 f002                   BEQ +                                               ; if (sound enabled) then branch
 15477  eb12 a9c0                   LDA #$C0                                            ; code for zero volume
 15478                          +
 15479                              ; we now convert the input volume into the value required to write to the sound chip
 15480  eb14 38                     SEC                                                 ; set carry
 15481  eb15 e940                   SBC #$40                                            ; subtract $40
 15482  eb17 4a                     LSR                                                 ; } divide by 8
 15483  eb18 4a                     LSR                                                 ; }
 15484  eb19 4a                     LSR                                                 ; }
 15485  eb1a 490f                   EOR #$0F                                            ; invert bits 0-3
 15486                          
 15487                          ;     BASIC SOUND   volume on entry     accumulator
 15488                          ;     volume        .channel0Volume     result now
 15489                          ;      -15                $3F              $10          loudest
 15490                          ;      -14                $37              $11
 15491                          ;      -13                $2F              $12
 15492                          ;      -12                $27              $13
 15493                          ;      -11                $1F              $14
 15494                          ;      -10                $17              $15
 15495                          ;       -9                $0F              $16
 15496                          ;       -8                $07              $17
 15497                          ;       -7                $FF              $18
 15498                          ;       -6                $F7              $19
 15499                          ;       -5                $EF              $1A
 15500                          ;       -4                $E7              $1B
 15501                          ;       -3                $DF              $1C
 15502                          ;       -2                $D7              $1D
 15503                          ;       -1                $CF              $1E
 15504                          ;        0                $C7              $1F          silent
 15505                          ;        -                $C0              $1F          silent
 15506                          
 15507  eb1c 1d3ceb                 ORA .soundParameterTable - .bufferNumberSound0,X    ; get encoded value for channel into top nybble
 15508  eb1f 0910                   ORA #$10                                            ; ensure bit 4 set (set volume)
 15509                          
 15510                          .sendToSoundChip
 15511  eb21 08                     PHP                                                 ;
 15512                          .sendToSoundChipFlagsAreadyPushed
 15513  eb22 78                     SEI                                                 ; disable interrupts
 15514  eb23 a0ff                   LDY #$FF                                            ; }
 15515  eb25 8c43fe                 STY .systemVIADataDirectionRegisterA                ; } set data direction to all outputs
 15516  eb28 8d4ffe                 STA .systemVIARegisterANoHandshake                  ; send data byte to sound chip
 15517  eb2b c8                     INY                                                 ; Y=0
 15518  eb2c 8c40fe                 STY .systemVIARegisterB                             ; set the write enable line low (active)
 15519                                                                                  ; to let the sound chip know there
 15520                                                                                  ; is data
 15521  eb2f a002                   LDY #2                                              ; Y = loop counter
 15522                          -
 15523  eb31 88                     DEY                                                 ; execute a short delay (this is to
 15524  eb32 d0fd                   BNE -                                               ; keep the write enable line low for
 15525                                                                                  ; at least 8 us, 16 cycles. This is
 15526                                                                                  ; required by the sound chip hardware)
 15527                                                                                  ;
 15528                                                                                  ; [An alternative to this loop that
 15529                                                                                  ; takes the same number of cycles, but
