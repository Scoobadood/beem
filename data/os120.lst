  6263                          ; ***************************************************************************************
  6264                          ;
  6265                          ; Chapter 7: Graphics cursor and soft character definitions
  6266                          ;
  6267                          ; ***************************************************************************************
  6268                          ; ***************************************************************************************
  6269                          
  6270                          ; ***************************************************************************************
  6271                          ;
  6272                          ; Subtract the number of bytes in a row from AX
  6273                          ;
  6274                          ; On Entry:
  6275                          ;       A = High byte of 16 bit value
  6276                          ;       X = Low byte of 16 bit value
  6277                          ;
  6278                          ; ***************************************************************************************
  6279                          .subtractNumberOfBytesInARowFromAX
  6280  ccf8 48                     PHA                                                 ; store A
  6281  ccf9 8a                     TXA                                                 ; A=X
  6282  ccfa 38                     SEC                                                 ; set carry for subtraction
  6283  ccfb ed5203                 SBC .vduBytesPerCharacterRowLow                     ; bytes per character row
  6284  ccfe aa                     TAX                                                 ; result goes into X
  6285  ccff 68                     PLA                                                 ; recall A
  6286  cd00 ed5303                 SBC .vduBytesPerCharacterRowHigh                    ; bytes per character row
  6287  cd03 cd4e03                 CMP .vduStartScreenAddressHighByte                  ; high byte of screen RAM address
  6288                          .exit6
  6289  cd06 60                     RTS                                                 ;
  6290                          
  6291                          ; ***************************************************************************************
  6292                          ;
  6293                          ; OSBYTE 20 - 'Explode' soft character definitions
  6294                          ;
  6295                          ; This sets how much RAM is reserved for custom ('soft') character definitions. These areas
  6296                          ; of memory are sometimes known as 'font zones'.
  6297                          ;
  6298                          ; On Entry:
  6299                          ;       X   memory assigned          character range   notes
  6300                          ;       0   $0C00->$0CFF               $80-$8F         minimum memory assigned ('imploded')
  6301                          ;       1   OSHWM->OSHWM+$FF           $A0-$BF         includes allocations above
  6302                          ;       2   OSHWM+$100->OSHWM+$1FF     $C0-$DF         includes allocations above
  6303                          ;       3   OSHWM+$200->OSHWM+$2FF     $E0-$FF         includes allocations above
  6304                          ;       4   OSHWM+$300->OSHWM+$3FF     $20-$3F         includes allocations above
  6305                          ;       5   OSHWM+$400->OSHWM+$4FF     $40-$5F         includes allocations above
  6306                          ;       6   OSHWM+$500->OSHWM+$5FF     $60-$7F         includes allocations above
  6307                          ;
  6308                          ; Here OSHWM refers to the value of .defaultOSHWM, which holds the value of OSHWM before any
  6309                          ; font explosions.
  6310                          ;
  6311                          ; ***************************************************************************************
  6312                          .osbyte20EntryPoint
  6313  cd07 a90f                   LDA #%00001111                                      ;
  6314  cd09 8d6703                 STA .vduFontFlags                                   ; characters 160-255 have soft character definitions
  6315  cd0c a90c                   LDA #>.softCharacterDefinitions                     ; page for software character definitions
  6316  cd0e a006                   LDY #.vduFontZoneAddressesHigh7 - .vduFontZoneAddressesHigh1     ; set loop counter
  6317                          -
  6318  cd10 996803                 STA .vduFontZoneAddressesHigh1,Y                    ; set all font zone addresses (high byte) to $0C
  6319  cd13 88                     DEY                                                 ; to indicate the page available
  6320  cd14 10fa                   BPL -                                               ; for user character definitions
  6321                          
  6322  cd16 e007                   CPX #7                                              ;
  6323  cd18 9002                   BCC +                                               ; if (X < 7, i.e. parameter is in range) then branch
  6324  cd1a a206                   LDX #6                                              ; X=6
  6325                          +
  6326  cd1c 8e4602                 STX .softCharacterDefinitionsSwitch                 ; character definition explosion switch
  6327  cd1f ad4302                 LDA .defaultOSHWM                                   ; A = initial OSHWM value, before font
  6328                                                                                  ;     explosions.
  6329  cd22 a200                   LDX #0                                              ; X = 0, loop counter
  6330                          -
  6331  cd24 ec4602                 CPX .softCharacterDefinitionsSwitch                 ; character definition explosion switch
  6332  cd27 b00b                   BCS +                                               ;
  6333  cd29 bcbac4                 LDY .softCharacterRamAllocationTable,X              ; Y = RAM allocation offset
  6334  cd2c 996803                 STA .vduFontZoneAddressesHigh1,Y                    ; store in relevant font zone address
  6335  cd2f 6901                   ADC #1                                              ; add 1 page (carry clear)
  6336  cd31 e8                     INX                                                 ; X=X+1
  6337  cd32 d0f0                   BNE -                                               ; if (X is not zero) then branch (loop back)
  6338                          +
  6339  cd34 8d4402                 STA .currentOSHWM                                   ; store new value of PAGE (OSHWM)
  6340  cd37 a8                     TAY                                                 ; Y=A
  6341  cd38 f0cc                   BEQ .exit6                                          ; if (zero) then branch (return)
  6342                          
  6343  cd3a a211                   LDX #.romServiceCallFontImplosionExplosionWarning   ; } issue ROM service call to let ROMs
  6344                                                                                  ; } know of the font explosion and
  6345  cd3c 4c68f1                 JMP .osbyte143EntryPoint                            ; } to let languages know OSHWM
  6346                                                                                  ; } is changing. Y is new PAGE number
  6347                          
  6348                          ; ***************************************************************************************
  6349                          .moveTextCursorToNextLine
  6350  cd3f a902                   LDA #2                                              ; A=2 to check if scrolling disabled
  6351  cd41 24d0                   BIT .vduStatusByte                                  ; test VDU status byte
  6352  cd43 d002                   BNE +                                               ; if (scrolling is disabled) then branch
  6353  cd45 5032                   BVC .exit8                                          ; if (cursor editing mode is disabled) then return
  6354                          +
  6355  cd47 ad0903                 LDA .vduTextWindowBottom                            ; bottom edge of text window
  6356  cd4a 9003                   BCC +                                               ; if (carry clear on entry) then branch
  6357  cd4c ad0b03                 LDA .vduTextWindowTop                               ; get top of text window
  6358                          +
  6359  cd4f 7008                   BVS .moveTextCursorToNextLineCursorEditing          ; if (cursor editing mode enabled) then branch
  6360  cd51 8d1903                 STA .vduTextCursorYPosition                         ; set current text line
  6361  cd54 68                     PLA                                                 ; pull return link from stack
  6362  cd55 68                     PLA                                                 ;
  6363  cd56 4cafc6                 JMP .setCursorSoftwareAndHardwarePosition           ; set cursor position
  6364                          
  6365                          ; ***************************************************************************************
  6366                          .moveTextCursorToNextLineCursorEditing
  6367  cd59 08                     PHP                                                 ; push flags
  6368  cd5a cd6503                 CMP .vduTextInputCursorYCoordinate                  ; Y coordinate of text input cursor
  6369  cd5d f019                   BEQ .pullAndExit                                    ; if (A = line count) then branch (exit)
  6370  cd5f 28                     PLP                                                 ; get back flags
  6371  cd60 9004                   BCC .incYCoordinate                                 ;
  6372  cd62 ce6503                 DEC .vduTextInputCursorYCoordinate                  ; Y coordinate of text input cursor
  6373                          .exit7
  6374  cd65 60                     RTS                                                 ;
  6375                          
  6376                          ; ***************************************************************************************
  6377                          .incYCoordinate
  6378  cd66 ee6503                 INC .vduTextInputCursorYCoordinate                  ; Y coordinate of text input cursor
  6379  cd69 60                     RTS                                                 ;
  6380                          
  6381                          ; ***************************************************************************************
  6382                          ;
  6383                          ; Set up a write cursor
  6384                          ;
  6385                          ; When entering a line of text, if the user presses a cursor key then two cursors are shown:
  6386                          ; The WRITE cursor is shown at the point of text entry (looks like a solid block character),
  6387                          ; and is the position at which new characters will be input.
  6388                          ; The READ cursor (shown as a flashing underline) is positioned by the cursor keys.
  6389                          ; The COPY key reads the character under the READ cursor and enters it at WRITE cursor.
  6390                          ;
  6391                          ; Editing finishes when RETURN is pressed.
  6392                          ;
  6393                          ; ***************************************************************************************
  6394                          .setUpWriteCursor
  6395  cd6a 08                     PHP                                                 ; save flags
  6396  cd6b 48                     PHA                                                 ; save A
  6397  cd6c ac4f03                 LDY .vduBytesPerCharacter                           ;
  6398  cd6f 88                     DEY                                                 ; Y = bytes per character - 1
  6399  cd70 d01d                   BNE .restoreWriteCursorNonMODE7                     ; if (not MODE 7) then branch
  6400  cd72 ad3803                 LDA .vduMODE7CursorCharacter                        ; get MODE 7 write character
  6401                                                                                  ; cursor character $7F
  6402  cd75 91d8                   STA (.vduWriteCursorScreenAddressLow),Y             ; store it at top scan line of current
  6403                                                                                  ; character
  6404                          .pullTwiceAndExit
  6405  cd77 68                     PLA                                                 ; pull A
  6406                          .pullAndExit
  6407  cd78 28                     PLP                                                 ; pull flags
  6408                          .exit8
  6409  cd79 60                     RTS                                                 ;
  6410                          
  6411                          ; ***************************************************************************************
  6412                          ;
  6413                          ; Restore a normal cursor
  6414                          ;
  6415                          ; ***************************************************************************************
  6416                          .restoreWriteCursor
  6417  cd7a 08                     PHP                                                 ; push flags
  6418  cd7b 48                     PHA                                                 ; push A
  6419  cd7c ac4f03                 LDY .vduBytesPerCharacter                           ;
  6420  cd7f 88                     DEY                                                 ; Y = bytes per character - 1
  6421  cd80 d00d                   BNE .restoreWriteCursorNonMODE7                     ; if (not MODE 7) then branch
  6422  cd82 b1d8                   LDA (.vduWriteCursorScreenAddressLow),Y             ; read from cursor screen address
  6423  cd84 8d3803                 STA .vduMODE7CursorCharacter                        ; store it
  6424  cd87 ad6603                 LDA .vduTeletextCharacterForCursor                  ; MODE 7 write cursor character
  6425  cd8a 91d8                   STA (.vduWriteCursorScreenAddressLow),Y             ; store it in MODE 7 screen address
  6426  cd8c 4c77cd                 JMP .pullTwiceAndExit                               ; and exit
  6427                          
  6428                          ; ***************************************************************************************
  6429                          .restoreWriteCursorNonMODE7
  6430  cd8f a9ff                   LDA #$FF                                            ; A=$FF (cursor byte mask)
  6431  cd91 c01f                   CPY #31                                             ; check bytes per character
  6432  cd93 d002                   BNE +                                               ; if (not MODE 2) then branch
  6433  cd95 a93f                   LDA #$3F                                            ; A=$3F (cursor byte mask)
  6434                          +
  6435  cd97 85da                   STA .vduTempStoreDA                                 ; store it
  6436                          -
  6437  cd99 b1d8                   LDA (.vduWriteCursorScreenAddressLow),Y             ; get scan line byte
  6438  cd9b 45da                   EOR .vduTempStoreDA                                 ; invert it
  6439  cd9d 91d8                   STA (.vduWriteCursorScreenAddressLow),Y             ; store it on scan line
  6440  cd9f 88                     DEY                                                 ; decrement scan line counter
  6441  cda0 10f7                   BPL -                                               ; do it again
  6442  cda2 30d3                   BMI .pullTwiceAndExit                               ; ALWAYS branch (pull and exit)
  6443                          
  6444                          ; ***************************************************************************************
  6445                          ;
  6446                          ; Software scroll text window downwards
  6447                          ;
  6448                          ; ***************************************************************************************
  6449                          .scrollTextWindowDownwards
  6450  cda4 205bce                 JSR .checkVerticalTextWindowBoundsAndMoveToLeftColumn   ;
  6451  cda7 ad0903                 LDA .vduTextWindowBottom                            ; bottom edge
  6452  cdaa 8d1903                 STA .vduTextCursorYPosition                         ; current text line
  6453  cdad 2006cf                 JSR .setTextCursorScreenAddresses                   ; set cursor screen addresses
  6454                          .loopBackScrollDown
  6455  cdb0 20f8cc                 JSR .subtractNumberOfBytesInARowFromAX              ; subtract bytes per character row
  6456  cdb3 b003                   BCS +                                               ;
  6457  cdb5 6d5403                 ADC .vduScreenSizeHighByte                          ; screen RAM size high byte
  6458                          +
  6459  cdb8 85db                   STA .vduTempStoreDB                                 ; store A
  6460  cdba 86da                   STX .vduTempStoreDA                                 ; X
  6461  cdbc 85dc                   STA .vduTempStoreDC                                 ; A again
  6462  cdbe b006                   BCS .noWraparound                                   ; if (C set; there was no wraparound) then branch
  6463                          -
  6464  cdc0 2073ce                 JSR .copyCharacterLineOfTextWindow                  ; copy line to new position
  6465                                                                                  ; using (.vduTempStoreDA) for read and
  6466                                                                                  ; (.vduWriteCursorScreenAddressLow)
  6467                                                                                  ; for write
  6468  cdc3 4ccecd                 JMP +                                               ;
  6469                          
  6470                          .noWraparound
  6471  cdc6 20f8cc                 JSR .subtractNumberOfBytesInARowFromAX              ; subtract bytes per character row
  6472  cdc9 90f5                   BCC -                                               ; if (outside screen RAM) then branch
  6473  cdcb 2038ce                 JSR .copyCharacterRow                               ; copy a character row of the text window
  6474                          +
  6475  cdce a5dc                   LDA .vduTempStoreDC                                 ; set write pointer from read pointer
  6476  cdd0 a6da                   LDX .vduTempStoreDA                                 ;
  6477  cdd2 85d9                   STA .vduWriteCursorScreenAddressHigh                ;
  6478  cdd4 86d8                   STX .vduWriteCursorScreenAddressLow                 ;
  6479  cdd6 c6de                   DEC .vduTempStoreDE                                 ; decrement window height
  6480  cdd8 d0d6                   BNE .loopBackScrollDown                             ; if (not zero) then branch (loop back)
  6481                          
  6482                          .exchangeTextCursorPositionWithWorkspaceAB
  6483  cdda a228                   LDX #.vduWorkspaceA - .vduVariablesStart            ; point to workspace
  6484                          
  6485  cddc a018                   LDY #.vduTextCursorXPosition - .vduVariablesStart   ; point to text column/line
  6486                              ; fall through...
  6487                          
  6488                          ; ***************************************************************************************
  6489                          .exchangeTwoVDUBytes
  6490  cdde a902                   LDA #2                                              ; number of bytes to swap
  6491  cde0 d006                   BNE .exchangeABytes                                 ; ALWAYS branch. Exchange
  6492                                                                                  ; (.vduWorkspaceA/B)+Y with (.workspaceA/B)+X
  6493                          
  6494                          ; ***************************************************************************************
  6495                          .exchangeGraphicsCursorWithOldPosition
  6496  cde2 a224                   LDX #.vduGraphicsCursorPixelsXLow - .vduVariablesStart     ; point to graphics cursor
  6497                          .exchangeOldGraphicsCursorPositionWithVariableX
  6498  cde4 a014                   LDY #.vduOldGraphicsCursorPixelsXLow - .vduVariablesStart  ; point to last graphics cursor
  6499                              ; fall through...
  6500                          
  6501                          ; ***************************************************************************************
  6502                          .exchangeFourBytes
  6503  cde6 a904                   LDA #4                                              ; A = 4
  6504                              ; fall through...
  6505                          
  6506                          ; ***************************************************************************************
  6507                          .exchangeABytes
  6508  cde8 85da                   STA .vduTempStoreDA                                 ; store it as loop counter
  6509                          -
  6510  cdea bd0003                 LDA .vduVariablesStart,X                            ; get byte
  6511  cded 48                     PHA                                                 ; store it
  6512  cdee b90003                 LDA .vduVariablesStart,Y                            ; get byte pointed to by Y
  6513  cdf1 9d0003                 STA .vduVariablesStart,X                            ; put it in 300+X
  6514  cdf4 68                     PLA                                                 ; get back A
  6515  cdf5 990003                 STA .vduVariablesStart,Y                            ; put it in 300+Y
  6516  cdf8 e8                     INX                                                 ; increment pointers
  6517  cdf9 c8                     INY                                                 ;
  6518  cdfa c6da                   DEC .vduTempStoreDA                                 ; decrement loop counter
  6519  cdfc d0ec                   BNE -                                               ; if (not zero) then branch (loop back and do it again)
  6520  cdfe 60                     RTS                                                 ;
  6521                          
  6522                          ; ***************************************************************************************
  6523                          ;
  6524                          ; Software scroll text window upwards
  6525                          ;
  6526                          ; ***************************************************************************************
  6527                          .scrollTextWindowUpwards
  6528  cdff 205bce                 JSR .checkVerticalTextWindowBoundsAndMoveToLeftColumn   ;
  6529  ce02 ac0b03                 LDY .vduTextWindowTop                               ; top of text window
  6530  ce05 8c1903                 STY .vduTextCursorYPosition                         ; current text line
  6531  ce08 2006cf                 JSR .setTextCursorScreenAddresses                   ; set cursor screen addresses
  6532                          .loopBackScrollUp
  6533  ce0b 20d4ca                 JSR .addNumberOfBytesInACharacterRowToAX            ; add bytes per character row
  6534  ce0e 1004                   BPL +                                               ;
  6535  ce10 38                     SEC                                                 ;
  6536  ce11 ed5403                 SBC .vduScreenSizeHighByte                          ; screen RAM size high byte
  6537                          +
  6538  ce14 85db                   STA .vduTempStoreDB                                 ; (.vduTempStoreDA)=X/A
  6539  ce16 86da                   STX .vduTempStoreDA                                 ;
  6540  ce18 85dc                   STA .vduTempStoreDC                                 ; .vduTempStoreDC=A
  6541  ce1a 9006                   BCC +                                               ;
  6542                          -
  6543  ce1c 2073ce                 JSR .copyCharacterLineOfTextWindow                  ; copy line to new position
  6544                                                                                  ; using (.vduTempStoreDA) for read
  6545                                                                                  ; and (.vduWriteCursorScreenAddressLow) for write
  6546  ce1f 4c2ace                 JMP .finishScroll                                   ;
  6547                          
  6548                          +
  6549  ce22 20d4ca                 JSR .addNumberOfBytesInACharacterRowToAX            ; add bytes per char. row
  6550  ce25 30f5                   BMI -                                               ; if (outside screen RAM) then branch
  6551  ce27 2038ce                 JSR .copyCharacterRow                               ; copy a character row of the text window
  6552                          .finishScroll
  6553  ce2a a5dc                   LDA .vduTempStoreDC                                 ;
  6554  ce2c a6da                   LDX .vduTempStoreDA                                 ;
  6555  ce2e 85d9                   STA .vduWriteCursorScreenAddressHigh                ;
  6556  ce30 86d8                   STX .vduWriteCursorScreenAddressLow                 ;
  6557  ce32 c6de                   DEC .vduTempStoreDE                                 ; decrement window height
  6558  ce34 d0d5                   BNE .loopBackScrollUp                               ; if (not zero) then branch (loop back)
  6559  ce36 f0a2                   BEQ .exchangeTextCursorPositionWithWorkspaceAB      ; ALWAYS branch - swap text cursor position with workspace
