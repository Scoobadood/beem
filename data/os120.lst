  6562                          ; ***************************************************************************************
  6563                          ;
  6564                          ; Copy bytes of one character row of the text window
  6565                          ;
  6566                          ; On Entry:
  6567                          ;       .vduTempStoreDA/DB                   is address to copy from
  6568                          ;       .vduWriteCursorScreenAddressLow/High is the destination address
  6569                          ;       .vduTextWindowWidthInBytesLow/High   is number of bytes to copy
  6570                          ; ***************************************************************************************
  6571                          .copyCharacterRow
  6572  ce38 ae4d03                 LDX .vduTextWindowWidthInBytesHigh                  ; text window width high (bytes)
  6573  ce3b f010                   BEQ +                                               ; if (no more than 256 bytes to copy) then branch
  6574                          
  6575  ce3d a000                   LDY #0                                              ; Y=0 to set loop counter
  6576                          -
  6577  ce3f b1da                   LDA (.vduTempStoreDA),Y                             ; } copy 256 bytes
  6578  ce41 91d8                   STA (.vduWriteCursorScreenAddressLow),Y             ; }
  6579  ce43 c8                     INY                                                 ; }
  6580  ce44 d0f9                   BNE -                                               ; } loop till Y=0 again
  6581  ce46 e6d9                   INC .vduWriteCursorScreenAddressHigh                ; increment high bytes
  6582  ce48 e6db                   INC .vduTempStoreDB                                 ;
  6583  ce4a ca                     DEX                                                 ; decrement window width
  6584  ce4b d0f2                   BNE -                                               ; if (not done yet) then branch (loop back)
  6585                          +
  6586  ce4d ac4c03                 LDY .vduTextWindowWidthInBytesLow                   ; text window width low (bytes)
  6587  ce50 f008                   BEQ +                                               ; if (text window is zero bytes wide) then branch (return)
  6588                          -
  6589  ce52 88                     DEY                                                 ; Y=Y-1
  6590  ce53 b1da                   LDA (.vduTempStoreDA),Y                             ; copy Y bytes
  6591  ce55 91d8                   STA (.vduWriteCursorScreenAddressLow),Y             ;
  6592  ce57 98                     TYA                                                 ; A=Y
  6593  ce58 d0f8                   BNE -                                               ; if (not done yet) then branch (loop back)
  6594                          +
  6595  ce5a 60                     RTS                                                 ;
