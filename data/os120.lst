  6614                          
  6615                          ; ***************************************************************************************
  6616                          .copyCharacterLineOfTextWindow
  6617  ce73 a5da                   LDA .vduTempStoreDA                                 ; get back A
  6618  ce75 48                     PHA                                                 ; push A
  6619  ce76 38                     SEC                                                 ; set carry
  6620  ce77 ad0a03                 LDA .vduTextWindowRight                             ; text window right
  6621  ce7a ed0803                 SBC .vduTextWindowLeft                              ; text window left
  6622  ce7d 85df                   STA .vduTempStoreDF                                 ; store text window width
  6623                          --
  6624  ce7f ac4f03                 LDY .vduBytesPerCharacter                           ; bytes per character to set loop counter
  6625  ce82 88                     DEY                                                 ; copy loop
  6626                          -
  6627  ce83 b1da                   LDA (.vduTempStoreDA),Y                             ; source: copy from .vduTempStoreDA/DB
  6628  ce85 91d8                   STA (.vduWriteCursorScreenAddressLow),Y             ; destination: store to screen
  6629  ce87 88                     DEY                                                 ;
  6630  ce88 10f9                   BPL -                                               ; keep copying for one character
  6631  ce8a a202                   LDX #2                                              ; X=2 loop counter
  6632                          -
  6633  ce8c 18                     CLC                                                 ; clear carry
  6634  ce8d b5d8                   LDA .vduWriteCursorScreenAddressLow,X               ;
  6635  ce8f 6d4f03                 ADC .vduBytesPerCharacter                           ; move screen pointer on by bytes per character
  6636  ce92 95d8                   STA .vduWriteCursorScreenAddressLow,X               ; and (when X=0) do the same with .vduTempStoreDA/DB
  6637  ce94 b5d9                   LDA .vduWriteCursorScreenAddressHigh,X              ;
  6638  ce96 6900                   ADC #0                                              ;
  6639  ce98 1004                   BPL +                                               ; if (this remains in screen RAM OK) then branch
  6640  ce9a 38                     SEC                                                 ; wrap around screen
  6641  ce9b ed5403                 SBC .vduScreenSizeHighByte                          ; take off screen RAM size high byte
  6642                          +
  6643  ce9e 95d9                   STA .vduWriteCursorScreenAddressHigh,X              ; store high byte
  6644  cea0 ca                     DEX                                                 ; X = X - 2
  6645  cea1 ca                     DEX                                                 ;
  6646  cea2 f0e8                   BEQ -                                               ; if (X = 0) then branch (loop back
  6647                                                                                  ; to adjust second set of pointers)
  6648  cea4 c6df                   DEC .vduTempStoreDF                                 ; decrement text window width counter
  6649  cea6 10d7                   BPL --                                              ; if (still +ve) then branch (loop
  6650                                                                                  ; back and do it all again)
  6651  cea8 68                     PLA                                                 ; get back A
  6652  cea9 85da                   STA .vduTempStoreDA                                 ; and store it
  6653  ceab 60                     RTS                                                 ;
  6654                          
  6655                          ; ***************************************************************************************
  6656                          .clearOneLine
  6657  ceac ad1803                 LDA .vduTextCursorXPosition                         ; text column
  6658  ceaf 48                     PHA                                                 ; save it
  6659  ceb0 206ece                 JSR .setTextCursorToLeftHandColumn                  ; set text column to left hand column
  6660  ceb3 2006cf                 JSR .setTextCursorScreenAddresses                   ; set cursor screen addresses
  6661  ceb6 38                     SEC                                                 ; set carry
  6662  ceb7 ad0a03                 LDA .vduTextWindowRight                             ; text window right
  6663  ceba ed0803                 SBC .vduTextWindowLeft                              ; text window left
  6664  cebd 85dc                   STA .vduTempStoreDC                                 ; as window width
  6665                          --
  6666  cebf ad5803                 LDA .vduBackgroundTextColour                        ; background text colour
  6667  cec2 ac4f03                 LDY .vduBytesPerCharacter                           ; bytes per character
  6668                          -
  6669  cec5 88                     DEY                                                 ; Y=Y-1 decrementing loop counter
  6670  cec6 91d8                   STA (.vduWriteCursorScreenAddressLow),Y             ; store background colour at this
  6671                                                                                  ; point on screen
  6672  cec8 d0fb                   BNE -                                               ; if (Y is not zero) then branch
  6673                                                                                  ; (loop back)
  6674  ceca 8a                     TXA                                                 ; A=X
  6675  cecb 18                     CLC                                                 ; clear carry to add
  6676  cecc 6d4f03                 ADC .vduBytesPerCharacter                           ; bytes per character
  6677  cecf aa                     TAX                                                 ; X=A restoring it
  6678  ced0 a5d9                   LDA .vduWriteCursorScreenAddressHigh                ; get high byte
  6679  ced2 6900                   ADC #0                                              ; add carry if any
  6680  ced4 1004                   BPL +                                               ; if (+ve) then branch
  6681  ced6 38                     SEC                                                 ; wrap around
  6682  ced7 ed5403                 SBC .vduScreenSizeHighByte                          ; screen RAM size high byte
  6683                          +
  6684  ceda 86d8                   STX .vduWriteCursorScreenAddressLow                 ; restore values
  6685  cedc 85d9                   STA .vduWriteCursorScreenAddressHigh                ;
  6686  cede c6dc                   DEC .vduTempStoreDC                                 ; decrement window width
  6687  cee0 10dd                   BPL --                                              ; and if not 0 do it all again
  6688  cee2 68                     PLA                                                 ; get back A
  6689                          
  6690                          .storeTextCursorXSetCarryAndReturn
  6691  cee3 8d1803                 STA .vduTextCursorXPosition                         ; restore text column
  6692                          .setCarryAndReturn
  6693  cee6 38                     SEC                                                 ; set carry
  6694  cee7 60                     RTS                                                 ;
