  3642                          ; ***************************************************************************************
  3643                          ;
  3644                          ; Screen initialisation on reset
  3645                          ;
  3646                          ; [This is an oddity, since there's no real reason for this JMP instruction to be here. The
  3647                          ; only caller (see .skipSpeech) could have equally used 'JSR .initialiseVDUVariablesAndSetMODE'
  3648                          ; instead of 'JSR .initialiseScreenOnReset' saving three bytes and three cycles.]
  3649                          ;
  3650                          ; ***************************************************************************************
  3651                          .vduBaseAddress
  3652                          .initialiseScreenOnReset
  3653  c300 4c1dcb                 JMP .initialiseVDUVariablesAndSetMODE               ;
  3654                          
  3655                          ; ***************************************************************************************
  3656                          ;
  3657                          ; The boot message
  3658                          ;
  3659                          ; See Boot.png
  3660                          ; See startup.mp3
  3661                          ; Here a BBC Micro Model B has booted up, displaying the 32K version of its welcome message.
  3662                          ; The Acorn Disk Filing System, installed on this machine as a sideways ROM, also identifies
  3663                          ; itself, after which the MOS enters the language ROM, BBC BASIC. It's BASIC, not the MOS,
  3664                          ; which displays the ">" prompt and receives commands. The screen is in MODE 7, so the
  3665                          ; text uses Teletext characters rather than being rendered in the raster font above.
  3666                          ;
  3667                          ; The startup sound has random variation in the first tone(s) as the sound chip starts
  3668                          ; playing random data on reset until the audio is silenced (See .resetClearAllSounds), and
  3669                          ; the second tone is the familiar .charBELL sound from the boot message below.
  3670                          ;
  3671                          ; Teletext characters look smoother than the regular raster font, thanks to the hardware's
  3672                          ; diagonal smoothing algorithm, giving them an effective resolution of 10x18 pixels instead
  3673                          ; of 8x8 in other MODEs.
  3674                          ; See https://en.wikipedia.org/wiki/Pixel-art_scaling_algorithms#SAA5050_'diagonal_smoothing'.
  3675                          ;
  3676                          ; Historical note: All of Acorn's early computers booted up with brief identifications
  3677                          ; like this, then a skipped line, then a prompt. For the System 2, it was "Acorn Cos",
  3678                          ; referring to its "cassette operating system"; for the Atom, which had only upper case
  3679                          ; characters, the ident was "ACORN ATOM". What is perhaps most notable about the ident on
  3680                          ; the original BBC Micro is that it mentions the BBC, but not Acorn (unless additional
  3681                          ; ROMs such as the disc filing system are also plugged in). Subsequent models did
  3682                          ; not follow this pattern: the BBC Master ident is "Acorn MOS", and the B+ is "Acorn OS"
  3683                          ; plus a RAM size.
  3684                          ;
  3685                          ; See 5050.png
  3686                          ;
  3687                          ; ***************************************************************************************
  3688                          
  3689                          .bootMessage
  3690  c303 0d42424320436f6d...    !text .charRETURN, "BBC Computer ", 0
  3691                          
  3692                          .bootMessageMemory16
  3693  c312 31364b0700             !text "16K", .charBELL, 0
  3694                          
  3695                          .bootMessageMemory32
  3696  c317 33324b0700             !text "32K", .charBELL, 0
  3697                          
  3698                          .bootMessageEnding
  3699  c31c 080d0d                 !text .charBACKSPACE, .charRETURN, .charRETURN      ; overlaps by one byte into the
  3700                                                                                  ; following table for the zero
  3701                                                                                  ; terminator
  3702                          
  3703                          ; ***************************************************************************************
  3704                          ;
  3705                          ; Four colour conversion table
  3706                          ;
  3707                          ; Used when drawing characters to the screen. The index into the table is a pattern of four
  3708                          ; bits (%0000-%1111) representing half of the eight bit text character row definition. The
  3709                          ; value of the array entry is the byte value required to write that pattern of white pixels
  3710                          ; on screen.
  3711                          ;
  3712                          ; ***************************************************************************************
  3713                          .fourColourMODEByteMaskTable
  3714  c31f 0011223344556677       !byte $00, $11, $22, $33, $44, $55, $66, $77
  3715  c327 8899aabbccddeeff       !byte $88, $99, $AA, $BB, $CC, $DD, $EE, $FF
  3716                          
  3717                          ; ***************************************************************************************
  3718                          ;
  3719                          ; Sixteen colour conversion table
  3720                          ;
  3721                          ; Used when drawing characters to the screen. The index into the table is a pattern of two
  3722                          ; bits (%00-%11) representing a quarter of the eight bit text character row definition. The
  3723                          ; value of the array entry is the byte value required to write that pattern of white pixels
  3724                          ; on screen.
  3725                          ;
  3726                          ; ***************************************************************************************
  3727                          .sixteenColourMODEByteMaskTable
  3728  c32f 0055aaff               !byte $00, $55, $AA, $FF
  3729                          
  3730                          ; ***************************************************************************************
  3731                          ;
  3732                          ; Table of addresses (low byte) to handle VDU N
  3733                          ;
  3734                          ; This table stores the low byte of the address of the routine to handle VDU n.
  3735                          ; It holds values for VDU 0-31 and 127.
  3736                          ;
  3737                          ; ***************************************************************************************
  3738                          .vduEntryPointTableLow
  3739  c333 11                     !byte <.vdu0EntryPoint                              ; Does nothing
  3740  c334 3b                     !byte <.vdu1EntryPoint                              ; Send next character to printer only
  3741  c335 96                     !byte <.vdu2EntryPoint                              ; Enable printer
  3742  c336 a1                     !byte <.vdu3EntryPoint                              ; Disable printer
  3743  c337 ad                     !byte <.vdu4EntryPoint                              ; Write text at text cursor
  3744  c338 b9                     !byte <.vdu5EntryPoint                              ; Write text at graphics cursor
  3745  c339 11                     !byte <.vdu6EntryPoint                              ; Enable VDU drivers
  3746  c33a 6f                     !byte <.vdu7EntryPoint                              ; Make a short beep
  3747  c33b c5                     !byte <.vdu8EntryPoint                              ; Move cursor left
  3748  c33c 64                     !byte <.vdu9EntryPoint                              ; Move cursor right
  3749  c33d f0                     !byte <.vdu10EntryPoint                             ; Move cursor down
  3750  c33e 5b                     !byte <.vdu11EntryPoint                             ; Move cursor up
  3751  c33f 59                     !byte <.vdu12EntryPoint                             ; Clear text window
  3752  c340 af                     !byte <.vdu13EntryPoint                             ; Move cursor to start of current line
  3753  c341 8d                     !byte <.vdu14EntryPoint                             ; Paged mode on
  3754  c342 a6                     !byte <.vdu15EntryPoint                             ; Paged mode off
  3755  c343 c0                     !byte <.vdu16EntryPoint                             ; Clear graphics window
  3756  c344 f9                     !byte <.vdu17EntryPoint                             ; Define text colour
  3757  c345 fd                     !byte <.vdu18EntryPoint                             ; Define graphics colour
  3758  c346 92                     !byte <.vdu19EntryPoint                             ; Change palette colour
  3759  c347 39                     !byte <.vdu20EntryPoint                             ; Restore default palette
  3760  c348 9b                     !byte <.vdu21EntryPoint                             ; Disable VDU drivers / delete line
  3761  c349 eb                     !byte <.vdu22EntryPoint                             ; Select screen MODE
  3762  c34a f1                     !byte <.vdu23EntryPoint                             ; Define character shape (etc)
  3763  c34b 39                     !byte <.vdu24EntryPoint                             ; Define graphics window
  3764  c34c 8c                     !byte <.vdu25EntryPoint                             ; PLOT
  3765  c34d bd                     !byte <.vdu26EntryPoint                             ; Restore default windows
  3766  c34e 11                     !byte <.vdu27EntryPoint                             ; Does nothing
  3767  c34f fa                     !byte <.vdu28EntryPoint                             ; Define text window
  3768  c350 a2                     !byte <.vdu29EntryPoint                             ; Define graphics origin
  3769  c351 79                     !byte <.vdu30EntryPoint                             ; Move text cursor to top left
  3770  c352 87                     !byte <.vdu31EntryPoint                             ; Move text cursor to X,Y
  3771                          .vduEntryPointTableDelete
  3772  c353 ac                     !byte <.vdu127EntryPoint                            ; Delete
  3773                          
  3774                          ; ***************************************************************************************
  3775                          ;
  3776                          ; Table of addresses (high byte) to handle VDU N
  3777                          ;
  3778                          ; The previous table holds the lower byte.
  3779                          ; This table holds values for VDU 0-31 and 127.
  3780                          ;
  3781                          ; If parameters are required then the top bit is clear, (16 - number of parameters) is stored
  3782                          ; in the lower 4 bits, and the remaining three of the top four bits holds the high byte of
  3783                          ; the offset from .vduBaseAddress. We only have three bits to store the offset's high byte,
  3784                          ; so the offset must be less than $800. For this reason, VDU calls with parameters are stored
  3785                          ; near the start of the ROM.
  3786                          ;
  3787                          ; The top bit set indicates that no parameters are required, so the entry just holds the high
  3788                          ; byte of the address directly.
  3789                          ;
  3790                          ; ***************************************************************************************
  3791                          .vduEntryPointTableHigh
  3792  c354 c5                     !byte >.vdu0EntryPoint                                      ; Does nothing
  3793  c355 2f                     !byte (>(.vdu1EntryPoint - .vduBaseAddress))*16 + (16 - 1)  ; Send next character to
  3794                                                                                          ; printer only (1 parameter)
  3795  c356 c5                     !byte >.vdu2EntryPoint                                      ; Enable printer
  3796  c357 c5                     !byte >.vdu3EntryPoint                                      ; Disable printer
  3797  c358 c5                     !byte >.vdu4EntryPoint                                      ; Write text at text cursor
  3798  c359 c5                     !byte >.vdu5EntryPoint                                      ; Write text at graphics cursor
  3799  c35a c5                     !byte >.vdu6EntryPoint                                      ; Enable VDU drivers
  3800  c35b e8                     !byte >.vdu7EntryPoint                                      ; Make a short beep
  3801  c35c c5                     !byte >.vdu8EntryPoint                                      ; Move cursor left
  3802  c35d c6                     !byte >.vdu9EntryPoint                                      ; Move cursor right
  3803  c35e c6                     !byte >.vdu10EntryPoint                                     ; Move cursor down
  3804  c35f c6                     !byte >.vdu11EntryPoint                                     ; Move cursor up
  3805  c360 c7                     !byte >.vdu12EntryPoint                                     ; Clear text area
  3806  c361 c7                     !byte >.vdu13EntryPoint                                     ; Move cursor to start of
  3807                                                                                          ; current line
  3808  c362 c5                     !byte >.vdu14EntryPoint                                     ; Paged mode on
  3809  c363 c5                     !byte >.vdu15EntryPoint                                     ; Paged mode off
  3810  c364 c7                     !byte >.vdu16EntryPoint                                     ; Clear graphics window
  3811  c365 4f                     !byte (>(.vdu17EntryPoint - .vduBaseAddress))*16 + (16 - 1) ; Define text colour
  3812                                                                                          ; (1 parameter)
  3813  c366 4e                     !byte (>(.vdu18EntryPoint - .vduBaseAddress))*16 + (16 - 2) ; Define graphics colour
  3814                                                                                          ; (2 parameters)
  3815  c367 5b                     !byte (>(.vdu19EntryPoint - .vduBaseAddress))*16 + (16 - 5) ; Define palette colour
  3816                                                                                          ; (5 parameters)
  3817  c368 c8                     !byte >.vdu20EntryPoint                                     ; Restore default palette
  3818  c369 c5                     !byte >.vdu21EntryPoint                                     ; Disable VDU drivers /
  3819                                                                                          ; delete current line
  3820  c36a 5f                     !byte (>(.vdu22EntryPoint - .vduBaseAddress))*16 + (16 - 1) ; Select screen MODE
  3821                                                                                          ; (1 parameter)
  3822  c36b 57                     !byte (>(.vdu23EntryPoint - .vduBaseAddress))*16 + (16 - 9) ; Define character shape (etc)
  3823                                                                                          ; (9 parameters)
  3824  c36c 78                     !byte (>(.vdu24EntryPoint - .vduBaseAddress))*16 + (16 - 8) ; Define graphics window
  3825                                                                                          ; (8 parameters)
  3826  c36d 6b                     !byte (>(.vdu25EntryPoint - .vduBaseAddress))*16 + (16 - 5) ; PLOT (5 parameters)
  3827  c36e c9                     !byte >.vdu26EntryPoint                                     ; Restore default windows
  3828  c36f c5                     !byte >.vdu27EntryPoint                                     ; Does nothing
  3829  c370 3c                     !byte (>(.vdu28EntryPoint - .vduBaseAddress))*16 + (16 - 4) ; Define text window
  3830                                                                                          ; (4 parameters)
  3831  c371 7c                     !byte (>(.vdu29EntryPoint - .vduBaseAddress))*16 + (16 - 4) ; Define graphics origin
  3832                                                                                          ; (4 parameters)
  3833  c372 c7                     !byte >.vdu30EntryPoint                                     ; Move text cursor to top left
  3834  c373 4e                     !byte (>(.vdu31EntryPoint - .vduBaseAddress))*16 + (16 - 2) ; Move text cursor to X,Y
  3835                                                                                          ; (2 parameters)
  3836  c374 ca                     !byte >.vdu127EntryPoint                                    ; Delete
