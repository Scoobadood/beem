  1312                          .rs423IRQBitMask                            = $0278     ; (Read using OSBYTE 232)
  1313                          .systemVIAIRQBitMask                        = $0279     ; (Read using OSBYTE 233)
  1314                          .tubePresentFlag                            = $027A     ; 0 = no Tube
  1315                                                                                  ; 255 = Tube present
  1316                                                                                  ; (Read using OSBYTE 234)
  1317                          .speechSystemPresentFlag                    = $027B     ; 0 = no speech
