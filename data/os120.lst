   630                          .eventInputBufferBecomesFull                = 1         ; X = buffer number, Y = character that can't be inserted
   631                          .eventCharacterEnteringInputBuffer          = 2         ; Y = ASCII value of character
   632                          .eventADCConversionComplete                 = 3         ; Y = ADC channel number
   633                          .eventStartOfVSync                          = 4         ;
