 19228  f91d a20f                   LDX #.fsLoadAddressHigh - .fsFilename               ; X = offset to load address (high byte)
 19229  f91f 2027f9                 JSR .printFourByteAddress                           ; print 4 bytes from tape filing system block header
 19230  f922 2091f9                 JSR .printSpace                                     ; print a space
 19231  f925 a213                   LDX #.fsExecutionAddressHigh - .fsFilename          ; X = offset to execution address (high byte)
 19232                              ; fall through...
