 19570                          ;
 19571                          ; Filing System Data Errors
 19572                          ;
 19573                          ; Note that these error routines are called if the abort flag is set in the current options.
 19574                          ; If the abort flag is not set, then the routine is not called, but by manipulating the
 19575                          ; address of the routine, the message contained within is printed and execution continues
 19576                          ; after the message. See .blockNumbersMatch for an example which executes .dontAbortOnError
 19577                          ; See .dontAbortOnError.
 19578                          ;
 19579                          ; ***************************************************************************************
 19580                          .dataError
 19581  fa8e 00                     BRK                                                 ;
 19582  fa8f d8                     !byte $D8                                           ; error number
 19583  fa90 0d446174613f           !text .charRETURN, "Data?"                          ; message
 19584  fa96 00                     !byte 0                                             ; terminator
 19585  fa97 d015                   BNE .postFileError                                  ; ALWAYs branch
 19586                          
 19587                          .fileError
 19588  fa99 00                     BRK                                                 ;
 19589  fa9a db                     !byte $DB                                           ; error number
 19590  fa9b 0d46696c653f           !text .charRETURN, "File?"                          ; message
 19591  faa1 00                     !byte 0                                             ; terminator
 19592  faa2 d00a                   BNE .postFileError                                  ; ALWAYs branch
 19593                          
 19594                          .blockError
 19595  faa4 00                     BRK                                                 ;
 19596  faa5 da                     !byte $DA                                           ; error number
 19597  faa6 0d426c6f636b3f         !text .charRETURN, "Block?"                         ; message
 19598  faad 00                     !byte 0                                             ; terminator
 19599                              ; fall through...
 19600                          
 19601                          ; ***************************************************************************************
 19602                          .postFileError
 19603  faae a5ba                   LDA .currentBlockHasDataErrorFlag                   ; get current block flag
 19604  fab0 f021                   BEQ .skipRewindTapeMessage                          ; if (zero) then branch
 19605  fab2 8a                     TXA                                                 ; A=X
 19606  fab3 f01e                   BEQ .skipRewindTapeMessage                          ; if (X == 0) then branch (no retry)
 19607  fab5 a922                   LDA #%00100010                                      ; A=$22
 19608  fab7 24bb                   BIT .tapeCurrentOptionsByte                         ; check current options
 19609  fab9 f018                   BEQ .skipRewindTapeMessage                          ; if (not retry) then branch (no retry)
 19610                          
 19611                              ; rewind tape
 19612  fabb 2046fb                 JSR .resetACIA                                      ; reset ACIA
 19613  fabe a8                     TAY                                                 ; Y=A
 19614  fabf 204afa                 JSR .printFollowingMessage                          ; print following message
 19615  fac2 0d                     !byte .charRETURN                                   ; Carriage Return
 19616  fac3 07                     !byte .charBELL                                     ; Beep
 19617  fac4 526577696e642074...    !text "Rewind tape"                                 ; Message
 19618  facf 0d0d                   !byte .charRETURN, .charRETURN                      ; Carriage Return, Carriage Return
 19619  fad1 00                     !byte 0                                             ; terminator
 19620                          .exit35
 19621  fad2 60                     RTS                                                 ;
 19622                          
