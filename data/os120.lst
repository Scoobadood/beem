 18946                          ; ***************************************************************************************
 18947                          ;
 18948                          ; Save a block to tape
 18949                          ;
 18950                          ; When saving to tape, we record a five second delay before the first block, then a delay
 18951                          ; specified by the interblock gap for all subsequent blocks. After all blocks are recorded
 18952                          ; there is a further five second delay.
 18953                          ;
 18954                          ; ***************************************************************************************
 18955                          .saveABlockToTape
 18956  f7ec 08                     PHP                                                 ; save flags on stack
 18957  f7ed a203                   LDX #3                                              ; X=loop counter
 18958  f7ef a900                   LDA #0                                              ; A=value to store
 18959                          -
 18960  f7f1 9dcb03                 STA .fsSpareByteA,X                                 ; clear the four spare bytes of file system block
 18961  f7f4 ca                     DEX                                                 ; X=X-1
 18962  f7f5 10fa                   BPL -                                               ;
 18963                          
 18964  f7f7 adc603                 LDA .fsBlockNumberLow                               ; block number
 18965  f7fa 0dc703                 ORA .fsBlockNumberHigh                              ; block number high
 18966  f7fd d005                   BNE .waitForInterblockGap                           ; if (block number is not zero) then branch
 18967  f7ff 2092f8                 JSR .waitFiveSeconds                                ; generate a 5 second delay
 18968  f802 f003                   BEQ +                                               ; ALWAYS branch
 18969                          
 18970                          .waitForInterblockGap
 18971  f804 2096f8                 JSR .generateInterBlockGapDelay                     ; generate delay set by interblock gap
 18972                          
 18973                              ; initialise and save value $2A to tape
 18974                          +
 18975  f807 a92a                   LDA #.fsSynchronisationByte                         ; A=synchronisation byte (byte to save to tape)
 18976  f809 85bd                   STA .fsCharacterJustReadOrCharToWrite               ; store character to write
 18977  f80b 2078fb                 JSR .zeroChecksumAndFSFlag                          ; initialise checksum and file system buffer flag
 18978  f80e 204afb                 JSR .activateRequestToSend                          ; request send to tape
 18979  f811 2084f8                 JSR .waitForByteToReadOrWrite                       ; wait for byte to be saved to tape
 18980  f814 88                     DEY                                                 ; Y=Y-1
 18981                          
 18982                              ; save filename
 18983                          -
 18984  f815 c8                     INY                                                 ; Y=Y+1
 18985  f816 b9d203                 LDA .filenameToSearchFor,Y                          ; move sought filename
 18986  f819 99b203                 STA .fsFilename,Y                                   ; into filename block
 18987  f81c 2075f8                 JSR .saveByteAToTapeAndUpdateCRC                    ; transfer byte to tape filing system and do CRC
 18988  f81f d0f4                   BNE -                                               ; if (filename not yet complete) then branch (do it again)
 18989                          
 18990                              ; save rest of header:
 18991                              ;   load address      (4 bytes)
 18992                              ;   execution address (4 bytes)
 18993                              ;   block number      (2 bytes)
 18994                              ;   block length      (2 bytes)
 18995                              ;   block flag byte   (1 byte)
 18996                              ;   spare bytes       (4 bytes)
 18997  f821 a20c                   LDX #.fsLoadAddressLow - .fsFilename                ; X=offset to load address
 18998                          -
 18999  f823 bdb203                 LDA .fsFilename,X                                   ; get filename byte
 19000  f826 2075f8                 JSR .saveByteAToTapeAndUpdateCRC                    ; transfer byte to tape filing system and do CRC
 19001  f829 e8                     INX                                                 ; X=X+1
 19002  f82a e01d                   CPX #.fsChecksumLow - .fsFilename                   ; until X reaches the end of the header block (just before the start of the two checksum bytes)
 19003  f82c d0f5                   BNE -                                               ;
 19004                          
 19005  f82e 207bf8                 JSR .saveChecksumToTape                             ; save checksum to TAPE reset buffer flag
 19006  f831 adc803                 LDA .fsBlockLengthLow                               ; block length
 19007  f834 0dc903                 ORA .fsBlockLengthHigh                              ; block length high
 19008  f837 f01c                   BEQ .saveFinalTwoBytes                              ; if (block length is zero) then branch
 19009                          
 19010  f839 a000                   LDY #0                                              ; Y=0
 19011  f83b 207cfb                 JSR .setChecksumBytesToY                            ; zero checksum bytes
 19012                          
 19013                          -
 19014  f83e b1b0                   LDA (.tapeSaveStartAddressLow),Y                    ; get a data byte to save
 19015  f840 20d3fb                 JSR .checkLoadAddressIsForSecondProcessor           ; check if load address is from second processor
 19016  f843 f003                   BEQ +                                               ; if (not from second processor) then branch
 19017  f845 aee5fe                 LDX .tubeULADataRegister3                           ; read byte from second processor
 19018                          +
 19019  f848 8a                     TXA                                                 ; A=X
 19020  f849 2075f8                 JSR .saveByteAToTapeAndUpdateCRC                    ; transfer byte to tape filing system and do CRC
 19021  f84c c8                     INY                                                 ; Y=Y+1
 19022  f84d ccc803                 CPY .fsBlockLengthLow                               ; check block length
 19023  f850 d0ec                   BNE -                                               ; if (block not done yet) then branch (loop back)
 19024                          
 19025  f852 207bf8                 JSR .saveChecksumToTape                             ; save checksum to TAPE
 19026                          
 19027                          .saveFinalTwoBytes
 19028  f855 2084f8                 JSR .waitForByteToReadOrWrite                       ; save byte
 19029  f858 2084f8                 JSR .waitForByteToReadOrWrite                       ; save byte
 19030  f85b 2046fb                 JSR .resetACIA                                      ; reset ACIA
 19031                          
 19032  f85e a901                   LDA #1                                              ; A=1
 19033  f860 2098f8                 JSR .generateDelay                                  ; generate 0.1 second delay
 19034  f863 28                     PLP                                                 ; get back flags
 19035  f864 20b9f8                 JSR .updateBlockFlagAndDisplayProgress              ; update block flag, PRINT filename (and address if reqd)
 19036  f867 2cca03                 BIT .fsBlockFlagByte                                ; block flag
 19037  f86a 1008                   BPL +                                               ; if (this is NOT last block) then branch
 19038  f86c 08                     PHP                                                 ; save flags on stack
 19039  f86d 2092f8                 JSR .waitFiveSeconds                                ; generate a 5 second delay
 19040  f870 2046f2                 JSR .beepCancelAndPrintReturn                       ; sound bell and cancel
 19041  f873 28                     PLP                                                 ; get back flags
 19042                          +
 19043  f874 60                     RTS                                                 ;
