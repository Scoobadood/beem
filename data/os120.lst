   565                          ; ***************************************************************************************
   566                          ;
   567                          ; Internal key codes
   568                          ;
   569                          ; The internal key code for the space bar is inserted into the first key pressed
   570                          ; (.firstKeyPressedInternal) on RESET. Otherwise, for example if SHIFT remained in the
   571                          ; 'first key pressed' after a RESET then the next key press might be misinterpreted as a
   572                          ; SHIFTed character.
   573                          ;
   574                          ; In general the internal key codes are converted to ASCII style codes using a table lookup,
   575                          ; see .getASCIICode
   576                          ;
   577                          ; ***************************************************************************************
   578                          .internalKeyNumberSPACEBAR                  = $62       ;
   579                          
   580                          ; ***************************************************************************************
   581                          ;
   582                          ; Buffer numbers
   583                          ;
   584                          ; See NAUG Section 9, Page 136
   585                          ;
   586                          ;                                Address         Empty     Start      End
   587                          ;         Buffer number          Range           Flag      pointer    pointer   Size
   588                          ;         --------------------------------------------------------------------------------
   589                          ;         0 = Keyboard           $03E0-$03FF     $02CF     $02D8      $02E1       32 bytes
   590                          ;         1 = RS-423 Input       $0A00-$0AFF     $02D0     $02D9      $02E2      256 bytes
   591                          ;         2 = RS-423 Output      $0900-$09BF     $02D1     $02DA      $02E3      192 bytes
   592                          ;         3 = Printer            $0880-$08BF     $02D2     $02DB      $02E4       64 bytes
   593                          ;         4 = Sound Channel 0    $0840-$084F     $02D3     $02DC      $02E5       16 bytes
   594                          ;         5 = Sound Channel 1    $0850-$085F     $02D4     $02DD      $02E6       16 bytes
   595                          ;         6 = Sound Channel 2    $0860-$086F     $02D5     $02DE      $02E7       16 bytes
   596                          ;         7 = Sound Channel 3    $0870-$087F     $02D6     $02DF      $02E8       16 bytes
   597                          ;         8 = Speech             $08C0-$08FF     $02D7     $02E0      $02E9       64 bytes
   598                          ;
   599                          ; ***************************************************************************************
   600                          .bufferNumberKeyboard                       = 0         ;
   601                          .bufferNumberRS423Input                     = 1         ;
   602                          .bufferNumberRS423Output                    = 2         ;
   603                          .bufferNumberPrinter                        = 3         ;
   604                          .bufferNumberSound0                         = 4         ; Noise channel
   605                          .bufferNumberSound1                         = 5         ;
   606                          .bufferNumberSound2                         = 6         ;
   607                          .bufferNumberSound3                         = 7         ;
   608                          .bufferNumberSpeech                         = 8         ;
   609                          .bufferNumberHighest                        = 8         ;
   610                          
   611                          ; Buffer offsets. When we add the buffer length it sums to 256.
   612                          .keyboardInputBufferOffset                  = 256 - 32  ;  32 bytes
   613                          .tapeOrRS423InputBufferOffset               = 256 - 256 ; 256 bytes
   614                          .rs423OutputBufferOffset                    = 256 - 192 ; 192 bytes
   615                          .printerBufferOffset                        = 256 - 64  ;  64 bytes
   616                          .soundChannel0BufferOffset                  = 256 - 16  ;  16 bytes
   617                          .soundChannel1BufferOffset                  = 256 - 16  ;  16 bytes
   618                          .soundChannel2BufferOffset                  = 256 - 16  ;  16 bytes
   619                          .soundChannel3BufferOffset                  = 256 - 16  ;  16 bytes
   620                          .speechBufferOffset                         = 256 - 64  ;  64 bytes
   621                          
