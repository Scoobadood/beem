 11954  e0eb 9003                   BCC +                                               ; buffer is not empty, jump to send character
 11955  e0ed 2070e1                 JSR .clearBusyFlagAndSetRS423Active                 ; set RS-423 Active
 11956                          +
 11957  e0f0 68                     PLA                                                 ; get character
 11958  e0f1 a202                   LDX #.bufferNumberRS423Output                       ; X=RS-423 output buffer
 11959  e0f3 20f8e1                 JSR .addByteToBuffer                                ; send character to RS-423 output buffer
 11960  e0f6 28                     PLP                                                 ; restore IRQs
 11961                          
 11962                          .skipRS423Output
