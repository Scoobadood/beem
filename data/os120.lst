  9637                          ; ***************************************************************************************
  9638                          
  9639  d976 9001                   !word .mosVariablesMinus166   ; MOS variables address (add OSBYTE number)     $0236-7   *FX 166/7
  9640  d978 9f0d                   !word .extendedVectorSpace    ; Address of ROM pointer table                  $0238-9   *FX 168/9
  9641  d97a a102                   !word .romTypeTable           ; ROM information table address                 $023A-B   *FX 170/1
  9642  d97c 2bf0                   !word .keyDataTable1 - 16     ; Key translation table address                 $023C-D   *FX 172/3
  9643  d97e 0003                   !word .vduVariablesStart      ; VDU variables start                           $023E-F   *FX 174/5
  9644  d980 00                     !byte 0                       ; vertical sync counter                         $0240     *FX 176
  9645  d981 00                     !byte 0                       ; current input buffer number                   $0241     *FX 177
  9646  d982 ff                     !byte $FF                     ; keyboard interrupt enable flag ($FF=enabled)  $0242     *FX 178
  9647  d983 00                     !byte 0                       ; primary OSHWM (default PAGE)                  $0243     *FX 179
  9648  d984 00                     !byte 0                       ; current OSHWM (PAGE)                          $0244     *FX 180
  9649  d985 01                     !byte 1                       ; RS-423 Mode                                   $0245     *FX 181
  9650  d986 00                     !byte 0                       ; character definition explosion state          $0246     *FX 182
  9651  d987 00                     !byte 0                       ; Filing system flag ROM=2; tape=0              $0247     *FX 183
  9652  d988 00                     !byte 0                       ; current Video ULA control register            $0248     *FX 184
  9653  d989 00                     !byte 0                       ; current palette setting                       $0249     *FX 185
  9654  d98a 00                     !byte 0                       ; number of ROM enabled at last BRK             $024A     *FX 186
  9655  d98b ff                     !byte $FF                     ; number of BASIC ROM                           $024B     *FX 187
  9656  d98c 04                     !byte 4                       ; current ADC channel number                    $024C     *FX 188
  9657  d98d 04                     !byte 4                       ; maximum ADC channel number                    $024D     *FX 189
  9658  d98e 00                     !byte 0                       ; ADC conversion type: 0 or $0C=12 bit; 8=8 Bit $024E     *FX 190
  9659  d98f ff                     !byte $FF                     ; RS-423 busy flag (bit 7 clear=busy)           $024F     *FX 191
  9660  d990 56                     !byte $56                     ; curent ACIA control register setting          $0250     *FX 192
  9661  d991 19                     !byte $19                     ; flash counter                                 $0251     *FX 193
  9662  d992 19                     !byte $19                     ; mark period count                             $0252     *FX 194
  9663  d993 19                     !byte $19                     ; space period count                            $0253     *FX 195
  9664  d994 32                     !byte 50                      ; keyboard Auto-repeat delay                    $0254     *FX 196
  9665  d995 08                     !byte 8                       ; keyboard Auto-repeat rate                     $0255     *FX 197
  9666  d996 00                     !byte 0                       ; *EXEC file handle  (0 -not allocated)         $0256     *FX 198
  9667  d997 00                     !byte 0                       ; *SPOOL file handle (0 -not allocated)         $0257     *FX 199
  9668  d998 00                     !byte 0                       ; bit 0 Escape enable/disable                   $0258     *FX 200
  9669                                                            ; bit 1 BREAK normal/clear memory
  9670  d999 00                     !byte 0                       ; Econet disable keyboard flag                  $0259     *FX 201
  9671  d99a 20                     !byte %00100000               ; keyboard status    bit 3=1 SHIFT pressed      $025A     *FX 202
  9672                                                            ;                    bit 4=0 CAPS LOCK
  9673                                                            ;                    bit 5=0 SHIFT LOCK
  9674                                                            ;                    bit 6=1 CTRL pressed
  9675                                                            ;                    bit 7=1 SHIFT enabled
  9676  d99b 09                     !byte 9                       ; buffer space left at buffer full signal       $025B     *FX 203
  9677  d99c 00                     !byte 0                       ; RS-423 input suppression flag                 $025C     *FX 204
  9678  d99d 00                     !byte 0                       ; cassette/RS-423 flag (0=tape, $40=RS-423)     $025D     *FX 205
  9679  d99e 00                     !byte 0                       ; Econet OS call interception flag (bit 7)      $025E     *FX 206
  9680  d99f 00                     !byte 0                       ; Econet OSRDCH interception flag (bit 7)       $025F     *FX 207
  9681  d9a0 00                     !byte 0                       ; Econet OSWRCH interception flag (bit 7)       $0260     *FX 208
  9682  d9a1 50                     !byte $50                     ; speech enable/disable flag ($50/$20)          $0261     *FX 209
  9683  d9a2 00                     !byte 0                       ; sound output disable flag                     $0262     *FX 210
  9684  d9a3 03                     !byte 3                       ; BELL channel number                           $0263     *FX 211
  9685  d9a4 90                     !byte $90                     ; BELL amplitude (or envelope number)           $0264     *FX 212
  9686  d9a5 64                     !byte 100                     ; BELL pitch (approx Treble C, 523.013Hz)       $0265     *FX 213
  9687  d9a6 06                     !byte 6                       ; BELL duration (in 20ths of a second)          $0266     *FX 214
  9688  d9a7 81                     !byte $81                     ; bit 7=0 ignore start up message               $0267     *FX 215
  9689                                                            ; bit 0=1 lock up if !BOOT error from *disc* and no language set
  9690  d9a8 00                     !byte 0                       ; length of KEY string                          $0268     *FX 216
  9691  d9a9 00                     !byte 0                       ; PRINT line counter                            $0269     *FX 217
  9692  d9aa 00                     !byte 0                       ; 2s compliment of number of items in VDU queue $026A     *FX 218
  9693  d9ab 09                     !byte 9                       ; TAB key value                                 $026B     *FX 219
  9694  d9ac 1b                     !byte $1B                     ; ESCAPE Character                              $026C     *FX 220
  9695                          
  9696                              ; The following four bytes are how characters are interpreted when placed into an input buffer
  9697                          
  9698  d9ad 01                     !byte $01                     ; C0-CF                                         $026D     *FX 221
  9699  d9ae d0                     !byte $D0                     ; D0-DF                                         $026E     *FX 222
  9700  d9af e0                     !byte $E0                     ; E0-EF                                         $026F     *FX 223
  9701  d9b0 f0                     !byte $F0                     ; F0-FF                                         $0270     *FX 224
  9702                          
  9703                              ; The next four bytes are the key status (soft key or codes) for:
  9704                              ;
  9705                              ;            function key
  9706                              ;      SHIFT-function key
  9707                              ;       CTRL-function key
  9708                              ; CTRL-SHIFT-function key
  9709                              ;
  9710                              ; 0 means ignore key
  9711                              ; 1 means expand as the normal soft key number
  9712                              ; 2-$FF means expand as the normal soft key number + this value
  9713                          
  9714  d9b1 01                     !byte $01                     ; 80-8F                                         $0271     *FX 225
  9715  d9b2 80                     !byte $80                     ; 90-9F                                         $0272     *FX 226
  9716  d9b3 90                     !byte $90                     ; A0-AF                                         $0273     *FX 227
  9717  d9b4 00                     !byte $00                     ; B0-BF                                         $0274     *FX 228
  9718                          
  9719  d9b5 00                     !byte $00                     ; ESCAPE key status (0=ESC, 1=ASCII)            $0275     *FX 229
  9720  d9b6 00                     !byte $00                     ; ESCAPE action                                 $0276     *FX 230
  9721                          .allBitsSet
  9722  d9b7 ff                     !byte $FF                     ; User VIA 6522 Bit IRQ mask                    $0277     *FX 231
  9723  d9b8 ff                     !byte $FF                     ; ACIA 6850 Bit IRQ bit mask                    $0278     *FX 232
  9724  d9b9 ff                     !byte $FF                     ; System VIA 6522 IRQ bit mask                  $0279     *FX 233
  9725  d9ba 00                     !byte $00                     ; Tube presence flag                            $027A     *FX 234
  9726  d9bb 00                     !byte $00                     ; speech processor presence flag                $027B     *FX 235
  9727  d9bc 00                     !byte $00                     ; character destination status                  $027C     *FX 236
  9728  d9bd 00                     !byte $00                     ; cursor editing state                          $027D     *FX 237
  9729                          
  9730                          .softResetHWM
  9731                          ; ************************* SOFT reset high water mark **********************************
  9732                          
  9733  d9be 00                     !byte $00                     ; unused                                        $027E     *FX 238
  9734  d9bf 00                     !byte $00                     ; unused                                        $027F     *FX 239
  9735  d9c0 00                     !byte $00                     ; country code (0=UK,1=US)                      $0280     *FX 240
  9736  d9c1 00                     !byte $00                     ; user flag                                     $0281     *FX 241
  9737  d9c2 64                     !byte $64                     ; serial ULA control register setting           $0282     *FX 242
  9738  d9c3 05                     !byte $05                     ; current system clock store pointer            $0283     *FX 243
  9739  d9c4 ff                     !byte $FF                     ; soft key status (inconsistent)                $0284     *FX 244
  9740  d9c5 01                     !byte $01                     ; printer destination (parallel printer)        $0285     *FX 245
  9741  d9c6 0a                     !byte 10                      ; printer ignore character (line feed)          $0286     *FX 246
  9742                          
  9743                          .hardResetHWM
  9744                          ; ************************* HARD reset high water mark **********************************
  9745                          
  9746  d9c7 00                     !byte $00                     ; user BREAK routine address JMP                $0287     *FX 247
  9747  d9c8 00                     !byte $00                     ; user BREAK routine address low                $0288     *FX 248
  9748  d9c9 00                     !byte $00                     ; user BREAK routine address high               $0289     *FX 249
  9749  d9ca 00                     !byte $00                     ; unused                                        $028A     *FX 250
  9750  d9cb 00                     !byte $00                     ; unused                                        $028B     *FX 251
  9751  d9cc ff                     !byte $FF                     ; current language ROM number                   $028C     *FX 252
  9752                          
  9753                          .powerOnResetHWM
  9754                          ; ********************** RESET High Water mark for Power on *****************************
  9755                          
  9756                          ; ***************************************************************************************
  9757                          ;
  9758                          ; Reset entry point
  9759                          ;
  9760                          ; Called on:
  9761                          ;       * Power on
  9762                          ;       * when a HARD BREAK occurs      (CTRL BREAK keys)
  9763                          ;       * when a SOFT BREAK occurs      (BREAK key)
  9764                          ;
  9765                          ; On Entry:
  9766                          ;       On power on: 6522 System VIA IER bits 0 to 6 will all be clear
  9767                          ;       On BREAK   : 6522 System VIA IER bits 0 to 6 at least one bit will be set
  9768                          ;
  9769                          ; This code runs through a list of steps:
  9770                          ;
  9771                          ;     * Store an RTI instruction at $0D00 (to stop executing any more NMI routines)
  9772                          ;     * Disable interrupts (stop executing any more IRQs)
  9773                          ;     * Clear decimal flag (decimal mode is never used within the OS. IRQ interrupts turn
  9774                          ;       it off while they run. Decimal mode must be off before calling any OS routine)
  9775                          ;     * Reset the stack pointer
  9776                          ;     * Clear RAM if needed (also detect amount of RAM present, either 16k or 32k, and
  9777                          ;       record this)
  9778                          ;     * Initialise System VIA registers
  9779                          ;     * Read keyboard
  9780                          ;     * Initialise OS vectors and variables ($0200 upwards, amount depending on type of
  9781                          ;       reset)
  9782                          ;     * Initialise JIM (which gives access to an optional 64k or more of Paged Memory)
  9783                          ;     * Enable some interrupts
  9784                          ;     * Clear sounds
  9785                          ;     * Initialise ROMs
  9786                          ;     * Initialise speech system if present
  9787                          ;     * Clear the screen
  9788                          ;     * Insert F10 key code into keyboard buffer if needed (implements effect of *KEY 10)
  9789                          ;     * Execute user boot code if present
  9790                          ;     * Set cassette options
  9791                          ;     * Initialise Tube
  9792                          ;     * Initialise ROMs (post Tube initialisation)
  9793                          ;     * Show 'BBC Computer 32K' message (or "16K", or no memory number on a SOFT BREAK)
  9794                          ;     * Initialise keyboard LEDs
  9795                          ;     * Select Filing System ROM
  9796                          ;     * Execute !BOOT if needed
  9797                          ;     * Find best language to enter, and enter it
  9798                          ;
  9799                          ; ***************************************************************************************
  9800                          .resetEntryPoint
  9801  d9cd a940                   LDA #$40                                            ; the numerical value of the RTI opcode
  9802  d9cf 8d000d                 STA .nmiEntryPoint                                  ; store RTI instruction at the start of the NMI routine
  9803                          
  9804  d9d2 78                     SEI                                                 ; disable interrupts just in case
  9805  d9d3 d8                     CLD                                                 ; clear decimal flag
  9806  d9d4 a2ff                   LDX #$FF                                            ; reset stack to where it should be
  9807  d9d6 9a                     TXS                                                 ; ($01FF)
  9808  d9d7 ad4efe                 LDA .systemVIAInterruptEnableRegister               ; read interupt enable register of the system VIA
  9809  d9da 0a                     ASL                                                 ; shift bit 7 (reading IER always returns 1 in bit 7) into carry
  9810  d9db 48                     PHA                                                 ; save what's left (for use later when setting page 2: just before .setUpPage2)
  9811  d9dc f009                   BEQ .clearRAM                                       ; if (power on) then branch
  9812  d9de ad5802                 LDA .escapeAndBreakEffect                           ; read BREAK Action flags (set by *FX200,n)
  9813  d9e1 4a                     LSR                                                 ; divide by 2 to get the break action
  9814  d9e2 c901                   CMP #1                                              ;
  9815  d9e4 d01d                   BNE .setUpSystemVIA                                 ; if (break action says we don't need to clear RAM) then branch
  9816  d9e6 4a                     LSR                                                 ; set A=0 (since A=1 at this point)
  9817                              ; fall through...
  9818                          
  9819                          ; ***************************************************************************************
  9820                          ; Clears all of RAM except the first byte in each Page. This avoids overwriting the RTI instruction at $0D00.
  9821                          .clearRAM
  9822  d9e7 a204                   LDX #4                                              ; start clearing memory from page 4 ($0400)
  9823  d9e9 8601                   STX $01                                             ; store a non-zero number at $01
  9824  d9eb 8500                   STA $00                                             ; store A (currently zero) at $00
  9825                          
  9826  d9ed a8                     TAY                                                 ; and set Y (loop counter) to zero
  9827                          -
  9828  d9ee 9100                   STA ($00),Y                                         ; clear RAM
  9829  d9f0 c501                   CMP $01                                             ; check high byte of address
  9830  d9f2 f009                   BEQ +                                               ; if (zero) then branch:
  9831                          
  9832                              ; This happens when we clear byte $4001 on a 16k machine the RAM memory addressing loops
  9833                              ; it around to write a zero into $0001. We are done at this point and branch out to avoid
  9834                              ; overwriting the rest of zero page.
  9835                          
  9836  d9f4 c8                     INY                                                 ; increment loop counter
  9837  d9f5 d0f7                   BNE -                                               ; if (not zero) then branch (loop back)
  9838  d9f7 c8                     INY                                                 ; increment again (Y=1) this avoids overwriting RTI instruction at $D00
  9839  d9f8 e8                     INX                                                 ; increment X
  9840  d9f9 e601                   INC $01                                             ; increment high byte of address
  9841  d9fb 10f1                   BPL -                                               ; loop until A=$80 then exit
  9842                          
  9843                          +
  9844  d9fd 8e8e02                 STX .systemAvailableRAM                             ; writes marker for available RAM ($40=16k; $80=32k)
  9845  da00 8e8402                 STX .softKeyConsistencyFlag                         ; write non-zero value in soft key consistency flag
  9846                              ; fall through...
  9847                          
  9848                          ; ***************************************************************************************
  9849                          .setUpSystemVIA
  9850  da03 a20f                   LDX #%00001111                                      ; set System VIA PORT B to output on bits 0-3; input on bits 4-7
  9851  da05 8e42fe                 STX .systemVIADataDirectionRegisterB                ;
  9852                          
  9853                          ; The next loop writes 14, 13, 12, 11, 10, 9, 8 in turn to System VIA Register B which:
  9854                          ;       - turns CAPS LOCK off;
  9855                          ;       - sets the hardware scroll address to $3000;
  9856                          ;       - enables keyboard auto scanning;
  9857                          ;       - enable read/write speech;
  9858                          ;       - disable sound;
  9859                          ;
  9860                          ; (See .systemVIARegisterB)
  9861                          -
  9862  da08 ca                     DEX                                                 ; loop counter
  9863  da09 8e40fe                 STX .systemVIARegisterB                             ; write system VIA register B
  9864  da0c e009                   CPX #9                                              ;
  9865  da0e b0f8                   BCS -                                               ; if (X>=9) then branch (loop back and do it again)
  9866                              ; fall through...
  9867                          
  9868                          ; ***************************************************************************************
  9869                          ;
  9870                          ; Read the keyboard 8 times with internal key numbers 9-1
  9871                          ;
  9872                          ; This reads the state of the CTRL key and the 'keyboard links', a set of DIP switches next
  9873                          ; to the keyboard. See .scanKeyboard for internal key numbers.
  9874                          ;
  9875                          ; These are rotated into the 8 bits of .interruptAccumulator for further processing
  9876                          ;
  9877                          ; ***************************************************************************************
  9878  da10 e8                     INX                                                 ; X=9 (loop counter)
  9879                          -
  9880  da11 8a                     TXA                                                 ; Start of loop to interrogate keyboard
  9881  da12 202af0                 JSR .interrogateKeyboard                            ; with A = 9...1 which reads keyboard links 9-2 and CTRL key
  9882  da15 e080                   CPX #$80                                            ; set carry if the 'key' or 'link' is 'pressed' or 'set'
  9883  da17 66fc                   ROR .interruptAccumulator                           ; rotate carry into MSB into bit 7 of .interruptAccumulator
  9884  da19 aa                     TAX                                                 ; get back value of X for loop
  9885  da1a ca                     DEX                                                 ; decrement it
  9886  da1b d0f4                   BNE -                                               ; if (not zero) then branch (do loop again)
  9887                          
  9888                              ; At this point Carry(C) and .interruptAccumulator holds:
  9889                              ; C = }
  9890                              ; 0 = } screen MODE on startup
  9891                              ; 1 = }
  9892                              ; 2 = if clear reverse SHIFT BREAK action
  9893                              ; 3 = }
  9894                              ; 4 = } set disc drive timings
  9895                              ; 5 = not used
  9896                              ; 6 = not used
  9897                              ; 7 = CTRL key
  9898                          
  9899  da1d 8e8d02                 STX .lastResetType                                  ; set last reset type = 0
  9900  da20 26fc                   ROL .interruptAccumulator                           ;
  9901                          
  9902                              ; At this point .interruptAccumulator holds keyboard links:
  9903                              ; 0 = }
  9904                              ; 1 = } screen MODE on startup
  9905                              ; 2 = }
  9906                              ; 3 = if clear reverse SHIFT BREAK action
  9907                              ; 4 = }
  9908                              ; 5 = } set disc drive timings
  9909                              ; 6 = not used
  9910                              ; 7 = not used
  9911                              ; C = CTRL key
  9912                          
  9913                              ; fall through...
  9914                          
  9915                          ; ***************************************************************************************
  9916                          ;
  9917                          ; Initialise keyboard lights, Work out what variables to reset
  9918                          ;
  9919                          ; ***************************************************************************************
  9920  da22 20ebee                 JSR .keyboardIndicators                             ; set LEDs. carry flag (CTRL key) is put into bit zero of A
  9921  da25 6a                     ROR                                                 ; put bit zero of A (CTRL key) into carry flag
  9922                          
  9923                              ; set up page 2 based on reset type
  9924  da26 a29c                   LDX #<.softResetLWM                                 ; X = low water mark for setting OS variables (writes to range $200+X -> $2FF)
  9925  da28 a08d                   LDY #.powerOnResetHWM - .defaultVectorTable         ; Y = high water mark for writing default values into OS variables (writes to range $200+Y -> $0200)
  9926  da2a 68                     PLA                                                 ; get back A (which is .systemVIAInterruptEnableRegister shifted left once)
  9927  da2b f009                   BEQ +                                               ; if (A=0) then branch (power on reset, with X=$9C Y=$8D)
  9928  da2d a07e                   LDY #.softResetHWM - .defaultVectorTable            ; set value for soft reset HWM
  9929  da2f 9011                   BCC .setUpPage2                                     ; if (soft reset) then branch
  9930  da31 a087                   LDY #.hardResetHWM - .defaultVectorTable            ; hard reset
  9931  da33 ee8d02                 INC .lastResetType                                  ; reset type=1
  9932                          +
  9933  da36 ee8d02                 INC .lastResetType                                  ; 'power on' or hard reset
  9934  da39 a5fc                   LDA .interruptAccumulator                           ; get keyboard links set
  9935  da3b 49ff                   EOR #%11111111                                      ; invert all bits
  9936  da3d 8d8f02                 STA .startUpOptions                                 ; and record as start up options
  9937  da40 a290                   LDX #<.hardResetLWM                                 ;
  9938                              ; fall through...
  9939                          
  9940                          ; ***************************************************************************************
  9941                          ;
  9942                          ; Reset OS Variables
  9943                          ;
  9944                          ; On Entry:
  9945                          ;       .lastResetType is reset type:
  9946                          ;
  9947                          ;        0    Soft reset    X=<.softResetLWM    Y=.softResetHWM    - .defaultVectorTable
  9948                          ;        1    Power on      X=<.hardResetLWM    Y=.powerOnResetHWM - .defaultVectorTable
  9949                          ;        2    Hard reset    X=<.hardResetLWM    Y=.hardResetHWM    - .defaultVectorTable
  9950                          ;
  9951                          ;   - Set variables at $200+X and up to zero or 255
  9952                          ;   - Copy default values for variables into $0200+Y-1 and below from .defaultVectorTable
  9953                          ;
  9954                          ; ***************************************************************************************
  9955                          .setUpPage2
  9956  da42 a900                   LDA #0                                              ; A=0
  9957                          -
  9958  da44 e0ce                   CPX #$CE                                            ; this loop writes zero into the addresses in range $0290/C to $02CD...
  9959  da46 9002                   BCC +                                               ;
  9960  da48 a9ff                   LDA #$FF                                            ; ... and writes 255 into addresses in range $02CE to $02FF
  9961                          +
  9962  da4a 9d0002                 STA .page2Start,X                                   ;
  9963  da4d e8                     INX                                                 ;
  9964  da4e d0f4                   BNE -                                               ;
  9965                                                                                  ; At this point A=$FF and X=0
  9966  da50 8d63fe                 STA .userVIADataDirectionRegisterA                  ; set port A of user VIA to all outputs (printer out)
  9967  da53 8a                     TXA                                                 ; A=0
  9968  da54 a2e2                   LDX #$E2                                            ; loop counter
  9969                          -
  9970  da56 9500                   STA $00,X                                           ; }
  9971  da58 e8                     INX                                                 ; } this loop stores zero in zero-page memory locations $E2 to $FF
  9972  da59 d0fb                   BNE -                                               ; }
  9973                              ; fall through...
  9974                          
  9975                          ; ***************************************************************************************
  9976                          ;
  9977                          ; Copy the default vectors and MOS variables
  9978                          ;
  9979                          ; Y is the loop counter (set up above, depending on boot type).
  9980                          ; ***************************************************************************************
  9981                          -
  9982  da5b b93fd9                 LDA .defaultVectorTable - 1,Y                       ; read data from default table+Y
  9983  da5e 99ff01                 STA .page2Start - 1,Y                               ; write data to $0200+Y
  9984  da61 88                     DEY                                                 ; decrement loop counter
  9985  da62 d0f7                   BNE -                                               ; branch back
  9986                              ; fall through...
  9987                          
  9988                          ; ***************************************************************************************
  9989                          ;
  9990                          ; Put a SPACE in the first key pressed variable
  9991                          ;
  9992                          ; ***************************************************************************************
  9993  da64 a962                   LDA #.internalKeyNumberSPACEBAR                     ; }
  9994  da66 85ed                   STA .firstKeyPressedInternal                        ; } store SPACE in .firstKeyPressedInternal
  9995  da68 200afb                 JSR .setupACIA                                      ; set up ACIA
  9996                                                                                  ; X=0
  9997                              ; fall through...
  9998                          
  9999                          ; ***************************************************************************************
 10000                          ;
 10001                          ; Set system and user VIA registers
 10002                          ;
 10003                          ; ***************************************************************************************
 10004  da6b a97f                   LDA #$7F                                            ; Disable interrupts (top bit clear and all others set means disable all interrupts)
 10005  da6d e8                     INX                                                 ; X=1
 10006                          -
 10007  da6e 9d4dfe                 STA .systemVIAInterruptFlagRegister,X               ; Set .systemVIAInterruptEnableRegister and .systemVIAInterruptFlagRegister
 10008  da71 9d6dfe                 STA .userVIAInterruptFlagRegister,X                 ; Set   .userVIAInterruptEnableRegister and   .userVIAInterruptFlagRegister
 10009  da74 ca                     DEX                                                 ; X--
 10010  da75 10f7                   BPL -                                               ; loop back if X >= 0
 10011                              ; fall through...
 10012                          
 10013                          ; ***************************************************************************************
 10014                          ;
 10015                          ; Check for initialising JIM device
 10016                          ;
 10017                          ; ***************************************************************************************
 10018  da77 58                     CLI                                                 ; briefly allow interrupts (JIM based hardware can cause an
 10019                                                                                  ; interrupt here, which will set .interruptAccumulator to $7F,
 10020                                                                                  ; according to the comments in the original source code)
 10021  da78 78                     SEI                                                 ; then disallow again (N.B. All VIA IRQs are disabled)
 10022  da79 24fc                   BIT .interruptAccumulator                           ; if bit six is set, then we have JIM hardware to initialize.
 10023  da7b 5003                   BVC +                                               ; if (bit six clear) then branch over next instruction
 10024  da7d 2055f0                 JSR .jimPagedEntryJumper                            ; This calls the JIM paged entry point (to initialise JIM based hardware.)
 10025                          +
 10026                              ; fall through...
 10027                          
 10028                          ; ***************************************************************************************
 10029                          ;
 10030                          ; Enable interrupts
 10031                          ;
 10032                          ; Initialises System VIA registers to enable a default set of interrupts:
 10033                          ;
 10034                          ;       The Vertical sync interrupt (50Hz)
 10035                          ;       The Analogue to Digital Converter complete interrupt
 10036                          ;       A timer interrupt for Speech
 10037                          ;       The 100Hz timer
 10038                          ;
 10039                          ; Initialises the 100Hz timer to $270E = 9998 uS (two less than expected because the latch
 10040                          ; reload costs 2uS)
 10041                          ;
 10042                          ; Initialises other devices to default settings (light pen strobe, printer, user port)
 10043                          ;
 10044                          ; ***************************************************************************************
 10045  da80 a2f2                   LDX #%11110010                                      ; enable some System VIA interrupts:
 10046  da82 8e4efe                 STX .systemVIAInterruptEnableRegister               ;   1   Vertical sync
 10047                                                                                  ;   4   Analogue conversion finished
 10048                                                                                  ;   5   Timer 2 counter (for speech)
 10049                                                                                  ;   6   Timer 1 counter (100Hz)
 10050  da85 a204                   LDX #%00000100                                      ; set system VIA PCR
 10051  da87 8e4cfe                 STX .systemVIAPeripheralControlRegister             ; set the PCR:
 10052                                                  ; CA1 has negative active edge       (vertical sync)
 10053                                                  ; CA2 positive edges active on input (keyboard)
 10054                                                  ; CB1 has negative active edge       (end of analogue conversion)
 10055                                                  ; CB2 negative active edges on input (light pen strobe)
 10056                          
 10057  da8a a960                   LDA #%01100000                                      ; set system VIA ACR
 10058  da8c 8d4bfe                 STA .systemVIAAuxiliaryControlRegister              ; Disable latches and shift register
 10059                                                                                  ; (bits 0-4 = %00000)
 10060                                                                                  ; timer 2 countdown (for Speech)
 10061                                                                                  ; with pulses on input pin PB6
 10062                                                                                  ; (bit 5 = %1)
 10063                                                                                  ; timer 1 free-run mode (100Hz timer)
 10064                                                                                  ; with PB7 disabled
 10065                                                                                  ; (bit 6-7 = %01)
 10066                          
 10067  da8f a90e                   LDA #$0E                                            ; set system VIA Timer 1 counter (Low)
 10068  da91 8d46fe                 STA .systemVIATimer1LatchLow                        ; this becomes effective when Timer 1 Counter High set
 10069                          
 10070  da94 8d6cfe                 STA .userVIAPeripheralControlRegister               ; set user VIA PCR:
 10071                                                  ; CA1 interrupt on -ve edge     (usually printer Acknowledge)
 10072                                                  ; CA2 high output               (usually printer strobe)
 10073                                                  ; CB1 interrupt on -ve edge     (user port)
 10074                                                  ; CB2 negative edge             (user port)
 10075                          
 10076  da97 8dc0fe                 STA .adcStartConversionRegister                     ; Start analogue to digital conversion
 10077                                                                                  ; A=%1110, meaning channel 2 of range 0-3,
 10078                                                                                  ; twelve bit conversion.
 10079                          
 10080  da9a cd6cfe                 CMP .userVIAPeripheralControlRegister               ; check user VIA PCR
 10081  da9d f003                   BEQ +                                               ; if (printer present) then branch
 10082  da9f ee7702                 INC .userVIAIRQBitMask                              ; increment user VIA mask to 0 to ignore all user VIA interrupts
 10083                          +
 10084  daa2 a927                   LDA #$27                                            ; set Timer 1 (high byte) to $27.
 10085                                                                                  ; this sets Timer 1 to $270E (=9998 uS)
 10086  daa4 8d47fe                 STA .systemVIATimer1LatchHigh                       ; so interrupt occurs
 10087                                                                                  ; every 100th of a second
 10088  daa7 8d45fe                 STA .systemVIATimer1CounterHigh                     ; set counter (high byte) which
 10089                                                                                  ; actually starts the timer
 10090                              ; fall through...
 10091                          
 10092                          ; ***************************************************************************************
 10093                          ;
 10094                          ; Clear all sounds; Initialise the Serial ULA; Reset soft key definitions
 10095                          ;
 10096                          ; ***************************************************************************************
 10097                          .resetClearAllSounds
 10098  daaa 2060ec                 JSR .clearSoundChannels                             ; clear the sound channels
 10099                          
 10100                              ; Initialise the serial ULA
 10101  daad ad8202                 LDA .serialULARegisterCopy                          ; read serial ULA control register (OS copy)
 10102  dab0 297f                   AND #$7F                                            ; zero bit 7
 10103  dab2 20a7e6                 JSR .setSerialULADirectly                           ; and set up serial ULA
 10104                          
 10105                              ; reset function keys
 10106  dab5 ae8402                 LDX .softKeyConsistencyFlag                         ; get soft key status flag
 10107  dab8 f003                   BEQ .selectROMLoop                                  ; if (keys OK) then branch
 10108  daba 20c8e9                 JSR .osbyte18EntryPoint                             ; reset function keys
 10109                              ; fall through...
 10110                          
 10111                          ; ***************************************************************************************
 10112                          ;
 10113                          ; Read ROM Types
 10114                          ;
 10115                          ; Check each sideways ROM (aka Paged ROM) and make a catalogue of their types X = 0...15
 10116                          ;
 10117                          ; Note that the OS itself is not a Paged ROM. As originally shipped, BASIC is the only
 10118                          ; Paged ROM present. The OS supports 16 Paged ROMS (0-15). There are only five slots in
 10119                          ; the original machine, so extra hardware is required to support more Paged ROMs.
 10120                          ;
 10121                          ; ROM Header
 10122                          ; ----------
 10123                          ; $8000 = language entry point      (.romLanguageEntry)
 10124                          ; $8003 = service entry point       (.romServiceEntry)
 10125                          ; $8006 = ROM Type byte (see below) (.romTypeByte)
 10126                          ; $8007 = copyright message         (.romCopyrightOffsetPointer)
 10127                          ; $8009 = offset to title string    (.romTitleString)
 10128                          ;
 10129                          ; ROM Type Byte
 10130                          ; -------------
 10131                          ; bits 0-3  Processor Type (see below)
 10132                          ; bit 4     not used (Electron only)
 10133                          ; bit 5     Language ROM has a relocation address provided. The ROM can only run on the second
 10134                          ;           processor when located at that address.
 10135                          ; bit 6     If set, this is a language ROM (and can be chosen on RESET). Otherwise this is
 10136                          ;           a utility or Filing System ROM.
 10137                          ; bit 7     ROM has a service entry. All ROMs should have this bit set. (The BASIC ROM is the
 10138                          ;           exception, it does not have this bit set).
 10139                          ;
 10140                          ; Processor Type
 10141                          ; --------------
 10142                          ; Language ROMs can be copied across to a second processor and run there. Processor codes
 10143                          ; have been assigned:
 10144                          ;
 10145                          ;  0 = 6502 BASIC
 10146                          ;  1 = 6502 Turbo code
 10147                          ;  2 = 6502 machine code
 10148                          ;  3 = 68000 code
 10149                          ;  4 = -
 10150                          ;  5 = -
 10151                          ;  6 = -
 10152                          ;  7 = PDP-11 code
 10153                          ;  8 = Z80 code
 10154                          ;  9 = 32016 code
 10155                          ; 10 = -
 10156                          ; 11 = 80186 code
 10157                          ; 12 = 80286 code
 10158                          ; 13 = ARM code
 10159                          ; 14 = -
 10160                          ; 15 = -
 10161                          ;
 10162                          ; ***************************************************************************************
 10163                          .selectROMLoop
 10164  dabd 2016dc                 JSR .selectROM                                      ; select ROM X
 10165  dac0 a203                   LDX #3                                              ; set X to point to offset in table
 10166  dac2 ac0780                 LDY .romCopyrightOffsetPointer                      ; get copyright offset from ROM
 10167                          -
 10168  dac5 b90080                 LDA .romStartAddress,Y                              ; get first byte
 10169  dac8 dd0cdf                 CMP .copyrightString,X                              ; compare it with table byte
 10170  dacb d02e                   BNE .noCopyright                                    ; if (no copyright) then branch
 10171  dacd c8                     INY                                                 ; point to next byte in ROM
 10172  dace ca                     DEX                                                 ; point to previous byte in ")C(",0 string
 10173  dacf 10f4                   BPL -                                               ; if (still +ve) then branch (go back to check next byte)
 10174                                                                                  ; this point is reached if 4 bytes indicate valid ROM
 10175                          
 10176                              ; Check the first 1K of each ROM against higher priority ROMs to ensure that
 10177                              ; there are no matches. If a match is found, ignore the lower priority ROM
 10178  dad1 a6f4                   LDX .currentlySelectedROM                           ; get RAM copy of ROM number in X
 10179  dad3 a4f4                   LDY .currentlySelectedROM                           ; and Y
 10180                          
 10181                          .nextROM
 10182  dad5 c8                     INY                                                 ; increment Y to check
 10183  dad6 c010                   CPY #16                                             ; check ROM number against 16
 10184  dad8 b025                   BCS .romComparisonDone                              ; if (ROM number is 16 or more) then branch (done checking each ROM, store catalogue byte)
 10185  dada 98                     TYA                                                 ; put Y in A
 10186  dadb 49ff                   EOR #$FF                                            ; invert it
 10187  dadd 85fa                   STA .tempStoreFA                                    ; and store at .tempStoreFA
 10188  dadf a97f                   LDA #$7F                                            ; }
 10189  dae1 85fb                   STA .tempStoreFB                                    ; } store $7F at .tempStoreFB to get address $7FFF-Y
 10190                          
 10191                          .nextByteInROM
 10192  dae3 8c30fe                 STY .romSelectRegister                              ; switch the ROM into the memory map
 10193  dae6 b1fa                   LDA (.tempStoreFA),Y                                ; get byte
 10194  dae8 8e30fe                 STX .romSelectRegister                              ; switch the original ROM into the memory map
 10195  daeb d1fa                   CMP (.tempStoreFA),Y                                ; and compare with previous byte called
 10196  daed d0e6                   BNE .nextROM                                        ; if (not the same) then branch (go back and do it again with next ROM)
 10197  daef e6fa                   INC .tempStoreFA                                    ; increment .tempStoreFA to point to new location
 10198  daf1 d0f0                   BNE .nextByteInROM                                  ; if (.tempStoreFA is not zero) then branch (check next byte)
 10199  daf3 e6fb                   INC .tempStoreFB                                    ; increment tempStoreFB (high byte of address)
 10200  daf5 a5fb                   LDA .tempStoreFB                                    ; load it
 10201  daf7 c984                   CMP #$84                                            ; check if it has reached $84 = $80 + (4*256 bytes), i.e. 1k checked
 10202  daf9 90e8                   BCC .nextByteInROM                                  ; if (not checked 1k yet) then branch (check next 256 bytes)
 10203                          
 10204                          .noCopyright
 10205  dafb a6f4                   LDX .currentlySelectedROM                           ; X=current ROM
 10206  dafd 100d                   BPL +                                               ; if (+ve) then branch
 10207                          
 10208                          .romComparisonDone
 10209  daff ad0680                 LDA .romTypeByte                                    ; get rom type byte
 10210  db02 9da102                 STA .romTypeTable,X                                 ; store it in catalogue
 10211  db05 298f                   AND #$8F                                            ; check for BASIC
 10212  db07 d003                   BNE +                                               ; if (not BASIC) then branch
 10213  db09 8e4b02                 STX .basicROMNumber                                 ; store X at BASIC pointer
 10214                          +
 10215  db0c e8                     INX                                                 ; increment X to point to next ROM
 10216  db0d e010                   CPX #16                                             ; check X against 16
 10217  db0f 90ac                   BCC .selectROMLoop                                  ; if (15 or less) then branch (back for next ROM)
 10218                              ; fall through...
 10219                          
 10220                          ; ***************************************************************************************
 10221                          ;
 10222                          ; Check for speech system
 10223                          ;
 10224                          ; ***************************************************************************************
 10225  db11 2c40fe                 BIT .systemVIARegisterB                             ; check for speech system
 10226  db14 3011                   BMI .skipSpeech                                     ; if (bit 7 set) then branch (no speech system fitted)
 10227                          
 10228  db16 ce7b02                 DEC .speechSystemPresentFlag                        ; .speechSystemPresentFlag set to $FF to indicate speech present
 10229                          
 10230                          -
 10231  db19 a0ff                   LDY #$FF                                            ; Y=$FF (speech 'reset' command)
 10232  db1b 207fee                 JSR .osbyte159EntryPoint                            ; initialise speech generator
 10233  db1e ca                     DEX                                                 ; loop counter X from 16 to zero
 10234  db1f d0f8                   BNE -                                               ; branch back unless zero
 10235                          
 10236  db21 8e48fe                 STX .systemVIATimer2CounterLow                      ;
 10237  db24 8e49fe                 STX .systemVIATimer2CounterHigh                     ; clear Timer 2 to zero (used for Speech)
 10238                              ; fall through...
 10239                          
 10240                          ; ***************************************************************************************
 10241                          ;
 10242                          ; Initialise screen, execute any BOOT interception code
 10243                          ;
 10244                          ; ***************************************************************************************
 10245                          .skipSpeech
 10246  db27 ad8f02                 LDA .startUpOptions                                 ; get back start up options (bits 0-2 are MODE)
 10247  db2a 2000c3                 JSR .initialiseScreenOnReset                        ; then jump to screen initialisation
 10248                          
 10249                              ; *KEY 10 facility (insert the *KEY 10 character code into the keyboard buffer)
 10250  db2d a0ca                   LDY #.charKEY10                                     ; }
 10251  db2f 20f1e4                 JSR .insertByteIntoKeyboardBuffer                   ; } enter $CA in keyboard buffer. This activates the *KEY 10 facility.
 10252                          
 10253                              ; execute any user BOOT interception code, if present (with carry clear)
 10254  db32 20d9ea                 JSR .osbyte247EntryPoint                            ; call user boot routine if present, with carry clear
 10255                                                                                  ; it's called again later with carry set
 10256                          
 10257  db35 2040f1                 JSR .setupTapeOptions                               ; set up cassette options [normally
 10258                                                                                  ; at 300 baud, but if the user BOOT
 10259                                                                                  ; interception code sets Z then
 10260                                                                                  ; 1200 baud]
 10261                              ; fall through...
 10262                          
 10263                          ; ***************************************************************************************
 10264                          ;
 10265                          ; Initialise Tube
 10266                          ;
 10267                          ; ***************************************************************************************
 10268  db38 a981                   LDA #%10000001                                      ; test for Tube to FIFO buffer 1
 10269  db3a 8de0fe                 STA .tubeULAStatusRegister                          ;
 10270  db3d ade0fe                 LDA .tubeULAStatusRegister                          ; test for Tube presence
 10271  db40 6a                     ROR                                                 ; put bit 0 into carry
 10272  db41 900a                   BCC +                                               ; if (no Tube present) then branch
 10273  db43 a2ff                   LDX #.romServiceCallTubeMainInitialisation          ; }
 10274  db45 2068f1                 JSR .osbyte143EntryPoint                            ; } initialise Tube system (issue ROM service call)
 10275  db48 d003                   BNE +                                               ; if (Tube not initialised) then branch
 10276  db4a ce7a02                 DEC .tubePresentFlag                                ; set Tube flag to show it's active
 10277                              ; fall through...
 10278                          
 10279                          ; ***************************************************************************************
 10280                          ;
 10281                          ; Initialize ROMs, claim memory from OSHWM
 10282                          ;
 10283                          ; Note that OSBYTE 143 issues the service call to all ROMs in turn (in slot order 15-0).
 10284                          ;
 10285                          ; ***************************************************************************************
 10286                          +
 10287  db4d a00e                   LDY #>.initialOSHWM                                 ; set default value of PAGE: $0E00
 10288  db4f a201                   LDX #.romServiceCallAbsoluteWorkspaceClaim          ; issue claim absolute workspace call
 10289  db51 2068f1                 JSR .osbyte143EntryPoint                            ; via .osbyte143EntryPoint
 10290  db54 a202                   LDX #.romServiceCallPrivateWorkspaceClaim           ; send private workspace claim call
 10291  db56 2068f1                 JSR .osbyte143EntryPoint                            ; via .osbyte143EntryPoint
 10292  db59 8c4302                 STY .defaultOSHWM                                   ; set primary OSHWM
 10293  db5c 8c4402                 STY .currentOSHWM                                   ; set current OSHWM
 10294  db5f a2fe                   LDX #.romServiceCallTubeSystemPostInitialisation    ; send to the Tube with the 'post
 10295                                                                                  ; initialisation' reason (e.g.
 10296                                                                                  ; second processor can decide to
 10297                                                                                  ; explode the character set etc.)
 10298  db61 ac7a02                 LDY .tubePresentFlag                                ; Y=$FF if Tube present else Y=0
 10299  db64 2068f1                 JSR .osbyte143EntryPoint                            ; and make call via .osbyte143EntryPoint
 10300                              ; fall through...
 10301                          
 10302                          ; ***************************************************************************************
 10303                          ;
 10304                          ; Show bootup message
 10305                          ;
 10306                          ; The startup message can only be suppressed if a ROM requests it on initialisation. Otherwise
 10307                          ; the .startupMessageSuppressionAndBootOptions variable was reset to its default value when
 10308                          ; resetting MOS variables above.
 10309                          ;
 10310                          ; ***************************************************************************************
 10311  db67 2d6702                 AND .startupMessageSuppressionAndBootOptions        ; check (result of post-init AND bit 7
 10312                                                                                  ; of .startupMessageSuppressionAndBootOptions)
 10313  db6a 101b                   BPL .skipStartupMessage                             ; if (result clear) then branch (skip
 10314                                                                                  ; startup message)
 10315  db6c a002                   LDY #.bootMessage - .vduBaseAddress - 1             ;
 10316  db6e 20a9de                 JSR .displayString                                  ; output 'BBC Computer ' message
 10317  db71 ad8d02                 LDA .lastResetType                                  ; 0=soft reset, anything else continue
 10318  db74 f00c                   BEQ .outputTwoNewlines                              ; if (soft reset) then branch (skip
 10319                                                                                  ; forward)
 10320  db76 a016                   LDY #.bootMessageMemory32 - .vduBaseAddress - 1     ; set to point to 32k message
 10321  db78 2c8e02                 BIT .systemAvailableRAM                             ; read available RAM ($40 = 16k
 10322                                                                                  ; $80 = 32k)
 10323  db7b 3002                   BMI +                                               ; if (32k RAM available) then branch
 10324  db7d a011                   LDY #.bootMessageMemory16 - .vduBaseAddress - 1     ; set to point to 16K message
 10325                          +
 10326  db7f 20a9de                 JSR .displayString                                  ; write message with '16K' or '32K'
 10327                          
 10328                          .outputTwoNewlines
 10329  db82 a01b                   LDY #.bootMessageEnding  - .vduBaseAddress - 1      ; and two newlines
 10330  db84 20a9de                 JSR .displayString                                  ;
 10331                              ; fall through...
 10332                          
 10333                          ; ***************************************************************************************
 10334                          ;
 10335                          ; Execute user BREAK intercept, set keyboard LEDs
 10336                          ;
 10337                          ; ***************************************************************************************
 10338                          .skipStartupMessage
 10339  db87 38                     SEC                                                 ;
 10340  db88 20d9ea                 JSR .osbyte247EntryPoint                            ; call user break intercept if present
 10341                                                                                  ; (with carry set)
 10342  db8b 20d9e9                 JSR .osbyte118EntryPoint                            ; set up keyboard LEDs to reflect
 10343                                                                                  ; current keyboard status
 10344                                                                                  ; also tests for SHIFT pressed
 10345                              ; fall through...
 10346                          
 10347                          ; ***************************************************************************************
 10348                          ;
 10349                          ; Get !BOOT options, and ask ROMs to handle it
 10350                          ;
 10351                          ; Note that OSBYTE 143 issues the service call to all ROMs in turn (in slot order 15-0).
 10352                          ; This stops when one of the ROMs returns zero, indicating it will accept the auto-boot.
 10353                          ;
 10354                          ; ***************************************************************************************
 10355  db8e 08                     PHP                                                 ; remember flags
 10356  db8f 68                     PLA                                                 ; and recall flags in A = nvbdizc
 10357  db90 4a                     LSR                                                 ;
 10358  db91 4a                     LSR                                                 ;
 10359  db92 4a                     LSR                                                 ;
 10360  db93 4a                     LSR                                                 ; A=0000nvbd
 10361  db94 4d8f02                 EOR .startUpOptions                                 ; EOR with start up options, in
 10362                                                                                  ; particular check bit 3 (if clear
 10363                                                                                  ; reverse SHIFT BREAK action)
 10364  db97 2908                   AND #8                                              ; isolate bit 3 only
 10365  db99 a8                     TAY                                                 ; Y=0 (execute !BOOT) or 8 (don't
 10366                                                                                  ; execute !BOOT)
 10367  db9a a203                   LDX #.romServiceCallAutoBoot                        ; X = rom service call for auto-boot
 10368  db9c 2068f1                 JSR .osbyte143EntryPoint                            ; ask each ROM in turn if they want
 10369                                                                                  ; to handle it
 10370  db9f f01d                   BEQ .checkForFindingLanguageROM                     ; if (a ROM accepts this call) then
 10371                                                                                  ; branch (to enter language ROM)
 10372  dba1 98                     TYA                                                 ; put result from ROM (Y register) in
 10373                                                                                  ; A (to test if it's zero)
 10374  dba2 d014                   BNE .setTapeFSAndFindLanguageROM                    ; if (Y != 0, i.e. no filing system
 10375                                                                                  ; accepts it) then branch
 10376                              ; fall through...
 10377                          
 10378                          ; ***************************************************************************************
 10379                          ;
 10380                          ; Select the *ROM filing system
 10381                          ;
 10382                          ; ***************************************************************************************
 10383  dba4 a98d                   LDA #141                                            ; }
 10384  dba6 2035f1                 JSR .osbyte141EntryPoint                            ; } select ROM filing system
 10385                              ; fall through...
 10386                          
 10387                          ; ***************************************************************************************
 10388                          ;
 10389                          ; Execute !BOOT
 10390                          ;
 10391                          ; ***************************************************************************************
 10392  dba9 a2d2                   LDX #<.runBootString                                ;
 10393  dbab a0ea                   LDY #>.runBootString                                ;
 10394  dbad ce6702                 DEC .startupMessageSuppressionAndBootOptions        ; decrement boot options
 10395  dbb0 20f7ff                 JSR .OSCLI                                          ; and execute */!BOOT
 10396  dbb3 ee6702                 INC .startupMessageSuppressionAndBootOptions        ; restore boot options
 10397  dbb6 d006                   BNE .checkForFindingLanguageROM                     ; ALWAYS branch, don't reset filing system
 10398                          
 10399                          ; ***************************************************************************************
 10400                          ;
 10401                          ; Select TAPE filing system
 10402                          ;
 10403                          ; ***************************************************************************************
 10404                          .setTapeFSAndFindLanguageROM
 10405  dbb8 a900                   LDA #0                                              ; }
 10406  dbba aa                     TAX                                                 ; } set tape filing system
 10407  dbbb 2037f1                 JSR .setTapeOrROMFS                                 ; }
 10408                              ; fall through...
 10409                          
 10410                          ; ***************************************************************************************
 10411                          ;
 10412                          ; Look for language ROM
 10413                          ;
 10414                          ; Looks for the 'best' language ROM (the language with the highest ROM slot number) and
 10415                          ; enters it
 10416                          ;
 10417                          ; ***************************************************************************************
 10418                          .checkForFindingLanguageROM
 10419  dbbe ad8d02                 LDA .lastResetType                                  ; get last RESET Type
 10420  dbc1 d005                   BNE .findBestLanguageROM                            ; if (not soft reset) then branch
 10421                          
 10422  dbc3 ae8c02                 LDX .languageROMNumber                              ; get current language ROM number
 10423  dbc6 101e                   BPL .resetAndEnterLanguageROM                       ; if (language available) then branch (initialise and enter ROM)
 10424                          
 10425                          .findBestLanguageROM
 10426  dbc8 a20f                   LDX #15                                             ; set pointer to highest available ROM
 10427                          -
 10428  dbca bda102                 LDA .romTypeTable,X                                 ; get ROM type from map
 10429  dbcd 2a                     ROL                                                 ; put bit 6 into bit 7
 10430  dbce 3016                   BMI .resetAndEnterLanguageROM                       ; if (bit 7 set then ROM has a language entry) then branch (initialise and enter ROM)
 10431                          
 10432  dbd0 ca                     DEX                                                 ;
 10433  dbd1 10f7                   BPL -                                               ; search for language until X=255
 10434                              ; fall through...
 10435                          
 10436                          ; ***************************************************************************************
 10437                          ;
 10438                          ; No language ROM present, so check for second processor
 10439                          ;
 10440                          ; If present, ask the second processor to copy an appropriate language ROM onto the second
 10441                          ; processor and run there. The Tube interface is implemented by the 'DNFS' ROM. Initialising
 10442                          ; the DNFS ROM copies Tube service code into the current language workspace at $0400-$07FF.
 10443                          ; Calling .tubeCopyLanguageROMToSecondProcessor ($0400) is therefore calling into the Tube
 10444                          ; service code, to find and copy the code of an appropriate language ROM into the second
 10445                          ; processor and run it there. The language ROM identifies the processor type it's designed
 10446                          ; for by the ROM header's processor type byte (See .selectROMLoop).
 10447                          ;
 10448                          ; ***************************************************************************************
 10449  dbd3 a900                   LDA #0                                              ; No language found.
 10450  dbd5 2c7a02                 BIT .tubePresentFlag                                ; check if Tube is present
 10451  dbd8 302e                   BMI .tubeCopyLanguageROMToSecondProcessorLocal      ; if (Tube present) then branch (call into Tube code)
 10452                              ; fall through...
 10453                          
 10454                          ; ***************************************************************************************
 10455                          .brkNoLanguageError
 10456  dbda 00                     BRK                                                 ;
 10457  dbdb f9                     !byte $F9                                           ; error number
 10458  dbdc 4c616e6775616765...    !text "Language?",0                                 ; message
 10459                          
 10460                          ; ***************************************************************************************
 10461                          .resetAndEnterLanguageROM
 10462  dbe6 18                     CLC                                                 ;
 10463                              ; fall through...
 10464                          
 10465                          ; ***************************************************************************************
 10466                          ;
 10467                          ; OSBYTE 142 - Enter language ROM (at $8000)
 10468                          ;
 10469                          ; On Entry:
 10470                          ;       X = ROM number
 10471                          ;       C set if OSBYTE call;
 10472                          ;       C clear if initialisation
 10473                          ;
 10474                          ; ***************************************************************************************
 10475                          .osbyte142EntryPoint
 10476  dbe7 08                     PHP                                                 ; save flags
 10477  dbe8 8e8c02                 STX .languageROMNumber                              ; put X in current ROM number
 10478  dbeb 2016dc                 JSR .selectROM                                      ; select that ROM
 10479  dbee a980                   LDA #>(.romTitleString - 1)                         ; } AY=address of ROM title string
 10480  dbf0 a008                   LDY #<(.romTitleString - 1)                         ; }
 10481  dbf2 20abde                 JSR .displayStringAY                                ; display text string held in ROM at .romTitleString
 10482  dbf5 84fd                   STY .languageVersionString                          ; save Y on exit (end of language string)
 10483  dbf7 20e7ff                 JSR .OSNEWL                                         ; two line feeds
 10484  dbfa 20e7ff                 JSR .OSNEWL                                         ; are output
 10485  dbfd 28                     PLP                                                 ; then get back flags
 10486  dbfe a901                   LDA #1                                              ; A=1 required for language entry
 10487  dc00 2c7a02                 BIT .tubePresentFlag                                ; check if the Tube is present
 10488  dc03 3003                   BMI .tubeCopyLanguageROMToSecondProcessorLocal      ; and branch if so
 10489  dc05 4c0080                 JMP .romLanguageEntry                               ; enter language at $8000
 10490                          
 10491                          ; ***************************************************************************************
 10492                          .tubeCopyLanguageROMToSecondProcessorLocal
 10493  dc08 4c0004                 JMP .tubeCopyLanguageROMToSecondProcessor           ; enter Tube environment
 10494                          
 10495                          ; ***************************************************************************************
 10496                          ;
 10497                          ; Read a byte from a given ROM
 10498                          ;
 10499                          ; On Entry:
 10500                          ;       Y = ROM number
 10501                          ; $F6/$F7 = address
 10502                          ;
 10503                          ; ***************************************************************************************
 10504                          .osrdrmEntryPoint
 10505  dc0b a6f4                   LDX .currentlySelectedROM                           ; get current ROM number into X
 10506  dc0d 84f4                   STY .currentlySelectedROM                           ; store new number
 10507  dc0f 8c30fe                 STY .romSelectRegister                              ; switch the ROM into the memory map
 10508  dc12 a000                   LDY #0                                              ; get current PHROM address
 10509  dc14 b1f6                   LDA (.romAddressLow),Y                              ; and get byte
 10510                              ; fall through...
 10511                          
 10512                          ; ***************************************************************************************
 10513                          ;
 10514                          ; Select ROM
 10515                          ;
 10516                          ; On Entry:
 10517                          ;       X = ROM number (0-15)
 10518                          ;
 10519                          ; ***************************************************************************************
 10520                          .selectROM
 10521  dc16 86f4                   STX .currentlySelectedROM                           ; RAM copy of current ROM
 10522  dc18 8e30fe                 STX .romSelectRegister                              ; switch the ROM into the memory map
 10523  dc1b 60                     RTS                                                 ;
 10524                          
 10525                          
 10526                          
 10527                          ; ***************************************************************************************
 10528                          ; ***************************************************************************************
 10529                          ;
 10530                          ; Chapter 11: Interrupt processing
 10531                          ;
 10532                          ; ***************************************************************************************
 10533                          ; ***************************************************************************************
 10534                          
 10535                          ; ***************************************************************************************
 10536                          ;
 10537                          ; IRQ entry point
 10538                          ;
 10539                          ; On Entry:
 10540                          ;       The stack contains status register (flags); high and low bytes of previous program
 10541                          ;       counter.
 10542                          ;
 10543                          ; IRQ and BRK causes execution here. If it was a BRK instruction we branch (see .brkRoutine)
 10544                          ; otherwise we call (indirectly via IRQ1V) the default IRQ1 handler (see .irq1Handler)
 10545                          ;
 10546                          ; ***************************************************************************************
 10547                          .irqEntryPoint
 10548  dc1c 85fc                   STA .interruptAccumulator                           ; save A
 10549  dc1e 68                     PLA                                                 ; read flags
 10550  dc1f 48                     PHA                                                 ; store flags again
 10551  dc20 2910                   AND #%00010000                                      ; check BRK flag
 10552  dc22 d003                   BNE .brkRoutine                                     ; if (BRK flag set) then branch (to BRK handler)
 10553  dc24 6c0402                 JMP (.vectorIRQ1V)                                  ; jump to the IRQ1 vector (by default this will jump to .irq1Handler)
 10554                          
 10555                          ; ***************************************************************************************
 10556                          .brkRoutine
 10557  dc27 8a                     TXA                                                 ; }
 10558  dc28 48                     PHA                                                 ; } save X on stack
 10559  dc29 ba                     TSX                                                 ; get stack pointer
 10560  dc2a bd0301                 LDA .stackPage + 3,X                                ; get program counter low
 10561  dc2d d8                     CLD                                                 ;
 10562  dc2e 38                     SEC                                                 ; set carry
 10563  dc2f e901                   SBC #1                                              ; subtract 1
 10564  dc31 85fd                   STA .brkAddressLow                                  ; and store
 10565  dc33 bd0401                 LDA .stackPage + 4,X                                ; get high byte
 10566  dc36 e900                   SBC #0                                              ; subtract 1 if necessary
 10567  dc38 85fe                   STA .brkAddressHigh                                 ; and store
 10568  dc3a a5f4                   LDA .currentlySelectedROM                           ; get currently active ROM
 10569  dc3c 8d4a02                 STA .romNumberActiveLastBRK                         ; and store it
 10570  dc3f 86f0                   STX .stackPointerLastBRK                            ; store stack pointer
 10571  dc41 a206                   LDX #.romServiceCallBreakInstruction                ; }
 10572  dc43 2068f1                 JSR .osbyte143EntryPoint                            ; } issue ROM service call 6 (Break) to ROMs so they get a chance to respond.
 10573                                                                                  ; at this point .brkAddressLow/High points to the byte after the BRK instruction.
 10574                                                                                  ; ROMS may use BRK for their own purposes
 10575                          
 10576  dc46 ae8c02                 LDX .languageROMNumber                              ; get current language
 10577  dc49 2016dc                 JSR .selectROM                                      ; and activate it
 10578  dc4c 68                     PLA                                                 ; get back original value of X
 10579  dc4d aa                     TAX                                                 ;
 10580  dc4e a5fc                   LDA .interruptAccumulator                           ; get back original value of A
 10581  dc50 58                     CLI                                                 ; allow interrupts
 10582  dc51 6c0202                 JMP (.vectorBRKV)                                   ; and JUMP via BRKV (normally into current language)
 10583                          
 10584                          
 10585                          ; ***************************************************************************************
 10586                          ;
 10587                          ; Default BRK handler
 10588                          ;
 10589                          ; This is the default BRK handler that is used at boot time. When BASIC or other language
 10590                          ; ROM starts it will set up it's own BRK handler instead.
 10591                          ;
 10592                          ; ***************************************************************************************
 10593                          .brkHandler
 10594  dc54 a000                   LDY #0                                              ; Y=0 to point to byte after BRK
 10595  dc56 20b1de                 JSR .printMessage                                   ; print message
 10596                          
 10597  dc59 ad6702                 LDA .startupMessageSuppressionAndBootOptions        ; } bit 0 set means: lock up machine if !BOOT errors from DISC (because e.g. no language found)
 10598  dc5c 6a                     ROR                                                 ; } rotate into carry
 10599                          -
 10600  dc5d b0fe                   BCS -                                               ; if (carry set) then branch (hang the machine!)
 10601                          
 10602  dc5f 20e7ff                 JSR .OSNEWL                                         ; print two newlines
 10603  dc62 20e7ff                 JSR .OSNEWL                                         ;
 10604  dc65 4cb8db                 JMP .setTapeFSAndFindLanguageROM                    ; set tape filing system before
 10605                                                                                  ; entering current language
 10606                          
 10607                          ; ***************************************************************************************
 10608                          .rs423Handler
 10609  dc68 38                     SEC                                                 ; set carry
 10610  dc69 6e4f02                 ROR .rs423ReadyFlag                                 ; set RS-423 ready
 10611  dc6c 2c5002                 BIT .rs423ControlRegisterCopy                       ; check bit 7 of current ACIA control register (aka 'CR7' - ACIA interrupts enabled flag)
 10612  dc6f 1007                   BPL .rs423SetRequestToSendInactive                  ; if (ACIA interrupts disabled) then branch
 10613  dc71 2041e7                 JSR .getRS423InputBufferFreeBytes                   ; call subroutine to check if serial buffer is full
 10614  dc74 a200                   LDX #0                                              ; set X to the value (zero) which will clear bit 5 and 6 of ACIA control register
 10615                                                                                  ; (aka 'CR5' and 'CR6' on the ACIA 6850 datasheet)
 10616                                                                                  ; which means set the 'Request To Send' pin low and transmit interrupt disabled.
 10617                                                                                  ; this is the active state.
 10618  dc76 b002                   BCS .rs423BufferSpaceOK                             ; if (buffer has enough free space) then branch
 10619                          
 10620                          .rs423SetRequestToSendInactive
 10621  dc78 a240                   LDX #%01000000                                      ; set X to value which will clear bit 5 and set bit 6 of ACIA control register
 10622                                                                                  ; (aka CR5 and CR6 on the ACIA 6850 datasheet)
 10623                                                                                  ; which means set the 'Request To Send' pin high and transmit interrupt disabled.
 10624                                                                                  ; this is the inactive state.
 10625                          .rs423BufferSpaceOK
 10626  dc7a 4c7ae1                 JMP .writeToACIARequestToSend                       ; write to 'Request To Send' value in ACIA
 10627                          
 10628                          ; ***************************************************************************************
 10629                          .readFromRS423
 10630  dc7d ac09fe                 LDY .acia6850DataRegister                           ; read serial data from ACIA
 10631  dc80 293a                   AND #$3A                                            ; AND %0011 1010
 10632  dc82 d034                   BNE .rs423ErrorDetected                             ; if (not zero) then branch
 10633  dc84 ae5c02                 LDX .rs423InputSuppressionFlag                      ; read RS-423 input suppression flag
 10634  dc87 d009                   BNE +                                               ; if (RS-423 input suppressed) then branch (return)
 10635  dc89 e8                     INX                                                 ; X=1
 10636  dc8a 20f3e4                 JSR .osbyte153EntryPoint                            ; put byte in RS-423 input buffer
 10637  dc8d 2041e7                 JSR .getRS423InputBufferFreeBytes                   ; count buffer
 10638  dc90 90e6                   BCC .rs423SetRequestToSendInactive                  ; if (buffer is low on free space) then branch back (to make 'Request To Send' inactive)
 10639                          +
 10640  dc92 60                     RTS                                                 ;
 10641                          
 10642                          ; ***************************************************************************************
 10643                          ;
 10644                          ; IRQ1 default handler
 10645                          ;
 10646                          ; When a hardware device generates an IRQ, this IRQ1 handler is executed (as the default
 10647                          ; handler, see .irqEntryPoint). After saving registers and a suitable return address on
 10648                          ; the stack, we check three hardware devices in turn, to see what needs attention:
 10649                          ;
 10650                          ;  1. Check for ACIA interrupt (see .irq1CheckACIA)
 10651                          ;       1a. updates RS-423 or Cassette then exit
 10652                          ;  2. Check for System VIA interrupt (see .irq1CheckSystemVIA)
 10653                          ;       2a. If VSYNC then update:
 10654                          ;               vsync counter
 10655                          ;               RS-423 counter
 10656                          ;               flashing colours
 10657                          ;               then exit
 10658                          ;       2b. If Timer 2 times out (Speech timer) (see .irq1CheckSystemVIASpeech)
 10659                          ;               update speech system (send speech data from speech buffer as needed)
 10660                          ;               then exit
 10661                          ;       2c. If Timer 1 times out (100Hz timer) (see .irq1CheckSystemVIA100HzTimer)
 10662                          ;           then update:
 10663                          ;               the clock
 10664                          ;               the countdown timer event
 10665                          ;               the INKEY timeout counter
 10666                          ;               sound
 10667                          ;               speech
 10668                          ;               ACIA
 10669                          ;               printer
 10670                          ;               keyboard
 10671                          ;               ADC conversion
 10672                          ;               then exit
 10673                          ;  3. Check for User VIA interrupt (see .irq1CheckUserVIA)
 10674                          ;       3a. updates a parallel printer then exit
 10675                          ;
 10676                          ;  Unrecognised interrupts are passed on to IRQ2V, allowing user code to process it.
 10677                          ;
 10678                          ; ***************************************************************************************
 10679                          .irq1Handler
 10680  dc93 d8                     CLD                                                 ; clear decimal flag
 10681  dc94 a5fc                   LDA .interruptAccumulator                           ; }
 10682  dc96 48                     PHA                                                 ; }
 10683  dc97 8a                     TXA                                                 ; } push original A,X,Y register onto stack
 10684  dc98 48                     PHA                                                 ; }
 10685  dc99 98                     TYA                                                 ; }
 10686  dc9a 48                     PHA                                                 ; }
 10687                          
 10688  dc9b a9de                   LDA #>(.restoreRegistersAndReturnFromInterrupt-1)   ; }
 10689  dc9d 48                     PHA                                                 ; } push return address onto stack
 10690  dc9e a981                   LDA #<(.restoreRegistersAndReturnFromInterrupt-1)   ; } RTS will now exit to .restoreRegistersAndReturnFromInterrupt
 10691  dca0 48                     PHA                                                 ; }
 10692  dca1 b8                     CLV                                                 ; clear V flag (meaning: check the ACIA generated the interrupt)
 10693                              ; fall through...
 10694                          
 10695                          ; ***************************************************************************************
 10696                          ;
 10697                          ; Check for ACIA Interrupt or Update ACIA
 10698                          ;
 10699                          ; Two modes of operation (V CLEAR and V SET)
 10700                          ;
 10701                          ; On Entry:
 10702                          ;       V CLEAR means check that the ACIA generated the interrupt, and if so then update
 10703                          ;               the RS-423 or cassette as needed
 10704                          ;       V  SET  means just update the RS-423
 10705                          .irq1CheckACIA
 10706  dca2 ad08fe                 LDA .acia6850StatusRegister                         ; get the ACIA status register
 10707  dca5 7002                   BVS +                                               ; if ('V SET') then branch (don't
 10708                                                                                  ; check the ACIA generated the
 10709                                                                                  ; interrupt)
 10710  dca7 105d                   BPL .irq1CheckSystemVIA                             ; if (ACIA didn't generate the
 10711                                                                                  ; interrupt) then branch (check the
 10712                                                                                  ; next thing)
 10713                          +
 10714  dca9 a6ea                   LDX .rs423TimeoutCounter                            ; read RS-423 timeout counter
 10715  dcab ca                     DEX                                                 ; decrement it
 10716  dcac 3030                   BMI .rs423HasControl                                ; if (timed out) then branch
 10717  dcae 702d                   BVS .exit13                                         ; if ('V SET') then branch (return)
 10718  dcb0 4c88f5                 JMP .updateACIA                                     ; update ACIA
 10719                          
 10720                          ; ***************************************************************************************
 10721                          .rs423ErrorDetectedSetAY
 10722  dcb3 ac09fe                 LDY .acia6850DataRegister                           ; read ACIA data
 10723  dcb6 2a                     ROL                                                 ;
 10724  dcb7 0a                     ASL                                                 ;
 10725                              ; fall through...
 10726                          
 10727                          ; ***************************************************************************************
 10728                          .rs423ErrorDetected
 10729  dcb8 aa                     TAX                                                 ; X=status byte shifted right once
 10730  dcb9 98                     TYA                                                 ; A=character received
 10731  dcba a007                   LDY #.eventRS423ErrorDetected                       ; Y=7
 10732  dcbc 4c94e4                 JMP .eventEntryPoint                                ; check and service EVENT 7 RS-423 error
 10733                          
 10734                          ; ***************************************************************************************
 10735                          ;
 10736                          ; Send to RS-423 / Serial printer as needed
 10737                          ;
 10738                          ; If we have a non-empty RS-423 output buffer, then send the next byte, reset the RS-423
 10739                          ; timeout counter and exit.
 10740                          ;
 10741                          ; If we have a serial printer, update the printer buffer empty flag. If not empty then
 10742                          ; send the byte to the printer (and also reset the RS-423 timeout counter).
 10743                          ;
 10744                          ; ***************************************************************************************
 10745                          .writeToACIA
 10746  dcbf a202                   LDX #.bufferNumberRS423Output                       ; }
 10747  dcc1 2060e4                 JSR .osbyte145EntryPoint                            ; } read from RS-423 output buffer
 10748  dcc4 9010                   BCC +                                               ; if (buffer isn't empty) then branch forward
 10749                          
 10750                              ; RS-423 buffer empty
 10751  dcc6 ad8502                 LDA .printerDestination                             ; read printer destination
 10752  dcc9 c902                   CMP #2                                              ; is it serial printer?
 10753  dccb d09b                   BNE .rs423Handler                                   ; if (not a serial printer) then branch (it must be RS-423)
 10754                          
 10755                              ; serial printer
 10756  dccd e8                     INX                                                 ; X=3 (.bufferNumberPrinter)
 10757  dcce 2060e4                 JSR .osbyte145EntryPoint                            ; read printer buffer
 10758  dcd1 6ed202                 ROR .printerBufferEmptyFlag                         ; update the empty flag (put carry into bit 7)
 10759  dcd4 3092                   BMI .rs423Handler                                   ; if (printer buffer is empty) then branch
 10760                          +
 10761  dcd6 8d09fe                 STA .acia6850DataRegister                           ; pass either printer or RS-423 data to ACIA
 10762  dcd9 a9e7                   LDA #$E7                                            ; } reset timeout counter to
 10763  dcdb 85ea                   STA .rs423TimeoutCounter                            ; } count up 25 vsyncs (0.5 seconds)
 10764                          .exit13
 10765  dcdd 60                     RTS                                                 ;
 10766                          
 10767                          ; ***************************************************************************************
 10768                          ;
 10769                          ; Service RS-423 interrupt
 10770                          ;
 10771                          ; See NAUG Section 8.4 - Serial system interrupts, Page 126
 10772                          ;
 10773                          ; On Entry:
 10774                          ;       A = ACIA status byte
 10775                          ;
 10776                          ;       Two modes of operation:
 10777                          ;       V CLEAR - read from RS-423; handle DCD (Data Carrier Detect); write to RS-423;
 10778                          ;                 handle unrecognised interrupt
 10779                          ;       V SET   - handle DCD; write to RS-423
 10780                          ; ***************************************************************************************
 10781                          .rs423HasControl
 10782  dcde 2d7802                 AND .rs423IRQBitMask                                ; AND with ACIA bit mask (normally $FF)
 10783  dce1 4a                     LSR                                                 ; shift right to put bit 0 of ACIA status (receive interrupt) in carry
 10784  dce2 9007                   BCC +                                               ; if (not a receive interrupt) then branch (skip read)
 10785  dce4 7005                   BVS +                                               ; if (V SET mode) then branch (skip read)
 10786  dce6 ac5002                 LDY .rs423ControlRegisterCopy                       ; read copy of ACIA control register
 10787  dce9 3092                   BMI .readFromRS423                                  ; if (ACIA 6850 interrupts enabled) then branch
 10788                          +
 10789  dceb 4a                     LSR                                                 ; shift,  put bit 1 of ACIA status into carry
 10790  dcec 6a                     ROR                                                 ; rotate, put bit 2 of ACIA status into carry
 10791  dced b0c4                   BCS .rs423ErrorDetectedSetAY                        ; if (Data Carrier Detected interrupt) then branch
 10792  dcef 30ce                   BMI .writeToACIA                                    ; if (ACIA status bit 1 is set) then branch (transmit interrupt)
 10793  dcf1 70ea                   BVS .exit13                                         ; if (V SET mode) then branch (exit)
 10794                              ; fall through...
 10795                          
 10796                          ; ***************************************************************************************
 10797                          ;
 10798                          ; Unrecognised Interrupt
 10799                          ;
 10800                          ; When we have an interrupt that we don't understand, pass it to the ROMs to see if
 10801                          ; they can handle it. If not, then pass it on to the IRQ2 vector.
 10802                          ; ***************************************************************************************
 10803                          .unrecognisedInterrupt
 10804  dcf3 a205                   LDX #.romServiceCallUnrecognisedInterrupt           ; }
 10805  dcf5 2068f1                 JSR .osbyte143EntryPoint                            ; } issue paged ROM service call for 'unrecognised interrupt'
 10806  dcf8 f0e3                   BEQ .exit13                                         ; if (a ROM recognises it) then branch (exit)
 10807  dcfa 68                     PLA                                                 ; otherwise remove address from stack
 10808  dcfb 68                     PLA                                                 ;
 10809  dcfc 68                     PLA                                                 ; and restore Y, X, and A
 10810  dcfd a8                     TAY                                                 ;
 10811  dcfe 68                     PLA                                                 ;
 10812  dcff aa                     TAX                                                 ;
 10813  dd00 68                     PLA                                                 ;
 10814  dd01 85fc                   STA .interruptAccumulator                           ; .interruptAccumulator=A
 10815  dd03 6c0602                 JMP (.vectorIRQ2V)                                  ; and offer to the user via IRQ2V
 10816                          
 10817                          ; ***************************************************************************************
 10818                          ;
 10819                          ; Check for System VIA interrupt
 10820                          ;
 10821                          ; Check if the System VIA triggered the interrupt and deal with it.
 10822                          ; ***************************************************************************************
 10823                          .irq1CheckSystemVIA
 10824  dd06 ad4dfe                 LDA .systemVIAInterruptFlagRegister                 ; read system VIA interrupt flag register
 10825  dd09 103c                   BPL .irq1CheckUserVIA                               ; if (the System VIA has not caused interrupt) then branch (try the next thing)
 10826                          
 10827  dd0b 2d7902                 AND .systemVIAIRQBitMask                            ; mask with VIA bit mask (normally $FF)
 10828  dd0e 2d4efe                 AND .systemVIAInterruptEnableRegister               ; and interrupt enable register
 10829  dd11 6a                     ROR                                                 ; }
 10830  dd12 6a                     ROR                                                 ; } rotate right twice to check for IRQ 1 (vsync)
 10831  dd13 9054                   BCC .irq1CheckSystemVIASpeech                       ; if (not vsync) then branch (to check for speech)
 10832                          
 10833                              ; vsync interrupt
 10834  dd15 ce4002                 DEC .verticalSyncCounter                            ; decrement vertical sync counter
 10835  dd18 a5ea                   LDA .rs423TimeoutCounter                            ; A = RS-423 Timeout counter
 10836  dd1a 1002                   BPL +                                               ; if (positive) then branch
 10837  dd1c e6ea                   INC .rs423TimeoutCounter                            ; increment counter
 10838                          +
 10839  dd1e ad5102                 LDA .videoULAFlashingColourIntervalCount            ; load flash counter
 10840  dd21 f01a                   BEQ .doneFlashingColours                            ; if (flashing system is not in use) then branch
 10841  dd23 ce5102                 DEC .videoULAFlashingColourIntervalCount            ; decrement counter
 10842  dd26 d015                   BNE .doneFlashingColours                            ; if (not time for a colour to flash) then branch (to continue processing)
 10843                          
 10844                              ; ready to flash colour
 10845  dd28 ae5202                 LDX .videoULAFirstFlashingColourInterval            ; get mark period count in X
 10846  dd2b ad4802                 LDA .videoULAVideoControlRegisterCopy               ; current Video ULA control setting in A
 10847  dd2e 4a                     LSR                                                 ; shift bit 0 into C
 10848  dd2f 9003                   BCC .restoreAndFlipBit                              ; if (first colour is in effect) then branch
 10849                          
 10850  dd31 ae5302                 LDX .videoULASecondFlashingColourInterval           ; get second colour period count in X
 10851                          .restoreAndFlipBit
 10852  dd34 2a                     ROL                                                 ; restore bit
 10853  dd35 4901                   EOR #1                                              ; and invert it
 10854  dd37 2000ea                 JSR .setVideoULA                                    ; then set colour
 10855  dd3a 8e5102                 STX .videoULAFlashingColourIntervalCount            ; reset the count until the next flash
 10856                          
 10857                          .doneFlashingColours
 10858  dd3d a004                   LDY #.eventStartOfVSync                             ; Y=event type: start of vsync
 10859  dd3f 2094e4                 JSR .eventEntryPoint                                ; call the event
 10860  dd42 a902                   LDA #%00000010                                      ; A=bit set to clear the vsync interrupt flag
 10861  dd44 4c6ede                 JMP .storeToSystemVIAIFR                            ; clear interrupt and exit
 10862                          
 10863                          
 10864                          ; ***************************************************************************************
 10865                          ;
 10866                          ; Check for User VIA interrupt
 10867                          ;
 10868                          ; Check if the User VIA triggered the interrupt and deal with it (check for parallel
 10869                          ; printer in particular).
 10870                          ; ***************************************************************************************
 10871                          .irq1CheckUserVIA
 10872  dd47 ad6dfe                 LDA .userVIAInterruptFlagRegister                   ; check User VIA interrupt flags register
 10873  dd4a 10a7                   BPL .unrecognisedInterrupt                          ; if (User VIA did not call interrupt) then branch
 10874                          
 10875  dd4c 2d7702                 AND .userVIAIRQBitMask                              ; }
 10876  dd4f 2d6efe                 AND .userVIAInterruptEnableRegister                 ; }
 10877  dd52 6a                     ROR                                                 ; }
 10878  dd53 6a                     ROR                                                 ; } check for User IRQ bit 1 set (printer interrupt)
 10879  dd54 909d                   BCC .unrecognisedInterrupt                          ; if (not printer interrupt) then branch
 10880  dd56 ac8502                 LDY .printerDestination                             ; get printer type
 10881  dd59 88                     DEY                                                 ; decrement
 10882  dd5a d097                   BNE .unrecognisedInterrupt                          ; if (not a parallel printer) then branch
 10883                          
 10884                              ; deal with parallel printer
 10885  dd5c a902                   LDA #%00000010                                      ; interrupt bit 1 (printer interrupt)
 10886  dd5e 8d6dfe                 STA .userVIAInterruptFlagRegister                   ; clear interrupt bit 1
 10887  dd61 8d6efe                 STA .userVIAInterruptEnableRegister                 ; enable interrupt bit 1
 10888  dd64 a203                   LDX #.bufferNumberPrinter                           ; }
 10889  dd66 4c3ae1                 JMP .openPrinterChannel                             ; } output data to parallel printer
 10890                          
 10891                          ; ***************************************************************************************
 10892                          ;
 10893                          ; Check to see if the interrupt is a Speech interrupt and deal with it
 10894                          ;
 10895                          ; The speech processor chip has an internal 16 byte buffer to hold incoming data.
 10896                          ;
 10897                          ; When speaking, this buffer will run out every 50 milliseconds. When the buffer becomes
 10898                          ; half full, an interrupt occurs. In fact, a speech interrupt is generated when any of the
 10899                          ; following occur:
 10900                          ;
 10901                          ;   (1) End of speech processing
 10902                          ;   (2) Speech hardware is low on data (half full, i.e. 8 bytes or less), indicating more
 10903                          ;       phrase data needs to be supplied for the Speak External command.
 10904                          ;   (3) Speech hardware is empty of data, indicating the CPU failed to supply phrase data
 10905                          ;       fast enough for the Speak External command.
 10906                          ;   (4) At the start of a Speak External instruction, if speech hardware is not empty of data.
 10907                          ;
 10908                          ; We call .updateSpeech in the 100Hz interrupt to keep the speech hardware regularly supplied
 10909                          ; with data.
 10910                          ;
 10911                          ; On Entry:
 10912                          ;       A = System VIA interrupt flag shifted right twice
 10913                          ; ***************************************************************************************
 10914                          .irq1CheckSystemVIASpeech
 10915  dd69 2a                     ROL                                                 ; } rotate left twice to get back to
 10916  dd6a 2a                     ROL                                                 ; } original interrupt flag register
 10917                                                                                  ; } alignment of bits
 10918                          
 10919  dd6b 2a                     ROL                                                 ; rotate left to get bit 5 into bit 6
 10920  dd6c 2a                     ROL                                                 ; rotate left to get bit 6 into bit 7
 10921  dd6d 105b                   BPL .irq1CheckSystemVIA100HzTimer                   ; if (bit 5 of system via IFR is
 10922                                                                                  ; clear, i.e. it's not timer 2, used
 10923                                                                                  ; for the speech interrupt)
 10924                                                                                  ; then branch
 10925                          
 10926                              ; deal with speech
 10927  dd6f a920                   LDA #%00100000                                      ; } clear bit 5, the timer 2
 10928  dd71 a200                   LDX #0                                              ; } interrupt
 10929  dd73 8d4dfe                 STA .systemVIAInterruptFlagRegister                 ; }
 10930  dd76 8e49fe                 STX .systemVIATimer2CounterHigh                     ; clear Timer 2 (write to high byte)
 10931                          
 10932                          .updateSpeech
 10933  dd79 a208                   LDX #8                                              ; } loop counter (shifted right on
 10934  dd7b 86fb                   STX .tempStoreFB                                    ; } each loop iteration)
 10935                          
 10936                              ; on each speech update we loop a maximum of 4 times to feed the speech chip with up to
 10937                              ; 4 bytes of new data from the CPU's speech buffer.
 10938                          .feedSpeechChipWithDataLoop
 10939                              ; check our speech buffer, see if there's more data
 10940  dd7d 205be4                 JSR .osbyte152EntryPoint                            ; examine buffer status for buffer 8
 10941                                                                                  ; (the speech buffer), C set if buffer
 10942                                                                                  ; is empty, otherwise A is byte read.
 10943  dd80 6ed702                 ROR .speechBufferEmptyFlag                          ; shift carry into bit 7 - store as
 10944                                                                                  ; the 'speech buffer empty' bit
 10945  dd83 3044                   BMI .exit14                                         ; if (top bit is set, i.e. set buffer
 10946                                                                                  ; is empty) then branch (return)
 10947  dd85 a8                     TAY                                                 ; Y = A = next byte to be removed
 10948                                                                                  ; from speech buffer
 10949  dd86 f005                   BEQ +                                               ;
 10950                          
 10951                              ; check if speech chip is ready?
 10952  dd88 206dee                 JSR .osbyte158EntryPoint                            ; read byte from speech chip
 10953  dd8b 303c                   BMI .exit14                                         ; if (top bit set) then branch (exit)
 10954                          
 10955                          +
 10956                              ; read three bytes from the speech buffer: <ROM number> <2 byte address>
 10957  dd8d 2060e4                 JSR .osbyte145EntryPoint                            ; read a byte from CPU's speech buffer
 10958  dd90 85f5                   STA .currentSpeechPHROMOrROMNumber                  ; store ROM number
 10959  dd92 2060e4                 JSR .osbyte145EntryPoint                            ; read another byte
 10960  dd95 85f7                   STA .romAddressHigh                                 ; store ROM address
 10961  dd97 2060e4                 JSR .osbyte145EntryPoint                            ; read another byte
 10962  dd9a 85f6                   STA .romAddressLow                                  ; store ROM address
 10963                          
 10964  dd9c a4f5                   LDY .currentSpeechPHROMOrROMNumber                  ; Y=ROM / PHROM number
 10965  dd9e f01b                   BEQ .writeROMAddressToSpeechProcessor               ; if (current logical speech PHROM
 10966                                                                                  ; or ROMFS Number is zero) then branch
 10967  dda0 1016                   BPL .writeCommandAndAddressToSpeechProcessor        ; if (+ve) then branch
 10968  dda2 24f5                   BIT .currentSpeechPHROMOrROMNumber                  ; check bit 6 of PHROM or ROM number
 10969  dda4 7005                   BVS +                                               ; if (PHROM or ROM number has bit 6
 10970                                                                                  ; set) then branch
 10971  dda6 20bbee                 JSR .writeAddressAndROMNumberToSpeechProcessor      ; continue for more speech processing
 10972  dda9 5007                   BVC .enableOrDisableSpeech                          ; ALWAYS branch
 10973                          
 10974                          +
 10975  ddab 06f6                   ASL .romAddressLow                                  ; double ROM address
 10976  ddad 26f7                   ROL .romAddressHigh                                 ;
 10977  ddaf 203bee                 JSR .readFromPHROM                                  ; and call .readFromPHROM
 10978                          
 10979                          .enableOrDisableSpeech
 10980  ddb2 ac6102                 LDY .speechSuppressionStatus                        ; get speech enable/disable flag
 10981                                                                                  ; whose values equate to speech
 10982                                                                                  ; processor commands:
 10983                                                                                  ; $50 = 'speak'; $20 = 'nop'
 10984  ddb5 4c7fee                 JMP .osbyte159EntryPoint                            ; write to speech processor
 10985                          
 10986                          .writeCommandAndAddressToSpeechProcessor
 10987  ddb8 207fee                 JSR .osbyte159EntryPoint                            ; write ROM number
 10988                          .writeROMAddressToSpeechProcessor
 10989  ddbb a4f6                   LDY .romAddressLow                                  ; get address pointer in Y
 10990  ddbd 207fee                 JSR .osbyte159EntryPoint                            ; write address to speech chip
 10991  ddc0 a4f7                   LDY .romAddressHigh                                 ; get address pointer high in Y
 10992  ddc2 207fee                 JSR .osbyte159EntryPoint                            ; write address to speech chip
 10993                          
 10994  ddc5 46fb                   LSR .tempStoreFB                                    ; update loop counter
 10995  ddc7 d0b4                   BNE .feedSpeechChipWithDataLoop                     ; loop back
 10996                          
 10997                          .exit14
 10998  ddc9 60                     RTS                                                 ;
 10999                          
 11000                          
 11001                          ; ***************************************************************************************
 11002                          ;
 11003                          ; IRQ1 Interrupt - 100Hz interrupt
 11004                          ;
 11005                          ; ***************************************************************************************
 11006                          .irq1CheckSystemVIA100HzTimer
 11007  ddca 907b                   BCC .irq1CheckSystemVIAADCEndConversion             ; bit 6 is in carry. if (there is no bit 6 interrupt) then branch
 11008  ddcc a940                   LDA #%01000000                                      ; }
 11009  ddce 8d4dfe                 STA .systemVIAInterruptFlagRegister                 ; } clear interrupt 6
 11010                          
 11011                              ; Update the 5 byte clock. There are 2 clock stores, at .timeClockA and .timeClockB. These
 11012                              ; are updated by adding 1 to the current clock and storing the result in the other, the
 11013                              ; direction of transfer being changed each time of update.  This ensures that at least
 11014                              ; 1 clock store is valid at any call as the current clock is only read.  Other methods
 11015                              ; would cause inaccuracies if a clock was read whilst being updated.
 11016  ddd1 ad8302                 LDA .timeClockSwitch                                ; get current system clock pointer (5 or 10)
 11017  ddd4 aa                     TAX                                                 ; put old system clock pointer in X
 11018  ddd5 490f                   EOR #$0F                                            ; invert bits so it toggles between 5 and 10
 11019  ddd7 48                     PHA                                                 ; remember A
 11020  ddd8 a8                     TAY                                                 ; put new system clock pointer in Y
 11021                          -
 11022  ddd9 bd9102                 LDA .timeClockA-1,X                                 ; get current system clock value
 11023  dddc 6900                   ADC #0                                              ; increment it (carry is set on the first iteration of the loop,
 11024                                                                                  ;     thereafter carry is set as needed based on this increment)
 11025  ddde 999102                 STA .timeClockA-1,Y                                 ; store result in new copy
 11026  dde1 ca                     DEX                                                 ; decrement X
 11027  dde2 f003                   BEQ +                                               ; if (finished) then branch (loop ends)
 11028  dde4 88                     DEY                                                 ; decrement Y
 11029  dde5 d0f2                   BNE -                                               ; and go back and do next byte
 11030                          +
 11031  dde7 68                     PLA                                                 ; get back new clock pointer
 11032  dde8 8d8302                 STA .timeClockSwitch                                ; and store back in clock pointer
 11033                          
 11034                              ; Update countdown interval timer. An EVENT is generated when it times out.
 11035  ddeb a205                   LDX #5                                              ; set loop counter
 11036                          -
 11037  dded fe9b02                 INC .countdownIntervalTimer - 1,X                   ; increment byte for countdown timer
 11038  ddf0 d008                   BNE +                                               ; if (done updating timer bytes) then branch
 11039  ddf2 ca                     DEX                                                 ; decrement loop counter
 11040  ddf3 d0f8                   BNE -                                               ; if (not finished looping) do it again
 11041                          
 11042  ddf5 a005                   LDY #.eventIntervalTimerCrossingZero                ; at this point all the interval timer bytes are zero
 11043  ddf7 2094e4                 JSR .eventEntryPoint                                ; call EVENT 5 interval timer
 11044                          
 11045                              ; Update INKEY timeout. Used when reading a key within a time limit.
 11046                          +
 11047  ddfa adb102                 LDA .inkeyTimeoutCounterLow                         ; get low byte of inkey countdown timer
 11048  ddfd d008                   BNE +                                               ; if (inkey timer is non-zero) then branch forward
 11049  ddff adb202                 LDA .inkeyTimeoutCounterHigh                        ; get high byte of inkey countdown timer
 11050  de02 f006                   BEQ ++                                              ; if (inkey timer is zero) then branch forward
 11051  de04 ceb202                 DEC .inkeyTimeoutCounterHigh                        ; decrement high byte
 11052                          +
 11053  de07 ceb102                 DEC .inkeyTimeoutCounterLow                         ; and decrement low byte
 11054                          
 11055                              ; Update sound.
 11056                          ++
 11057  de0a 2cce02                 BIT .soundIsUpdatingFlag                            ; check bit 7 of sound flag
 11058                                                                                  ; (this bit is set while processing
 11059                                                                                  ; sound interrupt. check so we don't
 11060                                                                                  ; try to process a second sound
 11061                                                                                  ; interrupt while still processing
 11062                                                                                  ; the first)
 11063  de0d 100b                   BPL +                                               ; if (bit clear; still processing)
 11064                                                                                  ; then branch (skip forward)
 11065  de0f eece02                 INC .soundIsUpdatingFlag                            ; increment to 0 (to signify that
 11066                                                                                  ; sound is being processed here)
 11067  de12 58                     CLI                                                 ; allow interrupts briefly
 11068  de13 2047eb                 JSR .processSoundInterrupt                          ; process sound
 11069  de16 78                     SEI                                                 ; disable interrupts
 11070  de17 cece02                 DEC .soundIsUpdatingFlag                            ; decrement 'sound is updating' flag
 11071                                                                                  ; back to $FF (this signifies that we
 11072                                                                                  ; are done processing the sound)
 11073                          
 11074                              ; Update speech.
 11075                          +
 11076  de1a 2cd702                 BIT .speechBufferEmptyFlag                          ; check speech buffer empty flag
 11077  de1d 300c                   BMI +                                               ; if (speech buffer is empty) then
 11078                                                                                  ; branch (skip speech)
 11079  de1f 206dee                 JSR .osbyte158EntryPoint                            ; read speech processor status register
 11080  de22 49a0                   EOR #%10100000                                      ; flip two bits
 11081  de24 c960                   CMP #%01100000                                      ; check
 11082  de26 9003                   BCC +                                               ; if (result < $60) then branch
 11083  de28 2079dd                 JSR .updateSpeech                                   ; process speech
 11084                          
 11085                              ; Update ACIA.
 11086                          +
 11087  de2b 2cb7d9                 BIT .allBitsSet                                     ; set V flag
 11088  de2e 20a2dc                 JSR .irq1CheckACIA                                  ; update ACIA
 11089                          
 11090                              ; Update keyboard.
 11091  de31 a5ec                   LDA .lastKeyPressedInternal                         ; } check if a key is currently
 11092  de33 05ed                   ORA .firstKeyPressedInternal                        ; } pressed
 11093  de35 2d4202                 AND .enableKeyboardInterruptProcessingFlag          ; ignore key presses if the flag
 11094                                                                                  ; is zero
 11095  de38 f004                   BEQ +                                               ; if (no key pressed or we should
 11096                                                                                  ; ignore keys pressed) then branch
 11097                                                                                  ; (ignore keyboard)
 11098  de3a 38                     SEC                                                 ; set carry
 11099  de3b 2065f0                 JSR .keyboardInterruptRoutine                       ; handle keyboard interrupt
 11100                          
 11101                              ; Update printer.
 11102                          +
 11103  de3e 209be1                 JSR .printerServiceCallIfNotEmpty                   ; check for data in printer buffer
 11104                          
 11105                              ; Update ADC conversion.
 11106  de41 2cc0fe                 BIT .adcDataStatusRegister                          ; check ADC status register
 11107  de44 7004                   BVS .handleADCConversionEnds                        ; if (bit 6 is set, i.e. ADC not
 11108                                                                                  ; busy) then branch
 11109                          
 11110  de46 60                     RTS                                                 ;
 11111                          
 11112                          
 11113                          ; ***************************************************************************************
 11114                          ;
 11115                          ; IRQ1 Interrupt - Analogue to Digital Conversion (End of Conversion)
 11116                          ;
 11117                          ; See .osbyte17EntryPoint
 11118                          ;
 11119                          ; ***************************************************************************************
 11120                          .irq1CheckSystemVIAADCEndConversion
 11121  de47 2a                     ROL                                                 ; put original bit 4 from .systemVIAInterruptFlagRegister into bit 7 of A
 11122  de48 1028                   BPL .irq1CheckSystemVIAKeyboard                     ; if (not an ADC conversion interrupt) then branch
 11123                          
 11124                          .handleADCConversionEnds
 11125  de4a ae4c02                 LDX .adcCurrentChannel                              ; get current ADC channel
 11126  de4d f01d                   BEQ .clearInterrupt4                                ; if (zero) then branch (clear interrupt and exit)
 11127                          
 11128  de4f adc2fe                 LDA .adcDataLowByte                                 ; read low data byte
 11129  de52 9db502                 STA .lowByteLastByteFromADCChannel1 - 1,X           ; store it in memory
 11130  de55 adc1fe                 LDA .adcDataHighByte                                ; get high data byte
 11131  de58 9db902                 STA .highByteLastByteFromADCChannel1 - 1,X          ; and store it in high byte
 11132  de5b 8ebe02                 STX .adcLastChannelRead                             ; store last ADC channel read
 11133  de5e a003                   LDY #.eventADCConversionComplete                    ; handle event 3 conversion complete
 11134  de60 2094e4                 JSR .eventEntryPoint                                ;
 11135                          
 11136  de63 ca                     DEX                                                 ; decrement X
 11137  de64 d003                   BNE +                                               ; if (X != 0) then branch forward
 11138  de66 ae4d02                 LDX .maximumADCChannelNumber                        ; get highest ADC channel present
 11139                          +
 11140  de69 208fde                 JSR .startADCConversion                             ; start new conversion
 11141                          .clearInterrupt4
 11142  de6c a910                   LDA #%00010000                                      ; reset interrupt 4
 11143                          .storeToSystemVIAIFR
 11144  de6e 8d4dfe                 STA .systemVIAInterruptFlagRegister                 ;
 11145  de71 60                     RTS                                                 ;
 11146                          
 11147                          ; ***************************************************************************************
 11148                          ;
 11149                          ; IRQ1 Interrupt - keyboard
 11150                          ;
 11151                          ; ***************************************************************************************
 11152                          .irq1CheckSystemVIAKeyboard
 11153  de72 2a                     ROL                                                 ; get original bit 0 in bit 7 position
 11154  de73 2a                     ROL                                                 ;
 11155  de74 2a                     ROL                                                 ;
 11156  de75 2a                     ROL                                                 ;
 11157  de76 1007                   BPL +                                               ; if (not a keyboard interrupt) then branch (skip keyboard processing)
 11158  de78 2065f0                 JSR .keyboardInterruptRoutine                       ; scan keyboard
 11159  de7b a901                   LDA #%00000001                                      ; }
 11160  de7d d0ef                   BNE .storeToSystemVIAIFR                            ; } reset interrupt 0 and return
 11161                          +
 11162  de7f 4cf3dc                 JMP .unrecognisedInterrupt                          ;
 11163                          
 11164                          ; ***************************************************************************************
 11165                          .restoreRegistersAndReturnFromInterrupt
 11166  de82 68                     PLA                                                 ; restore AXY registers
 11167  de83 a8                     TAY                                                 ;
 11168  de84 68                     PLA                                                 ;
 11169  de85 aa                     TAX                                                 ;
 11170  de86 68                     PLA                                                 ;
 11171  de87 85fc                   STA .interruptAccumulator                           ; store A
 11172                              ; fall through...
 11173                          
 11174                          ; ***************************************************************************************
 11175                          ;
 11176                          ; Default IRQ2 handler - does nothing
 11177                          ;
 11178                          ; ***************************************************************************************
 11179                          .irq2Handler
 11180  de89 a5fc                   LDA .interruptAccumulator                           ; get back original value of A
 11181  de8b 40                     RTI                                                 ; return
 11182                          
 11183                          ; ***************************************************************************************
 11184                          ;
 11185                          ; OSBYTE 17 - Start ADC conversions
 11186                          ;
 11187                          ; See 7002.png
 11188                          ;
 11189                          ; Analogue to digital conversion is performed by the ADC 7002 chip. It has four channels
 11190                          ; of data that can be read. This is often used to read an analogue joystick. This starts
 11191                          ; the conversion happening. They will keep happening until OSBYTE 16 with X=0 is called.
 11192                          ;
 11193                          ; OSBYTE 16 selects the range of channels to convert (0-4). See .osbyte16EntryPoint.
 11194                          ;
 11195                          ; OSBYTE 190 selects the ADC conversion type (8 or 12 bits). See .adcConversionType.
 11196                          ; Twelve bit conversion is the default (which takes about 10ms). Eight bit conversions are
 11197                          ; faster at around 4ms.
 11198                          ;
 11199                          ; The ADC 7002 generates an interrupt when the conversion is complete, and the IRQ1 handler
 11200                          ; stores the two byte result (in .lowByteLastByteFromADCChannel1 and upwards). It also
 11201                          ; starts the next conversion. See .irq1CheckSystemVIAADCEndConversion.
 11202                          ;
 11203                          ; OSBYTE 128 reads the latest converted ADC value (X=ADC channel 1-4). See .osbyte128EntryPoint.
 11204                          ; OSBYTE 128 can also read the state of the fire buttons. (X=0). See .osbyte128EntryPoint.
 11205                          ; These are encapsulated in the BASIC ADVAL command.
 11206                          ;
 11207                          ; On Entry:
 11208                          ;       X = ADC channel number (1-4)
 11209                          ;       Y = 0
 11210                          ;
 11211                          ; ***************************************************************************************
 11212                          .osbyte17EntryPoint
 11213  de8c 8cbe02                 STY .adcLastChannelRead                             ; set last channel to finish conversion (to zero)
 11214                          .startADCConversion
 11215  de8f e005                   CPX #5                                              ;
 11216  de91 9002                   BCC +                                               ; if (X < 5) then branch (skip forward)
 11217  de93 a204                   LDX #4                                              ; X=4 (maximum)
 11218                          +
 11219  de95 8e4c02                 STX .adcCurrentChannel                              ; store it as current ADC channel
 11220  de98 ac4e02                 LDY .adcConversionType                              ; get conversion type
 11221  de9b 88                     DEY                                                 ; decrement
 11222  de9c 98                     TYA                                                 ; A=Y
 11223  de9d 2908                   AND #%00001000                                      ; clear to zero except for bit 3 set
 11224                                                                                  ; indicates a 12 bit conversion
 11225  de9f 18                     CLC                                                 ; } add the ADC channel (1-4)
 11226  dea0 6d4c02                 ADC .adcCurrentChannel                              ; } then subtract one, effectively
 11227  dea3 e900                   SBC #0                                              ; } adding channel (0-3) into bits 0-2
 11228  dea5 8dc0fe                 STA .adcStartConversionRegister                     ; store value to start ADC conversion
 11229  dea8 60                     RTS                                                 ;
 11230                          
 11231                          ; ***************************************************************************************
 11232                          ;
 11233                          ; Display string on screen
 11234                          ;
 11235                          ; Display the boot message (e.g. 'BBC Computer 32K') and language ROM title (e.g. 'BASIC')
 11236                          ;
 11237                          ; On Entry:
 11238                          ;       Y = offset from page of .vduBaseAddress to start of string -1
 11239                          ;
 11240                          ; ***************************************************************************************
 11241                          .displayString
 11242  dea9 a9c3                   LDA #>.vduBaseAddress                               ; Start of string area (high byte)
 11243                          .displayStringAY
 11244  deab 85fe                   STA .displayStringAddressHigh                       ; store it
 11245  dead a900                   LDA #0                                              ; Low byte is zero (we use Y to index to correct string)
 11246  deaf 85fd                   STA .displayStringAddressLow                        ; store it and start loop
 11247                              ; fall through...
 11248                          
 11249                          ; ***************************************************************************************
 11250                          .printMessage
 11251  deb1 c8                     INY                                                 ; print character in string
 11252  deb2 b1fd                   LDA (.displayStringAddressLow),Y                    ; pointed to by $FD/E
 11253  deb4 20e3ff                 JSR .OSASCI                                         ; print it expanding Carriage returns
 11254  deb7 aa                     TAX                                                 ; store A in X
 11255  deb8 d0f7                   BNE .printMessage                                   ; and loop again if not zero
 11256  deba 60                     RTS                                                 ;
 11257                          
 11258                          ; ***************************************************************************************
 11259                          ; On Entry:
 11260                          ;       X/Y holds the time limit
 11261                          .osbyte129Timed
 11262  debb 8eb102                 STX .inkeyTimeoutCounterLow                         ; store time in INKEY countdown timer
 11263  debe 8cb202                 STY .inkeyTimeoutCounterHigh                        ; which is decremented every 10ms
 11264  dec1 a9ff                   LDA #255                                            ;
 11265  dec3 d002                   BNE .readCharacterTimed                             ; ALWAYS branch
 11266                          
 11267                          ; ***************************************************************************************
 11268                          ; ***************************************************************************************
 11269                          ;
 11270                          ; Chapter 12: Command Line Interpreter (star commands)
 11271                          ;
 11272                          ; ***************************************************************************************
 11273                          ; ***************************************************************************************
 11274                          
 11275                          ; ***************************************************************************************
 11276                          ;
 11277                          ; Introduction
 11278                          ;
 11279                          ; The Command Line Interpreter is responsible for executing star commands. There are a number
 11280                          ; built in to the system (see .starCommandTable), and more can be added via paged ROMs.
 11281                          ;
 11282                          ; The commands can have parameters as integer decimal, hexadecimal values, and strings.
 11283                          ; These commands have characters in the range 32-126, but can encode control codes and other
 11284                          ; non-printable characters. It uses GSINIT and GSREAD to convert the set of ASCII printable
 11285                          ; string characters into a full 8-bit ASCII converted values. See .gsinitEntryPoint .
 11286                          ;
 11287                          ; This chapter contains integer (in string form) to byte conversion,
 11288                          ; see .parseDecimalNumberFromString. A conversion for a hex digit in string form to a byte,
 11289                          ; see .readHexDigit, which is used to read a wole 32 bit address, see .readOSFILEAddress .
 11290                          ;
 11291                          ; Historical note: Every Acorn computer from the System 2 onwards has a CLI, and the
 11292                          ; asterisk probably derives from the System 2's use of it as a prompt character.
 11293                          ;
 11294                          ; ***************************************************************************************
 11295                          
 11296                          ; ***************************************************************************************
 11297                          ;
 11298                          ; OSRDCH - Read a character
 11299                          ;       This reads from an EXEC file if open, or the current input buffer otherwise
 11300                          ;
 11301                          ; On Entry:
 11302                          ;       A = 0 for reading a key instantly
 11303                          ;       A = 255 for reading a key with a time limit
 11304                          ;
 11305                          ; ***************************************************************************************
 11306                          .osrdchEntryPoint
 11307  dec5 a900                   LDA #0                                              ;
 11308                          .readCharacterTimed
 11309  dec7 85e6                   STA .readCharacterTimedFlag                         ; store A (0 or 255) to indicate if it's a timed read
 11310  dec9 8a                     TXA                                                 ; }
 11311  deca 48                     PHA                                                 ; }
 11312  decb 98                     TYA                                                 ; } store X and Y
 11313  decc 48                     PHA                                                 ; }
 11314  decd ac5602                 LDY .execFileHandle                                 ; get *EXEC file handle
 11315  ded0 f014                   BEQ .readCharacterFromCurrentInputBufferLoop        ; if (zero, i.e. no EXEC file open) then branch
 11316                          
 11317                              ; read from an EXEC file
 11318  ded2 38                     SEC                                                 ; set carry
 11319  ded3 66eb                   ROR .tapeCritical                                   ; set bit 7 of tape filing system active flag to prevent clashes
 11320  ded5 20d7ff                 JSR .OSBGET                                         ; get a byte from the file
 11321  ded8 08                     PHP                                                 ; push flags to preserve carry
 11322  ded9 46eb                   LSR .tapeCritical                                   ; clear .tapeCritical flag
 11323  dedb 28                     PLP                                                 ; get back flags
 11324  dedc 9025                   BCC .pullAndReturn                                  ; if (character found) then branch (recall values and exit)
 11325  dede a900                   LDA #0                                              ; error reading from file, so close the file
 11326  dee0 8d5602                 STA .execFileHandle                                 ; store it in exec file handle
 11327  dee3 20ceff                 JSR .OSFIND                                         ; and close file via OSFIND
 11328                          
 11329                          .readCharacterFromCurrentInputBufferLoop
 11330  dee6 24ff                   BIT .escapeFlag                                     ; check ESCAPE flag
 11331  dee8 3016                   BMI .setEscapeConditionAndExit                      ; if (ESCAPE flag set) then branch (set escape condition and exit)
 11332  deea ae4102                 LDX .currentInputBuffer                             ; get current input buffer number
 11333  deed 2077e5                 JSR .readFromEconetOrSoftKeyOrInputBufferA          ; get a byte from current input buffer
 11334  def0 9011                   BCC .pullAndReturn                                  ; if (valid character found) then branch (exit)
 11335                          
 11336                          .checkForTiming
 11337  def2 24e6                   BIT .readCharacterTimedFlag                         ; check for timed read
 11338  def4 50f0                   BVC .readCharacterFromCurrentInputBufferLoop        ; if (this is not timed) then branch (go back and read byte from input buffer again)
 11339  def6 adb102                 LDA .inkeyTimeoutCounterLow                         ; check timers
 11340  def9 0db202                 ORA .inkeyTimeoutCounterHigh                        ;
 11341  defc d0e8                   BNE .readCharacterFromCurrentInputBufferLoop        ; if (timer is not zero) then branch (loop back and keep trying to read)
 11342  defe b005                   BCS +                                               ; if (timed out) then branch (exit without storing character read)
 11343                          
 11344                          .setEscapeConditionAndExit
 11345  df00 38                     SEC                                                 ;
 11346  df01 a91b                   LDA #.charESCAPE                                    ; ESCAPE character read
 11347                          
 11348                          .pullAndReturn
 11349  df03 85e6                   STA .readCharacterTimedFlag                         ; remember character read
 11350                          +
 11351  df05 68                     PLA                                                 ; }
 11352  df06 a8                     TAY                                                 ; } restore X,Y
 11353  df07 68                     PLA                                                 ; }
 11354  df08 aa                     TAX                                                 ; }
 11355  df09 a5e6                   LDA .readCharacterTimedFlag                         ; recall character read
 11356  df0b 60                     RTS                                                 ;
 11357                          
 11358                          ; ***************************************************************************************
 11359                          ;
 11360                          ; Copyright string
 11361                          ; Only used as part of the check for valid Paged ROM, never printed
 11362                          ;
 11363                          ; ***************************************************************************************
 11364                          .copyrightString
 11365  df0c 29432800               !text ")C(",0                                       ; Copyright string (backwards)
 11366                          
 11367                          ; ***************************************************************************************
 11368                          ;
 11369                          ; Star command table
 11370                          ;
 11371                          ; *. <directory>                Synonym of *CAT
 11372                          ; *FX <a>,<x>,<y>               Calls OSBYTE
 11373                          ; *BASIC                        Start BASIC
 11374                          ; *CAT <directory>              Show catalogue from filing system
 11375                          ; *CODE <x>,<y>                 Execute code via USERV with A=0
 11376                          ; *EXEC <filename>              Execute a script file
 11377                          ; *HELP <string>                Get help
 11378                          ; *KEY <n> <string>             Define a soft key definition
 11379                          ; *LINE <string>                Execute code via USERV with A=1
 11380                          ; *LOAD <filename> <addr>       Load file
 11381                          ; *MOTOR <n>                    Turn on/off cassette motor
 11382                          ; *OPT <x>,<y>                  Set filing system options (Equivalent to OSBYTE 139)
 11383                          ; *RUN <filename>               Load and execute a file from the current filing system
 11384                          ; *ROM                          Set ROM filing system
 11385                          ; *SAVE <filename> <start> <end> <exec> <load> Save memory to the current filing system
 11386                          ; *SPOOL <filename>             Save keystrokes to the current filing system
 11387                          ; *TAPE <n>                     Set the TAPE filing system
 11388                          ; *TV <x>,<y>                   Adjust the TV display
 11389                          ;
 11390                          ; Commands can be abbreviated, e.g. *M. for *MOTOR.
 11391                          ;
 11392                          ; This list is not quite alphabetical, so that short abbreviations yield the more common
 11393                          ; commands, so *LOAD comes before *LINE so that *L. becomes *LOAD; and *R. becomes *RUN,
 11394                          ; not *ROM.
 11395                          ;
 11396                          ; The last entry is empty to catch anything else.
 11397                          ;
 11398                          ; After the name and address of each command is a single byte parameter that is passed in
 11399                          ; the accumulator before calling the routine's address. If the parameter has the top bit
 11400                          ; clear (*.; *BASIC; *CAT; *EXEC; *LOAD; *LINE; *RUN; *SAVE; *SPOOL), then the next part of
 11401                          ; the command line is decoded into a string (usually a pathname).
 11402                          ;
 11403                          ; A group of commands (*CODE; *MOTOR; *OPT; *TAPE; *ROM; *TV) are synonyms for *FX calls
 11404                          ; with the parameter being the OSBYTE number.
 11405                          ;
 11406                          ; Historical note: The Acorn System 2 star commands were *BASIC, *CAT, *LOAD, *SAVE, *GO,
 11407                          ; *RUN, *MEM, *MON, *NOMON, *DRIVE, *USE, and *FLOAD, while the Atom provided *CAT, *LOAD,
 11408                          ; *SAVE, *RUN, *MON, *NOMON, *FLOAD, and *DOS. Their CLIs each provide the dot abbreviation
 11409                          ; and have similar command-parsing code. But the System 2 and Atom monitors lack the ability
 11410                          ; to EXEC scripts, and have no comment notation. *FLOAD, "finish loading", allowed part of
 11411                          ; a file to be loaded into memory by ignoring its block numbers -- an ability which was,
 11412                          ; perhaps wisely, dropped from the BBC.
 11413                          ;
 11414                          ; ***************************************************************************************
 11415                          .starCommandTable
 11416  df10 2e                     !text "."                                           ; command name
 11417  df11 e031                   !be16 .passToCurrentFilingSystem                    ; address of routine to call
 11418  df13 05                     !byte 5                                             ; parameter to routine (in A)
 11419                          
 11420  df14 4658                   !text "FX"
 11421  df16 e342                   !be16 .fxEntryPoint
 11422  df18 ff                     !byte $FF
 11423                          
 11424  df19 4241534943             !text "BASIC"
 11425  df1e e018                   !be16 .basicEntryPoint
 11426  df20 00                     !byte 0
 11427                          
 11428  df21 434154                 !text "CAT"
 11429  df24 e031                   !be16 .passToCurrentFilingSystem
 11430  df26 05                     !byte 5
 11431                          
 11432  df27 434f4445               !text "CODE"
 11433  df2b e348                   !be16 .starCommandsForSpecificOSBYTEs
 11434  df2d 88                     !byte $88
 11435                          
 11436  df2e 45584543               !text "EXEC"
 11437  df32 f68d                   !be16 .closeAndOptionallyOpenANewEXECFile
 11438  df34 00                     !byte 0
 11439                          
 11440  df35 48454c50               !text "HELP"
 11441  df39 f0b9                   !be16 .starHelp
 11442  df3b ff                     !byte $FF
 11443                          
 11444  df3c 4b4559                 !text "KEY"
 11445  df3f e327                   !be16 .starKey
 11446  df41 ff                     !byte $FF
 11447                          
 11448  df42 4c4f4144               !text "LOAD"
 11449  df46 e23c                   !be16 .starLoad
 11450  df48 00                     !byte 0
 11451                          
 11452  df49 4c494e45               !text "LINE"
 11453  df4d e659                   !be16 .uservJumper
 11454  df4f 01                     !byte 1
 11455                          
 11456  df50 4d4f544f52             !text "MOTOR"
 11457  df55 e348                   !be16 .starCommandsForSpecificOSBYTEs
 11458  df57 89                     !byte $89
 11459                          
 11460  df58 4f5054                 !text "OPT"
 11461  df5b e348                   !be16 .starCommandsForSpecificOSBYTEs
 11462  df5d 8b                     !byte $8B
 11463                          
 11464  df5e 52554e                 !text "RUN"
 11465  df61 e031                   !be16 .passToCurrentFilingSystem
 11466  df63 04                     !byte 4
 11467                          
 11468  df64 524f4d                 !text "ROM"
 11469  df67 e348                   !be16 .starCommandsForSpecificOSBYTEs
 11470  df69 8d                     !byte $8D
 11471                          
 11472  df6a 53415645               !text "SAVE"
 11473  df6e e23e                   !be16 .starLoadSave
 11474  df70 00                     !byte 0
 11475                          
 11476  df71 53504f4f4c             !text "SPOOL"
 11477  df76 e281                   !be16 .starSpool
 11478  df78 00                     !byte 0
 11479                          
 11480  df79 54415045               !text "TAPE"
 11481  df7d e348                   !be16 .starCommandsForSpecificOSBYTEs
 11482  df7f 8c                     !byte $8C
 11483                          
 11484  df80 5456                   !text "TV"
 11485  df82 e348                   !be16 .starCommandsForSpecificOSBYTEs
 11486  df84 90                     !byte $90
 11487                          
 11488                              !text ""
 11489  df85 e031                   !be16 .passToCurrentFilingSystem
 11490  df87 03                     !byte 3
 11491  df88 00                     !byte 0
 11492                          
 11493                          
 11494                          ; ***************************************************************************************
 11495                          ;
 11496                          ; OSCLI - Command Line Interpreter
 11497                          ;       the default handler for CLIV vector
 11498                          ;
 11499                          ; On Entry:
 11500                          ;       XY is the address of the command line (terminated with a carriage return)
 11501                          ;
 11502                          ; On Exit:
 11503                          ;       A,X,Y,Flags undefined
 11504                          ;
 11505                          ; ***************************************************************************************
 11506                          .oscliEntryPoint
 11507  df89 86f2                   STX .stringInputBufferAddressLow                    ; Store XY in .stringInputBufferAddressLow/High
 11508  df8b 84f3                   STY .stringInputBufferAddressHigh                   ;
 11509  df8d a908                   LDA #8                                              ;
 11510  df8f 2031e0                 JSR .passToCurrentFilingSystem                      ; Inform filing system CLI being processed
 11511  df92 a000                   LDY #0                                              ; loop counter
 11512                          -
 11513  df94 b1f2                   LDA (.stringInputBufferAddressLow),Y                ; Check the line is correctly terminated
 11514  df96 c90d                   CMP #.charRETURN                                    ; loop until CR is found
 11515  df98 f004                   BEQ .stringOK                                       ;
 11516  df9a c8                     INY                                                 ; move to next character
 11517  df9b d0f7                   BNE -                                               ; loop back if less than 256 bytes long
 11518  df9d 60                     RTS                                                 ; string is > 255 characters, so return
 11519                          
 11520                              ; String is terminated ok - now skip prepended spaces and '*'s
 11521                          .stringOK
 11522  df9e a0ff                   LDY #$FF                                            ; Y = offset into string (which is about to be incremented so it will start at zero)
 11523                          -
 11524  dfa0 2039e0                 JSR .incAndSkipSpaces                               ; Skip any spaces
 11525  dfa3 f072                   BEQ .exit15                                         ; if (CR found) then branch (return)
 11526  dfa5 c92a                   CMP #.charSTAR                                      ; check for '*'
 11527  dfa7 f0f7                   BEQ -                                               ; if ('*' found) then branch (Loop back to skip it and skip spaces again)
 11528                          
 11529  dfa9 203ae0                 JSR .skipSpacesAndCheckForCRInStringInput           ; doesn't need to move forward, but checks if the current character is CR
 11530  dfac f069                   BEQ .exit15                                         ; if (CR found) then branch (exit)
 11531  dfae c97c                   CMP #.charBAR                                       ; check for '|' (a comment)
 11532  dfb0 f065                   BEQ .exit15                                         ; if ('|' found) then branch (exit)
 11533  dfb2 c92f                   CMP #.charFORWARDSLASH                              ; check for '/'
 11534  dfb4 d008                   BNE .startLookingForCommand                         ; if (NOT forward slash) then branch forward
 11535  dfb6 c8                     INY                                                 ; Move past the '/'
 11536  dfb7 2009e0                 JSR .convertStringInputPointerToXY                  ; Convert the address (.stringInputBufferAddressLow/High + Y) into XY
 11537  dfba a902                   LDA #2                                              ; 2 = execute "*/" command (See NAUG Section 16.1.7 - FSCV, Page 256-7)
 11538  dfbc d073                   BNE .passToCurrentFilingSystem                      ; ALWAYS branch (call into current filing system service routine)
 11539                          
 11540                          ; ***************************************************************************************
 11541                          ;
 11542                          ; Start looking for command
 11543                          ;
 11544                          ; Look command up in command table
 11545                          ; ***************************************************************************************
 11546                          .startLookingForCommand
 11547  dfbe 84e6                   STY .currentStringPointer                           ; Store offset to start of command in command line
 11548  dfc0 a200                   LDX #0                                              ; start of command
 11549  dfc2 f013                   BEQ .lookForCommand                                 ; ALWAYS branch
 11550                          
 11551                          ; ***************************************************************************************
 11552                          ;
 11553                          ; Compare character in A in a star command
 11554                          ;
 11555                          ; ***************************************************************************************
 11556                          .compareCharacterInCommand
 11557  dfc4 5d10df                 EOR .starCommandTable,X                             ; compare with character from star command table
 11558  dfc7 29df                   AND #%11011111                                      ; ignore case (zero the bit that distinguishes between upper and lower case)
 11559  dfc9 d017                   BNE .namesDontMatch                                 ; if (no match) then branch
 11560  dfcb c8                     INY                                                 ; increment offset in command line
 11561  dfcc 18                     CLC                                                 ; test next character
 11562                          
 11563                          .atEndOfCommandName
 11564  dfcd b025                   BCS .foundMatchForCommand                           ;
 11565  dfcf e8                     INX                                                 ; increment offset in star command table
 11566  dfd0 b1f2                   LDA (.stringInputBufferAddressLow),Y                ; read next character in command line
 11567  dfd2 20e3e4                 JSR .isLetter                                       ; carry clear if letter in A
 11568  dfd5 90ed                   BCC .compareCharacterInCommand                      ;
 11569                          
 11570                          .lookForCommand
 11571  dfd7 bd10df                 LDA .starCommandTable,X                             ; read byte from command table
 11572  dfda 3016                   BMI .endOfCommandStringFound                        ; if (top bit set, i.e. end of command name string) then branch
 11573  dfdc b1f2                   LDA (.stringInputBufferAddressLow),Y                ; read byte from command line
 11574  dfde c92e                   CMP #.charDOT                                       ; check for '.'
 11575  dfe0 f004                   BEQ .foundDot                                       ; if (dot character found) then branch
 11576                          
 11577                          .namesDontMatch
 11578  dfe2 18                     CLC                                                 ;
 11579  dfe3 a4e6                   LDY .currentStringPointer                           ;
 11580  dfe5 88                     DEY                                                 ;
 11581                          
 11582                          .foundDot
 11583  dfe6 c8                     INY                                                 ;
 11584  dfe7 e8                     INX                                                 ;
 11585                          
 11586                          -
 11587  dfe8 e8                     INX                                                 ;
 11588  dfe9 bd0edf                 LDA .starCommandTable-2,X                           ;
 11589  dfec f033                   BEQ .passCommandToROMs                              ; reached end of table; unrecognised star command
 11590  dfee 10f8                   BPL -                                               ; if (top bit clear, i.e. not yet end of command name) then branch back (move to next character)
 11591  dff0 30db                   BMI .atEndOfCommandName                             ; ALWAYS branch (loop back)
 11592                          
 11593                          ; ***************************************************************************************
 11594                          .endOfCommandStringFound
 11595  dff2 e8                     INX                                                 ;
 11596  dff3 e8                     INX                                                 ;
 11597                          
 11598                          .foundMatchForCommand
 11599  dff4 ca                     DEX                                                 ;
 11600  dff5 ca                     DEX                                                 ;
 11601  dff6 48                     PHA                                                 ; push star command address (high byte)
 11602  dff7 bd11df                 LDA .starCommandTable+1,X                           ;  get star command address (low byte)
 11603  dffa 48                     PHA                                                 ; push star command address (low byte)
 11604  dffb 203ae0                 JSR .skipSpacesAndCheckForCRInStringInput           ; skip over the following spaces
 11605  dffe 18                     CLC                                                 ; clear carry
 11606  dfff 08                     PHP                                                 ; push flags
 11607  e000 2004e0                 JSR .prepareRegistersForStarCommand                 ; prepare the A,X,Y registers for the call to star command routine
 11608                          
 11609                              ; the RTI instruction restores the flags, and jumps to the address we've just put on
 11610                              ; the stack. (i.e. jumps to the star command routine.)
 11611  e003 40                     RTI                                                 ; jump to star command routine
 11612                          
 11613                          ; ***************************************************************************************
 11614                          .prepareRegistersForStarCommand
 11615  e004 bd12df                 LDA .starCommandTable+2,X                           ; Get A parameter from table
 11616  e007 300e                   BMI .exit15                                         ; if (top bit set, this implies the
 11617                                                                                  ; command has no string parameter, but
 11618                                                                                  ; there may be numeric parameters)
 11619                                                                                  ; then branch (exit, we are done)
 11620                                                                                  ; otherwise we set XY to be the rest
 11621                                                                                  ; of the command line (i.e. string
 11622                                                                                  ; based)
 11623                              ; fall through...
 11624                          
 11625                          ; ***************************************************************************************
 11626                          ;
 11627                          ; Convert string input pointer to XY
 11628                          ;
 11629                          ; On Entry:
 11630                          ;       X is the offset into the starCommandTable at the end of the string
 11631                          ;       Y is the offset into the string at .stringInputBufferAddressLow/High
 11632                          ;
 11633                          ; On Exit:
 11634                          ;       XY = (.stringInputBufferAddressLow/High + A)
 11635                          ;       A = parameter from star command table
 11636                          ;
 11637                          ; ***************************************************************************************
 11638                          .convertStringInputPointerToXY
 11639  e009 98                     TYA                                                 ; Pass Y line offset to A for later
 11640  e00a bc12df                 LDY .starCommandTable+2,X                           ; Get A parameter from table
 11641                              ; fall through...
 11642                          
 11643                          ; ***************************************************************************************
 11644                          ;
 11645                          ; Convert string address to XY
 11646                          ;
 11647                          ; On Entry:
 11648                          ;       A = is offset into string at .stringInputBufferAddressLow/High
 11649                          ;
 11650                          ; On Exit:
 11651                          ;       XY = .stringInputBufferAddressLow/High + A
 11652                          ;       A = original value of Y on entry
 11653                          ;
 11654                          ; ***************************************************************************************
 11655                          .convertStringAddressToXY
 11656  e00d 18                     CLC                                                 ;
 11657  e00e 65f2                   ADC .stringInputBufferAddressLow                    ;
 11658  e010 aa                     TAX                                                 ; low byte in X
 11659  e011 98                     TYA                                                 ; remember original Y into A
 11660  e012 a4f3                   LDY .stringInputBufferAddressHigh                   ; }
 11661  e014 9001                   BCC .exit15                                         ; } put high byte in Y, increment as needed
 11662  e016 c8                     INY                                                 ; }
 11663                          .exit15
 11664  e017 60                     RTS                                                 ;
 11665                          
 11666                          
 11667                          ; ***************************************************************************************
 11668                          ;
 11669                          ; *BASIC
 11670                          ;
 11671                          ; This command enters the BASIC language environment. The BASIC ROM is unique among Paged ROMs
 11672                          ; in not having a service entry. If it did, then the *BASIC command could be implemented in
 11673                          ; the BASIC ROM instead of here.
 11674                          ;
 11675                          ; ***************************************************************************************
 11676                          .basicEntryPoint
 11677  e018 ae4b02                 LDX .basicROMNumber                                 ; Get BASIC ROM number
 11678  e01b 3004                   BMI .passCommandToROMs                              ; if (no BASIC found) then branch (pass command on to ROMs)
 11679  e01d 38                     SEC                                                 ; Set Carry = not entering from RESET
 11680  e01e 4ce7db                 JMP .osbyte142EntryPoint                            ; Enter language ROM in X
 11681                          
 11682                          ; ***************************************************************************************
 11683                          ;
 11684                          ; Pass command to ROMs
 11685                          ;
 11686                          ; Pass command on to Paged ROMs and to filing system
 11687                          ;
 11688                          ; ***************************************************************************************
 11689                          .passCommandToROMs
 11690  e021 a4e6                   LDY .currentStringPointer                           ; Restore pointer to start of command
 11691  e023 a204                   LDX #.romServiceCallUnrecognisedCommand             ; 4 = Unrecognised star command
 11692  e025 2068f1                 JSR .osbyte143EntryPoint                            ; Pass to sideways ROMs
 11693  e028 f0ed                   BEQ .exit15                                         ; if (claimed by ROM) then branch (exit)
 11694  e02a a5e6                   LDA .currentStringPointer                           ; Restore pointer to start of command
 11695  e02c 200de0                 JSR .convertStringAddressToXY                       ; Convert .stringInputBufferAddressLow/High+A to XY, ignore returned A
 11696  e02f a903                   LDA #3                                              ; 3 = Auto-boot call
 11697                          
 11698                          .passToCurrentFilingSystem
 11699  e031 6c1e02                 JMP (.vectorFSCV)                                   ; call into current filing system
 11700                                                                                  ; handler (for default handler,
 11701                                                                                  ; see .fscEntryPoint)
 11702                          
 11703                          ; ***************************************************************************************
 11704                          ;
 11705                          ; OSBYTE 139 - Select file options (*OPT)
 11706                          ;
 11707                          ; See .starOptEntryPoint for parameters
 11708                          ;
 11709                          ; On Entry:
 11710                          ;       X,Y hold the *OPT parameters
 11711                          ;
 11712                          ; ***************************************************************************************
 11713                          .osbyte139EntryPoint
 11714  e034 0a                     ASL                                                 ; Double A (clear bit zero)
 11715                              ; fall through...
 11716                          
 11717                          ; ***************************************************************************************
 11718                          ;
 11719                          ; OSBYTE 127 - Check for EOF on open file
 11720                          ;
 11721                          ; On Entry:
 11722                          ;       X = file handle
 11723                          ;
 11724                          ; ***************************************************************************************
 11725                          .osbyte127EntryPoint
 11726  e035 2901                   AND #1                                              ; A = 1 if entry via OSBYTE 127
 11727                                                                                  ; A = 0 if entry via OSBYTE 139
 11728  e037 10f8                   BPL .passToCurrentFilingSystem                      ; ALWAYS branch (send *OPT command
 11729                                                                                  ; to the current filing system).
 11730                          
 11731                          ; ***************************************************************************************
 11732                          ;
 11733                          ; Skip spaces
 11734                          ;
 11735                          ; On Entry:
 11736                          ;       .stringInputBufferAddressLow/High is address of string to test
 11737                          ;       Y is the current offset within the string
 11738                          ;
 11739                          ; On Exit:
 11740                          ;       Y is incremented to the next non-space character
 11741                          ;       Z set if RETURN found (end of string)
 11742                          ;
 11743                          ; ***************************************************************************************
 11744                          .incAndSkipSpaces
 11745  e039 c8                     INY                                                 ; move to next character in string
 11746                          .skipSpacesAndCheckForCRInStringInput
 11747  e03a b1f2                   LDA (.stringInputBufferAddressLow),Y                ; read character from string
 11748  e03c c920                   CMP #.charSPACE                                     ; check for SPACE character
 11749  e03e f0f9                   BEQ .incAndSkipSpaces                               ; if (SPACE) then branch (loop back)
 11750                          .compareWithReturnAndExit
 11751  e040 c90d                   CMP #.charRETURN                                    ; set Z flag if charRETURN found
 11752  e042 60                     RTS                                                 ;
 11753                          
 11754                          ; ***************************************************************************************
 11755                          ;
 11756                          ; Skip spaces and comma
 11757                          ;
 11758                          ; Skip past any spaces, and check for CR
 11759                          ;
 11760                          ; On Entry:
 11761                          ;     if carry is clear, then skip SPACEs then look for RETURN
 11762                          ;     if carry is set, then skip SPACEs then skip a comma or look for a RETURN
 11763                          ;
 11764                          ; On Exit:
 11765                          ;       Y incremented past any spaces and comma
 11766                          ;       Z set if RETURN found
 11767                          ;
 11768                          ; ***************************************************************************************
 11769                          .skipSpacesAndComma
 11770  e043 90f5                   BCC .skipSpacesAndCheckForCRInStringInput           ; if (carry clear) then branch
 11771                          .skipSpacesAndCommaValid
 11772  e045 203ae0                 JSR .skipSpacesAndCheckForCRInStringInput           ;
 11773  e048 c92c                   CMP #.charCOMMA                                     ;
 11774  e04a d0f4                   BNE .compareWithReturnAndExit                       ;
 11775  e04c c8                     INY                                                 ; move to next character. Y is not
 11776                                                                                  ; zero so Z is set.
 11777  e04d 60                     RTS                                                 ;
 11778                          
 11779                          ; ***************************************************************************************
 11780                          ;
 11781                          ; Read a number (0-255) from string
 11782                          ;
 11783                          ; On Entry:
 11784                          ;       stringInputBufferAddressLow/High + Y is address of string holding a number
 11785                          ; On Exit:
 11786                          ;       X = result (value 0-255) also stored in .tempWorkspaceE6
 11787                          ;       Carry clear on error
 11788                          ;       Zero set if RETURN found
 11789                          ;
 11790                          ; ***************************************************************************************
 11791                          .parseDecimalNumberFromString
 11792  e04e 203ae0                 JSR .skipSpacesAndCheckForCRInStringInput           ; skip spaces
 11793  e051 207de0                 JSR .readDigitFromString                            ; read digit
 11794  e054 9037                   BCC .errorReadingString                             ; if (error found) then branch (clear carry and exit)
 11795                          
 11796                          .readingDigits
 11797  e056 85e6                   STA .tempWorkspaceE6                                ; store temporary result
 11798  e058 207ce0                 JSR .readNextDigitFromString                        ; read next digit 0-9
 11799  e05b 9019                   BCC .finishedParsingDigits                          ; if (not a digit) then branch (we have finished)
 11800  e05d aa                     TAX                                                 ; remember best valid result so far
 11801  e05e a5e6                   LDA .tempWorkspaceE6                                ; recall previous digit P
 11802  e060 0a                     ASL                                                 ; A=P*2
 11803  e061 b02a                   BCS .errorReadingString                             ; result too big, return with carry clear (error)
 11804  e063 0a                     ASL                                                 ; A=P*4
 11805  e064 b027                   BCS .errorReadingString                             ; result too big, return with carry clear (error)
 11806  e066 65e6                   ADC .tempWorkspaceE6                                ; A=(P*4)+P =P*5
 11807  e068 b023                   BCS .errorReadingString                             ; result too big, return with carry clear (error)
 11808  e06a 0a                     ASL                                                 ; A=P*10
 11809  e06b b020                   BCS .errorReadingString                             ; result too big, return with carry clear (error)
 11810  e06d 85e6                   STA .tempWorkspaceE6                                ; Store temporary result
 11811  e06f 8a                     TXA                                                 ; recall current digit
 11812  e070 65e6                   ADC .tempWorkspaceE6                                ; Add previous digit times ten
 11813  e072 b019                   BCS .errorReadingString                             ; result too big, return with carry clear (error)
 11814  e074 90e0                   BCC .readingDigits                                  ; ALWAYS branch back
 11815                          
 11816                          ; ***************************************************************************************
 11817                          .finishedParsingDigits
 11818  e076 a6e6                   LDX .tempWorkspaceE6                                ; get best valid result
 11819  e078 c90d                   CMP #.charRETURN                                    ; set Z flag if RETURN found
 11820  e07a 38                     SEC                                                 ; set carry (success flag)
 11821  e07b 60                     RTS                                                 ;
 11822                          
 11823                          ; ***************************************************************************************
 11824                          .readNextDigitFromString
 11825  e07c c8                     INY
 11826                          .readDigitFromString
 11827  e07d b1f2                   LDA (.stringInputBufferAddressLow),Y                ; get digit from string
 11828  e07f c93a                   CMP #.charNINE + 1                                  ; }
 11829  e081 b00a                   BCS .errorReadingString                             ; } check if digit is in range '0' to '9'
 11830  e083 c930                   CMP #.charZERO                                      ; }
 11831  e085 9006                   BCC .errorReadingString                             ; }
 11832  e087 290f                   AND #$0F                                            ; mask off bits to leave binary value 0-9
 11833  e089 60                     RTS                                                 ;
 11834                          
 11835                          ; ***************************************************************************************
 11836                          .notAHexByte
 11837  e08a 2045e0                 JSR .skipSpacesAndCommaValid                        ;
 11838                          
 11839                          .errorReadingString
 11840  e08d 18                     CLC                                                 ;
 11841  e08e 60                     RTS                                                 ;
 11842                          
 11843                          ; ***************************************************************************************
 11844                          ;
 11845                          ; Read hex digit
 11846                          ;
 11847                          ; On Exit:
 11848                          ;       on success, carry is set, A = 0-15, based on ascii digit in string (0-9,A-F)
 11849                          ;       on error, carry clear
 11850                          ;
 11851                          ; ***************************************************************************************
 11852                          .readHexDigit
 11853  e08f 207de0                 JSR .readDigitFromString                            ; read digit 0-9
 11854  e092 b00e                   BCS +                                               ; if (digit not in 0-9 range) then branch
 11855  e094 29df                   AND #%11011111                                      ; clear bit 5 (converts lower case letters to upper case)
 11856  e096 c947                   CMP #.charF + 1                                     ;
 11857  e098 b0f0                   BCS .notAHexByte                                    ; if (higher than 'F') then branch (exit with error)
 11858  e09a c941                   CMP #.charA                                         ;
 11859  e09c 90ec                   BCC .notAHexByte                                    ; if (lower than 'A') then branch (exit with error)
 11860  e09e 08                     PHP                                                 ; carry set, push flags
 11861  e09f e937                   SBC #.charA - 10                                    ; Convert to range 10-15
 11862  e0a1 28                     PLP                                                 ; restore flags (carry set, for successful result)
 11863                          +
 11864  e0a2 c8                     INY                                                 ; move on to next byte
 11865  e0a3 60                     RTS                                                 ;
 11866                          
 11867                          
 11868                          ; ***************************************************************************************
 11869                          ; ***************************************************************************************
 11870                          ;
 11871                          ; Chapter 13: Writing characters; printer; buffers
 11872                          ;
 11873                          ; ***************************************************************************************
 11874                          ; ***************************************************************************************
 11875                          
 11876                          ; ***************************************************************************************
 11877                          ;
 11878                          ; OSWRCH - write character
 11879                          ;
 11880                          ; This is the main entry point for writing characters to the display and/or to other devices
 11881                          ; such as ECONET, a printer, RS-423 or to a file.
 11882                          ;
 11883                          ; Note: the .characterDestinationsAvailableFlags has the following bits:
 11884                          ;
 11885                          ;   bit 0 - enable RS-423 driver
 11886                          ;   bit 1 - disable VDU driver
 11887                          ;   bit 2 - disable printer driver
 11888                          ;   bit 3 - enable printer, independent of VDU 2/3 (=CTRL B/C)
 11889                          ;   bit 4 - disable SPOOLed output
 11890                          ;   bit 5 - not used, zero
 11891                          ;   bit 6 - disable printer driver (unless preceded by VDU 1)
 11892                          ;   bit 7 - not used, zero
 11893                          ;
 11894                          ; On Entry:
 11895                          ;       A = character to write
 11896                          ; On Exit:
 11897                          ;       A, X, Y are preserved
 11898                          ;
 11899                          ; ***************************************************************************************
 11900                          .oswrchEntryPoint
 11901  e0a4 48                     PHA                                                 ; }
 11902  e0a5 8a                     TXA                                                 ; }
 11903  e0a6 48                     PHA                                                 ; } store A,X,Y registers
 11904  e0a7 98                     TYA                                                 ; }
 11905  e0a8 48                     PHA                                                 ; }
 11906  e0a9 ba                     TSX                                                 ; X = stack pointer
 11907  e0aa bd0301                 LDA .stackPage + 3,X                                ; peek into stack to get A value back
 11908  e0ad 48                     PHA                                                 ; push A again
 11909  e0ae 2c6002                 BIT .econetWriteCharacterInterceptionFlag           ; check OSWRCH interception flag
 11910  e0b1 1008                   BPL .skipEconetProcessing                           ; if (not set) then branch (skip Econet)
 11911  e0b3 a8                     TAY                                                 ; pass character to Y
 11912  e0b4 a904                   LDA #4                                              ; A=4 for OSWRCH service call
 11913  e0b6 207ee5                 JSR .netvJumper                                     ; call NETV code
 11914  e0b9 b052                   BCS .oswrchFinishUp                                 ; if (claimed) then branch (finish up and exit)
 11915                          
 11916                          .skipEconetProcessing
 11917  e0bb 18                     CLC                                                 ; prepare to not send this to printer
 11918  e0bc a902                   LDA #2                                              ; check output destination
 11919  e0be 2c7c02                 BIT .characterDestinationsAvailableFlags            ; is VDU driver disabled?
 11920  e0c1 d005                   BNE .skipVDUOutput                                  ; yes, skip past VDU driver
 11921  e0c3 68                     PLA                                                 ; pull character
 11922  e0c4 48                     PHA                                                 ; push character
 11923  e0c5 20c0c4                 JSR .vduChrEntryPoint                               ; call VDU driver
 11924                                                                                  ; on exit, C=1 if character to be sent to printer
 11925                          .skipVDUOutput
 11926  e0c8 a908                   LDA #8                                              ; check output destination
 11927  e0ca 2c7c02                 BIT .characterDestinationsAvailableFlags            ; is printer separately enabled?
 11928  e0cd d002                   BNE .printerEnabled                                 ; yes, jump to call printer driver
 11929  e0cf 9005                   BCC .printerDisabled                                ; carry clear, don't sent to printer
 11930                          
 11931                          .printerEnabled
 11932  e0d1 68                     PLA                                                 ; pull character
 11933  e0d2 48                     PHA                                                 ; push character
 11934  e0d3 2014e1                 JSR .sendCharacterToPrinter                         ; call printer driver
 11935                          
 11936                          .printerDisabled
 11937  e0d6 ad7c02                 LDA .characterDestinationsAvailableFlags            ; check output destination
 11938  e0d9 6a                     ROR                                                 ; check RS-423 output bit
 11939  e0da 901b                   BCC .skipRS423Output                                ; if (RS-423 output is disabled) then branch (skip past serial output)
 11940                          
 11941                              ; Check for timeout
 11942  e0dc a4ea                   LDY .rs423TimeoutCounter                            ; get RS-423 timout counter
 11943  e0de 88                     DEY                                                 ; decrease counter
 11944  e0df 1016                   BPL .skipRS423Output                                ; if (timed out) then branch (skip past serial code)
 11945                          
 11946                              ; RS-423 output
 11947  e0e1 68                     PLA                                                 ; pull character
 11948  e0e2 48                     PHA                                                 ; push character
 11949  e0e3 08                     PHP                                                 ; save IRQs
 11950  e0e4 78                     SEI                                                 ; disable IRQs
