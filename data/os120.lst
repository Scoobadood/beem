 12078                          ;
 12079                          ; OSBYTE 156 - Update ACIA Control Register and OS Copy
 12080                          ;
 12081                          ; write (current value AND Y) EOR X
 12082                          ; Preserves Y and flags
 12083                          ;
 12084                          ; ***************************************************************************************
 12085                          .osbyte156EntryPoint
 12086  e17c 08                     PHP                                                 ; push flags
 12087  e17d 78                     SEI                                                 ; disable interrupts
 12088  e17e 98                     TYA                                                 ; A=Y
 12089  e17f 86fa                   STX .tempStoreFA                                    ; .tempStoreFA=X
 12090  e181 2d5002                 AND .rs423ControlRegisterCopy                       ; A=old value AND Y EOR X
 12091  e184 45fa                   EOR .tempStoreFA                                    ;
 12092  e186 ae5002                 LDX .rs423ControlRegisterCopy                       ; get old value in X
 12093                          .storeACIAAndPull
 12094  e189 8d5002                 STA .rs423ControlRegisterCopy                       ; put new value in
 12095  e18c 8d08fe                 STA .acia6850ControlRegister                        ; and store to ACIA control register
 12096  e18f 28                     PLP                                                 ; get back flags
 12097                          .exit17
 12098  e190 60                     RTS                                                 ;
