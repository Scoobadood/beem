  6603  ce62 ed0b03                 SBC .vduTextWindowTop                               ; top of text window
  6604  ce65 85de                   STA .vduTempStoreDE                                 ; store height of text area
  6605  ce67 d005                   BNE .setTextCursorToLeftHandColumn                  ; set text column to left hand column
  6606  ce69 68                     PLA                                                 ; get back return address (to exit caller routine early)
