  6183  cc38 9d0042                 STA $4200,X                                         ;
  6184  cc3b 9d0043                 STA $4300,X                                         ;
  6185  cc3e 9d0044                 STA $4400,X                                         ;
  6186  cc41 9d0045                 STA $4500,X                                         ;
  6187  cc44 9d0046                 STA $4600,X                                         ;
  6188  cc47 9d0047                 STA $4700,X                                         ;
  6189  cc4a 9d0048                 STA $4800,X                                         ;
  6190  cc4d 9d0049                 STA $4900,X                                         ;
  6191  cc50 9d004a                 STA $4A00,X                                         ;
  6192  cc53 9d004b                 STA $4B00,X                                         ;
  6193  cc56 9d004c                 STA $4C00,X                                         ;
  6194  cc59 9d004d                 STA $4D00,X                                         ;
  6195  cc5c 9d004e                 STA $4E00,X                                         ;
  6196  cc5f 9d004f                 STA $4F00,X                                         ;
  6197  cc62 9d0050                 STA $5000,X                                         ;
  6198  cc65 9d0051                 STA $5100,X                                         ;
  6199  cc68 9d0052                 STA $5200,X                                         ;
  6200  cc6b 9d0053                 STA $5300,X                                         ;
  6201  cc6e 9d0054                 STA $5400,X                                         ;
  6202  cc71 9d0055                 STA $5500,X                                         ;
  6203  cc74 9d0056                 STA $5600,X                                         ;
  6204  cc77 9d0057                 STA $5700,X                                         ;
  6205                          
  6206                          .clearScreenRoutineEntryPointMODE45
  6207  cc7a 9d0058                 STA $5800,X                                         ;
  6208  cc7d 9d0059                 STA $5900,X                                         ;
  6209  cc80 9d005a                 STA $5A00,X                                         ;
  6210  cc83 9d005b                 STA $5B00,X                                         ;
  6211  cc86 9d005c                 STA $5C00,X                                         ;
  6212  cc89 9d005d                 STA $5D00,X                                         ;
  6213  cc8c 9d005e                 STA $5E00,X                                         ;
  6214  cc8f 9d005f                 STA $5F00,X                                         ;
  6215                          
  6216                          .clearScreenRoutineEntryPointMODE6
  6217  cc92 9d0060                 STA $6000,X                                         ;
  6218  cc95 9d0061                 STA $6100,X                                         ;
  6219  cc98 9d0062                 STA $6200,X                                         ;
  6220  cc9b 9d0063                 STA $6300,X                                         ;
  6221  cc9e 9d0064                 STA $6400,X                                         ;
  6222  cca1 9d0065                 STA $6500,X                                         ;
  6223  cca4 9d0066                 STA $6600,X                                         ;
  6224  cca7 9d0067                 STA $6700,X                                         ;
  6225  ccaa 9d0068                 STA $6800,X                                         ;
  6226  ccad 9d0069                 STA $6900,X                                         ;
  6227  ccb0 9d006a                 STA $6A00,X                                         ;
  6228  ccb3 9d006b                 STA $6B00,X                                         ;
  6229  ccb6 9d006c                 STA $6C00,X                                         ;
  6230  ccb9 9d006d                 STA $6D00,X                                         ;
  6231  ccbc 9d006e                 STA $6E00,X                                         ;
  6232  ccbf 9d006f                 STA $6F00,X                                         ;
  6233  ccc2 9d0070                 STA $7000,X                                         ;
  6234  ccc5 9d0071                 STA $7100,X                                         ;
  6235  ccc8 9d0072                 STA $7200,X                                         ;
  6236  cccb 9d0073                 STA $7300,X                                         ;
  6237  ccce 9d0074                 STA $7400,X                                         ;
  6238  ccd1 9d0075                 STA $7500,X                                         ;
  6239  ccd4 9d0076                 STA $7600,X                                         ;
  6240  ccd7 9d0077                 STA $7700,X                                         ;
  6241  ccda 9d0078                 STA $7800,X                                         ;
  6242  ccdd 9d0079                 STA $7900,X                                         ;
  6243  cce0 9d007a                 STA $7A00,X                                         ;
  6244  cce3 9d007b                 STA $7B00,X                                         ;
