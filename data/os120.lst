  1243                                                                                  ; (Read/Write using OSBYTE 204)
  1244                          .tapeRS423SelectionFlag                     = $025D     ; 0 = RS-423; $40 = TAPE (Comes into effect when using OSBYTE 7/8 to change)
  1245                                                                                  ; (Read/Write using OSBYTE 205)
