  1144                                                                                  ; (Read using OSBYTE 166/167)
  1145                          .romPointerTable                            = $0238     ; Constant value .extendedVectorSpace
  1146                                                                                  ; (Read using OSBYTE 168/169)
  1147                          .romInformationTable                        = $023A     ; Constant value .romTypeTable
  1148                                                                                  ; (Read using OSBYTE 170/171)
  1149                          .keyTranslationTable                        = $023C     ; Constant value .keyDataTable1 - 16
  1150                                                                                  ; (Read using OSBYTE 172/173)
  1151                          .vduVariablesTable                          = $023E     ; Constant value .vduVariablesStart
  1152                                                                                  ; (Read using OSBYTE 174/175)
  1153                          
  1154                          .verticalSyncCounter                        = $0240     ; decremented every vertical sync
  1155                                                                                  ; (Read/Write using OSBYTE 176)
  1156                          .currentInputBuffer                         = $0241     ; buffer number for current input
  1157                                                                                  ; (Read/Write using OSBYTE 177)
  1158                          .enableKeyboardInterruptProcessingFlag      = $0242     ; aka 'Keyboard semaphore'
  1159                                                                                  ; $00 = don't update key presses
  1160                                                                                  ;       on 100Hz interrupts
  1161                                                                                  ; $FF = key presses are processed
  1162                                                                                  ;       as normal
  1163                                                                                  ; (Read/Write using OSBYTE 178)
  1164                          .defaultOSHWM                               = $0243     ; default/primary High Water Mark.
  1165                                                                                  ; this is after Paged ROMs have
  1166                                                                                  ; asked for their workspace memory,
  1167                                                                                  ; but before soft character
  1168                                                                                  ; definitions have been 'exploded'.
  1169                                                                                  ; Initialised at RESET time, and
  1170                                                                                  ; otherwise remains constant.
  1171                                                                                  ; (Read/Write using OSBYTE 179)
  1172                          .currentOSHWM                               = $0244     ; current OS High Water Mark, which
  1173                                                                                  ; varies due to font explosions.
  1174                                                                                  ; (Read/Write using OSBYTE 180)
  1175                          .rs423Mode                                  = $0245     ; RS-423 mode (1 is default):
  1176                                                                                  ;   0 = treat RS-423 input the same
  1177                                                                                  ;       as the keyboard
  1178                                                                                  ;   1 = ESCAPE is ignored;
  1179                                                                                  ;       Soft keys are not expanded;
  1180                                                                                  ;       no events are triggered
  1181                                                                                  ; (Read/Write using OSBYTE 181)
  1182                          .softCharacterDefinitionsSwitch             = $0246     ; which ranges of characters are Soft
  1183                                                                                  ; character definitions (i.e. the
  1184                                                                                  ; value X used in *FX 20,X)
  1185                                                                                  ; (Read using OSBYTE 182 but note
  1186                                                                                  ; that this is incompatible with
  1187                                                                                  ; the Master series)
  1188                          .tapeOrROMSwitch                            = $0247     ; 0 is *TAPE, 2 = *ROM
  1189                                                                                  ; (Read/Write using OSBYTE 183)
  1190                          .videoULAVideoControlRegisterCopy           = $0248     ; OS copy of video control register
  1191                                                                                  ; (Read using OSBYTE 184)
  1192                          .videoULAPaletteValue                       = $0249     ; value last written to the palette:
  1193                                                                                  ; bits 0-3: physical colour EOR 7
  1194                                                                                  ; bits 4-7: logical colour
  1195                                                                                  ; (Read using OSBYTE 185)
  1196                          .romNumberActiveLastBRK                     = $024A     ; ROM socket number when last BRK occurred
  1197                                                                                  ; (Read using OSBYTE 186)
  1198                          .basicROMNumber                             = $024B     ; ROM socket number containing BASIC or $FF
  1199                                                                                  ; (Read using OSBYTE 187)
  1200                          .adcCurrentChannel                          = $024C     ; current ADC channel number
  1201                                                                                  ; (Read using OSBYTE 188)
  1202                          .maximumADCChannelNumber                    = $024D     ; read maximum ADC channel number
  1203                                                                                  ; (Read using OSBYTE 189)
  1204                          .adcConversionType                          = $024E     ; ADC conversion type:
  1205                                                                                  ; 0 = default (12 bits)
  1206                                                                                  ; 8 = 8 bits
  1207                                                                                  ; 12 = 12 bits
  1208                                                                                  ; (Read/Write using OSBYTE 190)
  1209                          .rs423ReadyFlag                             = $024F     ; bit 7 set means RS-423 is ready
  1210                                                                                  ; otherwise RS-423 is busy
  1211                                                                                  ; (Read/Write using OSBYTE 191)
  1212                          .rs423ControlRegisterCopy                   = $0250     ; OS copy of the RS-423 control flag
  1213                                                                                  ; (Read/Write using OSBYTE 192)
  1214                          .videoULAFlashingColourIntervalCount        = $0251     ; counts down time before flashing the colours
  1215                                                                                  ; (Read/Write using OSBYTE 193)
