  1273                                                                                  ; (Read/Write using OSBYTE 217)
  1274                          .twosComplimentOfNumberOfBytesInVDUQueue    = $026A     ; 255 - bytes in vdu queue
  1275                                                                                  ; (Read/Write using OSBYTE 218)
