  6697                          .validatePositionAndSetupScreenAddress
  6698  cee8 ae1803                 LDX .vduTextCursorXPosition                         ; get text cursor X position
  6699  ceeb ec0803                 CPX .vduTextWindowLeft                              ; test against left edge of text window
  6700  ceee 30f6                   BMI .setCarryAndReturn                              ; if (less than left edge) then branch (return with carry set)
  6701  cef0 ec0a03                 CPX .vduTextWindowRight                             ; test against right edge of text window
  6702  cef3 f002                   BEQ +                                               ; if (equal to right edge) then branch (thats OK)
  6703  cef5 10ef                   BPL .setCarryAndReturn                              ; if (greater than right edge) then branch (return with carry set)
  6704                          +
  6705  cef7 ae1903                 LDX .vduTextCursorYPosition                         ; current text line
  6706  cefa ec0b03                 CPX .vduTextWindowTop                               ; test against top edge of text window
  6707  cefd 30e7                   BMI .setCarryAndReturn                              ; if (less than top edge) then branch (return with carry set)
  6708  ceff ec0903                 CPX .vduTextWindowBottom                            ; test against bottom edge of text window
  6709  cf02 f002                   BEQ .setTextCursorScreenAddresses                   ; if (equal to bottom edge) then branch (ok to set cursor screen addresses)
  6710  cf04 10e0                   BPL .setCarryAndReturn                              ; if (greater than bottom edge) then branch (return with carry set)
  6711                              ; fall through...
  6712                          
  6713                          ; ***************************************************************************************
  6714                          ;
  6715                          ; Set text cursor screen addresses from X,Y position
  6716                          ;
  6717                          ; Let X,Y be the text cursor position (in absolute character cells from top left corner)
  6718                          ;
  6719                          ;     MODE 0: address = screen_start + Y*640 + X* 8
  6720                          ;     MODE 1: address = screen_start + Y*640 + X*16
  6721                          ;     MODE 2: address = screen_start + Y*640 + X*32
  6722                          ;     MODE 3: address = screen_start + Y*640 + X* 8
  6723                          ;     MODE 4: address = screen_start + Y*320 + X* 8
  6724                          ;     MODE 5: address = screen_start + Y*320 + X*16
  6725                          ;     MODE 6: address = screen_start + Y*320 + X* 8
  6726                          ;     MODE 7: address = screen_start + Y* 40 + X
  6727                          ;
  6728                          ; Given the text cursor X,Y position, use the multiplication table and other characteristic
  6729                          ; values for the current MODE to calculate the address on screen.
  6730                          ;
  6731                          ; On Entry:
  6732                          ;       .vduTextCursorX/YPosition stores the X,Y coordinates of the text cursor
  6733                          ;
  6734                          ; On Exit:
  6735                          ;       Carry clear
  6736                          ;       Stores the result in .vduTextCursorCRTCAddressLow/High, then wraps the address back on
  6737                          ;       screen if beyond the bottom of the screen. Store the new wrapped result in
  6738                          ;       .vduWriteCursorScreenAddressLow/High.
  6739                          ;
  6740                          ; ***************************************************************************************
  6741                          .setTextCursorScreenAddresses
  6742  cf06 ad1903                 LDA .vduTextCursorYPosition                         ; current text line
  6743  cf09 0a                     ASL                                                 ; multiply by two to get table offset
  6744  cf0a a8                     TAY                                                 ; Y=A
  6745  cf0b b1e0                   LDA (.vduMultiplicationTableLow),Y                  ; get CRTC multiplication table pointer
  6746  cf0d 85d9                   STA .vduWriteCursorScreenAddressHigh                ; .vduWriteCursorScreenAddressHigh=A
  6747  cf0f c8                     INY                                                 ; Y=Y+1
  6748  cf10 a902                   LDA #2                                              ; A=2
  6749  cf12 2d5603                 AND .vduCurrentScreenMODEGroup                      ; AND with MODE group:
  6750                                                                                  ;   0 = 20k (MODE 0,1,2)
  6751                                                                                  ;   1 = 16k (MODE 3)
  6752                                                                                  ;   2 = 10k (MODE 4,5)
  6753                                                                                  ;   3 = 8k (MODE 6)
  6754                                                                                  ;   4 = 1k (MODE 7)
  6755  cf15 08                     PHP                                                 ; save flags
  6756  cf16 b1e0                   LDA (.vduMultiplicationTableLow),Y                  ; get CRTC multiplication table pointer
  6757  cf18 28                     PLP                                                 ; pull flags
  6758  cf19 f003                   BEQ +                                               ; branch if MODE 0,1,2,3 or 7
  6759  cf1b 46d9                   LSR .vduWriteCursorScreenAddressHigh                ; MODE 4,5,6: Halve value from multiplication table (high and low bytes)
  6760  cf1d 6a                     ROR                                                 ; A = A / 2 + (128*carry)
  6761                          +
  6762  cf1e 6d5003                 ADC .vduScreenTopLeftAddressLow                     ; add start of screen (low)
  6763  cf21 85d8                   STA .vduWriteCursorScreenAddressLow                 ; store
  6764  cf23 a5d9                   LDA .vduWriteCursorScreenAddressHigh                ; get offset from start of screen (high)
  6765  cf25 6d5103                 ADC .vduScreenTopLeftAddressHigh                    ; add start of screen (high)
  6766  cf28 a8                     TAY                                                 ; store in Y
  6767  cf29 ad1803                 LDA .vduTextCursorXPosition                         ; text column
  6768  cf2c ae4f03                 LDX .vduBytesPerCharacter                           ; bytes per character
  6769  cf2f ca                     DEX                                                 ; X=X-1
  6770  cf30 f012                   BEQ .mode7Cursor                                    ; if (in MODE 7) then branch
  6771  cf32 e00f                   CPX #15                                             ; is it mode 1 or mode 5? (four colour modes = 16 bytes per character)
  6772  cf34 f003                   BEQ .mode1or5Cursor                                 ; if (mode 1 or 5) then branch (with carry set)
  6773  cf36 9002                   BCC .mode0346Cursor                                 ; if (mode 0,3,4, or 6) then branch (with carry clear)
  6774  cf38 0a                     ASL                                                 ; A=A*16 if entered here (MODE 2)
  6775                          .mode1or5Cursor
  6776  cf39 0a                     ASL                                                 ; A=A*8 if entered here
  6777                          .mode0346Cursor
  6778  cf3a 0a                     ASL                                                 ; A=A*4 if entered here
  6779  cf3b 0a                     ASL                                                 ;
  6780  cf3c 9002                   BCC .skipIncs                                       ; if (carry clear) then branch
  6781  cf3e c8                     INY                                                 ; Y=Y+2
  6782  cf3f c8                     INY                                                 ; Y is the high byte of the address
  6783                          .skipIncs
  6784  cf40 0a                     ASL                                                 ; A=A*2
  6785  cf41 9002                   BCC .skipInc                                        ; if (carry clear) branch (to add to .vduWriteCursorScreenAddressLow)
  6786  cf43 c8                     INY                                                 ; Y=Y+1
  6787                          .mode7Cursor
  6788  cf44 18                     CLC                                                 ; clear carry
  6789                          .skipInc
  6790  cf45 65d8                   ADC .vduWriteCursorScreenAddressLow                 ; add to .vduWriteCursorScreenAddressLow
  6791  cf47 85d8                   STA .vduWriteCursorScreenAddressLow                 ; and store it
  6792  cf49 8d4a03                 STA .vduTextCursorCRTCAddressLow                    ; text cursor CRTC address
  6793  cf4c aa                     TAX                                                 ; X=A
  6794  cf4d 98                     TYA                                                 ; A=Y
  6795  cf4e 6900                   ADC #0                                              ; add carry if set
  6796  cf50 8d4b03                 STA .vduTextCursorCRTCAddressHigh                   ; store the text cursor CRTC address (before any wraparound)
  6797  cf53 1004                   BPL +                                               ; if (not negative) then branch
  6798  cf55 38                     SEC                                                 ; wrap around...
  6799  cf56 ed5403                 SBC .vduScreenSizeHighByte                          ; ...subtract the screen size (high byte)
  6800                          +
  6801  cf59 85d9                   STA .vduWriteCursorScreenAddressHigh                ; store in high byte
  6802  cf5b 18                     CLC                                                 ; clear carry
  6803  cf5c 60                     RTS                                                 ;
  6804                          
  6805                          ; ***************************************************************************************
  6806                          ;
  6807                          ; Display a character at the current graphics cursor
  6808                          ;
  6809                          ; ***************************************************************************************
  6810                          .plotACharacterAtGraphicsCursor
  6811  cf5d ae5903                 LDX .vduForegroundGraphicsColour                    ; foreground graphics colour
  6812  cf60 ac5b03                 LDY .vduForegroundGCOLMode                          ; foreground graphics GCOL mode
  6813                          .plotACharacterWithXYAsGraphicsColourAndGCOLMode
  6814  cf63 20b3d0                 JSR .setGraphicsColourMaskXY                        ; set graphics byte mask in .vduGraphicsColourByteOR/EOR
  6815  cf66 2086d4                 JSR .copyGraphicsCursorPixelPositionToWorkspaceABCD ; copy graphics cursor in pixels to workspace (.vduWorkspaceA-D)
  6816  cf69 a000                   LDY #0                                              ; Y=0
  6817                          .displayNextRowOfCharacter
  6818  cf6b 84dc                   STY .vduTempStoreDC                                 ; .vduTempStoreDC=Y
  6819  cf6d a4dc                   LDY .vduTempStoreDC                                 ; Y=.vduTempStoreDC [redundant instruction]
  6820  cf6f b1de                   LDA (.vduTempStoreDE),Y                             ; get pattern byte
  6821  cf71 f013                   BEQ .characterPatternZero                           ; if (A=0) then branch
  6822  cf73 85dd                   STA .vduTempStoreDD                                 ; .vduTempStoreDD = 1 bit character pattern byte
  6823                          -
  6824  cf75 1003                   BPL +                                               ; if (pattern's top bit is clear) then branch (nothing to draw)
  6825  cf77 20e3d0                 JSR .plotAPixelInACharacter                         ; display a pixel
  6826                          +
  6827  cf7a ee2403                 INC .vduGraphicsCursorPixelsXLow                    ; current horizontal graphics cursor
  6828  cf7d d003                   BNE +                                               ;
  6829  cf7f ee2503                 INC .vduGraphicsCursorPixelsXHigh                   ; current horizontal graphics cursor
  6830                          +
  6831  cf82 06dd                   ASL .vduTempStoreDD                                 ; shift the bit pattern left to draw next pixel
  6832  cf84 d0ef                   BNE -                                               ; if (there's still something left to draw) then branch (loop back)
  6833                          .characterPatternZero
  6834  cf86 a228                   LDX #.vduWorkspaceA - .vduVariablesStart            ; source is workspace
  6835  cf88 a024                   LDY #.vduGraphicsCursorPixelsXLow - .vduVariablesStart
  6836                                                                                  ; destination is horizontal graphics cursor pixel position
  6837  cf8a 2082d4                 JSR .copyTwoBytesWithinVDUVariables                 ; copy two bytes
  6838  cf8d ac2603                 LDY .vduGraphicsCursorPixelsYLow                    ; }
  6839  cf90 d003                   BNE +                                               ; }
  6840  cf92 ce2703                 DEC .vduGraphicsCursorPixelsYHigh                   ; } decrement graphics cursor Y pixel position
  6841                          +                                                       ; }
  6842  cf95 ce2603                 DEC .vduGraphicsCursorPixelsYLow                    ; }
  6843  cf98 a4dc                   LDY .vduTempStoreDC                                 ; loop counter
  6844  cf9a c8                     INY                                                 ;
  6845  cf9b c008                   CPY #8                                              ;
  6846  cf9d d0cc                   BNE .displayNextRowOfCharacter                      ; if (Y<8) then branch (loop back)
  6847  cf9f a228                   LDX #.vduWorkspaceA - .vduVariablesStart            ; source: workspaceA-D
  6848  cfa1 a024                   LDY #.vduGraphicsCursorPixelsXLow - .vduVariablesStart
  6849                                                                                  ; destination: graphics cursor position
  6850  cfa3 4c8ad4                 JMP .copyFourBytesWithinVDUVariables                ; copy to graphics cursor position
  6851                          
  6852                          ; ***************************************************************************************
  6853                          .graphicsCursorHome
  6854  cfa6 a206                   LDX #.vduGraphicsWindowPixelsTopLow - .vduVariablesStart ; source bytes (graphics window top)
  6855  cfa8 a026                   LDY #.vduGraphicsCursorPixelsYLow - .vduVariablesStart   ; destination bytes (graphics cursor Y)
  6856  cfaa 2082d4                 JSR .copyTwoBytesWithinVDUVariables                      ; copy two bytes
  6857                              ; fall through...
  6858                          
  6859                          ; ***************************************************************************************
  6860                          .setGraphicsCursorToLeftHandColumn
  6861  cfad a200                   LDX #.vduGraphicsWindowPixelsLeftLow - .vduVariablesStart ; source: left edge of graphics
  6862                                                                                        ; window
