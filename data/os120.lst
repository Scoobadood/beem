 17892                          ; ***************************************************************************************
 17893                          ;
 17894                          ; OSFIND - Open or close a file
 17895                          ;
 17896                          ; When opening a file, this returns a file handle ('channel') number:
 17897                          ;
 17898                          ;   1 = input file on tape
 17899                          ;   2 = output file on tape
 17900                          ;   3 = input file from ROMFS
 17901                          ;
 17902                          ; On Entry:
 17903                          ;       A determines action
 17904                          ;       Y may contain file handle (channel number)
 17905                          ;       or XY is the address of the filename terminated by $0D
 17906                          ;
 17907                          ;       A=0    closes file in channel Y; if Y = 0 closes all files
 17908                          ;       A=$40  open a file for input  (reading) XY points to filename
 17909                          ;       A=$80  open a file for output (writing) XY points to filename
 17910                          ;       A=$C0  open a file for both input and output (random Access)
 17911                          ;              (not supported by TAPE and ROM filing systems)
 17912                          ;
 17913                          ; On Exit:
 17914                          ;       A = file handle of opened file or zero on error
 17915                          ;       X,Y are preserved
 17916                          ;
 17917                          ; ***************************************************************************************
 17918                          .osfindEntryPoint
 17919  f3ca 85bc                   STA .fsTempStorage                                  ; save action in temporary store
 17920  f3cc 8a                     TXA                                                 ; }
 17921  f3cd 48                     PHA                                                 ; }
 17922  f3ce 98                     TYA                                                 ; } save X and Y on the stack
 17923  f3cf 48                     PHA                                                 ; }
 17924  f3d0 a5bc                   LDA .fsTempStorage                                  ; recall action
 17925  f3d2 d01e                   BNE .openAFile                                      ; if (A is non zero) then branch (open a specific file)
 17926                          
 17927                          .closeOneFile
 17928  f3d4 98                     TYA                                                 ; A=Y
 17929  f3d5 d00c                   BNE +                                               ; if (A is not zero) then branch (close specified file)
 17930  f3d7 2075e2                 JSR .osbyte119EntryPoint                            ; close all SPOOL/EXEC files using OSBYTE 119
 17931  f3da 2078f4                 JSR .closeFileThatsOpenForOutput                    ; close file open for output
 17932                          -
 17933  f3dd 46e2                   LSR .fsStatusByte                                   ; shift right (bit zero into carry)
 17934  f3df 06e2                   ASL .fsStatusByte                                   ; shift left (clear bit zero)
 17935  f3e1 900c                   BCC .finishWithError                                ; if (carry clear, i.e. no input file open) then branch
 17936                          +
 17937  f3e3 4a                     LSR                                                 ; A contains file handle so shift bit 0 into carry
 17938  f3e4 b0f7                   BCS -                                               ; if (carry set) then branch (close input file)
 17939  f3e6 4a                     LSR                                                 ; shift bit 1 into carry
 17940  f3e7 b003                   BCS .closeOutputFile                                ; if (carry set) then branch (close output file)
 17941  f3e9 4cb1fb                 JMP .channelError                                   ; report 'Channel error'
 17942                                                                                  ; as tape filing system can only support one input and one output file
 17943                          
 17944                          .closeOutputFile
 17945  f3ec 2078f4                 JSR .closeFileThatsOpenForOutput                    ; close file open for output
 17946                          .finishWithError
 17947  f3ef 4c71f4                 JMP .restoreRegistersAndExit                        ; and exit
 17948                          
 17949                          ; ***************************************************************************************
 17950                          ;
 17951                          ; Open a file
 17952                          ;
 17953                          ; A file is opened for input or output. The file handle ('channel') is returned in A.
 17954                          ;
 17955                          ; File handles returned:
 17956                          ;   1 = input file on tape
 17957                          ;   2 = output file on tape
 17958                          ;   3 = input file from ROMFS
 17959                          ;
 17960                          ; On Entry:
 17961                          ;       XY = address of zero terminated filename
 17962                          ;       .fsTempStorage - action from .OSFIND (See .osfindEntryPoint)
 17963                          ;           bit 6 set to open for input
 17964                          ;           bit 7 set to open for output
 17965                          ;           (opening both for input and output is not supported on either tape or ROMFS)
 17966                          ;
 17967                          ; On Exit:
 17968                          ;       A = file handle ('channel')
 17969                          ;
 17970                          ; ***************************************************************************************
 17971                          .openAFile
 17972  f3f2 205af2                 JSR .getFilenameFromXY                              ; get filename from buffer at XY
 17973  f3f5 24bc                   BIT .fsTempStorage                                  ; get action (OSFIND value of A on entry)
 17974  f3f7 503d                   BVC .openAFileForOutputOnly                         ; if (bit 6 not set, i.e. it's to be an output only file) then branch
 17975                          
 17976                              ; open a file for input
 17977  f3f9 a900                   LDA #0                                              ; it's an input file
 17978  f3fb 8d9e03                 STA .bgetBufferOffset                               ; BGET buffer offset for next byte
 17979  f3fe 8ddd03                 STA .nextBGETBlockLow                               ; Expected BGET file block number low
 17980  f401 8dde03                 STA .nextBGETBlockHigh                              ; expected BGET file block number high
 17981  f404 a93e                   LDA #%00111110                                      ; }
 17982  f406 203df3                 JSR .clearTapeStatusBits                            ; } clear 'input file open' bit; clear 'EOF reached'; clear 'EOF warning given'
 17983  f409 201afb                 JSR .claimSerialSystemForSequentialAccess           ; claim serial system and set OPTions
 17984  f40c 08                     PHP                                                 ; save flags on stack
 17985  f40d 2031f6                 JSR .searchForFile                                  ; search for file
 17986  f410 20b4f6                 JSR .checkLockedFlag                                ; check protection bit of block status and respond
 17987  f413 28                     PLP                                                 ; get back flags
 17988  f414 a2ff                   LDX #$FF                                            ; X=loop counter
 17989                          
 17990                          -
 17991  f416 e8                     INX                                                 ; X=X+1
 17992  f417 bdb203                 LDA .fsFilename,X                                   ; copy file name character
 17993  f41a 9da703                 STA .bgetFilename,X                                 ; and store as BGET filename
 17994  f41d d0f7                   BNE -                                               ; until end of filename (zero terminator)
 17995                          
 17996  f41f a901                   LDA #%00000001                                      ; A=1 to set bit for 'input file open'
 17997  f421 2044f3                 JSR .setTapeStatusBits                              ; set status bit
 17998  f424 adea02                 LDA .tapeInputCurrentBlockSizeLow                   ; tape filing system currently resident file block length low
 17999  f427 0deb02                 ORA .tapeInputCurrentBlockSizeHigh                  ; tape filing system currently resident file block length high
 18000  f42a d003                   BNE +                                               ; if (block length is no zero) then branch
 18001  f42c 2042f3                 JSR .setTapeEOFStatus                               ; set tape filing system status bit 6 (EOF reached)
 18002                          +
 18003  f42f a901                   LDA #1                                              ; }
 18004  f431 0d4702                 ORA .tapeOrROMSwitch                                ; } get input file handle, 1 = tape; 3=ROMFS
 18005  f434 d039                   BNE .returnAWithXYRestoredFromStack                 ; ALWAYS branch (restore registers and exit)
 18006                          
 18007                          ; ***************************************************************************************
 18008                          ;
 18009                          ; Open a file for output
 18010                          ;
 18011                          ; On Entry:
 18012                          ;       X is length of filename
 18013                          ; ***************************************************************************************
 18014                          .openAFileForOutputOnly
 18015  f436 8a                     TXA                                                 ; A=X
 18016  f437 d003                   BNE +                                               ; if (filename length is non-zero) then branch
 18017  f439 4c8fea                 JMP .brkBadString                                   ; output 'Bad String' error
 18018                          
 18019                          +
 18020  f43c a2ff                   LDX #$FF                                            ; X=$FF
 18021                          .copyFilenameLoop
 18022  f43e e8                     INX                                                 ; X=X+1
 18023  f43f bdd203                 LDA .filenameToSearchFor,X                          ; sought filename
 18024  f442 9d8003                 STA .tapeBlockHeaderStart,X                         ; write it to BPUT file header block
 18025  f445 d0f7                   BNE .copyFilenameLoop                               ; until A=0 (zero terminator at end of filename)
 18026                          
 18027  f447 a9ff                   LDA #$FF                                            ; A=$FF
 18028  f449 a208                   LDX #8                                              ; X=8
 18029                          -
 18030  f44b 9d8b03                 STA .tapeBlockLoadAddressLow-1,X                    ; set load and exec address to $FF
 18031  f44e ca                     DEX                                                 ; X=X-1
 18032  f44f d0fa                   BNE -                                               ;
 18033                          
 18034  f451 8a                     TXA                                                 ; A=0
 18035  f452 a214                   LDX #.tapeBlockNumberLow - .tapeBlockHeaderStart    ; X=loop counter from $14 to $1E
 18036                          -
 18037  f454 9d8003                 STA .tapeBlockHeaderStart,X                         ; BPUT file header block
 18038  f457 e8                     INX                                                 ; X=X+1
 18039  f458 e01e                   CPX #.bgetBufferOffset - .tapeBlockHeaderStart      ; this zeros BPUT block
 18040  f45a d0f8                   BNE -                                               ;
 18041                          
 18042  f45c 2e9703                 ROL .tapeBlockLengthHigh                            ;
 18043  f45f 2027fb                 JSR .claimSerialSystemForLoadSave                   ; claim serial system for cassette load/save
 18044  f462 2034f9                 JSR .promptToRecordOnTape                           ; prompt to start recording
 18045  f465 20f2fa                 JSR .cancelTapeOperationAndMotor                    ;
 18046  f468 a902                   LDA #%00000010                                      ; } set the tape status bit
 18047  f46a 2044f3                 JSR .setTapeStatusBits                              ; } for 'output file open'
 18048  f46d a902                   LDA #2                                              ; A=2=file handle of (tape) file open for output
 18049                          
 18050                          .returnAWithXYRestoredFromStack
 18051  f46f 85bc                   STA .fsTempStorage                                  ; store value of A temporarily
 18052                          
 18053                          .restoreRegistersAndExit
 18054  f471 68                     PLA                                                 ; }
 18055  f472 a8                     TAY                                                 ; }
 18056  f473 68                     PLA                                                 ; } Restore X and Y registers
 18057  f474 aa                     TAX                                                 ; }
 18058  f475 a5bc                   LDA .fsTempStorage                                  ; recall temporary store into A
 18059                          .exit30
 18060  f477 60                     RTS                                                 ;
 18061                          
 18062                          ; ***************************************************************************************
 18063                          .closeFileThatsOpenForOutput
 18064  f478 a902                   LDA #%00000010                                      ; }
 18065  f47a 25e2                   AND .fsStatusByte                                   ; } clear all of tape status byte except bit 1
 18066  f47c f0f9                   BEQ .exit30                                         ; if (output file not open) then branch (exit)
 18067                          
 18068                              ; an output file is open
 18069  f47e a900                   LDA #0                                              ; A=0
 18070  f480 8d9703                 STA .tapeBlockLengthHigh                            ; setting block length to current value of BPUT offset
 18071  f483 a980                   LDA #$80                                            ; A=$80 (last block)
 18072  f485 ae9d03                 LDX .bputBufferOffset                               ; get BPUT buffer offset
 18073  f488 8e9603                 STX .tapeBlockLengthLow                             ; setting block length to current value of BPUT offset
 18074  f48b 8d9803                 STA .tapeBlockFlagByte                              ; mark current block as last
 18075  f48e 2096f4                 JSR .saveSequentialAccessBlockToTape                ; save block to tape
 18076  f491 a9fd                   LDA #%11111101                                      ; }
 18077  f493 4c3df3                 JMP .clearTapeStatusBits                            ; } clear bit 1 of the tape status (no file is open for output) and return
 18078                          
 18079                          ; ***************************************************************************************
 18080                          ; Sequential access writes bytes instead of files. (As used by BGET and BPUT in BASIC).
 18081                          .saveSequentialAccessBlockToTape
 18082  f496 201afb                 JSR .claimSerialSystemForSequentialAccess           ; claim serial system and set OPTions
 18083                          
 18084  f499 a211                   LDX #17                                             ; loop counter
 18085                          -
 18086  f49b bd8c03                 LDA .tapeBlockLoadAddressLow,X                      ; }
 18087  f49e 9dbe03                 STA .fsLoadAddressLow,X                             ; } copy header block
 18088  f4a1 ca                     DEX                                                 ; X=X-1
 18089  f4a2 10f7                   BPL -                                               ; loop back until X=255
 18090                          
 18091                              ; set load address to "FFFF0900"
 18092  f4a4 86b2                   STX .tapeSaveStartAddressMid2                       ; store $FF
 18093  f4a6 86b3                   STX .tapeSaveStartAddressHigh                       ; store $FF
 18094  f4a8 e8                     INX                                                 ; increment X (to zero)
 18095  f4a9 86b0                   STX .tapeSaveStartAddressLow                        ; store $00
 18096  f4ab a909                   LDA #$09                                            ;
 18097  f4ad 85b1                   STA .tapeSaveStartAddressMid1                       ; store $09
 18098                          
 18099                              ; Copy
 18100  f4af a27f                   LDX #(.tapeBlockFilename-1) - .vduVariablesStart    ;
 18101  f4b1 2081fb                 JSR .copyToSoughtFilename                           ; copy filename from .tapeBlockFilename to .filenameToSearchFor
 18102  f4b4 8ddf03                 STA .fsLastBlockReadFlagsCopy                       ; set copy of last read block flag to zero
 18103  f4b7 208efb                 JSR .zeroFileHandleAndMotorOn                       ; switch Motor On
 18104  f4ba 20e2fb                 JSR .setupForCassetteWrite                          ; set up tape filing system for write operation
 18105  f4bd 20ecf7                 JSR .saveABlockToTape                               ; write block to tape
 18106                          
 18107                              ; increment block number
 18108  f4c0 ee9403                 INC .tapeBlockNumberLow                             ; block number low
 18109  f4c3 d003                   BNE +                                               ;
 18110  f4c5 ee9503                 INC .tapeBlockNumberHigh                            ; block number high
 18111                          +
 18112  f4c8 60                     RTS                                                 ;
