  9256                          ; ***************************************************************************************
  9257                          ; ***************************************************************************************
  9258                          ;
  9259                          ; Chapter 9: Cursor editing mode
  9260                          ;
  9261                          ; ***************************************************************************************
  9262                          ; ***************************************************************************************
  9263                          
  9264                          ; ***************************************************************************************
  9265                          ;
  9266                          ; OSBYTE 135 - Read character at text cursor position
  9267                          ;
  9268                          ; ***************************************************************************************
  9269                          .osbyte135EntryPoint
  9270  d7c2 ac6003                 LDY .vduNumberOfLogicalColoursMinusOne              ; get number of logical colours for current MODE
  9271  d7c5 d015                   BNE .nonMODE7ReadCharacter                          ; if (MODE is not 7) then branch
  9272  d7c7 b1d8                   LDA (.vduWriteCursorScreenAddressLow),Y             ; read MODE 7 character from screen
  9273  d7c9 a002                   LDY #2                                              ; Y=2
  9274                          -
  9275  d7cb d9b7c4                 CMP .teletextCharacterConversionTable + 1,Y         ; compare with conversion table
  9276  d7ce d004                   BNE +                                               ; if (not equal) then branch
  9277  d7d0 b9b6c4                 LDA .teletextCharacterConversionTable,Y             ; get previous byte from table
  9278  d7d3 88                     DEY                                                 ; Y=Y-1
  9279                          +
  9280  d7d4 88                     DEY                                                 ; Y=Y-1
  9281  d7d5 10f4                   BPL -                                               ; if (+ve) then branch (loop back and do it again)
  9282                          .finishUpFX135
  9283  d7d7 ac5503                 LDY .vduCurrentScreenMODE                           ; Y = current screen MODE
  9284  d7da aa                     TAX                                                 ; X = character
  9285  d7db 60                     RTS                                                 ;
  9286                          
  9287                          ; ***************************************************************************************
  9288                          .nonMODE7ReadCharacter
  9289  d7dc 2008d8                 JSR .readCharacterDefinitionMaskFromScreen          ; read from screen, making a one bit
  9290                                                                                  ; mask of 8 bytes to match against
  9291                                                                                  ; each character, in workspaceA-H
  9292  d7df a220                   LDX #.charSPACE                                     ; Start with the space character (loop counter)
  9293                          .readCharLoop
  9294  d7e1 8a                     TXA                                                 ; Loop through each character in turn looking to see if it matches workspaceA-H
  9295  d7e2 48                     PHA                                                 ; Save character
  9296  d7e3 203ed0                 JSR .getCharacterDefinitionAddress                  ; get character definition address for character A
  9297  d7e6 68                     PLA                                                 ; recall character
  9298  d7e7 aa                     TAX                                                 ; move to X
  9299                          -
  9300  d7e8 a007                   LDY #7                                              ; Y=7
  9301                          --
  9302  d7ea b92803                 LDA .vduWorkspaceA,Y                                ; get byte in workspaceA-H copy
  9303  d7ed d1de                   CMP (.vduTempStoreDE),Y                             ; check against character definition
  9304  d7ef d008                   BNE +                                               ; if (not the same) then branch (to skip to next character)
  9305  d7f1 88                     DEY                                                 ; Y--
  9306  d7f2 10f6                   BPL --                                              ; if (still non-negative) then branch (back to loop eight times, to check each row of the character)
  9307  d7f4 8a                     TXA                                                 ; At this point the character matches
  9308  d7f5 e07f                   CPX #.charDELETE                                    ; but if it's the DELETE character then pretend we didn't match and carry on
  9309  d7f7 d0de                   BNE .finishUpFX135                                  ; if (we are NOT the DELETE character) then branch (to finish up)
  9310                          +
  9311  d7f9 e8                     INX                                                 ; no match on this character so increment to next character
  9312  d7fa a5de                   LDA .vduTempStoreDE                                 ; }
  9313  d7fc 18                     CLC                                                 ; } Add 8 to address of character definition to move on to the next character
  9314  d7fd 6908                   ADC #8                                              ; } Affects low byte only as we check one page of characters at a time
  9315  d7ff 85de                   STA .vduTempStoreDE                                 ; }
  9316  d801 d0e5                   BNE -                                               ; if (we have not reached the end of the page) then branch (back to check the character)
  9317                          
  9318  d803 8a                     TXA                                                 ; A=X
  9319  d804 d0db                   BNE .readCharLoop                                   ; if (character number not zero) then branch (loop back)
  9320  d806 f0cf                   BEQ .finishUpFX135                                  ; ALWAYS branch (finish up)
  9321                          
  9322                          ; ***************************************************************************************
  9323                          ;
  9324                          ; Read character from screen pixels
  9325                          ;
  9326                          ; Reads 8x8 cell of pixels from the screen. This will be compared against each of the
  9327                          ; character definitions to determine which character is on screen. This is for the
  9328                          ; cursor editing mode feature.
  9329                          ;
  9330                          ; ***************************************************************************************
  9331                          .readCharacterDefinitionMaskFromScreen
  9332  d808 a007                   LDY #7                                              ; Y=7
  9333                          .setupPatternLoop
  9334  d80a 84da                   STY .vduTempStoreDA                                 ; .vduTempStoreDA=Y (loop counter)
  9335  d80c a901                   LDA #1                                              ; A=1
  9336  d80e 85db                   STA .vduTempStoreDB                                 ; .vduTempStoreDB=A
  9337                          --
  9338  d810 ad6203                 LDA .vduColourMaskLeft                              ; A=left colour mask
  9339  d813 85dc                   STA .vduTempStoreDC                                 ; store in .vduTempStoreDC
  9340  d815 b1d8                   LDA (.vduWriteCursorScreenAddressLow),Y             ; get a byte from current text character
  9341  d817 4d5803                 EOR .vduBackgroundTextColour                        ; EOR with text background colour
  9342  d81a 18                     CLC                                                 ; clear carry
  9343                          -
  9344  d81b 24dc                   BIT .vduTempStoreDC                                 ; and check bits of colour mask
  9345  d81d f001                   BEQ +                                               ; if (result = 0) then branch (this becomes a zero bit in our mask)
  9346  d81f 38                     SEC                                                 ; set carry. This becomes a one bit in our mask
  9347                          +
  9348  d820 26db                   ROL .vduTempStoreDB                                 ; Rotate left and add the carry in the low bit
  9349  d822 b00a                   BCS +                                               ; if (carry now set; bit 7 originally set) then branch (because we are done:
  9350                                                                                  ;               the initial value of 1 has rotated through the 8 bits and into the carry)
  9351  d824 46dc                   LSR .vduTempStoreDC                                 ; shift mask right one place for the next pixel
  9352  d826 90f3                   BCC -                                               ; if (carry clear; nothing shifted off the left) then branch (loop back)
  9353  d828 98                     TYA                                                 ; }
  9354  d829 6907                   ADC #7                                              ; } Y = Y + 8 (Carry is set, so adding 7 + carry = 8)
  9355  d82b a8                     TAY                                                 ; }
  9356  d82c 90e2                   BCC --                                              ; if (no overflow from the add) then branch (loop back, move on to the next cell to read from)
  9357                          +
  9358  d82e a4da                   LDY .vduTempStoreDA                                 ; read modified values into Y and A
  9359  d830 a5db                   LDA .vduTempStoreDB                                 ;
  9360  d832 992803                 STA .vduWorkspaceA,Y                                ; store copy
  9361  d835 88                     DEY                                                 ; and do it again
  9362  d836 10d2                   BPL .setupPatternLoop                               ; until 8 bytes copied
  9363  d838 60                     RTS                                                 ;
  9364                          
  9365                          ; ***************************************************************************************
  9366                          ;
  9367                          ; Read pixel
  9368                          ;
  9369                          ; On Entry:
  9370                          ;       A = VDU variable offset for the graphics coordinates to use.
  9371                          ;
  9372                          ; On Exit:
  9373                          ;       A = current colour at the coordinate specified OR
  9374                          ;       A = $FF if coordinate is out of bounds
  9375                          ; ***************************************************************************************
  9376                          .readPixel
  9377  d839 48                     PHA                                                 ; store A
  9378  d83a aa                     TAX                                                 ; X=A
  9379  d83b 2049d1                 JSR .plotConvertExternalAbsoluteCoordinatesToPixels ; set up positional data
  9380  d83e 68                     PLA                                                 ; get back A
  9381  d83f aa                     TAX                                                 ; X=A
  9382  d840 205fd8                 JSR .checkPointXInBoundsAndSetScreenAddresses       ; set a screen address after checking for window bounds
  9383  d843 d015                   BNE ++                                              ; if (out of bounds) then branch (exit with A=$FF)
  9384  d845 b1d6                   LDA (.vduScreenAddressOfGraphicsCursorCellLow),Y    ; get row of current graphics cell
  9385                          -
  9386  d847 0a                     ASL                                                 ; A=A*2, Carry=bit 7
  9387  d848 26da                   ROL .vduTempStoreDA                                 ; .vduTempStoreDA=.vduTempStoreDA+2 +Carry,
  9388                                                                                  ; Carry=bit 7 of .vduTempStoreDA
  9389  d84a 06d1                   ASL .vduCurrentPlotByteMask                         ; byte mask=byte mask*2 + Carry
  9390  d84c 08                     PHP                                                 ; save flags
  9391  d84d b002                   BCS +                                               ; if (carry set) then branch
  9392  d84f 46da                   LSR .vduTempStoreDA                                 ; restore .vduTempStoreDA with bit 7=0
  9393                          +
  9394  d851 28                     PLP                                                 ; pull flags
  9395  d852 d0f3                   BNE -                                               ; if (Z set) then branch
  9396  d854 a5da                   LDA .vduTempStoreDA                                 ; A=.vduTempStoreDA AND number of colours in current MODE -1
  9397  d856 2d6003                 AND .vduNumberOfLogicalColoursMinusOne              ;
  9398  d859 60                     RTS                                                 ;
  9399                          
  9400                          ++
  9401  d85a a9ff                   LDA #$FF                                            ; A=$FF
  9402                          -
  9403  d85c 60                     RTS                                                 ;
  9404                          
  9405                          
  9406                          ; ***************************************************************************************
  9407                          ;
  9408                          ; Check the graphics point on the VDU queue is within the graphics window
  9409                          ;
  9410                          ; ***************************************************************************************
  9411                          .checkParameterInBoundsAndSetScreenAddresses
  9412  d85d a220                   LDX #.vdu25ParameterXLow - .vduVariablesStart       ; X is the offset to the desired parameter for the point in graphics coordinates
  9413                              ; fall through...
  9414                          
  9415                          ; ***************************************************************************************
  9416                          ;
  9417                          ; Check the given point is within the graphics window
  9418                          ;
  9419                          ; Takes the graphics coordinates pointed to by X, checks whether they are in the bounds of
  9420                          ; the graphics window, and if so sets up screen addresses.
  9421                          ;
  9422                          ; On Entry:
  9423                          ;       X is the vdu variables offset to the graphics point to check
  9424                          ; On Exit:
  9425                          ;       .vduScreenAddressOfGraphicsCursorCellLow/High is the screen address
  9426                          ;       Y is the vertical offset within the character cell (0-7)
  9427                          ;       Z is clear (i.e. BNE will branch) if coordinates are outside the graphics area
  9428                          ; ***************************************************************************************
  9429                          .checkPointXInBoundsAndSetScreenAddresses
  9430  d85f 200fd1                 JSR .checkPointXIsWithinGraphicsWindow              ;
  9431  d862 d0f8                   BNE -                                               ; if (point is not in graphics window) then branch (exit)
  9432                          .setScreenAddress
  9433  d864 bd0203                 LDA .vduGraphicsWindowPixelsBottomLow,X             ; read low byte of Y coordinate
  9434  d867 49ff                   EOR #$FF                                            ; Flip the coordinates to be from the top of the screen
  9435  d869 a8                     TAY                                                 ; Remember in Y
  9436  d86a 2907                   AND #7                                              ; A = row within a character cell
  9437  d86c 8d1a03                 STA .vduGraphicsCursorVerticalOffsetInCell          ; store row (0-7)
  9438  d86f 98                     TYA                                                 ; A=Y
  9439  d870 4a                     LSR                                                 ; }
  9440  d871 4a                     LSR                                                 ; }
  9441  d872 4a                     LSR                                                 ; } divide by 8
  9442  d873 0a                     ASL                                                 ; Multiply by two to give the offset in the multiplication table
  9443  d874 a8                     TAY                                                 ; Y = offset into multiplication table
  9444  d875 b1e0                   LDA (.vduMultiplicationTableLow),Y                  ; Get high byte of offset from screen RAM start
  9445  d877 85da                   STA .vduTempStoreDA                                 ; store it
  9446  d879 c8                     INY                                                 ; Y=Y+1
  9447  d87a b1e0                   LDA (.vduMultiplicationTableLow),Y                  ; get low byte
  9448  d87c ac5603                 LDY .vduCurrentScreenMODEGroup                      ; check MODE group
  9449  d87f f003                   BEQ +                                               ; if (zero, i.e. MODEs 0,1,2) then branch (skip this next bit)
  9450  d881 46da                   LSR .vduTempStoreDA                                 ; } divide the offset by two
  9451  d883 6a                     ROR                                                 ; }
  9452                          +
  9453  d884 6d5003                 ADC .vduScreenTopLeftAddressLow                     ; add the screen top left address (low)
  9454  d887 85d6                   STA .vduScreenAddressOfGraphicsCursorCellLow        ; store it
  9455  d889 a5da                   LDA .vduTempStoreDA                                 ; get high byte
  9456  d88b 6d5103                 ADC .vduScreenTopLeftAddressHigh                    ; add with carry the screen top left address (high)
  9457  d88e 85d7                   STA .vduScreenAddressOfGraphicsCursorCellHigh       ; store it
  9458  d890 bd0103                 LDA .vduGraphicsWindowPixelsLeftHigh,X              ;
  9459  d893 85da                   STA .vduTempStoreDA                                 ; store x coordinate of point (high)
  9460  d895 bd0003                 LDA .vduGraphicsWindowPixelsLeftLow,X               ; get x coordinate of point (low)
  9461  d898 48                     PHA                                                 ; remember it
  9462  d899 2d6103                 AND .vduPixelsPerByteMinusOne                       ; get the horizontal X offset within the range of pixelsPerByte
  9463  d89c 6d6103                 ADC .vduPixelsPerByteMinusOne                       ; add the pixels per byte minus one,
  9464                                                                                  ; which offsets to (one more than) the
  9465                                                                                  ; start of the MODE mask table for the
  9466                                                                                  ; current MODE
  9467  d89f a8                     TAY                                                 ; Y=A
  9468  d8a0 b906c4                 LDA .sixteenColourMODEMaskTable - 1,Y               ; read byte mask
  9469  d8a3 85d1                   STA .vduCurrentPlotByteMask                         ; store it
  9470  d8a5 68                     PLA                                                 ; get back A
  9471  d8a6 ac6103                 LDY .vduPixelsPerByteMinusOne                       ; Y=number of pixels per byte minus one
  9472  d8a9 c003                   CPY #3                                              ; compare with 3
  9473  d8ab f005                   BEQ +                                               ; if (MODE 1 or 5) then branch forward
  9474  d8ad b006                   BCS ++                                              ; if (MODE 0 or 4) then branch forward
  9475  d8af 0a                     ASL                                                 ; }
  9476  d8b0 26da                   ROL .vduTempStoreDA                                 ; } (A,.vduTempStoreDA) *= 2
  9477                          +
  9478  d8b2 0a                     ASL                                                 ; }
  9479  d8b3 26da                   ROL .vduTempStoreDA                                 ; } (A,.vduTempStoreDA) *= 2
  9480                          ++
  9481  d8b5 29f8                   AND #$F8                                            ; clear bits 0-2
  9482  d8b7 18                     CLC                                                 ; clear carry
  9483  d8b8 65d6                   ADC .vduScreenAddressOfGraphicsCursorCellLow        ; add A/.vduTempStoreDA to screen address
  9484  d8ba 85d6                   STA .vduScreenAddressOfGraphicsCursorCellLow        ;
  9485  d8bc a5da                   LDA .vduTempStoreDA                                 ;
  9486  d8be 65d7                   ADC .vduScreenAddressOfGraphicsCursorCellHigh       ;
  9487  d8c0 1004                   BPL +                                               ; if (result +ve) then branch
  9488  d8c2 38                     SEC                                                 ; set carry
  9489  d8c3 ed5403                 SBC .vduScreenSizeHighByte                          ; and subtract screen memory size making it wrap round
  9490                          +
  9491  d8c6 85d7                   STA .vduScreenAddressOfGraphicsCursorCellHigh       ; store it
  9492  d8c8 ac1a03                 LDY .vduGraphicsCursorVerticalOffsetInCell          ; get line in graphics cell containing current graphics
  9493                          .zeroAReturn
  9494  d8cb a900                   LDA #0                                              ; A=0 to set Z flag (valid result)
  9495  d8cd 60                     RTS                                                 ;
