  1076                          ; ***************************************************************************************
  1077                          ;
  1078                          ; The 6502 Stack ($0100-$01FF)
  1079                          ;
  1080                          ; The 6502 stack starts at $01FF and grows downwards.
  1081                          ;
  1082                          ; ***************************************************************************************
  1083                          .stackPage                                  = $0100     ; 6502 stack
  1084                          
  1085                          ; ***************************************************************************************
  1086                          ;
  1087                          ; Vectors ($0200-$0235)
  1088                          ;
  1089                          ; Vectors are addresses that can be set to point to a user routine to handle operating system
  1090                          ; calls, overriding or augmenting the standard behaviour. By default they are set to locations
  1091                          ; in the MOS ROM.
  1092                          ;
  1093                          ; See .defaultVectorTable for the default entry points for each vector
  1094                          ; See NAUG Section 6, Page 102
  1095                          ;
  1096                          ; Historical note: Acorn began storing vectors at $0200 with the System 2 (1980) and then
  1097                          ; the Atom (also 1980). Many of the vectors below appear there too, but not .vectorIRQ2V,
  1098                          ; .vectorBYTEV, .vectorWORDV or anything beyond .vectorNETV.
  1099                          ;
  1100                          ; ***************************************************************************************
  1101                          .page2Start                                 = $0200
  1102                          
  1103                          .vectorUSERV                                = $0200     ; User vector
  1104                          .vectorBRKV                                 = $0202     ; BRK vector
  1105                          .vectorIRQ1V                                = $0204     ; Primary IRQ vector
  1106                          .vectorIRQ2V                                = $0206     ; Unrecognised IRQ vector
  1107                          .vectorCLIV                                 = $0208     ; Command line interpreter
  1108                          .vectorBYTEV                                = $020A     ; OSBYTE call
  1109                          .vectorWORDV                                = $020C     ; OSWORD call
  1110                          .vectorWRCHV                                = $020E     ; OSWRCH call
  1111                          .vectorRDCHV                                = $0210     ; OSRDCH call
  1112                          .vectorFILEV                                = $0212     ; Load / Save file
  1113                          .vectorARGSV                                = $0214     ; Load / Save file parameters
  1114                          .vectorBGETV                                = $0216     ; Get byte from file
  1115                          .vectorBPUTV                                = $0218     ; Put byte to file
  1116                          .vectorGBPBV                                = $021A     ; Transfer data to or from a file
  1117                          .vectorFINDV                                = $021C     ; Open / Close file
  1118                          .vectorFSCV                                 = $021E     ; Filing system control
  1119                          .vectorEVNTV                                = $0220     ; Events
  1120                          .vectorUPTV                                 = $0222     ; User print
  1121                          .vectorNETV                                 = $0224     ; Econet
  1122                          .vectorVDUV                                 = $0226     ; Unrecognised PLOT / VDU 23 commands
  1123                          .vectorKEYV                                 = $0228     ; Keyboard
  1124                          .vectorINSV                                 = $022A     ; Insert character into buffer
  1125                          .vectorREMV                                 = $022C     ; Remove character from buffer
  1126                          .vectorCNPV                                 = $022E     ; Count or purge buffer
  1127                          .vectorIND1V                                = $0230     ; Unused vector
  1128                          .vectorIND2V                                = $0232     ; Unused vector
  1129                          .vectorIND3V                                = $0234     ; Unused vector
  1130                          
  1131                          ; ***************************************************************************************
