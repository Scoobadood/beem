 17785                          ; ***************************************************************************************
 17786                          ;
 17787                          ; Search for the next block, checking for Tape or ROM
 17788                          ;
 17789                          ; Used when loading a file or cataloguing a directory.
 17790                          ;
 17791                          ; On Entry:
 17792                          ;       A = $FF - must match the current filename and block number
 17793                          ;       A = $00 - match anything (e.g. for catalogue)
 17794                          ;
 17795                          ; On Exit:
 17796                          ;       V clear if final block
 17797                          ;
 17798                          ; ***************************************************************************************
 17799                          .searchForBlockCheckFilingSystem
 17800  f348 48                     PHA                                                 ; save A on stack
 17801  f349 ad4702                 LDA .tapeOrROMSwitch                                ; filing system flag 0=Tape; 2=ROMFS
 17802  f34c f00b                   BEQ .searchForBlockReadHeaderAndCompare             ; if (tape filing system active) then branch
 17803                          
 17804                              ; deal with search on ROM FS
 17805  f34e 2013ee                 JSR .setInitialSpeechPHROMNumber                    ; set current Filing System ROM/PHROM
 17806  f351 2018ee                 JSR .readByteFromROMOrPHROM                         ; get byte from data ROM check type
 17807  f354 9003                   BCC .searchForBlockReadHeaderAndCompare             ; if (carry clear) then branch
 17808  f356 b8                     CLV                                                 ; clear overflow flag
 17809  f357 5041                   BVC .pullAAndReturn                                 ; ALWAYS branch
 17810                          
 17811                          ; ***************************************************************************************
 17812                          .searchForBlockReadHeaderAndCompare
 17813  f359 207bf7                 JSR .readBlockHeader                                ; read block header
 17814  f35c adc603                 LDA .fsBlockNumberLow                               ; block number
 17815  f35f 85b4                   STA .currentBlockNumberLow                          ; current block number low
 17816  f361 adc703                 LDA .fsBlockNumberHigh                              ; block number high
 17817  f364 85b5                   STA .currentBlockNumberHigh                         ; current block number high
 17818  f366 a2ff                   LDX #$FF                                            ; X=$FF
 17819  f368 8edf03                 STX .fsLastBlockReadFlagsCopy                       ; copy of last read block flag
 17820  f36b e8                     INX                                                 ; X=0
 17821  f36c 86ba                   STX .currentBlockHasDataErrorFlag                   ; reset data error flag to zero
 17822  f36e f006                   BEQ +                                               ; ALWAYS branch
 17823                          
 17824                          .searchForBlockLoop
 17825  f370 2069fb                 JSR .incrementBlockNumbers                          ; increment current block number
 17826  f373 207bf7                 JSR .readBlockHeader                                ; read block header
 17827                          
 17828                          +
 17829  f376 ad4702                 LDA .tapeOrROMSwitch                                ; get filing system flag 0=tape; 2=ROMFS
 17830  f379 f002                   BEQ +                                               ; if (tape filing system is active) then branch
 17831  f37b 501d                   BVC .pullAAndReturn                                 ; if (final block, on ROMFS) then branch (exit)
 17832                          
 17833                          +
