 20300                          ; ***************************************************************************************
 20301                          ; ***************************************************************************************
 20302                          ;
 20303                          ; Chapter 23: Extended vectors
 20304                          ;
 20305                          ; ***************************************************************************************
 20306                          ; ***************************************************************************************
 20307                          
 20308                          ; ***************************************************************************************
 20309                          ;
 20310                          ; Extended Vector Entry Points
 20311                          ;
 20312                          ; ***************************************************************************************
 20313                          ; See NAUG Section 17.4.3 - Extended Vectors, Page 312
 20314                          ;
 20315                          ; There is a mechanism by which Paged ROMs can intercept the standard vectors at $0200
 20316                          ; upwards, instead getting them to point to a specific address *in a specified ROM*.
 20317                          ;
 20318                          ; To intercept vector N:
 20319                          ;
 20320                          ;   - Disable interrupts during this change over
 20321                          ;   - Get memory base address (call it V) using OSBYTE 168
 20322                          ;           (V is address '.extendedVectorSpace' in this particular version of the ROM)
 20323                          ;   - Store desired ROM address for routine at the two byte starting at V+3*N
 20324                          ;   - Store desired ROM number in the following byte
 20325                          ;   - Make a copy of the original contents of the vector at $0200+2*N if needed
 20326                          ;   - Store the address '$FF00+3*N' in OS vector at '$0200+2*N'
 20327                          ;
 20328                          .extendedVectorTable
 20329  ff00 2051ff                 JSR .extendedVectorEntryPoint                       ; E_USERV
 20330  ff03 2051ff                 JSR .extendedVectorEntryPoint                       ; E_BRKV
 20331  ff06 2051ff                 JSR .extendedVectorEntryPoint                       ; E_IRQ1V
 20332  ff09 2051ff                 JSR .extendedVectorEntryPoint                       ; E_IRQ2V
 20333  ff0c 2051ff                 JSR .extendedVectorEntryPoint                       ; E_CLIV
 20334  ff0f 2051ff                 JSR .extendedVectorEntryPoint                       ; E_BYTEV
 20335  ff12 2051ff                 JSR .extendedVectorEntryPoint                       ; E_WORDV
 20336  ff15 2051ff                 JSR .extendedVectorEntryPoint                       ; E_WRCHV
 20337  ff18 2051ff                 JSR .extendedVectorEntryPoint                       ; E_RDCHV
 20338  ff1b 2051ff                 JSR .extendedVectorEntryPoint                       ; E_FILEV
 20339  ff1e 2051ff                 JSR .extendedVectorEntryPoint                       ; E_ARGSV
 20340  ff21 2051ff                 JSR .extendedVectorEntryPoint                       ; E_BGETV
 20341  ff24 2051ff                 JSR .extendedVectorEntryPoint                       ; E_BPUTV
 20342  ff27 2051ff                 JSR .extendedVectorEntryPoint                       ; E_GBPBV
 20343  ff2a 2051ff                 JSR .extendedVectorEntryPoint                       ; E_FINDV
 20344  ff2d 2051ff                 JSR .extendedVectorEntryPoint                       ; E_FSCV
 20345  ff30 2051ff                 JSR .extendedVectorEntryPoint                       ; E_EVENTV
 20346  ff33 2051ff                 JSR .extendedVectorEntryPoint                       ; E_UPTV
 20347  ff36 2051ff                 JSR .extendedVectorEntryPoint                       ; E_NETV
 20348  ff39 2051ff                 JSR .extendedVectorEntryPoint                       ; E_VDUV
 20349  ff3c 2051ff                 JSR .extendedVectorEntryPoint                       ; E_KEYV
 20350  ff3f 2051ff                 JSR .extendedVectorEntryPoint                       ; E_INSV
 20351  ff42 2051ff                 JSR .extendedVectorEntryPoint                       ; E_REMV
 20352  ff45 2051ff                 JSR .extendedVectorEntryPoint                       ; E_CNPV
 20353  ff48 2051ff                 JSR .extendedVectorEntryPoint                       ; E_IND1V
 20354  ff4b 2051ff                 JSR .extendedVectorEntryPoint                       ; E_IND2V
 20355  ff4e 2051ff                 JSR .extendedVectorEntryPoint                       ; E_IND3V
 20356                          
 20357                          ; ***************************************************************************************
 20358                          .extendedVectorEntryPoint
 20359  ff51 48                     PHA                                                 ; save A on stack - make space for currently selected ROM (address '$109,X' in code below)
 20360  ff52 48                     PHA                                                 ; save A on stack - make space for return address low     (address '$108,X' in code below)
 20361  ff53 48                     PHA                                                 ; save A on stack - make space for return address high    (address '$107,X' in code below)
 20362  ff54 48                     PHA                                                 ; save A on stack - make space for ROM address low        (address '$106,X' in code below)
 20363  ff55 48                     PHA                                                 ; save A on stack - make space for ROM address high       (address '$105,X' in code below)
 20364                          
 20365  ff56 08                     PHP                                                 ; }
 20366  ff57 48                     PHA                                                 ; }
 20367  ff58 8a                     TXA                                                 ; } save Flags,A,X,Y to the stack
 20368  ff59 48                     PHA                                                 ; }
 20369  ff5a 98                     TYA                                                 ; }
 20370  ff5b 48                     PHA                                                 ; }
 20371  ff5c ba                     TSX                                                 ; get stack pointer into X
 20372                          
 20373  ff5d a9ff                   LDA #>(.returnFromROM-1)                            ; }
 20374  ff5f 9d0801                 STA .stackPage + 8,X                                ; }
 20375  ff62 a988                   LDA #<(.returnFromROM-1)                            ; } store return address in the stack (the .returnFromROM routine below)
 20376  ff64 9d0701                 STA .stackPage + 7,X                                ; }
 20377                          
 20378  ff67 bc0a01                 LDY .stackPage + 10,X                               ; Y=3*N+2 (low byte of caller address)
 20379  ff6a b99d0d                 LDA .extendedVectorSpace-2,Y                        ; get low byte of action address
 20380  ff6d 9d0501                 STA .stackPage + 5,X                                ; store it on stack
 20381  ff70 b99e0d                 LDA .extendedVectorSpace-1,Y                        ; get high byte of action address
 20382  ff73 9d0601                 STA .stackPage + 6,X                                ; store it on stack
 20383  ff76 a5f4                   LDA .currentlySelectedROM                           ; get the current ROM number
 20384  ff78 9d0901                 STA .stackPage + 9,X                                ; store it on stack
 20385  ff7b b99f0d                 LDA .extendedVectorSpace,Y                          ; get new ROM number
 20386  ff7e 85f4                   STA .currentlySelectedROM                           ; store RAM copy of current ROM
 20387  ff80 8d30fe                 STA .romSelectRegister                              ; switch the ROM into the memory map
 20388  ff83 68                     PLA                                                 ; }
 20389  ff84 a8                     TAY                                                 ; }
 20390  ff85 68                     PLA                                                 ; } Restore Y,X,A from stack
 20391  ff86 aa                     TAX                                                 ; }
 20392  ff87 68                     PLA                                                 ; }
 20393                          
 20394  ff88 40                     RTI                                                 ; the RTI instruction restores the
 20395                                                                                  ; flags, and jumps to the (ROM)
 20396                                                                                  ; address we've put on the stack.
 20397                                                                                  ; i.e. this jumps to the ROM routine.
 20398                                                                                  ; When that returns, the address on
 20399                                                                                  ; the stack jumps us to the routine
 20400                                                                                  ; below.
 20401                          
 20402                          ; ***************************************************************************************
 20403                          ;
 20404                          ; Return from ROM
 20405                          ;
 20406                          ; Once the ROM routine from above is finished, the return address takes us here, which restores
 20407                          ; the registers and returns to the proper calling routine.
 20408                          ;
 20409                          .returnFromROM
 20410  ff89 08                     PHP                                                 ; }
 20411  ff8a 48                     PHA                                                 ; }
 20412  ff8b 8a                     TXA                                                 ; } save Flags,A,X to the stack
 20413  ff8c 48                     PHA                                                 ; }
 20414  ff8d ba                     TSX                                                 ;
 20415  ff8e bd0201                 LDA .stackPage + 2,X                                ; }
 20416  ff91 9d0501                 STA .stackPage + 5,X                                ; }
 20417  ff94 bd0301                 LDA .stackPage + 3,X                                ; } store real return address onto stack (ready for RTS)
 20418  ff97 9d0601                 STA .stackPage + 6,X                                ; }
 20419                          
 20420  ff9a 68                     PLA                                                 ; }
 20421  ff9b aa                     TAX                                                 ; } recall X
 20422  ff9c 68                     PLA                                                 ; recall A - lose these 2 bytes. They are the address of this routine.
 20423  ff9d 68                     PLA                                                 ; recall A - lose these 2 bytes. They are the address of this routine.
 20424  ff9e 68                     PLA                                                 ; get back A (original ROM number)
 20425  ff9f 85f4                   STA .currentlySelectedROM                           ; store it as RAM copy of current ROM number
 20426  ffa1 8d30fe                 STA .romSelectRegister                              ; switch the ROM into the memory map
 20427                          
 20428  ffa4 68                     PLA                                                 ; get back A
 20429  ffa5 28                     PLP                                                 ; get back flags
 20430                          .return
 20431  ffa6 60                     RTS                                                 ; return (pulls real return address from stack)
 20432                          
