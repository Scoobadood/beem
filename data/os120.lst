   641                          .eventUserEvent                             = 9         ; For user events
   642                          
   643                          ; ***************************************************************************************
   644                          ;
   645                          ; CRTC registers
   646                          ;
   647                          ; See 6845.png
   648                          ;
   649                          ; These 18 registers are mostly write only
   650                          ; See NAUG Section 13.3.3, Page 190
   651                          ;
   652                          ; Register  Description                             Default value for MODE
   653                          ;                                              0     1     2     3     4     5     6     7
   654                          ; ----------------------------------------------------------------------------------------
   655                          ; R0        Horizontal total                 127   127   127   127    63    63    63    63
   656                          ; R1        Characters per line               80    80    80    80    40    40    40    40
   657                          ; R2        Horizontal sync position          98    98    98    98    49    49    49    51
   658                          ; R3        Horizontal sync width (bits 0-3)   8     8     8     8     4     4     4     4
   659                          ;           + Vertical sync width (bits 4-7)   2     2     2     2     2     2     2     2
   660                          ; R4        Vertical total                    38    38    38    30    38    38    30    30
   661                          ; R5        Vertical total adjust              0     0     0     2     0     0     2     2
   662                          ; R6        Vertical displayed characters     32    32    32    25    32    32    25    25
   663                          ; R7        Vertical sync position            34    34    34    27    34    34    27    27
   664                          ; R8        Interlace mode (bits 0,1)          1     1     1     1     1     1     1     3
   665                          ;           + Display delay (bits 4,5)         0     0     0     0     0     0     0     1
   666                          ;           + Cursor delay (bits 6,7)          0     0     0     0     0     0     0     2
   667                          ; R9        Scan lines per character           7     7     7     9     7     7     9    18
   668                          ; R10       Cursor start (bits 0-4)            7     7     7     7     7     7     7    18
   669                          ;           Cursor type (bit 5)                1     1     1     1     1     1     1     1
   670                          ;           Cursor blink (bit 6)               1     1     1     1     1     1     1     1
   671                          ; R11       Cursor end                         8     8     8     9     8     8     9    19
   672                          ; R12,R13   Screen start address / 8           -     -     -     -     -     -     -     -
   673                          ; R14,R15   Cursor position                    -     -     -     -     -     -     -     -
   674                          ; R16,R17   Light pen position                 -     -     -     -     -     -     -     -
   675                          ;
   676                          ; R0    = The total number of 'character time units' across the screen - 1 (including
   677                          ;         non-displayed characters)
   678                          ; R1    = Number of displayed characters across the screen
   679                          ; R2    = Horizontal sync pulse (changing this moves the screen left/right)
   680                          ; R3    = Horz/Vert sync pulse width. Not advisable to change since most TVs/monitors require
   681                          ;         the standard values.
   682                          ; R4/R5 = (Integer) number of character rows (R4) + (fractional) number of scan lines (R5)
   683                          ;         to make a 50Hz refresh rate.
   684                          ; R6    = Number of displayed character rows
   685                          ; R7    = Vertical sync position in character rows (moves display up and down by character
   686                          ;         rows. Used by *TV)
   687                          ; R8    = bits 0-1 = interlacing (0 or 2 = non interlaced; 1 = interlaced; 2 = interlace and
   688                          ;         video for MODE 7 support)
   689                          ;         bits 2-3 = unused
   690                          ;         bits 4-5 = display blanking delay (0 = no delay; 1 = one character delay; 2 = two
   691                          ;         character delay; 3 = disable video output)
   692                          ;         bits 6-7 = cursor blanking delay (0 = No delay; 1 = one character delay; 2 = two
   693                          ;         character delay; 3 = disable cursor output)
   694                          ; R9    = scan lines per character - 1
   695                          ; R10   = cursor start register
   696                          ;           bit 7 = unused
   697                          ;           bit 6 = enable / disable blinking
   698                          ;           bit 5 = blink rate (fast when set)
   699                          ;           bits 0-4 = cursor start scan line
   700                          ; R11   = bits 0-4 = cursor end scan line
   701                          ; R12/R13 = When setting R12/R13 the value to set is related to the screen start address as
   702                          ; follows:
   703                          ;
   704                          ; MODE 0-6: set (screen address / 8)
   705                          ;   MODE 7: set (screen address - $7400 EOR $2000)
   706                          ;
   707                          ; The same logic applies to setting R14/R15 (cursor position)
   708                          ;
   709                          ; R16/R17 = light pen position. See NAUG Section 13.3.9, Page 196.
   710                          ;
   711                          ; The CRTC registers can be set directly by writing to memory mapped IO. Write the register
   712                          ; to change in .crtcAddressRegister ($FE00) then write the new value in .crtcAddressWrite
   713                          ; ($FE01). (The OS sets these registers in .setCRTCRegisterDirect and .setTwoCRTCRegisters)
   714                          ;
   715                          ; A more OS friendly method is to use "VDU 23,0,R,V,0,0,0,0,0,0" to set register R to value V.
   716                          ;
   717                          ; ***************************************************************************************
   718                          .crtcHorizontalTotalRegister                = 0         ;
   719                          .crtcHorizontalDisplayedRegister            = 1         ;
   720                          .crtcHorizontalSyncPositionRegister         = 2         ;
   721                          .crtcSyncWidthRegister                      = 3         ;
   722                          .crtcVerticalTotalRegister                  = 4         ;
   723                          .crtcVerticalTotalAdjustRegister            = 5         ;
   724                          .crtcVerticalDisplayedCharactersRegister    = 6         ;
   725                          .crtcVerticalSyncPositionRegister           = 7         ;
   726                          .crtcInterlaceAndDelayRegister              = 8         ;
   727                          .crtcScanLinesPerCharacterRegister          = 9         ;
   728                          .crtcCursorStartRegister                    = 10        ;
   729                          .crtcCursorEndRegister                      = 11        ;
   730                          .crtcStartScreenAddressHighRegister         = 12        ;
   731                          .crtcStartScreenAddressLowRegister          = 13        ;
   732                          .crtcCursorPositionHighRegister             = 14        ;
   733                          .crtcCursorPositionLowRegister              = 15        ;
   734                          .crtcLightPenPositionHighRegister           = 16        ;
   735                          .crtcLightPenPositionLowRegister            = 17        ;
   736                          
