 18114                          ; ***************************************************************************************
 18115                          ;
 18116                          ; OSBGET - get byte from file
 18117                          ;
 18118                          ; On Entry:
 18119                          ;       Y contains channel number (file handle)
 18120                          ; On Exit:
 18121                          ;       X and Y are preserved
 18122                          ;       C=0 indicates valid character
 18123                          ;       A contains character (or error) A=$FE End Of File
 18124                          ;
 18125                          ; See LoadFromTape.pdf
 18126                          ; See LoadFromROM.pdf
 18127                          ;
 18128                          ; ***************************************************************************************
 18129                          .osbgetEntryPoint
 18130  f4c9 8a                     TXA                                                 ; A=X
 18131  f4ca 48                     PHA                                                 ; save A on stack
 18132  f4cb 98                     TYA                                                 ; A=Y
 18133  f4cc 48                     PHA                                                 ; save A on stack
 18134  f4cd a901                   LDA #1                                              ; A=1 (check file is open for reading)
 18135  f4cf 209cfb                 JSR .checkFileIsOpen                                ; check conditions for OSBGET are OK
 18136  f4d2 a5e2                   LDA .fsStatusByte                                   ; tape/ROM FS status byte
 18137  f4d4 0a                     ASL                                                 ; shift bit 7 into carry (EOF warning given)
 18138  f4d5 b04c                   BCS .eofErrorMessage                                ; if (carry set) then branch
 18139  f4d7 0a                     ASL                                                 ; shift bit 6 into carry
 18140  f4d8 9009                   BCC .notEOF                                         ; if (carry clear, i.e. EOF not reached) then branch
 18141  f4da a980                   LDA #%10000000                                      ; }
 18142  f4dc 2044f3                 JSR .setTapeStatusBits                              ; } set bit 7 of status byte ('EOF warning given')
 18143  f4df a9fe                   LDA #$FE                                            ; A = return value = $FE (end of file)
 18144  f4e1 b038                   BCS .storeFileStatus                                ; if (carry set) then branch
 18145                          
 18146                          .notEOF
 18147  f4e3 ae9e03                 LDX .bgetBufferOffset                               ; BGET buffer offset for next byte
 18148  f4e6 e8                     INX                                                 ; X=X+1
 18149  f4e7 ecea02                 CPX .tapeInputCurrentBlockSizeLow                   ; tape filing system currently resident file block length low
 18150  f4ea d02a                   BNE .readFromFSBufferAndContinue                    ; if (not end of block) then branch (read a byte from buffer)
 18151                          
 18152  f4ec 2cec02                 BIT .blockFlagOfCurrentlyResidentBlock              ; block flag of currently resident block
 18153  f4ef 3022                   BMI .setEOF                                         ; if (this is the last block) then branch
 18154  f4f1 aded02                 LDA .lastCharacterOfCurrentlyResidentBlock          ; last character of currently resident block
 18155  f4f4 48                     PHA                                                 ; save A on stack
 18156  f4f5 201afb                 JSR .claimSerialSystemForSequentialAccess           ; claim serial system and set OPTions
 18157  f4f8 08                     PHP                                                 ; save flags on stack
 18158  f4f9 20acf6                 JSR .bgetReadBlockAndHeader                         ; read in a new block
 18159  f4fc 28                     PLP                                                 ; get back flags
 18160  f4fd 68                     PLA                                                 ; get back A
 18161  f4fe 85bc                   STA .fsTempStorage                                  ; store return value: last byte of current block
 18162  f500 18                     CLC                                                 ; clear carry flag
 18163  f501 2cec02                 BIT .blockFlagOfCurrentlyResidentBlock              ; block flag of currently resident block
 18164  f504 1017                   BPL .incrementAndFinish                             ; if (not last block) then branch
 18165  f506 adea02                 LDA .tapeInputCurrentBlockSizeLow                   ; get block length
 18166  f509 0deb02                 ORA .tapeInputCurrentBlockSizeHigh                  ; OR with high byte
 18167  f50c d00f                   BNE .incrementAndFinish                             ; if (block size not zero) then branch
 18168  f50e 2042f3                 JSR .setTapeEOFStatus                               ; set tape filing system status bit 6 (EOF reached)
 18169  f511 d00a                   BNE .incrementAndFinish                             ; if (not EOF) then branch
 18170                          
 18171                          .setEOF
 18172  f513 2042f3                 JSR .setTapeEOFStatus                               ; set tape filing system status bit 6 (EOF reached)
 18173                          
 18174                          .readFromFSBufferAndContinue
 18175  f516 ca                     DEX                                                 ; X=X-1
 18176  f517 18                     CLC                                                 ; clear carry flag
 18177  f518 bd000a                 LDA .tapeOrRS423InputBuffer,X                       ; read byte from cassette buffer
 18178                          
 18179                          .storeFileStatus
 18180  f51b 85bc                   STA .fsTempStorage                                  ; store return value temporarily
 18181                          .incrementAndFinish
 18182  f51d ee9e03                 INC .bgetBufferOffset                               ; BGET buffer offset for next byte
 18183  f520 4c71f4                 JMP .restoreRegistersAndExit                        ; exit via .restoreRegistersAndExit
 18184                          
 18185                          ; ***************************************************************************************
 18186                          .eofErrorMessage
 18187  f523 00                     BRK                                                 ;
 18188  f524 df                     !byte $DF                                           ; error number
 18189  f525 454f4600               !text "EOF",0                                       ; string and zero terminator
 18190                          
 18191                          ; ***************************************************************************************
 18192                          ;
 18193                          ; OSBPUT - Write a byte to file
 18194                          ;
 18195                          ; This is for the TAPE filing system only. The OS supplies filing system code for TAPE and
 18196                          ; ROM filing systems, and obviously you can't write into the ROM filing system.
 18197                          ;
 18198                          ; On Entry:
 18199                          ;       Y contains channel number (file handle)
 18200                          ;       A contains byte to be written
 18201                          ;
 18202                          ; See .saveFileToTape for PDF showing the code path and how bytes are written to tape.
 18203                          ;
 18204                          ; ***************************************************************************************
 18205                          .osbputEntryPoint
 18206  f529 85c4                   STA .tapeLastBputValue                              ; store A in temporary store
 18207  f52b 8a                     TXA                                                 ; }
 18208  f52c 48                     PHA                                                 ; } save XY on the stack
 18209  f52d 98                     TYA                                                 ; }
 18210  f52e 48                     PHA                                                 ; }
 18211  f52f a902                   LDA #2                                              ; A=2 (meaning check file is open for writing)
 18212  f531 209cfb                 JSR .checkFileIsOpen                                ; check conditions necessary for OSBPUT are OK
 18213  f534 ae9d03                 LDX .bputBufferOffset                               ; BPUT buffer offset for next byte
 18214  f537 a5c4                   LDA .tapeLastBputValue                              ; get back original value of A
 18215  f539 9d0009                 STA .tapeOrRS423OutputBuffer,X                      ; Write into cassette or RS-423 buffer
 18216  f53c e8                     INX                                                 ; X=X+1
 18217  f53d d006                   BNE +                                               ; if (not zero, buffer is not full) then branch
 18218  f53f 2096f4                 JSR .saveSequentialAccessBlockToTape                ; buffer is full so save block to tape
 18219  f542 20f2fa                 JSR .cancelTapeOperationAndMotor                    ;
 18220                          +
 18221  f545 ee9d03                 INC .bputBufferOffset                               ; BPUT buffer offset for next byte
 18222  f548 a5c4                   LDA .tapeLastBputValue                              ; get back A
 18223  f54a 4c6ff4                 JMP .returnAWithXYRestoredFromStack                 ; and exit
 18224                          
 18225                          ; ***************************************************************************************
 18226                          ;
 18227                          ; *OPT X,Y
 18228                          ;
 18229                          ; On Entry:
 18230                          ;
 18231                          ;        X,Y
 18232                          ;   *OPT 0,0  restore *OPT default message values
 18233                          ;   *OPT 1,0  turn off filing system messages
 18234                          ;   *OPT 1,1  turn on filing system messages (normal)
 18235                          ;   *OPT 1,2  turn on filing system messages (extended)
 18236                          ;   *OPT 2,0  ignore errors, though messages may be displayed
 18237                          ;   *OPT 2,1  on error prompt for retry
 18238                          ;   *OPT 2,2  on error, abort
 18239                          ;   *OPT 3,n  set interblock gaps to n/10 seconds (for tape SAVE operations)
 18240                          ;             if n>127 then set default value
 18241                          ;
 18242                          ; ***************************************************************************************
 18243                          .starOptEntryPoint
 18244  f54d 8a                     TXA                                                 ; A=X
 18245  f54e f02e                   BEQ .restoreDefaultOPTs                             ; if (*OPT 0) then branch (set defaults)
 18246  f550 e003                   CPX #3                                              ;
 18247  f552 f01f                   BEQ .tapeSetInterblockGap                           ; if (*OPT 3) then branch (to set interblock gap)
 18248  f554 c003                   CPY #3                                              ;
 18249  f556 b006                   BCS .issueBadCommand                                ; if (Y > 2) then branch ('Bad command' error)
 18250  f558 ca                     DEX                                                 ;
 18251  f559 f006                   BEQ .opt1                                           ; if (*OPT 1) then branch (set filing system message level)
 18252  f55b ca                     DEX                                                 ;
 18253  f55c f00a                   BEQ .opt2                                           ; if (*OPT 2) then branch (response level to errors)
 18254                          .issueBadCommand
 18255  f55e 4c10e3                 JMP .badCommandError                                ; issue 'Bad command' error
 18256                          
 18257                          
 18258                          ; ***************************************************************************************
 18259                          ; Set filing system message level
 18260                          .opt1
 18261  f561 a933                   LDA #%00110011                                      ; set lower two bits of each nybble as a MASK
 18262                                                                                  ; this allows us to set the top two bits of each nybble (message type) and
 18263                                                                                  ; still keep the existing values for the bottom two bits
 18264                                                                                  ; of each nybble (ignore/retry/abort)
 18265  f563 c8                     INY                                                 ; }
 18266  f564 c8                     INY                                                 ; } Y=Y+3 (offset into .tapeOptByteTable)
 18267  f565 c8                     INY                                                 ; }
 18268  f566 d002                   BNE .setOptWithMask                                 ; ALWAYS branch
 18269                          
 18270                          ; ***************************************************************************************
 18271                          ; Set error levels
 18272                          .opt2
 18273  f568 a9cc                   LDA #%11001100                                      ; setting top two bits of each nybble as a MASK
 18274                                                                                  ; allows us to set the bottom two bits of each nybble (ignore/retry/abort) and
 18275                                                                                  ; still keep the existing values for the top two bits
 18276                                                                                  ; of each nybble (message type)
 18277                          .setOptWithMask
 18278  f56a c8                     INY                                                 ; Y=Y+1 (offset into .tapeOptByteTable)
 18279  f56b 25e3                   AND .tapeOptionsByte                                ; keep bits set in MASK for keeping current tape options
 18280                          .setOPTValueY
 18281  f56d 1981f5                 ORA .tapeOptByteTable,Y                             ; OR with table value to set new options
 18282  f570 85e3                   STA .tapeOptionsByte                                ; store it
 18283  f572 60                     RTS                                                 ;
 18284                          
 18285                          ; ***************************************************************************************
 18286                          .tapeSetInterblockGap
 18287  f573 98                     TYA                                                 ; A=Y (interblock gap)
 18288  f574 3002                   BMI +                                               ; if (A > 127) use default value
 18289  f576 d002                   BNE .useGapDontUseDefaultValue                      ; if (A != 0) then branch (don't use default value)
 18290                          +
 18291  f578 a919                   LDA #25                                             ; A=25 (2.5 seconds by default)
 18292                          .useGapDontUseDefaultValue
 18293  f57a 8dd103                 STA .tapeSequentialAccessInterBlockGap              ; sequential block gap
 18294  f57d 60                     RTS                                                 ;
 18295                          
 18296                          ; ***************************************************************************************
 18297                          .restoreDefaultOPTs
 18298  f57e a8                     TAY                                                 ; Y=A=0
 18299  f57f f0ec                   BEQ .setOPTValueY                                   ; ALWAYS branch
 18300                          
 18301                          
 18302                          ; ***************************************************************************************
 18303                          ;
 18304                          ; Tape opt byte table
 18305                          ;
 18306                          ; Options are stored in top four bits (LOAD/SAVE) and bottom four bits (sequential access)
 18307                          ; See .tapeCurrentOptionsByte.
 18308                          ;
 18309                          ;   bit 0/4 = Abort bit
 18310                          ;   bit 1/5 = Retry bit
 18311                          ;   bit 2/6 } Message type: 00 = no messages
 18312                          ;   bit 3/7 }             : 10 = short messages
 18313                          ;           }             : 11 = long messages
 18314                          ;
 18315                          ; 0000     Ignore errors         no messages
 18316                          ; 0001     Abort if error        no messages
 18317                          ; 0010     Retry after error     no messages
 18318                          ; 1000     Ignore error          short messages
 18319                          ; 1001     Abort if error        short messages
 18320                          ; 1010     Retry after error     short messages
 18321                          ; 1100     Ignore error          long messages
 18322                          ; 1101     Abort if error        long messages
 18323                          ; 1110     Retry after error     long messages
 18324                          ;
 18325                          ; ***************************************************************************************
 18326                          .tapeOptByteTable
 18327  f581 a1                     !byte %10100001                                     ; default value:
 18328                                                                                  ; LOAD/SAVE: Retry; short messages
 18329                                                                                  ; SEQUENTIAL: Abort; no messages
 18330  f582 00                     !byte %00000000                                     ; ignore error
 18331  f583 22                     !byte %00100010                                     ; retry if error
 18332  f584 11                     !byte %00010001                                     ; abort if error
 18333  f585 00                     !byte %00000000                                     ; no messages
 18334  f586 88                     !byte %10001000                                     ; short messages
 18335  f587 cc                     !byte %11001100                                     ; long messages
 18336                          
 18337                          ; ***************************************************************************************
 18338                          ; ***************************************************************************************
 18339                          ;
 18340                          ; Chapter 19: Low Level Tape Operations
 18341                          ;
 18342                          ; ***************************************************************************************
 18343                          ; ***************************************************************************************
 18344                          
 18345                          ; ***************************************************************************************
 18346                          ;
 18347                          ; Update ACIA
 18348                          ;
 18349                          ; If necessary, read or write a byte to cassette, or read a byte from ROMFS.
 18350                          ; Can either be called from interrupt routine, or when loading from cassette.
 18351                          ;
 18352                          ; ***************************************************************************************
 18353                          .updateACIA
 18354  f588 c6c0                   DEC .fsGotACharacterToReadOrWriteFlag               ; Used when writing to tape,
 18355                                                                                  ; to decrement the value from zero to
 18356                                                                                  ; 255 indicating the byte has been
 18357                                                                                  ; written (which happens below)
 18358                          
 18359  f58a ad4702                 LDA .tapeOrROMSwitch                                ; filing system flag 0=tape; 2=ROMFS
 18360  f58d f007                   BEQ .updateACIATape                                 ; if (tape filing system active) then branch
 18361                          
 18362                              ; deal with reading a byte from ROM / PHROM
 18363  f58f 2051ee                 JSR .readByteFromROMFSorPHROM                       ; read ROMFS data ROM or PHROM
 18364  f592 a8                     TAY                                                 ; Y=A
 18365  f593 18                     CLC                                                 ; clear carry flag
 18366  f594 901a                   BCC .postReadByte                                   ; ALWAYS branch
 18367                          
 18368                          .updateACIATape
 18369                              ; deal with reading or writing to tape
 18370  f596 ad08fe                 LDA .acia6850StatusRegister                         ; ACIA status register
 18371  f599 48                     PHA                                                 ; save A on stack
 18372  f59a 2902                   AND #2                                              ; clear all but bit 1
 18373  f59c f00b                   BEQ .readByteFromTape                               ; if (transmit data register full,
 18374                                                                                  ; i.e. not ready to send) then branch
 18375                                                                                  ; (read from tape)
 18376  f59e a4ca                   LDY .tapeSendingFlag                                ; check we are sending to tape
 18377  f5a0 f007                   BEQ .readByteFromTape                               ; if (not sending to tape) then
 18378                                                                                  ; branch (read from tape)
 18379                          
 18380                              ; send a byte to tape
 18381  f5a2 68                     PLA                                                 ; get back A
 18382  f5a3 a5bd                   LDA .fsCharacterJustReadOrCharToWrite               ; get character to send
 18383  f5a5 8d09fe                 STA .acia6850DataRegister                           ; ACIA transmit data register
 18384  f5a8 60                     RTS                                                 ;
 18385                          
 18386                              ; read a byte from tape
 18387                          .readByteFromTape
 18388  f5a9 ac09fe                 LDY .acia6850DataRegister                           ; read ACIA receive data register
 18389  f5ac 68                     PLA                                                 ; get back A
 18390  f5ad 4a                     LSR                                                 ; }
 18391  f5ae 4a                     LSR                                                 ; } shift bit 2 to carry
 18392  f5af 4a                     LSR                                                 ; } (data carrier detect)
 18393                              ; fall through
 18394                          
 18395                          ; ***************************************************************************************
 18396                          ;
 18397                          ; Process byte after being read from tape or ROMFS
 18398                          ;
 18399                          ; This is called from the 100Hz interrupt routine. It updates the read progress state as
 18400                          ; needed, and stores the byte for later processing in .readBlockHeader and
 18401                          ; .readTapeBlockHeader.
 18402                          ; See .readBlockHeader.
 18403                          ; See .readTapeBlockHeader.
 18404                          ;
 18405                          ; The progress in reading a block is tracked by a progress byte (0-5):
 18406                          ;
 18407                          ; See .fsReadProgressState
 18408                          ;
 18409                          ;     0 - exit
 18410                          ;     1 - looking for carrier tone
 18411                          ;     2 - found carrier tone, waiting for sync byte $2A
 18412                          ;     3 - found sync byte $2A, now reading header
 18413                          ;     4 - have read the header with non-zero block data length, now reading actual block data
 18414                          ;     5 - finished reading data in block
 18415                          ;
 18416                          ; On Entry:
 18417                          ;       Y = byte just read
 18418                          ;       Carry set if it's the tape filing system and 'data carrier detect' bit is set
 18419                          ;
 18420                          ; ***************************************************************************************
 18421                          .postReadByte
 18422  f5b0 a6c2                   LDX .fsReadProgressState                            ; read progress state
 18423  f5b2 f069                   BEQ .exit31                                         ; if (.fsReadProgressState = 0) then branch (exit)
 18424  f5b4 ca                     DEX                                                 ; X=X-1
 18425  f5b5 d006                   BNE .fsReadProgress2FoundCarrierTone                ; if (.fsReadProgressState > 1) then branch
 18426                          
 18427                              ; deal with progress state = 1 (looking for carrier tone)
 18428  f5b7 9064                   BCC .exit31                                         ; if (reading from ROM OR carrier
 18429                                                                                  ; tone from cassette not detected)
 18430                                                                                  ; then branch (exit)
 18431  f5b9 a002                   LDY #2                                              ; Y=2
 18432  f5bb d05e                   BNE .storeTapeProgress                              ; ALWAYS branch (store progress and
 18433                                                                                  ; return)
 18434                          
 18435                          ; ***************************************************************************************
 18436                          .fsReadProgress2FoundCarrierTone
 18437  f5bd ca                     DEX                                                 ; X=X-1
 18438  f5be d013                   BNE .fsReadProgress3FoundSyncByte                   ; if (.fsReadProgressState > 2) then branch
 18439                          
 18440                              ; deal with progress state = 2 (found carrier tone, waiting for it to finish)
 18441  f5c0 b05b                   BCS .exit31                                         ; if (carrier tone from cassette
 18442                                                                                  ; still detected) then branch (exit)
 18443                          
 18444  f5c2 98                     TYA                                                 ; A=Y=byte read
 18445  f5c3 2078fb                 JSR .zeroChecksumAndFSFlag                          ; initialise CRC checksum to zero
 18446  f5c6 a003                   LDY #3                                              ; Y=3
 18447  f5c8 c92a                   CMP #.fsSynchronisationByte                         ; check for the sync byte $2A
 18448  f5ca f04f                   BEQ .storeTapeProgress                              ; if (found sync byte) then branch
 18449                                                                                  ; (store state and return)
 18450                          
 18451                              ; sync byte not found, revert back to progress state 1
 18452  f5cc 2050fb                 JSR .flipRelayOffAndOnThenSetToReadFromTape         ; control cassette system
 18453  f5cf a001                   LDY #1                                              ; Y=1
 18454  f5d1 d048                   BNE .storeTapeProgress                              ; ALWAYS branch
 18455                          
 18456                          ; ***************************************************************************************
 18457                          .fsReadProgress3FoundSyncByte
 18458  f5d3 ca                     DEX                                                 ; X=X-1
 18459  f5d4 d00c                   BNE .fsReadProgress4FoundBlockData                  ; if (.fsReadProgressState > 3) then branch
 18460                          
 18461                              ; deal with progress state = 3 (found sync byte $2A, reading block header)
 18462  f5d6 b004                   BCS +                                               ; if (carrier detected) then branch
 18463  f5d8 84bd                   STY .fsCharacterJustReadOrCharToWrite               ; store byte just read
 18464  f5da f041                   BEQ .exit31                                         ; if (zero) then branch (exit)
 18465                          +
 18466  f5dc a980                   LDA #$80                                            ; A=$80
 18467  f5de 85c0                   STA .fsGotACharacterToReadOrWriteFlag               ; note that we have just read a byte
 18468  f5e0 d03b                   BNE .exit31                                         ; ALWAYS branch (exit)
 18469                          
 18470                          ; ***************************************************************************************
 18471                          .fsReadProgress4FoundBlockData
 18472  f5e2 ca                     DEX                                                 ; X=X-1
 18473  f5e3 d029                   BNE .fsReadProgress5FinishedReadingBlockData        ; if (.fsReadProgressState > 4) then branch
 18474                          
 18475                              ; deal with progress state = 4 (found non-zero length block, reading block data)
 18476                          
 18477                              ; if carrier detected then reset progress to zero
 18478  f5e5 b02f                   BCS .resetACIAAndResetProgress                      ; if (carry set) then branch (reset and return)
 18479                          
 18480  f5e7 98                     TYA                                                 ; A=Y=byte just read
 18481  f5e8 20b0f7                 JSR .updateCRC                                      ; perform CRC
 18482  f5eb a4bc                   LDY .fsTempStorage                                  ; get length of block read
 18483  f5ed e6bc                   INC .fsTempStorage                                  ; increment length of block read
 18484  f5ef 24bd                   BIT .fsCharacterJustReadOrCharToWrite               ; check if bit 7 set (meaning
 18485                                                                                  ; searching, not loading)
 18486  f5f1 300d                   BMI .checkForEndOfBlock                             ; if (searching) then branch
 18487                          
 18488                              ; send byte to second processor if needed, or store byte in regular memory
 18489  f5f3 20d3fb                 JSR .checkLoadAddressIsForSecondProcessor           ; check load address is ok
 18490                                                                                  ; also puts value of A (the byte
 18491                                                                                  ; just read) into X
 18492  f5f6 f005                   BEQ +                                               ; if (load address is not for second
 18493                                                                                  ; processor) then branch
 18494  f5f8 8ee5fe                 STX .tubeULADataRegister3                           ; Write byte to Tube. This triggers
 18495                                                                                  ; an NMI on the co-processor.
 18496  f5fb d003                   BNE .checkForEndOfBlock                             ; ALWAYS branch
 18497                          
 18498                          +
 18499  f5fd 8a                     TXA                                                 ; A=X restore value
 18500  f5fe 91b0                   STA (.loadAddressLow),Y                             ; store byte at current load address
 18501                          
 18502                          .checkForEndOfBlock
 18503  f600 c8                     INY                                                 ; Y=Y+1
 18504  f601 ccc803                 CPY .fsBlockLengthLow                               ; block length
 18505  f604 d017                   BNE .exit31                                         ; if (not equal) then branch (exit)
 18506                          
 18507                              ; reached end of block data
 18508  f606 a901                   LDA #1                                              ; A=1
 18509  f608 85bc                   STA .fsTempStorage                                  ; loop counter
 18510  f60a a005                   LDY #5                                              ; Y=5
 18511  f60c d00d                   BNE .storeTapeProgress                              ; ALWAYS branch (store progress and return)
 18512                          
 18513                          ; ***************************************************************************************
 18514                          .fsReadProgress5FinishedReadingBlockData
 18515                              ; this first section reads two more bytes (one byte at a time) by using .fsTempStorage
 18516                              ; (which was initialised to 1 on the previous progress state above) as a loop counter.
 18517  f60e 98                     TYA                                                 ; A=Y=byte read
 18518  f60f 20b0f7                 JSR .updateCRC                                      ; update CRC
 18519  f612 c6bc                   DEC .fsTempStorage                                  ; decrement loop counter (1,0)
 18520  f614 1007                   BPL .exit31                                         ; exit if loop is not done
 18521                          
 18522                          .resetACIAAndResetProgress
 18523  f616 2046fb                 JSR .resetACIA                                      ; reset ACIA
 18524  f619 a000                   LDY #0                                              ; Y=0
 18525                          .storeTapeProgress
 18526  f61b 84c2                   STY .fsReadProgressState                            ; progress state
 18527                          .exit31
 18528  f61d 60                     RTS                                                 ;
 18529                          
 18530                          
 18531                          ; ***************************************************************************************
 18532                          ;
 18533                          ; Check for EOF on an open file
 18534                          ;
 18535                          ; On Entry:
 18536                          ;       X = file handle
 18537                          ; On Exit:
 18538                          ;       Preserves A,Y
 18539                          ;       X is 0 if EOF reached
 18540                          ;
 18541                          ; ***************************************************************************************
 18542                          .checkEOFEntryPoint
 18543  f61e 48                     PHA                                                 ; save A on stack
 18544  f61f 98                     TYA                                                 ;
 18545  f620 48                     PHA                                                 ; save Y on stack
 18546  f621 8a                     TXA                                                 ; }
 18547  f622 a8                     TAY                                                 ; } Y=X=file handle
 18548  f623 a903                   LDA #3                                              ; A=3 (meaning check for file being
 18549                                                                                  ; open for read or write)
 18550  f625 209cfb                 JSR .checkFileIsOpen                                ; confirm file is open (otherwise
 18551                                                                                  ; BRK with 'Channel' error)
 18552  f628 a5e2                   LDA .fsStatusByte                                   ; tape / ROM FS status byte
 18553  f62a 2940                   AND #%01000000                                      ; mask for just the EOF flag
 18554  f62c aa                     TAX                                                 ; X=A
 18555  f62d 68                     PLA                                                 ; get back A
 18556  f62e a8                     TAY                                                 ; Y=A
 18557  f62f 68                     PLA                                                 ; get back A
 18558  f630 60                     RTS                                                 ;
 18559                          
 18560                          ; ***************************************************************************************
 18561                          .searchForFile
 18562  f631 a900                   LDA #0                                              ; }
 18563  f633 85b4                   STA .currentBlockNumberLow                          ; } reset current block number
 18564  f635 85b5                   STA .currentBlockNumberHigh                         ; }
 18565                          
 18566                          .searchForSpecifiedBlock
 18567  f637 a5b4                   LDA .currentBlockNumberLow                          ; current block number (low byte)
 18568  f639 48                     PHA                                                 ; save A on stack
 18569  f63a 85b6                   STA .nextBlockNumberLow                             ; save as next block number (low byte)
 18570  f63c a5b5                   LDA .currentBlockNumberHigh                         ; current block number (high byte)
 18571  f63e 48                     PHA                                                 ; save A on stack
 18572  f63f 85b7                   STA .nextBlockNumberHigh                            ; save as next block number (high byte)
 18573                          
 18574  f641 2046fa                 JSR .safePrintFollowingMessage                      ; print message following call
 18575  f644 536561726368696e...    !text "Searching"                                   ;
 18576  f64d 0d00                   !text .charRETURN,0                                 ;
 18577                          
 18578  f64f a9ff                   LDA #$FF                                            ; A=$FF (Meaning 'Must match filename
 18579                                                                                  ; and block number')
 18580  f651 2048f3                 JSR .searchForBlockCheckFilingSystem                ; read data from tape filing system/ROMFS
 18581  f654 68                     PLA                                                 ; get back A
 18582  f655 85b5                   STA .currentBlockNumberHigh                         ; current block number high
 18583  f657 68                     PLA                                                 ; get back A
 18584  f658 85b4                   STA .currentBlockNumberLow                          ; current block number low
 18585  f65a a5b6                   LDA .nextBlockNumberLow                             ; next block number low
 18586  f65c 05b7                   ORA .nextBlockNumberHigh                            ; next block number high
 18587  f65e d00d                   BNE +                                               ;
 18588  f660 85b4                   STA .currentBlockNumberLow                          ; zero current block number low
 18589  f662 85b5                   STA .currentBlockNumberHigh                         ; zero current block number high
 18590  f664 a5c1                   LDA .checksumIsValidFlag                            ; checksum result
 18591  f666 d005                   BNE +                                               ;
 18592  f668 a2b1                   LDX #(.fsFilename-1) - .vduVariablesStart           ;
 18593  f66a 2081fb                 JSR .copyToSoughtFilename                           ; copy filename from .fsFilename to .filenameToSearchFor
 18594                          +
 18595  f66d ad4702                 LDA .tapeOrROMSwitch                                ; filing system flag 0=tape filing system; 2=ROMFS
 18596  f670 f013                   BEQ .setBlockFlagsAndExit                           ; if (tape filing system active) then branch
 18597  f672 7011                   BVS .setBlockFlagsAndExit                           ; if (V set) then branch
 18598                          
 18599                          .fileNotFoundError
 18600  f674 00                     BRK                                                 ;
 18601  f675 d6                     !byte $D6                                           ; Error number
 18602  f676 46696c65206e6f74...    !text "File not found",0                            ;
 18603                          
 18604                          ; ***************************************************************************************
 18605                          .setBlockFlagsAndExit
 18606  f685 a0ff                   LDY #$FF                                            ; Y=$FF
 18607  f687 8cdf03                 STY .fsLastBlockReadFlagsCopy                       ; copy of last read block flag
 18608  f68a 60                     RTS                                                 ;
 18609                          
 18610                          
 18611                          ; ***************************************************************************************
 18612                          ;
 18613                          ; Close a SPOOL / EXEC file
 18614                          ;
 18615                          ; ***************************************************************************************
 18616                          .closeSpoolOrExecFile
