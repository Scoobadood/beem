  9540                          ; ***************************************************************************************
  9541                          ; When editing a line with two cursors, pressing return terminates the edit.
  9542                          ; This clears the VDU status flags and restores the text cursor to normal.
  9543                          .terminateEdit
  9544  d918 a9bd                   LDA #%10111101                                      ; }
  9545  d91a 20a8c5                 JSR .clearVDUStatusByteFlags                        ; } clear bits 2 and 6 of VDU status (page scrolling; separated cursors)
  9546  d91d 2051c9                 JSR .setTextCursor                                  ; set text cursor (CRTC hardware)
  9547  d920 a90d                   LDA #.charRETURN                                    ; continue processing as a RETURN character
  9548  d922 60                     RTS                                                 ;
