  2029                          
  2030                          ; ***************************************************************************************
  2031                          ;
  2032                          ; ROM Header Addresses
  2033                          ;
  2034                          ; Paged ROMs are switched into the memory map at $8000-$BFFF. When the MOS wants to identify
  2035                          ; ROMs, it reads the first bytes from each ROM in turn, which is a header containing useful
  2036                          ; information about the ROM.
  2037                          ;
  2038                          ; See .selectROMLoop
  2039                          ;
  2040                          ; ***************************************************************************************
  2041                          .romStartAddress                            = $8000     ;
  2042                          .romLanguageEntry                           = $8000     ;
  2043                          .romServiceEntry                            = $8003     ;
  2044                          .romTypeByte                                = $8006     ;
  2045                          .romCopyrightOffsetPointer                  = $8007     ;
  2046                          .romTitleString                             = $8009     ;
  2047                          
  2048                          ; ***************************************************************************************
  2049                          ; ***************************************************************************************
  2050                          ;
  2051                          ; Chapter 3: Memory Mapped IO
  2052                          ;
  2053                          ; ***************************************************************************************
  2054                          ; ***************************************************************************************
  2055                          
  2056                          ; ***************************************************************************************
  2057                          ;
  2058                          ; Memory Mapping
  2059                          ;
  2060                          ; Addresses in the range $FC00-$FEFF are not mapped to the OS ROM as might be expected, but
  2061                          ; are connected to hardware devices. Consequently the CPU can communicate with hardware
  2062                          ; devices by reading and writing to specific addresses in this range.
  2063                          ;
  2064                          ; $FC00-$FCFF   - FRED      - Addresses are assigned to external devices:
  2065                          ;                             Winchester Disc / Teletext / Prestel / IEEE488 etc
  2066                          ; $FD00-$FDFF   - JIM       - Access to an optional extra 64K of RAM. See .jimPage.
  2067                          ; $FE00-$FEFF   - SHEILA    - Read / Write hardware internal to the BBC Micro (see next
  2068                          ;                             section).
  2069                          ;
  2070                          ; The OS provides OSBYTE calls for user programs to access these locations.
  2071                          ; See .osbyte146EntryPoint.
  2072                          ;
  2073                          ; Unlike the Commodore 64, this region of memory is permanently assigned to memory mapped IO,
  2074                          ; and is not bank switchable.
  2075                          ;
  2076                          ; Because of this address mapping, the underlying memory in the ROM can't be read or written
  2077                          ; by the OS. This memory stores credits text instead. See Chapter 22.
  2078                          ;
  2079                          ; ***************************************************************************************
  2080                          
  2081                          ; ***************************************************************************************
  2082                          ;
  2083                          ; FRED
  2084                          ;
  2085                          ; Accesses peripherals on the 1Mhz bus. Peripherals are allocated address ranges as follows:
  2086                          ;
  2087                          ;   Address range      Hardware allocated           Later additions
  2088                          ;   ---------------------------------------------------------------------
  2089                          ;   $FC00 - $FC0F      Test hardware                -
  2090                          ;   $FC10 - $FC13      Teletext                     -
  2091                          ;   $FC14 - $FC1F      Prestel                      -
  2092                          ;   $FC20 - $FC27      IEEE 488 Interface           -
  2093                          ;   $FC28 - $FC2F      -                            Econet (Electron)
  2094                          ;   $FC30 - $FC3F      Cambridge Ring Interface     -
  2095                          ;   $FC40 - $FC47      Winchester Disc              } Compact Flash Interface
  2096                          ;   $FC48 - $FC4F      Reserved                     }
  2097                          ;   $FC50 - $FC5F      -                            -
  2098                          ;   $FC60 - $FC6F      Serial expansion             -
  2099                          ;   $FC70 - $FC7F      -                            -
  2100                          ;   $FC80 - $FC8F      Test hardware                -
  2101                          ;   $FC90 - $FC9F      -                            -
  2102                          ;   $FCA0 - $FCAF      -                            -
  2103                          ;   $FCB0 - $FCBF      -                            6522 VIA (Electron)
  2104                          ;   $FCC0 - $FCCF      -                            1770 FDC (Electron)
  2105                          ;   $FCD0 - $FCDF      -                            -
  2106                          ;   $FCE0 - $FCEF      -                            Tube (Electron)
  2107                          ;   $FCF0 - $FCF7      -                            -
  2108                          ;   $FCF8 - $FCFD      -                            RetroClinic DataCentre
  2109                          ;   $FCFE              JIM paging register MSB      -
  2110                          ;   $FCFF              JIM paging register LSB      -
  2111                          ;
  2112                          ; ***************************************************************************************
  2113                          .fredPage                                   = $FC00     ;
  2114                          
  2115                          ; ***************************************************************************************
  2116                          ;
  2117                          ; JIM
  2118                          ;
  2119                          ; If fitted JIM allows access to either an optional 64K of RAM or even up to 16Mb of RAM, one
  2120                          ; page at a time. Select which page by writing to location $FCFF (the JIM paging register)
  2121                          ; and if a 16 bit register is available also write to $FCFE. Then $FD00-$FDFF can be read
  2122                          ; or written to as RAM. Reading and writing is about half the speed of regular RAM.
  2123                          ;
  2124                          ; ***************************************************************************************
  2125                          .jimPage                                    = $FD00     ;
  2126                          .jimPagedEntryPoint                         = $FDFE     ; at reset time, holds the address
  2127                                                                                  ; to call to initialise JIM hardware
  2128                          
  2129                          ; ***************************************************************************************
  2130                          ;
  2131                          ; SHEILA
  2132                          ;
  2133                          ; ***************************************************************************************
  2134                          .sheilaPage                                 = $FE00     ;
  2135                          .crtcAddressRegister                        = $FE00     ;
  2136                          .crtcAddressWrite                           = $FE01     ;
  2137                          
  2138                          ; ***************************************************************************************
  2139                          ;
  2140                          ; ACIA 6850, Control Register ($FE08)
  2141                          ;
  2142                          ; This is used for writing values. By convention (for clarity) we use the Status Register
  2143                          ; (See .acia6850StatusRegister below) for reading values. Even though they both refer to
  2144                          ; the same memory location, they have different meanings depending on whether it's being
  2145                          ; read or written.
  2146                          ;
  2147                          ;     bits 0,1 - the counter divide select bits (CR0/CR1)
  2148                          ;          %00 - divide counter by 1
  2149                          ;          %01 - divide counter by 16                     (used for 1200 baud tape)
  2150                          ;          %10 - divide counter by 64 (default for RS-423) (used for 300 baud tape)
  2151                          ;          %11 - master reset
  2152                          ;     bit 2 - set means odd parity; otherwise even parity
  2153                          ;     bit 3 - set means 1 stop bit; otherwise 2 stop bits
  2154                          ;     bit 4 - set means 8 bit word; otherwise 7 bit word
  2155                          ;     bits 5,6:
  2156                          ;          %00 - 'Request To Send' ('RTS') low, transmit interrupt disabled
  2157                          ;          %01 - RTS low, transmit interrupt enabled
  2158                          ;          %10 - RTS high, transmit interrupt disabled
  2159                          ;          %11 - RTS low, break level on data output, transmit interrupt disabled
  2160                          ;     bit 7 - enable receive data register full, overrun, DCD transition interrupts
  2161                          ;
  2162                          ;         DCD = Data Carrier Detect interrupt occurs when the tone at the end of a cassette
  2163                          ;               block is discontinued
  2164                          ;
  2165                          ;     RTS low is the active state ('Request To Send')
  2166                          ;
  2167                          ; ***************************************************************************************
  2168                          .acia6850ControlRegister                    = $FE08     ;
  2169                          
  2170                          ; ***************************************************************************************
  2171                          ;
  2172                          ; ACIA 6850, Status Register ($FE08)
  2173                          ;
  2174                          ; This is used for reading values. By convention (for clarity) we use the Control Register
  2175                          ; (See .acia6850ControlRegister above) for writing values. Even though they both refer to
  2176                          ; the same memory location, they have different meanings depending on whether it's being
  2177                          ; read or written.
  2178                          ;
  2179                          ;     bit 0 - set when a receiver interrupt is generated
  2180                          ;     bit 1 - set when a transmit interrupt is generated
  2181                          ;     bit 2 - set when a Data Carrier Detect ('DCD') interrupt is generated
  2182                          ;     bit 3 - set if the 6850 is not clear to send ('CTS')
  2183                          ;     bit 4 - framing error     } only valid if bit 0 set
  2184                          ;     bit 5 - receiver over run } only valid if bit 0 set
  2185                          ;     bit 6 - parity error      } only valid if bit 0 set
  2186                          ;     bit 7 - set if the 6850 generated the current interrupt
  2187                          ;
  2188                          ; ***************************************************************************************
  2189                          .acia6850StatusRegister                     = $FE08     ;
  2190                          
  2191                          .acia6850DataRegister                       = $FE09     ; ACIA 6850, transmit / receive data register ('TDR'/'RDR')
  2192                          
  2193                          ; ***************************************************************************************
  2194                          ;
  2195                          ; Serial ULA, Control Register ($FE10)
  2196                          ;
  2197                          ; See ula.png
  2198                          ;
  2199                          ;     bits 0-2 - transmit rate
  2200                          ;     bits 3-5 - receive rate
  2201                          ;                   %000    19200 baud
  2202                          ;                   %001     9600 baud
  2203                          ;                   %010     4800 baud
  2204                          ;                   %011     2400 baud
  2205                          ;                   %100     1200 baud
  2206                          ;                   %101      300 baud
  2207                          ;                   %110      150 baud
  2208                          ;                   %111       75 baud
  2209                          ;     bit 6 - if set, the RS-423 system has control of the serial system; otherwise the cassette system has control
  2210                          ;     bit 7 - if set, switch on the cassette motor and relay
  2211                          ;
  2212                          ; ***************************************************************************************
  2213                          .serialULAControlRegister                   = $FE10     ; Serial ULA control register
  2214                          
  2215                          ; ***************************************************************************************
  2216                          ;
  2217                          ; Video ULA Control Register ($FE20)
  2218                          ;
  2219                          ; See vula.png
  2220                          ; https://github.com/YazanMehyar/FPGA-BBC-micro/blob/master/docs/VULA.txt
  2221                          ;
  2222                          ; bit 0   = flash on/off
  2223                          ; bit 1   = teletext / normal
  2224                          ; bit 2/3 = number of characters per line
  2225                          ;           %00=10 characters
  2226                          ;           %01=20 characters
  2227                          ;           %10=40 characters
  2228                          ;           %11=80 characters
  2229                          ; bit 4   = 0 means low clock frequency,  used in MODES 4-7
  2230                          ;           1 means high clock frequency, used in MODES 0-3
  2231                          ; bit 5-7 = cursor width
  2232                          ;           %000  hide cursor
  2233                          ;           %100  MODE 0,3,4,6
  2234                          ;           %110  MODE 1,5
  2235                          ;           %111  MODE 2
  2236                          ;           %010  MODE 7
  2237                          ;
  2238                          ; ***************************************************************************************
  2239                          .videoULAControlRegister                    = $FE20     ; Video ULA control register
  2240                          
  2241                          ; ***************************************************************************************
  2242                          ;
  2243                          ; Video ULA Palette Register ($FE21)
  2244                          ;
  2245                          ; Write to this register to change the palette. The top four bits define the logical colour
  2246                          ; field, and the bottom four bits are the physical colour EOR 7. Changing the palette is a
  2247                          ; little more work than you might expect however:
  2248                          ;
  2249                          ; 16 colour MODEs (MODE 2)
  2250                          ; ------------------------
  2251                          ; This is straightforward. Write the logical colour to the top four bits, and the physical
  2252                          ; colour EOR 7 in the bottom four bits.
  2253                          ;
  2254                          ; 2 colour MODEs (MODE 0,3,4,6)
  2255                          ; -----------------------------
  2256                          ; Bit 7 defines the logical colour, but ALL combinations of bits 4-6 must be set individually
  2257                          ; in order to make the change properly. e.g. to change logical colour 1 to physical colour 2:
  2258                          ;
  2259                          ;     LDA #$85
  2260                          ;     STA .videoULAPaletteRegister
  2261                          ;     LDA #$95
  2262                          ;     STA .videoULAPaletteRegister
  2263                          ;     LDA #$A5
  2264                          ;     STA .videoULAPaletteRegister
  2265                          ;     LDA #$B5
  2266                          ;     STA .videoULAPaletteRegister
  2267                          ;     LDA #$C5
  2268                          ;     STA .videoULAPaletteRegister
  2269                          ;     LDA #$D5
  2270                          ;     STA .videoULAPaletteRegister
  2271                          ;     LDA #$E5
  2272                          ;     STA .videoULAPaletteRegister
  2273                          ;     LDA #$F5
  2274                          ;     STA .videoULAPaletteRegister
  2275                          ;
  2276                          ; 4 colour MODEs (MODE 1,5)
  2277                          ; -------------------------
  2278                          ; Bits 5 and 7 define the logical colour. But ALL combinations of bits 4 and 6 must also be
  2279                          ; set to make the change properly. e.g. to change logical colour 1 to physical colour 2:
  2280                          ;
  2281                          ;     LDA #$25
  2282                          ;     STA .videoULAPaletteRegister
  2283                          ;     LDA #$35
  2284                          ;     STA .videoULAPaletteRegister
  2285                          ;     LDA #$65
  2286                          ;     STA .videoULAPaletteRegister
  2287                          ;     LDA #$75
  2288                          ;     STA .videoULAPaletteRegister
  2289                          ;
  2290                          ; More OS friendly ways to set the palette are VDU 19; OSWORD 12 (which is faster than the
  2291                          ; VDU 19 sequence of calls and can be used in interrupts); or OSBYTE 155 (but this only writes
  2292                          ; to the ULA register once, so multiple calls are still needed as above).
  2293                          ;
  2294                          ; If using one of the OS friendly ways above to change the palette then the physical colours
  2295                          ; are:
  2296                          ;                 0 = black             8 = flashing black-white
  2297                          ;                 1 = red               9 = flashing red-cyan
  2298                          ;                 2 = green            10 = flashing green-magenta
  2299                          ;                 3 = yellow           11 = flashing yellow-blue
  2300                          ;                 4 = blue             12 = flashing blue-yellow
  2301                          ;                 5 = magenta          13 = flashing magenta-green
  2302                          ;                 6 = cyan             14 = flashing cyan-red
  2303                          ;                 7 = white            15 = flashing white-black
  2304                          ;
  2305                          ; If writing directly to .videoULAPaletteRegister ($FE21) then the values for the physical
  2306                          ; colour are different:
  2307                          ;
  2308                          ;      value to write = physical colour from table above EOR 7.
  2309                          ;
  2310                          ; ***************************************************************************************
  2311                          .videoULAPaletteRegister                    = $FE21     ; Video ULA palette register
  2312                          
  2313                          .romSelectRegister                          = $FE30     ;
  2314                          
  2315                          
  2316                          ; ***************************************************************************************
  2317                          ;
  2318                          ; System VIA, Register B ($FE40)
  2319                          ;
  2320                          ; Notes:
  2321                          ;     The bottom four bits are used for writing, and the top four bits are used for reading.
  2322                          ;     (See .systemVIADataDirectionRegisterB)
  2323                          ;
  2324                          ;     Values 0-15 can be written to System VIA Register B (Output):
  2325                          ;
  2326                          ;         Value   Effect
  2327                          ;         -------------------------
  2328                          ;         0       Enable sound chip
  2329                          ;         1       Enable Read Speech
  2330                          ;         2       Enable Write Speech
  2331                          ;         3       Disable Keyboard auto scanning
  2332                          ;         4       Hardware scrolling - set C0=0 (See below)
  2333                          ;         5       Hardware scrolling - set C1=0 (See below)
  2334                          ;         6       Turn on CAPS LOCK LED
  2335                          ;         7       Turn on SHIFT LOCK LED
  2336                          ;         8       Disable sound chip
  2337                          ;         9       Disable Read Speech
  2338                          ;         10      Disable Write Speech
  2339                          ;         11      Enable Keyboard auto scanning
  2340                          ;         12      Hardware scrolling - set C0=1 (See below)
  2341                          ;         13      Hardware scrolling - set C1=1 (See below)
  2342                          ;         14      Turn off CAPS LOCK LED
  2343                          ;         15      Turn off SHIFT LOCK LED
  2344                          ;
  2345                          ;  The values of C0 and C1 together determine the start scroll address for the screen:
  2346                          ;
  2347                          ;         C0   C1      Screen       Used in
  2348                          ;                      Address   Regular MODEs
  2349                          ;         ------------------------------------
  2350                          ;          0    0      $4000           3
  2351                          ;          0    1      $5800          4,5
  2352                          ;          1    0      $6000           6
  2353                          ;          1    1      $3000         0,1,2
  2354                          ;
  2355                          ; When reading from this address the top four bits are read:
  2356                          ;
  2357                          ; bit 7:    Speech processor 'ready' signal
  2358                          ; bit 6:    Speech processor 'interrupt' signal
  2359                          ; bit 4-5:  joystick buttons (bit is zero when button pressed)
  2360                          ;
  2361                          ; ***************************************************************************************
  2362                          .systemVIARegisterB                         = $FE40     ; System VIA Register B (Input and Output)
  2363                          
  2364                          ; ***************************************************************************************
  2365                          ;
  2366                          ; System VIA, Register A ($FE41)
  2367                          ;
  2368                          ; This register is not used. The non-handshaking variant is used instead.
  2369                          ; See .systemVIADataDirectionRegisterA for details.
  2370                          ; ***************************************************************************************
  2371                          .systemVIARegisterA                         = $FE41     ; System VIA Register A (Input and Output)
  2372                          
  2373                          ; ***************************************************************************************
  2374                          ;
  2375                          ; System VIA, Data Direction Register B ($FE42) (aka 'DDRB')
  2376                          ;
  2377                          ; When writing data into Register B (.systemVIARegisterB), the bits that are set on DDRB
  2378                          ; indicate which bits are actually written into Register B. The bits that are clear on DDRB
  2379                          ; are used to read from Register B.
  2380                          ;
  2381                          ; DDRB is only written once on startup where it is initialised to %00001111
  2382                          ; (see .setUpSystemVIA) and the OS expects it to remain that way. Only the bottom four bits
  2383                          ; of .systemVIARegisterB are used when writing, and only the upper four bits are read from
  2384                          ; .systemVIARegisterB. See .systemVIARegisterB.
  2385                          ;
  2386                          ; ***************************************************************************************
  2387                          .systemVIADataDirectionRegisterB            = $FE42     ; System VIA data direction register B (DDRB)
  2388                          
  2389                          ; ***************************************************************************************
  2390                          ;
  2391                          ; System VIA, Data Direction Register A ($FE43) (aka 'DDRA')
  2392                          ;
  2393                          ; The keyboard, sound and speech systems use Data Direction Register A. Each bit of DDRA
  2394                          ; indicates whether data can be written or read on that bit when data is accessed via
  2395                          ; .systemVIARegisterANoHandshake. This is similar to DDRB. Unlike DDRB, the OS modifies
  2396                          ; DDRA frequently to set the appropriate bits for accessing the device (often in the IRQ
  2397                          ; interrupt code). Once set, data is read or written to .systemVIARegisterANoHandshake as
  2398                          ; needed. See .systemVIARegisterANoHandshake.
  2399                          ;
  2400                          ; Sound:    When outputting sound, DDRA is set to %11111111 meaning all bits of data
  2401                          ;           that are subsequently written to .systemVIARegisterANoHandshake are output bits.
  2402                          ;           (See .sendToSoundChipFlagsAreadyPushed)
  2403                          ;
  2404                          ; Speech:   For speech, DDRA is set to %00000000 (for reading) or %11111111 (for writing) as
  2405                          ;           needed. (See .readWriteSpeechProcessorPushedFlags)
  2406                          ;
  2407                          ; Keyboard: When reading the keyboard, DDRA is set to (%011111111). The key to read is written
  2408                          ;           into bits 0-6 of .systemVIARegisterANoHandshake, and the 'pressed' state of that
  2409                          ;           key is then read from bit 7.
  2410                          ;           (See .interrogateKeyboard)
  2411                          ;           (See .scanKeyboard)
  2412                          ;
  2413                          ; ***************************************************************************************
  2414                          .systemVIADataDirectionRegisterA            = $FE43     ; System VIA data direction register A (DDRA)
  2415                          
  2416                          ; ***************************************************************************************
  2417                          ;
  2418                          ; System VIA, Timer 1 registers ($FE44-7)
  2419                          ;
  2420                          ; This is a 1Mhz countdown timer. An IRQ is triggered when the timer reaches zero. The OS
  2421                          ; uses this timer as a 100Hz timer to update various parts of the OS. It is expected to
  2422                          ; remain as a 100Hz timer if the OS is to continue working properly. User VIA Timers are
  2423                          ; available for user programs instead.
  2424                          ; See .irq1CheckSystemVIA100HzTimer.
  2425                          ;
  2426                          ; Timer 1 can be configured in one of two modes by writing to the ACR
  2427                          ; (see .systemVIAAuxiliaryControlRegister):
  2428                          ;
  2429                          ; One-shot mode:
  2430                          ;   .systemVIATimer1LatchLow and .systemVIATimer1CounterHigh form a 16 bit countdown value.
  2431                          ;   Write to .systemVIATimer1LatchLow first then writing to .systemVIATimer1CounterHigh
  2432                          ;   starts the timer. When the timer is complete a timer IRQ interrupt is generated. This
  2433                          ;   only happens once.
  2434                          ;
  2435                          ; Free-run mode (aka 'Continuous interrupts'):
  2436                          ;   .systemVIATimer1LatchLow and .systemVIATimer1LatchHigh are initialised to the initial
  2437                          ;   timeout value for the timer. The timer starts when .systemVIATimer1CounterHigh is
  2438                          ;   also written. Unlike one-shot mode, once the timeout interrupt has happened the counter
  2439                          ;   is reset to the values in the latches and the process repeats. The process can be stopped
  2440                          ;   by writing .systemVIATimer1CounterHigh, by reading .systemVIATimer1CounterLow, or by
  2441                          ;   writing to the interrupt flag.
  2442                          ;   This is the mode set by the OS for Timer 1 at startup. See .setUpPage2.
  2443                          ;
  2444                          ; ***************************************************************************************
  2445                          .systemVIATimer1CounterLow                  = $FE44     ;
  2446                          .systemVIATimer1CounterHigh                 = $FE45     ;
  2447                          .systemVIATimer1LatchLow                    = $FE46     ;
  2448                          .systemVIATimer1LatchHigh                   = $FE47     ;
  2449                          
  2450                          ; ***************************************************************************************
  2451                          ;
  2452                          ; System VIA, Timer 2 registers ($FE48-9)
  2453                          ;
  2454                          ; Timer 2 (like Timer 1) is a 1MHz countdown timer with an IRQ being generated when the
  2455                          ; counter reaches zero. It is used by the OS to update the Speech system if present. It also
  2456                          ; has two modes of operation, selected by writing to the ACR. (See .systemVIAAuxiliaryControlRegister).
  2457                          ;
  2458                          ; One-shot mode:
  2459                          ;   This is similar to Timer 1 (above). Write the low byte of the timer first
  2460                          ;   .systemVIATimer2CounterLow then writing to the high byte of the counter
  2461                          ;   .systemVIATimer2CounterHigh starts the timer. When the timer is countdown reaches zero
  2462                          ;   a timer IRQ interrupt is generated. This only happens once.
  2463                          ;
  2464                          ; Pulse counting mode:
  2465                          ;   This is unlike Timer 1. It counts down the number of negative going pulses applied to
  2466                          ;   System VIA input pin PB6. Firstly write to .systemVIATimer2CounterLow, then writing to
  2467                          ;   .systemVIATimer2CounterHigh will start the countdown. When PB6 is pulsed low for the
  2468                          ;   appropriate number of times then an IRQ interrupt occurs. This only happens once. This
  2469                          ;   is the default mode as initialised at startup.
  2470                          ;
  2471                          ; Timer 2 is started by the Speech system (if present) as needed to time Speech. The timer
  2472                          ; is cleared by the OS when a Timer 2 IRQ is received (see .irq1CheckSystemVIASpeech).
  2473                          ; It is also cleared at startup. See .setUpPage2.
  2474                          ; ***************************************************************************************
  2475                          .systemVIATimer2CounterLow                  = $FE48     ;
  2476                          .systemVIATimer2CounterHigh                 = $FE49     ;
  2477                          
  2478                          ; ***************************************************************************************
  2479                          ;
  2480                          ; The System VIA, Shift Register ($FE4A)
  2481                          ;
  2482                          ; This is not used in this OS. It is designed to be used for serial data I/O by shifting
  2483                          ; bits one at a time under the control of an internal modulo-8 counter.
  2484                          ; See NAUG Section 22.4.9, Page 395.
  2485                          ;
  2486                          ; ***************************************************************************************
  2487                          .systemVIAShiftRegister                     = $FE4A     ;
  2488                          
  2489                          ; ***************************************************************************************
  2490                          ;
  2491                          ; System VIA, Auxiliary Control Register ($FE4B) (aka 'ACR')
  2492                          ;
  2493                          ; bit 0:    PA latch enable
  2494                          ; bit 1:    PB latch enable
  2495                          ; bits 2-4: Shift register mode
  2496                          ; bit 5:    Timer 2 mode: 0=One-shot mode; 1=Pulse counting mode.
  2497                          ; bit 6:    Timer 1 mode: 0=One shot mode; 1=Free-run mode.
  2498                          ; bit 7:    Enable pulsing of System VIA output pin PB7.
  2499                          ;           When enabled, Timer 1 will set PB7 as follows:
  2500                          ;           In One-shot mode:
  2501                          ;               PB7 is cleared when Timer 1 started,
  2502                          ;               PB7 is set when Timer 1 one-shot mode times out.
  2503                          ;           In Free-run mode:
  2504                          ;               PB7 is inverted when Timer 1 times out.
  2505                          ;
  2506                          ; In the reset code (see .setUpPage2) this register is initialised to:
  2507                          ;
  2508                          ;   (a) disable the latches and the shift register,
  2509                          ;   (b) set Timer 2 as an interval timer,
  2510                          ;   (c) set Timer 1 as free-run mode (aka continuous interrupts).
  2511                          ;
  2512                          ; Otherwise this register is not used by the OS.
  2513                          ;
  2514                          ; See NAUG Section 22.4.8, Page 395.
  2515                          ;
  2516                          ; ***************************************************************************************
  2517                          .systemVIAAuxiliaryControlRegister          = $FE4B     ;
  2518                          
  2519                          ; ***************************************************************************************
  2520                          ;
  2521                          ; System VIA, Peripheral Control Register ($FE4C) (aka 'PCR')
  2522                          ;
  2523                          ; bit 0    = CA1 interrupt control
  2524                          ;            Writing to CA1 means "data taken"
  2525                          ;            0 means negative active edge
  2526                          ;            1 means positive active edge
  2527                          ;
  2528                          ; bits 1-3 = CA2 control mode
  2529                          ;            CA2 signifies "data ready"
  2530                          ;
  2531                          ; bit 4    = CB1 interrupt control
  2532                          ;            Writing to CB1 means "data taken"
  2533                          ;            0 means negative active edge
  2534                          ;            1 means positive active edge
  2535                          ;
  2536                          ; bits 5-7 = CB2 control mode
  2537                          ;            CB2 signifies "data ready"
  2538                          ;
  2539                          ; control mode:
  2540                          ;   000 = negative edges active on input
  2541                          ;   001 = independent interrupt; input negative edge
  2542                          ;   010 = positive edges active on input
  2543                          ;   011 = independent interrupt; input positive edge
  2544                          ;   100 = handshake output mode
  2545                          ;   101 = pulse output mode
  2546                          ;   110 = low output
  2547                          ;   111 = high output
  2548                          ;
  2549                          ; The System VIA PCR initialises like so (See .setUpPage2):
  2550                          ;       CA1 has negative active edge       (vertical sync)
  2551                          ;       CA2 positive edges active on input (keyboard)
  2552                          ;       CB1 has negative active edge       (end of analogue conversion)
  2553                          ;       CB2 negative active edges on input (light pen strobe)
  2554                          ; ***************************************************************************************
  2555                          .systemVIAPeripheralControlRegister         = $FE4C     ;
  2556                          
  2557                          ; ***************************************************************************************
  2558                          ;
  2559                          ; System VIA, Interrupt Flag Register ($FE4D) (aka 'IFR')
  2560                          ;
  2561                          ;   bit 0 = key pressed
  2562                          ;   bit 1 = vertical sync occurred
  2563                          ;   bit 2 = shift register timeout (unused)
  2564                          ;   bit 3 = lightpen strobe off screen
  2565                          ;   bit 4 = analogue conversion completed
  2566                          ;   bit 5 = timer 2 has timed out (used for speech)
  2567                          ;   bit 6 = timer 1 has timed out (100Hz signal)
  2568                          ;   bit 7 = (when reading) master interrupt flag (0-6 invalid if clear)
  2569                          ;
  2570                          ; Used in interrupt code:
  2571                          ;
  2572                          ; Reading
  2573                          ; -------
  2574                          ; If bit 7 is set then the System VIA caused the current interrupt. The remaining bits can
  2575                          ; then be checked to see the exact cause.
  2576                          ;
  2577                          ; Writing
  2578                          ; -------
  2579                          ; Clear bit 7 and set a bit 0-6 to clear that interrupt.
  2580                          ;
  2581                          ; ***************************************************************************************
  2582                          .systemVIAInterruptFlagRegister             = $FE4D     ;
  2583                          
  2584                          ; ***************************************************************************************
  2585                          ;
  2586                          ; System VIA, Interrupt Enable Register ($FE4E) (aka 'IER')
  2587                          ;
  2588                          ; Each bit controls whether an interrupt is enabled or disabled.
  2589                          ;
  2590                          ; bit 0 = key pressed
  2591                          ; bit 1 = vertical sync occurred
  2592                          ; bit 2 = shift register timeout (unused)
  2593                          ; bit 3 = light pen strobe off screen
  2594                          ; bit 4 = analogue conversion completed
  2595                          ; bit 5 = timer 2 timed out (used for speech)
  2596                          ; bit 6 = timer 1 timed out (100Hz signal)
  2597                          ; bit 7 = enable/disable interrupt value (see below)
  2598                          ;
  2599                          ; Writing:
  2600                          ; --------
  2601                          ; To enable  an interrupt, write a byte with bit 7 set   and set the desired bit(s) (0-6).
  2602                          ; To disable an interrupt, write a byte with bit 7 clear and set the desired bit(s) (0-6).
  2603                          ;
  2604                          ; Reading:
  2605                          ; --------
  2606                          ; Bits 0-6 are read as expected.
  2607                          ; Bit 7 is always set when read.
  2608                          ;
  2609                          ; ***************************************************************************************
  2610                          .systemVIAInterruptEnableRegister           = $FE4E     ;
  2611                          
  2612                          ; See .systemVIADataDirectionRegisterA.
  2613                          .systemVIARegisterANoHandshake              = $FE4F     ; System VIA Register A without handshaking
  2614                          
  2615                          ; ***************************************************************************************
  2616                          ;
  2617                          ; User VIA
  2618                          ;
  2619                          ; Port A is the (Centronics) parallel printer port (output only)
  2620                          ; Port B is the user port (input and output) (unused by the OS)
  2621                          ;
  2622                          ; See .openPrinterChannel for details of how to write to the printer.
  2623                          ;
  2624                          ; The data direction registers work as they do on the System VIA
  2625                          ; (see .systemVIADataDirectionRegisterB)
  2626                          ;
  2627                          ; The User VIA has Timer 1 and Timer 2. They work in the same way as the timers on the
  2628                          ; System VIA. These are not used by the OS so are available for user programs.
  2629                          ; See .systemVIATimer1CounterLow.
  2630                          ; See .systemVIATimer2CounterLow.
  2631                          ;
  2632                          ; The auxiliary control register works the same way as on the System VIA.
  2633                          ; See .systemVIAAuxiliaryControlRegister.
  2634                          ;
  2635                          ; The shift register is unused.
  2636                          ;
  2637                          ; ***************************************************************************************
  2638                          .userVIARegisterB                           = $FE60     ; Register B (input/output)
  2639                          .userVIARegisterA                           = $FE61     ; Register A (output)
  2640                          .userVIADataDirectionRegisterB              = $FE62     ; data direction register B
  2641                          .userVIADataDirectionRegisterA              = $FE63     ; data direction register A
  2642                          
  2643                          .userVIATimer1CounterLow                    = $FE64     ; Timer 1 counter (low)
  2644                          .userVIATimer1CounterHigh                   = $FE65     ; Timer 1 counter (high)
  2645                          .userVIATimer1LatchLow                      = $FE66     ; Timer 1 latch (low)
  2646                          .userVIATimer1LatchHigh                     = $FE67     ; Timer 1 latch (high)
  2647                          .userVIATimer2CounterLow                    = $FE68     ; Timer 2 counter (low)
  2648                          .userVIATimer2CounterHigh                   = $FE69     ; Timer 2 counter (high)
  2649                          
  2650                          .userVIAShiftRegister                       = $FE6A     ; shift register
  2651                          .userVIAAuxiliaryControlRegister            = $FE6B     ; auxiliary control register
  2652                          
  2653                          ; ***************************************************************************************
  2654                          ;
  2655                          ; User VIA, peripheral control register ($FE6C)
  2656                          ;
  2657                          ; This works the same as on the System VIA (See .systemVIAPeripheralControlRegister).
  2658                          ;
  2659                          ; The User VIA PCR initialises like so (See .setUpPage2):
  2660                          ;           CA1 interrupt on -ve edge     (usually printer Acknowledge)
  2661                          ;           CA2 high output               (usually printer strobe)
  2662                          ;           CB1 interrupt on -ve edge     (user port)
  2663                          ;           CB2 negative edge             (user port)
  2664                          ; ***************************************************************************************
  2665                          .userVIAPeripheralControlRegister           = $FE6C     ; Peripheral control register
  2666                          
  2667                          ; ***************************************************************************************
  2668                          ;
  2669                          ; User VIA, interrupt flag register ($FE6D)
  2670                          ;
  2671                          ; bit 1 = printer interrupt
  2672                          ; bit 5 = timer 2 timed out interrupt
  2673                          ; bit 6 = timer 1 timed out interrupt
  2674                          ;
  2675                          ; Writing:
  2676                          ; Clear bit 7 to clear each of the interrupts indicated by the other set bits.
  2677                          ; Or set bit 7 to raise each of the interrupts.
  2678                          ;   e.g. To clear a printer interrupt, clear bit 7 and set bit 1
  2679                          ;
  2680                          ; Reading:
  2681                          ; bit 1 set signifies a parallel printer interrupt.
  2682                          ; bit 5 set signifies timer 2 timed out
  2683                          ; bit 6 set signifies timer 1 timed out
  2684                          ; bit 7 set means the current interrupt is from the User VIA
  2685                          ; (See .irq1CheckUserVIA)
  2686                          ;
  2687                          ; ***************************************************************************************
  2688                          .userVIAInterruptFlagRegister               = $FE6D     ; Interrupt flag register
  2689                          
  2690                          ; ***************************************************************************************
  2691                          ;
  2692                          ; User VIA, interrupt enable register ($FE6E)
  2693                          ;
  2694                          ; bit 1 = printer interrupt
  2695                          ; bit 5 = timer 2 timed out interrupt
  2696                          ; bit 6 = timer 1 timed out interrupt
  2697                          ;
  2698                          ; Writing:
  2699                          ; Clear bit 7 to disable each of the interrupts indicated by the other set bits.
  2700                          ; Or set bit 7 to enable each of the interrupts.
  2701                          ;
  2702                          ; e.g. To disable printer interrupts, clear bit 7 and set bit 1
  2703                          ;      To  enable printer interrupts,   set bit 7 and set bit 1
  2704                          ;
  2705                          ; Reading:
  2706                          ; bit 7 is always read as set when reading.
  2707                          ; (See .irq1CheckUserVIA)
  2708                          ; ***************************************************************************************
  2709                          .userVIAInterruptEnableRegister             = $FE6E     ; Interrupt enable register
  2710                          
  2711                          ; ***************************************************************************************
  2712                          ;
  2713                          ; User VIA, Register B no handshake ($FE6F)
  2714                          ;
  2715                          ; ***************************************************************************************
  2716                          .userVIARegisterBNoHandshake                = $FE6F     ; Register B but no handshake
  2717                          
  2718                          ; ***************************************************************************************
  2719                          ;
  2720                          ; ADC 7002 - Analogue to digital conversion
  2721                          ;
  2722                          ; See .osbyte17EntryPoint
  2723                          ;
  2724                          ; ***************************************************************************************
  2725                          .adcDataStatusRegister                      = $FEC0     ; For reading the current ADC
  2726                                                                                  ; conversion state
  2727                          .adcStartConversionRegister                 = $FEC0     ; For writing when we want to start
  2728                                                                                  ; an ADC conversion
  2729                          .adcDataHighByte                            = $FEC1     ; ADC (7002) high data byte
  2730                          .adcDataLowByte                             = $FEC2     ; ADC (7002) low data byte
  2731                          
  2732                          ; ***************************************************************************************
  2733                          ;
  2734                          ; The Tube - Registers
  2735                          ;
  2736                          ; See NAUG Section 18.3, Page 328
  2737                          ;
  2738                          ; ***************************************************************************************
  2739                          .tubeULAStatusRegister                      = $FEE0     ; Tube ULA Status Register
  2740                          .tubeULADataRegister3                       = $FEE5     ;
