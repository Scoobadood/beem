  6869                          .displayACharacter
  6870  cfb7 ae6003                 LDX .vduNumberOfLogicalColoursMinusOne              ; number of logical colours less 1
  6871  cfba f020                   BEQ .displayCharacterMODE7                          ; if (MODE 7) then branch
  6872  cfbc 203ed0                 JSR .getCharacterDefinitionAddress                  ; set up character definition pointers
  6873                              ; fall through...
