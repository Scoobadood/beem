 11985                          ; ***************************************************************************************
 11986                          ;
 11987                          ; On Entry:
 11988                          ;       A=character to print
 11989                          ;
 11990                          ; ***************************************************************************************
 11991                          .sendCharacterToPrinter
 11992  e114 2c7c02                 BIT .characterDestinationsAvailableFlags            ; check for bit 6 set
 11993  e117 7020                   BVS .exit16                                         ; if (printer is disabled) then branch (exit)
 11994  e119 cd8602                 CMP .printerIgnoreCharacter                         ; compare character against printer ignore character
 11995  e11c f01b                   BEQ .exit16                                         ; if (the same) then branch (exit)
 11996                          
 11997                          .sendValidByteToPrinter
 11998  e11e 08                     PHP                                                 ; save flags (including IRQ flag)
 11999  e11f 78                     SEI                                                 ; disable interrupts
 12000  e120 aa                     TAX                                                 ; store byte to send in X
 12001  e121 a904                   LDA #%00000100                                      ; }
 12002  e123 2c7c02                 BIT .characterDestinationsAvailableFlags            ; } check bit 2 'disable printer driver'
 12003  e126 d010                   BNE .pullAndExit14                                  ; if (printer is disabled) then branch (pull flags and exit)
 12004  e128 8a                     TXA                                                 ; restore byte to send to A
 12005  e129 a203                   LDX #.bufferNumberPrinter                           ; X=printer buffer number
 12006  e12b 20f8e1                 JSR .addByteToBuffer                                ; put character in printer buffer
 12007  e12e b008                   BCS .pullAndExit14                                  ; if (carry set, i.e. unsuccessful) then branch (pull flags and exit)
 12008                          
 12009  e130 2cd202                 BIT .printerBufferEmptyFlag                         ; check buffer empty flag
 12010  e133 1003                   BPL .pullAndExit14                                  ; if (printer buffer is not empty) then branch (pull flags and exit)
 12011  e135 203ae1                 JSR .openPrinterChannel                             ; open printer channel
 12012                          .pullAndExit14
 12013  e138 28                     PLP                                                 ; restore flags (including IRQ flag)
 12014                          .exit16
 12015  e139 60                     RTS                                                 ;
 12016                          
 12017                          ; ***************************************************************************************
 12018                          .openPrinterChannel
 12019  e13a ad8502                 LDA .printerDestination                             ; check printer destination
 12020  e13d f06e                   BEQ .flushBufferX                                   ; if (zero) then branch (clear printer buffer and exit)
 12021  e13f c901                   CMP #1                                              ; }
 12022  e141 d021                   BNE .checkForSerialPrinter                          ; } if (parallel printer not selected) then branch (check for serial printer)
 12023                          
 12024                              ; deal with parallel printer
 12025  e143 2060e4                 JSR .osbyte145EntryPoint                            ; read a byte from the printer buffer
 12026  e146 6ed202                 ROR .printerBufferEmptyFlag                         ; rotate carry into bit 7 of the printer buffer empty flag
 12027  e149 3045                   BMI .exit17                                         ; if (printer buffer empty) then branch (return)
 12028                          
 12029                              ; To send data to the parallel printer:
 12030                              ;
 12031                              ; 1. Enable the User VIA interrupt '1'. The printer will trigger an IRQ when it is ready
 12032                              ;    for another character.
 12033                              ; 2. Write the byte to send to .userVIARegisterA
 12034                              ; 3. Set bits 1-3 of the userVIAPeripheralControlRegister to %110
 12035                              ; 4. Set bits 1-3 of the userVIAPeripheralControlRegister to %111
 12036                              ; This sends a 'STROBE' signal to advise the printer that valid data is waiting.
 12037                          
 12038  e14b a082                   LDY #%10000010                                      ; enable interrupt 1 of the user VIA
 12039  e14d 8c6efe                 STY .userVIAInterruptEnableRegister                 ; this is triggered by the printer
 12040                                                                                  ; when it is ready to receive a new
 12041                                                                                  ; character
 12042  e150 8d61fe                 STA .userVIARegisterA                               ; pass byte to the Centronics port
 12043  e153 ad6cfe                 LDA .userVIAPeripheralControlRegister               ; }
 12044  e156 29f1                   AND #%11110001                                      ; }
 12045  e158 090c                   ORA #%00001100                                      ; } pulse CA2 line to generate
 12046  e15a 8d6cfe                 STA .userVIAPeripheralControlRegister               ; } STROBE signal to advise printer
 12047  e15d 090e                   ORA #%00001110                                      ; } that valid data is waiting
 12048  e15f 8d6cfe                 STA .userVIAPeripheralControlRegister               ; }
 12049  e162 d02c                   BNE .exit17                                         ; ALWAYS branch (return)
 12050                                                                                  ; [this could just be an RTS, saving one byte]
 12051                          
 12052                          ; ***************************************************************************************
 12053                          .checkForSerialPrinter
 12054  e164 c902                   CMP #2                                              ; }
 12055  e166 d029                   BNE .userPrinter                                    ; } if (serial printer is NOT selected) then branch (check for user printer)
 12056                          
 12057                              ; deal with serial printer
 12058  e168 a4ea                   LDY .rs423TimeoutCounter                            ; }
 12059  e16a 88                     DEY                                                 ; }
 12060  e16b 1040                   BPL .flushBufferX                                   ; } if (timeout counter is timed out) then branch (to flush the buffer)
 12061  e16d 4ed202                 LSR .printerBufferEmptyFlag                         ; clear printer buffer empty flag
 12062                          
