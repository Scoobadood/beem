 11964  e0f9 2c7c02                 BIT .characterDestinationsAvailableFlags            ; check SPOOL output
 11965  e0fc d00f                   BNE .oswrchFinishUp                                 ; if (SPOOL output disabled) then branch (skip past SPOOL output)
 11966  e0fe ac5702                 LDY .spoolFileHandle                                ; get SPOOL file handle
 11967  e101 f00a                   BEQ .oswrchFinishUp                                 ; if (not open) then branch (skip past SPOOL output)
 11968  e103 68                     PLA                                                 ; pull character
 11969  e104 48                     PHA                                                 ; push character
 11970  e105 38                     SEC                                                 ; }
 11971  e106 66eb                   ROR .tapeCritical                                   ; } Set tape critical flag
 11972  e108 20d4ff                 JSR .OSBPUT                                         ; write character to SPOOL channel (A=character to write, Y=file handle)
 11973  e10b 46eb                   LSR .tapeCritical                                   ; clear tape critical flag
 11974                          
 11975                          .oswrchFinishUp
 11976  e10d 68                     PLA                                                 ;
 11977  e10e 68                     PLA                                                 ; }
 11978  e10f a8                     TAY                                                 ; }
 11979  e110 68                     PLA                                                 ; } restore A,X,Y registers
 11980  e111 aa                     TAX                                                 ; }
 11981  e112 68                     PLA                                                 ; }
 11982  e113 60                     RTS                                                 ;
