 19174                          ; ***************************************************************************************
 19175                          ;
 19176                          ; Display Progress (post-filename)
 19177                          ;
 19178                          ; John Kortink found a couple of bugs in the filing systems. See .reachedFinalBlock.
 19179                          ;
 19180                          ; The first is that in the ROM filing system, .tapeFileLengthLow / High only get set here
 19181                          ; if long messages are enabled, otherwise we early out of this routine. This means OSFILE
 19182                          ; can return an invalid size.
 19183                          ;
 19184                          ; See .reachedFinalBlock for more information
 19185                          ;
 19186                          ; ***************************************************************************************
 19187                          .filenameDone
 19188  f8e2 ad4702                 LDA .tapeOrROMSwitch                                ; filing system switch (0=cassette, 2=ROM filing system)
 19189  f8e5 f004                   BEQ +                                               ; if (tape filing system active) then branch
 19190  f8e7 24bb                   BIT .tapeCurrentOptionsByte                         ; check bit 6 of current options
 19191  f8e9 5048                   BVC .exit33                                         ; if (long messages not needed) then branch (exit)
 19192                          
 19193                              ; print spaces after filename up to 11 characters total
 19194                          +
 19195  f8eb 2091f9                 JSR .printSpace                                     ; print a space
 19196  f8ee c8                     INY                                                 ; Y=Y+1
 19197  f8ef c00b                   CPY #11                                             ;
 19198  f8f1 90ef                   BCC .filenameDone                                   ; if (Y<11) then branch (loop again to fill out filename with spaces)
 19199                          
 19200                              ; print block number
 19201  f8f3 adc603                 LDA .fsBlockNumberLow                               ; block number
 19202  f8f6 aa                     TAX                                                 ; remember block number in X
 19203  f8f7 207af9                 JSR .printHexByte                                   ; print hex byte as ASCII
 19204  f8fa 2cca03                 BIT .fsBlockFlagByte                                ; block flag byte (bit 7 is 'last block' flag)
 19205  f8fd 1034                   BPL .exit33                                         ; if (not end of file) then branch (return)
 19206                          
 19207                              ; at this point we are on the last block of the file
 19208                              ; print the file length in hex
 19209  f8ff 8a                     TXA                                                 ; recall block number from X
 19210  f900 18                     CLC                                                 ;
 19211  f901 6dc903                 ADC .fsBlockLengthHigh                              ; add block length high byte (to get total file length high)
 19212  f904 85cd                   STA .tapeFileLengthHigh                             ; store as file length (high byte)
 19213  f906 2075f9                 JSR .printSpaceThenHexByte                          ; print space then hex byte as ASCII
 19214  f909 adc803                 LDA .fsBlockLengthLow                               ; get block length (low byte)
 19215  f90c 85cc                   STA .tapeFileLengthLow                              ; store as file length (low byte)
 19216  f90e 207af9                 JSR .printHexByte                                   ; print hex byte as ASCII
 19217  f911 24bb                   BIT .tapeCurrentOptionsByte                         ; current options
 19218  f913 501e                   BVC .exit33                                         ; if (long messages not required) then branch (return)
 19219                          
 19220                              ; print four spaces
 19221  f915 a204                   LDX #4                                              ; X=loop counter
 19222                          -
 19223  f917 2091f9                 JSR .printSpace                                     ; print a space
 19224  f91a ca                     DEX                                                 ;
 19225  f91b d0fa                   BNE -                                               ; loop to print 4 spaces
 19226                          
