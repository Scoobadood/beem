  4275                          ; ***************************************************************************************
  4276                          ;
  4277                          ; Converting characters in Teletext
  4278                          ;
  4279                          ; See teletext.png
  4280                          ;
  4281                          ; Writing printable characters (32-126) directly to the display memory in MODE 7
  4282                          ; gives different results in three cases to printing via OSWRCH. In particular:
  4283                          ;
  4284                          ; Value     Write to Screen     Write to screen
  4285                          ;           Memory Directly       via OSWRCH
  4286                          ; ----------------------------------------------
  4287                          ;   $23           £                   #
  4288                          ;   $5F           #                   long dash
  4289                          ;   $60           long dash           £
  4290                          ; ----------------------------------------------
  4291                          ;
  4292                          ; ***************************************************************************************
  4293                          .teletextCharacterConversionTable
  4294  c4b6 23                     !byte $23                                           ; when writing a character in MODE 7,
  4295                                                                                  ; replace each byte here with the next
  4296                                                                                  ; in the table
  4297  c4b7 5f                     !byte $5F                                           ; when reading the character from the
  4298                                                                                  ; screen, replace each byte with the
  4299                                                                                  ; previous in the table
  4300  c4b8 60                     !byte $60                                           ;
  4301  c4b9 23                     !byte $23                                           ;
  4302                          
  4303                          ; ***************************************************************************************
  4304                          ;
  4305                          ; Soft character table offsets
  4306                          ;
  4307                          ; Converts the OSBYTE 20 parameter 1-6 (how much of the character set to 'explode', i.e.
  4308                          ; which range of character definitions can be redefined) into the offset into the
  4309                          ; .vduFontZoneAddressesHigh1 table, which stores the page addresses used to define characters
  4310                          ; in an 'exploded' soft character set.
  4311                          ; See .osbyte20EntryPoint
  4312                          ;
  4313                          ; ***************************************************************************************
  4314                          .softCharacterRamAllocationTable
  4315  c4ba 04                     !byte $04                                           ; 1 -> 4 = range of characters 128-159
  4316  c4bb 05                     !byte $05                                           ; 2 -> 5 = range of characters 160-191
  4317  c4bc 06                     !byte $06                                           ; 3 -> 6 = range of characters 192-223
  4318  c4bd 00                     !byte $00                                           ; 4 -> 0 = range of characters  32-63
  4319  c4be 01                     !byte $01                                           ; 5 -> 1 = range of characters  64-95
  4320  c4bf 02                     !byte $02                                           ; 6 -> 2 = range of characters  96-127
  4321                          
  4322                          ; ***************************************************************************************
  4323                          ; ***************************************************************************************
  4324                          ;
  4325                          ; Chapter 5: VDU and OSWORD routines
  4326                          ;
  4327                          ; ***************************************************************************************
  4328                          ; ***************************************************************************************
  4329                          
  4330                          ; ***************************************************************************************
  4331                          ;
  4332                          ; Note about the BBC Micro Character Set (it's almost, but not quite 7-bit ASCII)
  4333                          ;
  4334                          ; ***************************************************************************************
  4335                          ; One of the main tasks for OSWRCH is to draw characters to the screen. The VDUCHR routine
  4336                          ; performs this job. In particular, with A in the range 32-126 these are the 'printable'
  4337                          ; characters. They result in a visual character appearing on screen. They almost match the
  4338                          ; standard 7-bit ASCII character set. The exception being ASCII CODE 96 '`' (GRAVE ACCENT)
  4339                          ; which is not available. When this code is used with OSWRCH, a pound sign '£' is displayed
  4340                          ; instead. For character definitions, see Chapter 4.
  4341                          ;
  4342                          ; Additionally, MODE 7 (the TELETEXT mode) has a different character set from ASCII, which
  4343                          ; means 10 of the ASCII printable characters can't be displayed. Substitutions are made
  4344                          ; as follows:
  4345                          ;
  4346                          ;     ASCII CODE 91  '[' is displayed as an arrow pointing left
  4347                          ;     ASCII CODE 92  '\' is displayed as the fraction 1/2
  4348                          ;     ASCII CODE 93  ']' is displayed as an arrow pointing right
  4349                          ;     ASCII CODE 94  '^' is displayed as an arrow pointing up
  4350                          ;     ASCII CODE 95  '_' is displayed as a dash
  4351                          ;     ASCII CODE 96  '`' is displayed as a pound sign
  4352                          ;     ASCII CODE 123 '{' is displayed as the fraction 1/4
  4353                          ;     ASCII CODE 124 '|' is displayed as a double vertical bar
  4354                          ;     ASCII CODE 125 '}' is displayed as the fraction 3/4
  4355                          ;     ASCII CODE 126 '~' is displayed as the divide symbol
  4356                          ;
  4357                          ; Note that when writing directly to the display memory in MODE 7 this gives different
  4358                          ; results in three cases to printing via OSWRCH. See .teletextCharacterConversionTable
  4359                          ;
  4360                          ; The character being output is interpreted as below:
  4361                          ;
  4362                          ; Character Range   Description
  4363                          ;   0-31            Control characters, which are interpreted as a whole range of special
  4364                          ;                   commands. Multiple bytes may need to be output to complete the
  4365                          ;                   command. Each VDU command is described at it's own entry point
  4366                          ;                   which are listed in a table (See .vduEntryPointTableLow).
  4367                          ;   32-126          Printable ASCII(-ish) characters as described above.
  4368                          ;   127             Delete character. Attempts to remove the previous printed character
  4369                          ;                   from the screen at the text or graphics cursor (whichever is active).
  4370                          ;   128-255         Available for users programs as soft characters (see .osbyte20EntryPoint).
  4371                          ;                   In MODE 7 these control the appearance of Teletext characters.
  4372                          ;
  4373                          ; ***************************************************************************************
  4374                          ;
  4375                          ; VDUCHR entry point
  4376                          ;
  4377                          ; This is a limited version of OSWRCH that assumes output is to the display only, not to
  4378                          ; Econet, the printer, RS-423, nor SPOOLed to a file. It assumes the VDU drivers are enabled.
  4379                          ;
  4380                          ; ***************************************************************************************
  4381                          .vduChrEntryPoint
  4382  c4c0 ae6a02                 LDX .twosComplimentOfNumberOfBytesInVDUQueue        ; get the number of items in the VDU queue
  4383  c4c3 d04d                   BNE .vduParametersAreOutstanding                    ; if (parameters are still needed) then branch
  4384  c4c5 24d0                   BIT .vduStatusByte                                  ; test VDU status byte
  4385  c4c7 500f                   BVC +                                               ; if (cursor editing mode is NOT active) then branch forward
  4386                          
  4387                              ; handle cursor editing mode...
  4388  c4c9 2068c5                 JSR .exchangeTextCursorAndInputCursorValues         ; temporarily swap the text cursor and input cursor coordinates
  4389  c4cc 206acd                 JSR .setUpWriteCursor                               ; set up write cursor
  4390  c4cf 3007                   BMI +                                               ; if (display is disabled) then branch forward
  4391  c4d1 c90d                   CMP #.charRETURN                                    ;
  4392  c4d3 d003                   BNE +                                               ; if (character is not RETURN) then branch forward
  4393  c4d5 2018d9                 JSR .terminateEdit                                  ; terminate editing
  4394                          
  4395                          +
  4396  c4d8 c97f                   CMP #.charDELETE                                    ;
  4397  c4da f011                   BEQ .handleDeleteCharacter                          ; if (character is DELETE) then branch
  4398  c4dc c920                   CMP #.charSPACE                                     ;
  4399  c4de 900f                   BCC .readVDUEntryPointAddressAndParameters          ; if (character less than space, i.e. a VDU control code) then branch
  4400  c4e0 24d0                   BIT .vduStatusByte                                  ; test VDU status byte again
  4401  c4e2 3006                   BMI +                                               ; if (screen disabled) then branch forward
  4402  c4e4 20b7cf                 JSR .displayACharacter                              ; display a character
  4403  c4e7 2064c6                 JSR .vdu9EntryPoint                                 ; and cursor right
  4404                          +
  4405  c4ea 4c5ec5                 JMP .exitVDUCHR                                     ;
  4406                          
  4407                          ; ***************************************************************************************
  4408                          .handleDeleteCharacter
  4409  c4ed a920                   LDA #.vduEntryPointTableDelete - .vduEntryPointTableLow ; index to read the vdu entry
  4410                                                                                      ; point table for DELETE
  4411                          
  4412                          .readVDUEntryPointAddressAndParameters
  4413  c4ef a8                     TAY                                                 ; store the VDU number in Y
  4414  c4f0 b933c3                 LDA .vduEntryPointTableLow,Y                        ; get low byte of entry point address
  4415  c4f3 8d5d03                 STA .vduJumpVectorLow                               ; store it in jump vector
  4416  c4f6 b954c3                 LDA .vduEntryPointTableHigh,Y                       ; get high byte of entry point address
  4417  c4f9 304a                   BMI .explicitAddressNoParameters                    ; if (a direct access with no parameters) then branch
  4418  c4fb aa                     TAX                                                 ; X=A
  4419  c4fc 09f0                   ORA #%11110000                                      ; set up negated parameter count (set bits in top nybble)
  4420  c4fe 8d6a02                 STA .twosComplimentOfNumberOfBytesInVDUQueue        ; store it back as number of items in VDU queue
  4421  c501 8a                     TXA                                                 ; get back A
  4422  c502 4a                     LSR                                                 ; }
  4423  c503 4a                     LSR                                                 ; }
  4424  c504 4a                     LSR                                                 ; } get high nybble into low nybble
  4425  c505 4a                     LSR                                                 ; }
  4426  c506 18                     CLC                                                 ; clear carry
  4427  c507 69c3                   ADC #>.vduBaseAddress                               ; add base address (high byte) to get high byte of VDU entry point address
  4428  c509 8d5e03                 STA .vduJumpVectorHigh                              ;
  4429  c50c 24d0                   BIT .vduStatusByte                                  ; check for cursor editing mode enabled
  4430  c50e 701f                   BVS .reexchangeCursorsAndExit                       ; if (cursor editing mode enabled) then branch (re-exchange cursors)
  4431  c510 18                     CLC                                                 ; clear carry
  4432                              ; fall through...
  4433                          
  4434                          ; ***************************************************************************************
  4435                          ;
  4436                          ;   VDU 0 / 6 / 27      Empty handlers
  4437                          ;
  4438                          ;   VDU 0  - Does nothing
  4439                          ;   VDU 6  - Enable VDU drivers (re-enabling is handled prior to here, see .checkForVDUReenable)
  4440                          ;   VDU 27 - ESCAPE code, does nothing
  4441                          ;
  4442                          ; ***************************************************************************************
  4443                          .vdu0EntryPoint
  4444                          .vdu6EntryPoint
  4445                          .vdu27EntryPoint
  4446                          .exit
  4447  c511 60                     RTS                                                 ;
  4448                          
  4449                          ; ***************************************************************************************
  4450                          .vduParametersAreOutstanding
  4451  c512 9d2402                 STA .vduQueueEndByte-$FF,X                          ; store parameter in vdu queue
  4452                                                                                  ; (X = 256 - number of parameters
  4453                                                                                  ; i.e. X=$FF for 1, $FE for 2 etc.)
  4454  c515 e8                     INX                                                 ; increment X
  4455  c516 8e6a02                 STX .twosComplimentOfNumberOfBytesInVDUQueue        ; store it as number of bytes in VDU queue (2's complement)
  4456  c519 d017                   BNE .clearCarryAndExit                              ; if (more parameters are needed) then branch
  4457  c51b 24d0                   BIT .vduStatusByte                                  ; test VDU status byte
  4458  c51d 3015                   BMI .preVDU1                                        ; if (VDU disabled) then branch to VDU 1 code
  4459  c51f 7005                   BVS .handleCursorEditing                            ; if (cursor editing mode) then branch
  4460  c521 20f5cc                 JSR .executeRequiredVDUFunction                     ; execute required function for VDU command
  4461  c524 18                     CLC                                                 ; clear carry
  4462  c525 60                     RTS                                                 ;
  4463                          
  4464                          .handleCursorEditing
  4465  c526 2068c5                 JSR .exchangeTextCursorAndInputCursorValues         ; swap values of cursors
  4466  c529 206acd                 JSR .setUpWriteCursor                               ; set up write cursor
  4467  c52c 20f5cc                 JSR .executeRequiredVDUFunction                     ; execute required function for VDU command
  4468                          .reexchangeCursorsAndExit
  4469  c52f 2065c5                 JSR .reswapCursorsBack                              ; re-exchange cursors
  4470                          .clearCarryAndExit
  4471  c532 18                     CLC                                                 ; carry clear
  4472  c533 60                     RTS                                                 ;
  4473                          
  4474                          .preVDU1
  4475  c534 ac5e03                 LDY .vduJumpVectorHigh                              ; check the upper byte of entry point address
  4476  c537 c0c5                   CPY #>.vdu1EntryPoint                               ; check for the default handler
  4477  c539 d0f7                   BNE .clearCarryAndExit                              ; if (not the default handler) then branch (exit)
  4478                              ; fall through...
  4479                          
  4480                          
  4481                          ; ***************************************************************************************
  4482                          ;
  4483                          ;   VDU 1       Send next byte to printer only
  4484                          ;
  4485                          ; ***************************************************************************************
  4486                          .vdu1EntryPoint
  4487  c53b aa                     TAX                                                 ; remember A
  4488  c53c a5d0                   LDA .vduStatusByte                                  ; get VDU status byte
  4489  c53e 4a                     LSR                                                 ; get bit 0 into carry (printer enabled bit)
  4490  c53f 90d0                   BCC .exit                                           ; if (printer not enabled) then branch (exit)
  4491  c541 8a                     TXA                                                 ; restore A
  4492  c542 4c1ee1                 JMP .sendValidByteToPrinter                         ; send byte in A (next byte) to printer
  4493                          
  4494                          ; ***************************************************************************************
  4495                          .explicitAddressNoParameters
  4496  c545 8d5e03                 STA .vduJumpVectorHigh                              ; upper byte of link address
  4497  c548 98                     TYA                                                 ; restore A (the VDU number)
  4498                          
  4499                              ; set carry if VDU number is within range 8-13 (cursor movement)
  4500  c549 c908                   CMP #8                                              ;
  4501  c54b 9006                   BCC +                                               ; if (VDU number < 8) then branch (carry clear)
  4502  c54d 49ff                   EOR #$FF                                            ; invert value
  4503  c54f c9f2                   CMP #$F2                                            ; if (VDU number > 13) then clear carry
  4504  c551 49ff                   EOR #$FF                                            ; re-invert value back again
  4505                          
  4506                          +
  4507  c553 24d0                   BIT .vduStatusByte                                  ; test VDU status byte
  4508  c555 3029                   BMI .checkForVDUReenable                            ; if (VDU disabled) then branch
  4509  c557 08                     PHP                                                 ; push flags
  4510  c558 20f5cc                 JSR .executeRequiredVDUFunction                     ; execute required function
  4511  c55b 28                     PLP                                                 ; pull flags back
  4512  c55c 9003                   BCC +                                               ; if (not VDU 8-13 cursor movement) then branch (skip 'printer enabled' check)
  4513                              ; fall through...
  4514                          
  4515                          ; ***************************************************************************************
  4516                          .exitVDUCHR
  4517  c55e a5d0                   LDA .vduStatusByte                                  ; read VDU status byte
  4518  c560 4a                     LSR                                                 ; carry is set if printer is enabled
  4519                          +
  4520  c561 24d0                   BIT .vduStatusByte                                  ; test VDU status byte
  4521  c563 50ac                   BVC .exit                                           ; if (no cursor editing mode) then branch
  4522                              ; fall through...
  4523                          
  4524                          ; ***************************************************************************************
  4525                          .reswapCursorsBack
  4526  c565 207acd                 JSR .restoreWriteCursor                             ; restore normal write cursor
  4527                          
  4528                          .exchangeTextCursorAndInputCursorValues
  4529  c568 08                     PHP                                                 ; save flags
  4530  c569 48                     PHA                                                 ; save A
  4531  c56a a218                   LDX #.vduTextCursorXPosition        - .vduVariablesStart    ; offset within VDU variables for text cursor position
  4532  c56c a064                   LDY #.vduTextInputCursorXCoordinate - .vduVariablesStart    ; offset within VDU variables for text input cursor position
  4533  c56e 20decd                 JSR .exchangeTwoVDUBytes                            ; exchange current text cursor coordinates with text input cursor coordinates
  4534  c571 2006cf                 JSR .setTextCursorScreenAddresses                   ; set cursor screen addresses
  4535  c574 2002ca                 JSR .setHardwareCursorAddress                       ; set cursor position
  4536  c577 a5d0                   LDA .vduStatusByte                                  ; get VDU status byte
  4537  c579 4902                   EOR #%00000010                                      ; invert bit 1 to allow or inhibit scrolling
  4538  c57b 85d0                   STA .vduStatusByte                                  ; store VDU status byte
  4539  c57d 68                     PLA                                                 ; restore flags
  4540  c57e 28                     PLP                                                 ; restore A
  4541  c57f 60                     RTS                                                 ;
  4542                          
  4543                          ; ***************************************************************************************
  4544                          .checkForVDUReenable
  4545  c580 4906                   EOR #6                                              ; check for VDU 6 (to reenable output to the display)
  4546  c582 d008                   BNE .exit1                                          ; if (not VDU 6) then branch (exit)
  4547  c584 a97f                   LDA #%01111111                                      ; set A to clear the top bit of the VDU status byte
  4548  c586 9020                   BCC .clearVDUStatusByteFlags                        ; ALWAYS branch, clearing the top bit (enabling output to the display again)
  4549                          
  4550                          ; ***************************************************************************************
  4551                          ;
  4552                          ; Check whether the text or graphics cursor is active
  4553                          ;
  4554                          ; On Exit:
  4555                          ;    A = 0   if text cursor is active           (Z flag set)
  4556                          ;    A = $20 otherwise (graphics cursor active) (Z flag clear)
  4557                          ;
  4558                          ; ***************************************************************************************
  4559                          .isTextCursorActive
  4560  c588 a5d0                   LDA .vduStatusByte                                  ; VDU status byte
  4561  c58a 2920                   AND #%00100000                                      ; test bit 5 of status byte
  4562                          .exit1
  4563  c58c 60                     RTS                                                 ;
  4564                          
  4565                          
  4566                          ; ***************************************************************************************
  4567                          ;
  4568                          ;   VDU 14    Set paged mode
  4569                          ;
  4570                          ; ***************************************************************************************
  4571                          .vdu14EntryPoint
  4572  c58d a000                   LDY #0                                              ; Y = 0
  4573  c58f 8c6902                 STY .pagedModeCounter                               ; paged mode counter
  4574  c592 a904                   LDA #4                                              ; A = 4
  4575  c594 d007                   BNE .setVDUStatusByteFlags                          ; ALWAYS branch
  4576                          
  4577                          
  4578                          ; ***************************************************************************************
  4579                          ;
  4580                          ;   VDU 2     Printer On
  4581                          ;
  4582                          ; ***************************************************************************************
  4583                          .vdu2EntryPoint
  4584  c596 20a2e1                 JSR .printerServiceCall                             ; select printer buffer
  4585  c599 a994                   LDA #$94                                            ; A=$94 when inverted at next statement this = 1
  4586                                                                                  ; thereby setting bit 0 of the VDU status byte (printer output enable)
  4587                              ; fall through...
  4588                          
  4589                          
  4590                          ; ***************************************************************************************
  4591                          ;
  4592                          ;   VDU 21    Disable VDU drivers
  4593                          ;
  4594                          ; Output to the VDU is disabled (until a VDU 6 is used to re-enable output).
  4595                          ;
  4596                          ; ***************************************************************************************
  4597                          .vdu21EntryPoint
  4598  c59b 4995                   EOR #$95                                            ; if A=21  (entry from VDU 21) then A = $80
  4599                                                                                  ; if A=$94 (entry from VDU 2)  then A = 1
  4600                          .setVDUStatusByteFlags
  4601  c59d 05d0                   ORA .vduStatusByte                                  ; VDU status byte set bit 0 or bit 7
  4602  c59f d009                   BNE .storeVDUStatusByteAndReturn                    ; ALWAYS branch (since A != 0)
  4603                          
  4604                          
  4605                          ; ***************************************************************************************
  4606                          ;
  4607                          ;   VDU 3     Printer off
  4608                          ;
  4609                          ; ***************************************************************************************
  4610                          .vdu3EntryPoint
  4611  c5a1 20a2e1                 JSR .printerServiceCall                             ; select printer buffer
  4612  c5a4 a90a                   LDA #10                                             ;
  4613                              ; fall through...
  4614                          
  4615                          
  4616                          ; ***************************************************************************************
  4617                          ;
  4618                          ;   VDU 15    Paged mode off
  4619                          ;
  4620                          ; On Entry:
  4621                          ;       A = 15  paged mode off
  4622                          ;       A = 10  printer off
  4623                          ;
  4624                          ; ***************************************************************************************
  4625                          .vdu15EntryPoint
  4626  c5a6 49f4                   EOR #$F4                                            ; convert to $FB or $FE to clear
  4627                                                                                  ; bit 2 or 1 respectively
  4628                          .clearVDUStatusByteFlags
  4629  c5a8 25d0                   AND .vduStatusByte                                  ; AND with VDU status byte
  4630                          .storeVDUStatusByteAndReturn
  4631  c5aa 85d0                   STA .vduStatusByte                                  ; store VDU status byte
  4632                          -
  4633  c5ac 60                     RTS                                                 ;
  4634                          
  4635                          
  4636                          ; ***************************************************************************************
  4637                          ;
  4638                          ;   VDU 4       Select text cursor
  4639                          ;
  4640                          ; At all times either the text cursor is active or the graphics cursor is active
  4641                          ; Characters are either drawn normally in text cells (at the text cursor) or at any pixel
  4642                          ; position (the graphics cursor)
  4643                          ;
  4644                          ; ***************************************************************************************
  4645                          .vdu4EntryPoint
  4646  c5ad ad6103                 LDA .vduPixelsPerByteMinusOne                       ; pixels per byte
  4647  c5b0 f0fa                   BEQ -                                               ; if (not in graphics MODE) then branch (return)
  4648  c5b2 2051c9                 JSR .setTextCursor                                  ; set text cursor (CRTC hardware)
  4649  c5b5 a9df                   LDA #%11011111                                      ; clear bit 5 (graphics cursor bit)
  4650  c5b7 d0ef                   BNE .clearVDUStatusByteFlags                        ; ALWAYS branch - clear bit 5 and exit
  4651                          
  4652                          
  4653                          ; ***************************************************************************************
  4654                          ;
  4655                          ;   VDU 5       Select graphics cursor
  4656                          ;
  4657                          ; ***************************************************************************************
  4658                          .vdu5EntryPoint
  4659  c5b9 ad6103                 LDA .vduPixelsPerByteMinusOne                       ; pixels per byte minus one
  4660  c5bc f0ee                   BEQ -                                               ; if (not in graphics MODE) then branch (return)
  4661  c5be a920                   LDA #32                                             ; cursor setting
  4662  c5c0 2054c9                 JSR .setCursorOnOrOff                               ; turn off cursor
  4663  c5c3 d0d8                   BNE .setVDUStatusByteFlags                          ; ALWAYS branch - set bit 5 of VDU status byte and exit
  4664                          
  4665                          
  4666                          ; ***************************************************************************************
  4667                          ;
  4668                          ;   VDU 8       Cursor left (.charBACKSPACE)
  4669                          ;
  4670                          ; ***************************************************************************************
  4671                          .vdu8EntryPoint
  4672  c5c5 2088c5                 JSR .isTextCursorActive                             ; set A=0 if text cursor is active
  4673                                                                                  ;  or A=$20 if graphics cursor
  4674  c5c8 d055                   BNE .moveGraphicsCursorLeftEightPixels              ; if (currently in graphics cursor
  4675                                                                                  ; mode) then branch (to move cursor
  4676                                                                                  ; left 8 pixels)
  4677  c5ca ce1803                 DEC .vduTextCursorXPosition                         ; decrement text column
  4678  c5cd ae1803                 LDX .vduTextCursorXPosition                         ; get new text column
  4679  c5d0 ec0803                 CPX .vduTextWindowLeft                              ; check against left of text window
  4680  c5d3 3019                   BMI .wrapFromLeftEdgeToRightEdgeOfTextWindow        ; if (less than left edge of text
  4681                                                                                  ; window) then branch (wrap to right
  4682                                                                                  ; edge and one line up)
  4683  c5d5 ad4a03                 LDA .vduTextCursorCRTCAddressLow                    ; get text cursor CRTC address (low)
  4684  c5d8 38                     SEC                                                 ;
  4685  c5d9 ed4f03                 SBC .vduBytesPerCharacter                           ; subtract bytes per character
  4686  c5dc aa                     TAX                                                 ; put in X
  4687  c5dd ad4b03                 LDA .vduTextCursorCRTCAddressHigh                   ; get text cursor CRTC address (high)
  4688  c5e0 e900                   SBC #0                                              ; subtract 0 + carry
  4689  c5e2 cd4e03                 CMP .vduStartScreenAddressHighByte                  ; compare with high byte of screen
  4690                                                                                  ; RAM address
  4691  c5e5 b003                   BCS +                                               ; if (text cursor is not below the
  4692                                                                                  ; start of the screen address) then
  4693                                                                                  ; branch forward
  4694  c5e7 6d5403                 ADC .vduScreenSizeHighByte                          ; add screen RAM size high byte to
  4695                                                                                  ; wrap back onto screen
  4696                          +
  4697  c5ea a8                     TAY                                                 ; Y=A
  4698  c5eb 4cf6c9                 JMP .setTextCursorCRTCAddress                       ; A high and X low byte of cursor
  4699                                                                                  ; address
  4700                          
  4701                          ; ***************************************************************************************
  4702                          .wrapFromLeftEdgeToRightEdgeOfTextWindow
  4703  c5ee ad0a03                 LDA .vduTextWindowRight                             ; load text window right edge
  4704  c5f1 8d1803                 STA .vduTextCursorXPosition                         ; set current text column
  4705                          
  4706                          .cursorUp
  4707  c5f4 ce6902                 DEC .pagedModeCounter                               ; paged mode counter
  4708  c5f7 1003                   BPL +                                               ; if (not less than zero) then branch (skip next instruction)
  4709  c5f9 ee6902                 INC .pagedModeCounter                               ; paged mode counter to restore X=0
  4710                          +
  4711  c5fc ae1903                 LDX .vduTextCursorYPosition                         ; current text line
  4712  c5ff ec0b03                 CPX .vduTextWindowTop                               ; top of text window
  4713  c602 f006                   BEQ .cursorAtTopOfTextWindow                        ; if (it's at the top of the text window) then branch
  4714  c604 ce1903                 DEC .vduTextCursorYPosition                         ; decrement current text line
  4715  c607 4cafc6                 JMP .setCursorSoftwareAndHardwarePosition           ; set cursor position
  4716                          
  4717                          ; ***************************************************************************************
  4718                          .cursorAtTopOfTextWindow
  4719  c60a 18                     CLC                                                 ; clear carry
  4720  c60b 203fcd                 JSR .moveTextCursorToNextLine                       ; move cursor
  4721  c60e a908                   LDA #%00001000                                      ; A=8 to check for software scrolling
  4722  c610 24d0                   BIT .vduStatusByte                                  ; test VDU status byte
  4723  c612 d005                   BNE +                                               ; if (software scrolling enabled) then branch forward
  4724  c614 2094c9                 JSR .hardwareScrollDown                             ; scroll down
  4725  c617 d003                   BNE .skipScrolling                                  ; branch
  4726                          +
  4727  c619 20a4cd                 JSR .scrollTextWindowDownwards                      ; soft scroll 1 line
  4728                          .skipScrolling
  4729  c61c 4cacc6                 JMP .clearOneLineAndPositionCursor                  ; clear one line and exit
  4730                          
  4731                          ; ***************************************************************************************
  4732                          .moveGraphicsCursorLeftEightPixels
  4733  c61f a200                   LDX #0                                              ; X = 0 to select horizontal movement (move left)
  4734                              ; fall through...
  4735                          
  4736                          ; ***************************************************************************************
  4737                          ;
  4738                          ; Move graphics cursor (left or down)
  4739                          ;
  4740                          ; On Entry:
  4741                          ;       X = 0 to move left or
  4742                          ;       X = 2 to move down
  4743                          ;
  4744                          ; ***************************************************************************************
  4745                          .moveGraphicsCursorLeftOrDownEightPixels
  4746  c621 86db                   STX .vduTempStoreDB                                 ; store X
  4747  c623 200dd1                 JSR .checkGraphicsCursorIsWithinGraphicsWindow      ; check window bounds
  4748  c626 a6db                   LDX .vduTempStoreDB                                 ; restore X
  4749  c628 38                     SEC                                                 ; set carry
  4750  c629 bd2403                 LDA .vduGraphicsCursorPixelsXLow,X                  ; current graphics cursor (X=2 for vertical movement)
  4751  c62c e908                   SBC #8                                              ; subtract 8 to move back/down 1 character
  4752  c62e 9d2403                 STA .vduGraphicsCursorPixelsXLow,X                  ; store in current graphics cursor (X=2 for vertical movement)
  4753  c631 b003                   BCS +                                               ; if (carry set, no need to adjust high byte) then branch forward
  4754  c633 de2503                 DEC .vduGraphicsCursorPixelsXHigh,X                 ; decrement high byte of graphics cursor
  4755                          +
  4756  c636 a5da                   LDA .vduTempStoreDA                                 ; check the old graphics cursor position
  4757  c638 d01e                   BNE .setUpExternalGraphicsCoordinates               ; if (old graphics position out of the graphics window bounds) then branch
  4758  c63a 200dd1                 JSR .checkGraphicsCursorIsWithinGraphicsWindow      ; check the new graphics cursor position
  4759  c63d f019                   BEQ .setUpExternalGraphicsCoordinates               ; if (not out of bounds now) then branch
  4760                          
  4761                              ; this is the case where the old coordinates were within the window, but now are not.
  4762                              ; when moving left, then move up and clamp to the right edge.
  4763                              ; when moving down, clamp to the top edge.
  4764  c63f a6db                   LDX .vduTempStoreDB                                 ; get back X
  4765  c641 bd0403                 LDA .vduGraphicsWindowPixelsRightLow,X              ; get graphics window right (X=0) or top (X=2)
  4766  c644 e001                   CPX #1                                              ;
  4767  c646 b002                   BCS +                                               ; if (moving down) then branch forward
  4768  c648 e906                   SBC #6                                              ; moving left. A = A - 7 (note carry is clear)
  4769                          +
  4770  c64a 9d2403                 STA .vduGraphicsCursorPixelsXLow,X                  ; current graphics cursor position (X=2 means vertical)
  4771  c64d bd0503                 LDA .vduGraphicsWindowPixelsRightHigh,X             ; graphics window right (X=0) or top (X=2) high byte
  4772  c650 e900                   SBC #0                                              ; subtract carry
  4773  c652 9d2503                 STA .vduGraphicsCursorPixelsXHigh,X                 ; current graphics cursor position (X=2 means vertical)
  4774  c655 8a                     TXA                                                 ;
  4775  c656 f008                   BEQ .graphicsCursorUpEightPixels                    ; if (moving left) then branch
  4776                                                                                  ; (because we've hit the left edge,
  4777                                                                                  ; move graphics cursor up)
  4778                          
  4779                          .setUpExternalGraphicsCoordinates
  4780  c658 4cb8d1                 JMP .convertPixelGraphicsCoordinatesToExternal      ; set up external coordinates for graphics
  4781                          
  4782                          
  4783                          ; ***************************************************************************************
  4784                          ;
  4785                          ;   VDU 11       Cursor up
  4786                          ;
  4787                          ; ***************************************************************************************
  4788                          .vdu11EntryPoint
  4789  c65b 2088c5                 JSR .isTextCursorActive                             ; set A=0 if text cursor is active; A=$20 if graphics cursor
  4790  c65e f094                   BEQ .cursorUp                                       ; if (text cursor is active) then branch
  4791                          .graphicsCursorUpEightPixels
  4792  c660 a202                   LDX #2                                              ; set X = 2 for moving graphics cursor UP
  4793  c662 d052                   BNE .moveGraphicsCursorUpOrRightEightPixels         ; ALWAYS branch
  4794                          
  4795                          
  4796                          ; ***************************************************************************************
  4797                          ;
  4798                          ;   VDU 9        Cursor right
  4799                          ;
  4800                          ; ***************************************************************************************
  4801                          .vdu9EntryPoint
  4802  c664 a5d0                   LDA .vduStatusByte                                  ; get VDU status byte
  4803  c666 2920                   AND #%00100000                                      ; check bit 5 (graphics cursor)
  4804  c668 d04a                   BNE .moveGraphicsCursorRightEightPixels             ; if (graphics cursor in use) then branch
  4805  c66a ae1803                 LDX .vduTextCursorXPosition                         ; text column
  4806  c66d ec0a03                 CPX .vduTextWindowRight                             ; text window right
  4807  c670 b012                   BCS .moveTextCursorToLeftEdgeAndDown                ; if (X exceeds window right) then branch
  4808  c672 ee1803                 INC .vduTextCursorXPosition                         ; text column
  4809  c675 ad4a03                 LDA .vduTextCursorCRTCAddressLow                    ; text cursor CRTC address low
  4810  c678 6d4f03                 ADC .vduBytesPerCharacter                           ; add bytes per character
  4811  c67b aa                     TAX                                                 ; X = new low byte of CRTC address
  4812  c67c ad4b03                 LDA .vduTextCursorCRTCAddressHigh                   ; text cursor CRTC address high
  4813  c67f 6900                   ADC #0                                              ; add carry. A = new high byte of CRTC address
  4814  c681 4cf6c9                 JMP .setTextCursorCRTCAddress                       ; use X and A to set new text cursor CRTC address
  4815                          
  4816                          ; ***************************************************************************************
  4817                          .moveTextCursorToLeftEdgeAndDown
  4818  c684 ad0803                 LDA .vduTextWindowLeft                              ; text window left
  4819  c687 8d1803                 STA .vduTextCursorXPosition                         ; text column
  4820                              ; fall through...
  4821                          
  4822                          ; ***************************************************************************************
  4823                          .moveTextCursorDown
  4824  c68a 18                     CLC                                                 ; clear carry
  4825  c68b 20e3ca                 JSR .handleScrollingInPagedModeInternal             ; check text window bottom edge, X=line count
  4826  c68e ae1903                 LDX .vduTextCursorYPosition                         ; current text line
  4827  c691 ec0903                 CPX .vduTextWindowBottom                            ; bottom edge
  4828  c694 b005                   BCS +                                               ; if (current text Y position => bottom edge) then branch
  4829  c696 ee1903                 INC .vduTextCursorYPosition                         ; increment current text line
  4830  c699 9014                   BCC .setCursorSoftwareAndHardwarePosition           ; ALWAYS branch (set cursor position)
  4831                          +
  4832  c69b 203fcd                 JSR .moveTextCursorToNextLine                       ; move cursor to next line
  4833  c69e a908                   LDA #%00001000                                      ; check bit 3 (software scrolling)
  4834  c6a0 24d0                   BIT .vduStatusByte                                  ; test VDU status byte
  4835  c6a2 d005                   BNE +                                               ; if (software scrolling enabled) then branch
  4836  c6a4 20a4c9                 JSR .hardwareScrollUp                               ; perform hardware scroll
  4837  c6a7 d003                   BNE .clearOneLineAndPositionCursor                  ;
  4838                          +
  4839  c6a9 20ffcd                 JSR .scrollTextWindowUpwards                        ; execute upward software scroll
  4840                              ; fall through...
  4841                          
  4842                          ; ***************************************************************************************
  4843                          .clearOneLineAndPositionCursor
  4844  c6ac 20acce                 JSR .clearOneLine                                   ; clear a line
  4845                              ; fall through...
  4846                          
  4847                          ; ***************************************************************************************
  4848                          ;
  4849                          ; Set cursor address
  4850                          ;
  4851                          ; Calculates cursor screen addresses and sets the hardware
  4852                          ;
  4853                          ; ***************************************************************************************
  4854                          .setCursorSoftwareAndHardwarePosition
  4855  c6af 2006cf                 JSR .setTextCursorScreenAddresses                   ; set cursor screen addresses
  4856  c6b2 907e                   BCC .setHardwareCursorAddressLocal                  ; ALWAYS branch
  4857                          
  4858                          ; ***************************************************************************************
  4859                          .moveGraphicsCursorRightEightPixels
  4860  c6b4 a200                   LDX #0                                              ; X=0 for move cursor right
  4861                              ; fall through...
  4862                          
  4863                          ; ***************************************************************************************
  4864                          ;
  4865                          ; Move graphics cursor (up or right)
  4866                          ;
  4867                          ; On Entry:
  4868                          ;       X = 0 means move graphics cursor right
  4869                          ;       X = 2 means move graphics cursor up
  4870                          ;
  4871                          ; ***************************************************************************************
  4872                          .moveGraphicsCursorUpOrRightEightPixels
  4873  c6b6 86db                   STX .vduTempStoreDB                                 ; store X
  4874  c6b8 200dd1                 JSR .checkGraphicsCursorIsWithinGraphicsWindow      ; check window bounds
  4875  c6bb a6db                   LDX .vduTempStoreDB                                 ; recall X
  4876  c6bd 18                     CLC                                                 ;
  4877  c6be bd2403                 LDA .vduGraphicsCursorPixelsXLow,X                  ; get current graphics cursor (low)
  4878  c6c1 6908                   ADC #8                                              ; add 8 pixels
  4879  c6c3 9d2403                 STA .vduGraphicsCursorPixelsXLow,X                  ; set current graphics cursor (low)
  4880  c6c6 9003                   BCC +                                               ;
  4881  c6c8 fe2503                 INC .vduGraphicsCursorPixelsXHigh,X                 ; set current graphics cursor (high)
  4882                          +
  4883  c6cb a5da                   LDA .vduTempStoreDA                                 ; A=0 no window violations, 1 or 2 indicates violation
  4884  c6cd d089                   BNE .setUpExternalGraphicsCoordinates               ; if (outside graphics window) then branch
  4885  c6cf 200dd1                 JSR .checkGraphicsCursorIsWithinGraphicsWindow      ; check window bounds
  4886  c6d2 f084                   BEQ .setUpExternalGraphicsCoordinates               ; if (within graphics window) then branch
  4887                          
  4888  c6d4 a6db                   LDX .vduTempStoreDB                                 ; get back X
  4889  c6d6 bd0003                 LDA .vduGraphicsWindowPixelsLeftLow,X               ; get left/bottom edge of graphics
  4890                                                                                  ; window (low) (X=0 means left,
  4891                                                                                  ; else X=2 means bottom)
  4892  c6d9 e001                   CPX #1                                              ;
  4893  c6db 9002                   BCC +                                               ; if (X is 0; hit left edge) then branch
  4894  c6dd 6906                   ADC #6                                              ; A = A + 7 (including carry)
  4895                          +
  4896  c6df 9d2403                 STA .vduGraphicsCursorPixelsXLow,X                  ; set current graphics cursor position (low)
  4897  c6e2 bd0103                 LDA .vduGraphicsWindowPixelsLeftHigh,X              ; get left edge (high)
  4898  c6e5 6900                   ADC #0                                              ; add carry
  4899  c6e7 9d2503                 STA .vduGraphicsCursorPixelsXHigh,X                 ; set current graphics cursor position (high)
  4900  c6ea 8a                     TXA                                                 ; A=X
  4901  c6eb f008                   BEQ .graphicsCursorDown                             ; if (X = 0) then branch (move graphics cursor down)
  4902  c6ed 4cb8d1                 JMP .convertPixelGraphicsCoordinatesToExternal      ; set up external coordinates for graphics
  4903                          
  4904                          
  4905                          ; ***************************************************************************************
  4906                          ;
  4907                          ;   VDU 10       Cursor down
  4908                          ;
  4909                          ; ***************************************************************************************
  4910                          .vdu10EntryPoint
  4911  c6f0 2088c5                 JSR .isTextCursorActive                             ; set A=0 if text cursor is active; A=$20 if graphics cursor
  4912  c6f3 f095                   BEQ .moveTextCursorDown                             ; if (text cursor active) then branch
  4913                          .graphicsCursorDown
  4914  c6f5 a202                   LDX #2                                              ; X = 2 to indicate movement down
  4915  c6f7 4c21c6                 JMP .moveGraphicsCursorLeftOrDownEightPixels        ; move graphics cursor down
  4916                          
  4917                          
  4918                          ; ***************************************************************************************
  4919                          ;
  4920                          ;   VDU 28       Define Text Window
  4921                          ;
  4922                          ; A sub-rectangle on screen can be defined that limits where text can be drawn.
  4923                          ;
  4924                          ; ***************************************************************************************
  4925                          .vdu28ParamLeftEdge   = .vduQueueEndByte - 3
  4926                          .vdu28ParamBottomEdge = .vduQueueEndByte - 2
  4927                          .vdu28ParamRightEdge  = .vduQueueEndByte - 1
  4928                          .vdu28ParamTopEdge    = .vduQueueEndByte
  4929                          ; Note that last parameter is always in 0323
  4930                          
  4931                          .vdu28EntryPoint
  4932  c6fa ae5503                 LDX .vduCurrentScreenMODE                           ; get current screen MODE
  4933  c6fd ad2103                 LDA .vdu28ParamBottomEdge                           ; get bottom edge
  4934  c700 cd2303                 CMP .vdu28ParamTopEdge                              ; compare with top edge
  4935  c703 9053                   BCC .exit2                                          ; if (bottom edge exceeds top edge) then branch (return)
  4936  c705 dde7c3                 CMP .textWindowBottomRowTable,X                     ; check against text window bottom edge maximum
  4937  c708 f002                   BEQ +                                               ; if (on the edge) then branch (it's OK)
  4938  c70a b04c                   BCS .exit2                                          ; if (outside bounds) then branch (exit)
  4939                          +
  4940  c70c ad2203                 LDA .vdu28ParamRightEdge                            ; get right edge
  4941  c70f a8                     TAY                                                 ; put it in Y
  4942  c710 ddefc3                 CMP .textWindowRightColumnTable,X                   ; text window right hand edge maximum
  4943  c713 f002                   BEQ +                                               ; if (on the edge) then branch (it's OK)
  4944  c715 b041                   BCS .exit2                                          ; if (outside bounds) then branch (exit)
  4945                          +
  4946  c717 38                     SEC                                                 ; set carry to subtract
  4947  c718 ed2003                 SBC .vdu28ParamLeftEdge                             ; left edge
  4948  c71b 303b                   BMI .exit2                                          ; if (left edge greater than right) then branch (exit)
  4949  c71d a8                     TAY                                                 ; A=Y (window width)
  4950  c71e 2088ca                 JSR .calculateBytesPerTextWindowRow                 ; calculate number of bytes in a text window row
  4951  c721 a908                   LDA #%00001000                                      ; set bit 3 of .vduStatusByte
  4952  c723 209dc5                 JSR .setVDUStatusByteFlags                          ; indicating that text window is defined
  4953  c726 a220                   LDX #.vdu28ParamLeftEdge - .vduVariablesStart       ; point to parameters
  4954  c728 a008                   LDY #.vduTextWindowLeft  - .vduVariablesStart       ; point to text window edges
  4955  c72a 208ad4                 JSR .copyFourBytesWithinVDUVariables                ; copy 4 parameters into the text window edges
  4956  c72d 20e8ce                 JSR .validatePositionAndSetupScreenAddress          ; check ok and set up screen address
  4957  c730 b047                   BCS .vdu30EntryPoint                                ; home cursor within window
  4958                          .setHardwareCursorAddressLocal
  4959  c732 4c02ca                 JMP .setHardwareCursorAddress                       ; set cursor position
  4960                          
  4961                          
  4962                          ; ***************************************************************************************
  4963                          ;
  4964                          ;   OSWORD 9 - Read a pixel
  4965                          ;
  4966                          ; On Entry:
  4967                          ;       .oswordA = 9
  4968                          ;       .oswordX = low byte of parameter block address
  4969                          ;       .oswordY = high byte of parameter block address
  4970                          ;
  4971                          ;   .oswordX/Y is the address of the four bytes of parameters:
  4972                          ;       byte 0-1: X coordinate
  4973                          ;       byte 2-3: Y coordinate
  4974                          ;
  4975                          ; On Exit:
  4976                          ;       Result stored in byte 4 of parameter block:
  4977                          ;           $FF if point was off screen, or logical colour of point if on screen
  4978                          ;
  4979                          ; ***************************************************************************************
  4980                          .osword9EntryPoint
  4981  c735 a003                   LDY #3                                              ; Y is loop counter
  4982                          -
  4983  c737 b1f0                   LDA (.oswordX),Y                                    ; get it
  4984  c739 992803                 STA .vduWorkspaceA,Y                                ; store it
  4985  c73c 88                     DEY                                                 ; decrement counter
  4986  c73d 10f8                   BPL -                                               ; loop back until done
  4987  c73f a928                   LDA #.vduWorkspaceA - .vduVariablesStart            ;
  4988  c741 2039d8                 JSR .readPixel                                      ;
  4989  c744 a004                   LDY #4                                              ; Y=4
  4990  c746 d008                   BNE .storeAInParameterBlock                         ; ALWAYS branch
  4991                          
  4992                          
  4993                          ; ***************************************************************************************
  4994                          ;
  4995                          ;   OSWORD 11 - Read palette
  4996                          ;
  4997                          ; On Entry:
  4998                          ;       Y = 0
  4999                          ;       .oswordA = 11
  5000                          ;       .osWordX = low byte of parameter block address
  5001                          ;       .osWordY = high byte of parameter block address
  5002                          ;
  5003                          ;   .oswordX/Y is the address of the four byte parameter block:
  5004                          ;       byte 0: logical colour to read
  5005                          ;
  5006                          ; On Exit:
  5007                          ;       byte 0: logical colour
  5008                          ;       byte 1: physical colour
  5009                          ;       byte 2: zero
  5010                          ;       byte 3: zero
  5011                          ;
  5012                          ; ***************************************************************************************
  5013                          .osword11EntryPoint
  5014  c748 2d6003                 AND .vduNumberOfLogicalColoursMinusOne              ; number of logical colours less 1
  5015  c74b aa                     TAX                                                 ; put it in X
  5016  c74c bd6f03                 LDA .vduColourPaletteStart,X                        ; get value from colour palette
  5017                          -
  5018  c74f c8                     INY                                                 ; increment Y to point to byte 1
  5019                          .storeAInParameterBlock
  5020  c750 91f0                   STA (.oswordX),Y                                    ; store data
  5021  c752 a900                   LDA #0                                              ; issue 0s
  5022  c754 c004                   CPY #4                                              ; to next bytes until Y=4
  5023  c756 d0f7                   BNE -                                               ;
  5024                          .exit2
  5025  c758 60                     RTS                                                 ;
  5026                          
  5027                          
  5028                          ; ***************************************************************************************
  5029                          ;
  5030                          ;   VDU 12      Clear text or graphics window
  5031                          ;
  5032                          ; ***************************************************************************************
  5033                          .vdu12EntryPoint
  5034  c759 2088c5                 JSR .isTextCursorActive                             ; set A=0 if text cursor is active; A=$20 if graphics cursor
  5035  c75c d05f                   BNE .clearGraphicsWindowAndHomeGraphicsCursor       ; if (graphics cursor active) then branch (clear graphics area)
  5036  c75e a5d0                   LDA .vduStatusByte                                  ; VDU status byte
  5037  c760 2908                   AND #%00001000                                      ; check if software scrolling (text window set)
  5038  c762 d003                   BNE +                                               ; if (software scrolling) then branch
  5039  c764 4cc1cb                 JMP .initializeDisplayAndHomeCursor                 ; initialise screen display and home cursor
  5040                          +
  5041  c767 ae0b03                 LDX .vduTextWindowTop                               ; top of text window
  5042                          -
  5043  c76a 8e1903                 STX .vduTextCursorYPosition                         ; current text line
  5044  c76d 20acce                 JSR .clearOneLine                                   ; clear a line
  5045                          
  5046  c770 ae1903                 LDX .vduTextCursorYPosition                         ; current text line
  5047  c773 ec0903                 CPX .vduTextWindowBottom                            ; bottom edge
  5048  c776 e8                     INX                                                 ; X=X+1
  5049  c777 90f1                   BCC -                                               ; if (not reached bottom edge yet)
  5050                                                                                  ; then branch (loop back and clear the next row)
  5051                              ; fall through...
  5052                          
  5053                          
  5054                          ; ***************************************************************************************
  5055                          ;
  5056                          ;   VDU 30      Home Cursor
  5057                          ;
  5058                          ; Moves the current cursor (text or graphics) to the top left of the defined text or
  5059                          ; graphics window.
  5060                          ;
  5061                          ; ***************************************************************************************
  5062                          .vdu30EntryPoint
  5063  c779 2088c5                 JSR .isTextCursorActive                             ; set A=0 if text cursor is active; A=$20 if graphics cursor
  5064  c77c f003                   BEQ .homeTextCursor                                 ; if (text cursor active) then branch
  5065  c77e 4ca6cf                 JMP .graphicsCursorHome                             ; home graphic cursor
  5066                          
  5067                          .homeTextCursor
  5068  c781 8d2303                 STA .vdu31ParamYCoordinate                          ; store 0 in last two parameters
  5069  c784 8d2203                 STA .vdu31ParamXCoordinate                          ;
  5070                              ; fall through...
  5071                          
  5072                          ; ***************************************************************************************
  5073                          ;
  5074                          ;   VDU 31      Position text cursor
  5075                          ;
  5076                          ; ***************************************************************************************
  5077                          .vdu31ParamXCoordinate = .vduQueueEndByte - 1
  5078                          .vdu31ParamYCoordinate = .vduQueueEndByte
  5079                          .vdu31EntryPoint
  5080  c787 2088c5                 JSR .isTextCursorActive                             ; set A=0 if text cursor is active; A=$20 if graphics cursor
  5081  c78a d0cc                   BNE .exit2                                          ; if (graphics cursor active) then branch (exit)
  5082  c78c 20a8c7                 JSR +                                               ; exchange text column/line with workspace .vduWorkspaceA/B
  5083  c78f 18                     CLC                                                 ; clear carry
  5084  c790 ad2203                 LDA .vdu31ParamXCoordinate                          ; get X coordinate
  5085  c793 6d0803                 ADC .vduTextWindowLeft                              ; add to text window left
  5086  c796 8d1803                 STA .vduTextCursorXPosition                         ; store as text column
  5087  c799 ad2303                 LDA .vdu31ParamYCoordinate                          ; get Y coordinate
  5088  c79c 18                     CLC                                                 ;
  5089  c79d 6d0b03                 ADC .vduTextWindowTop                               ; add top of text window
  5090  c7a0 8d1903                 STA .vduTextCursorYPosition                         ; current text line
  5091  c7a3 20e8ce                 JSR .validatePositionAndSetupScreenAddress          ; set up screen address
  5092  c7a6 908a                   BCC .setHardwareCursorAddressLocal                  ; if (carry clear, ie. on screen) then branch (set cursor position)
  5093                          +
  5094  c7a8 a218                   LDX #.vduTextCursorXPosition  - .vduVariablesStart  ; point to text cursor position (low byte)
  5095  c7aa a028                   LDY #.vduWorkspaceA - .vduVariablesStart            ; point to vdu workspace (low byte)
  5096  c7ac 4cdecd                 JMP .exchangeTwoVDUBytes                            ; exchange text cursor position with workspace .vduWorkspaceA/B
  5097                          
  5098                          
  5099                          ; ***************************************************************************************
  5100                          ;
  5101                          ;   VDU 13      Carriage Return (.charRETURN)
  5102                          ;
  5103                          ; ***************************************************************************************
  5104                          .vdu13EntryPoint
  5105  c7af 2088c5                 JSR .isTextCursorActive                             ; set A=0 if text cursor is active; A=$20 if graphics cursor
  5106  c7b2 f003                   BEQ +                                               ; if (text cursor active) then branch
  5107  c7b4 4cadcf                 JMP .setGraphicsCursorToLeftHandColumn              ; set graphics cursor to left hand columm
  5108                          +
  5109  c7b7 206ece                 JSR .setTextCursorToLeftHandColumn                  ; set text column to left hand column
  5110  c7ba 4cafc6                 JMP .setCursorSoftwareAndHardwarePosition           ; set cursor position
  5111                          
  5112                          ; ***************************************************************************************
  5113                          .clearGraphicsWindowAndHomeGraphicsCursor
  5114  c7bd 20a6cf                 JSR .graphicsCursorHome                             ; home graphic cursor
  5115                              ; fall through...
  5116                          
  5117                          
  5118                          ; ***************************************************************************************
  5119                          ;
  5120                          ;   VDU 16      Clear graphics window
  5121                          ;
  5122                          ; ***************************************************************************************
  5123                          .vdu16EntryPoint
  5124  c7c0 ad6103                 LDA .vduPixelsPerByteMinusOne                       ; pixels per byte
  5125  c7c3 f033                   BEQ .exitNoGraphics                                 ; if (current MODE has no graphics) then branch (exit)
  5126  c7c5 ae5a03                 LDX .vduBackgroundGraphicsColour                    ; background graphics colour
  5127  c7c8 ac5c03                 LDY .vduBackgroundGCOLMode                          ; background graphics plot mode (GCOL n)
  5128  c7cb 20b3d0                 JSR .setGraphicsColourMaskXY                        ; set graphics byte mask in .vduGraphicsColourByteOR/EOR
  5129  c7ce a200                   LDX #.vduGraphicsWindowPixelsLeftLow - .vduVariablesStart
  5130                                                                                  ; source      = graphics window
  5131  c7d0 a028                   LDY #.vduWorkspaceA - .vduVariablesStart            ; destination = workspace A to H
  5132  c7d2 207cd4                 JSR .copyEightBytesWithinVDUVariables               ; copy graphics window coordinates to workspace
  5133  c7d5 38                     SEC                                                 ; set carry
  5134  c7d6 ad0603                 LDA .vduGraphicsWindowPixelsTopLow                  ; graphics window top low
  5135  c7d9 ed0203                 SBC .vduGraphicsWindowPixelsBottomLow               ; graphics window bottom low
  5136  c7dc a8                     TAY                                                 ; Y=difference
  5137  c7dd c8                     INY                                                 ; increment
  5138  c7de 8c3003                 STY .vduClearGraphicsWindowLineCount                ; and store in workspace (this is line count)
  5139                          -
  5140  c7e1 a22c                   LDX #.vduWorkspaceE - .vduVariablesStart            ; graphics window right column
  5141  c7e3 a028                   LDY #.vduWorkspaceA - .vduVariablesStart            ; graphics window left column
  5142  c7e5 20a6d6                 JSR .fillRow                                        ; fillRow
  5143  c7e8 ad2e03                 LDA .vduWorkspaceG                                  ; decrement window height in pixels
  5144  c7eb d003                   BNE +                                               ;
  5145  c7ed ce2f03                 DEC .vduWorkspaceH                                  ;
  5146                          +
  5147  c7f0 ce2e03                 DEC .vduWorkspaceG                                  ;
  5148  c7f3 ce3003                 DEC .vduClearGraphicsWindowLineCount                ; decrement line count
  5149  c7f6 d0e9                   BNE -                                               ; if (not zero) then branch (do it again)
  5150                          .exitNoGraphics
  5151  c7f8 60                     RTS                                                 ;
  5152                          
  5153                          
  5154                          ; ***************************************************************************************
  5155                          ;
  5156                          ;   VDU 17      Define text colour
  5157                          ;
  5158                          ; The parameter is the logical colour to use as the current text foreground colour. If the
  5159                          ; top bit is set, then the current text background is changed. This is the equivalent of
  5160                          ; BASIC's COLOUR command.
  5161                          ;
  5162                          ; ***************************************************************************************
  5163                          .vdu17EntryPoint
  5164  c7f9 a000                   LDY #0                                              ; Y = 0 (to set text foreground colour)
  5165  c7fb f002                   BEQ .defineTextOrGraphicsColour                     ; ALWAYS branch
  5166                          
  5167                          
  5168                          ; ***************************************************************************************
  5169                          ;
  5170                          ;   VDU 18      Define graphics colour
  5171                          ;
  5172                          ; This sets the current graphics foreground or background colour. It is the equivalent of
  5173                          ; BASIC's GCOL command.
  5174                          ;
  5175                          ; The first parameter is the GCOL mode: 0=Normal, 1=OR, 2=AND, 3=EOR, 4=Invert
  5176                          ;
  5177                          ; This signifies how to modify the colour of pixels that will be drawn in the future. This
  5178                          ; can depend on both the current graphics colour and the colour of the current pixel already
  5179                          ; on screen.
  5180                          ;
  5181                          ; The second parameter:
  5182                          ;
  5183                          ;   bits 0-6 is the logical colour to use.
  5184                          ;   bit 7    set indicates that the current background colour should be set, otherwise
  5185                          ;            the current foreground colour is set.
  5186                          ;
  5187                          ; ***************************************************************************************
  5188                          .vdu18ParameterGCOLNumber           = .vduQueueEndByte-1
  5189                          .vdu18ParameterLogicalColour        = .vduQueueEndByte
  5190                          
  5191                          .vdu18EntryPoint
  5192  c7fd a002                   LDY #2                                              ; Y = 2 (to set graphics foreground colour)
  5193                          
  5194                          .defineTextOrGraphicsColour
  5195  c7ff ad2303                 LDA .vdu18ParameterLogicalColour                    ; get last parameter
  5196  c802 1001                   BPL +                                               ; if (not negative, it's a foreground colour) then branch
  5197  c804 c8                     INY                                                 ; increment y (to set text/graphics background colour)
  5198                          +
  5199  c805 2d6003                 AND .vduNumberOfLogicalColoursMinusOne              ; ensure colour is at most 'number of logical colours less 1'
  5200  c808 85da                   STA .vduTempStoreDA                                 ; store it
  5201  c80a ad6003                 LDA .vduNumberOfLogicalColoursMinusOne              ; number of logical colours less 1
  5202  c80d f01c                   BEQ .exit3                                          ; if (not in a graphics MODE) then branch (exit)
  5203  c80f 2907                   AND #7                                              ; limit to an available colour (and clear M)
  5204  c811 18                     CLC                                                 ; clear carry
  5205  c812 65da                   ADC .vduTempStoreDA                                 ; add last parameter to get pointer to table.
  5206  c814 aa                     TAX                                                 ; X is the offset into the tables of colours.
  5207                                                                                  ; X = (number of logical colours - 1 + logicalColour)
  5208  c815 bd23c4                 LDA .twoColourMODEParameterTable-1,X                ; get plot options from table
  5209  c818 995703                 STA .vduForegroundTextColour,Y                      ; store current colour:
  5210                                                                                  ;
  5211                                                                                  ;       Y=0 means text foreground
  5212                                                                                  ;       Y=1 means text background
  5213                                                                                  ;       Y=2 means graphics foreground
  5214                                                                                  ;       Y=3 means graphics background
  5215  c81b c002                   CPY #2                                              ;
  5216  c81d b00d                   BCS .setGraphicsGCOLColour                          ; if (graphics colour changed) then branch (set graphics colour)
  5217  c81f ad5703                 LDA .vduForegroundTextColour                        ; foreground text colour
  5218  c822 49ff                   EOR #$FF                                            ; invert
  5219  c824 85d3                   STA .vduTextColourByteEOR                           ; text colour byte to EOR-ed into memory
  5220  c826 4d5803                 EOR .vduBackgroundTextColour                        ; background text colour
  5221  c829 85d2                   STA .vduTextColourByteOR                            ; text colour byte to OR-ed into memory
  5222                          .exit3
  5223  c82b 60                     RTS                                                 ;
  5224                          
  5225                          ; ***************************************************************************************
  5226                          .setGraphicsGCOLColour
  5227  c82c ad2203                 LDA .vdu18ParameterGCOLNumber                       ; get first parameter
  5228  c82f 995903                 STA .vduForegroundGraphicsColour,Y                  ; text colour Y=0=foreground; 1=background etc.
  5229  c832 60                     RTS                                                 ;
  5230                          
  5231                          ; ***************************************************************************************
  5232                          .restoreMODE7TextBackgroundColour
  5233  c833 a920                   LDA #32                                             ;
  5234  c835 8d5803                 STA .vduBackgroundTextColour                        ; background text colour
  5235  c838 60                     RTS                                                 ;
  5236                          
  5237                          
  5238                          ; ***************************************************************************************
  5239                          ;
  5240                          ;   VDU 20      Restore default colours
  5241                          ;
  5242                          ; ***************************************************************************************
  5243                          .vdu20EntryPoint
  5244  c839 a205                   LDX #5                                              ; X = 5, loop counter
  5245  c83b a900                   LDA #0                                              ; A = 0
  5246                          -
  5247  c83d 9d5703                 STA .vduForegroundTextColour,X                      ; zero all colours
  5248  c840 ca                     DEX                                                 ;
  5249  c841 10fa                   BPL -                                               ; until X=$FF
  5250  c843 ae6003                 LDX .vduNumberOfLogicalColoursMinusOne              ; number of logical colours less 1
  5251  c846 f0eb                   BEQ .restoreMODE7TextBackgroundColour               ; if (none, it's MODE 7) then branch
  5252  c848 a9ff                   LDA #$FF                                            ; A=$FF
  5253  c84a e00f                   CPX #15                                             ;
  5254  c84c d002                   BNE +                                               ; if (not 16 colours; ie. not MODE 2) then branch
  5255  c84e a93f                   LDA #$3F                                            ; A=$3F
  5256                          +
  5257  c850 8d5703                 STA .vduForegroundTextColour                        ; foreground text colour
  5258  c853 8d5903                 STA .vduForegroundGraphicsColour                    ; foreground graphics colour
  5259  c856 49ff                   EOR #$FF                                            ; invert A
  5260  c858 85d2                   STA .vduTextColourByteOR                            ; text colour byte to be OR-ed into memory
  5261  c85a 85d3                   STA .vduTextColourByteEOR                           ; text colour byte to be EOR-ed into memory
  5262  c85c 8e1f03                 STX .vdu19ParameterLogicalColour                    ; set first parameter of 5
  5263  c85f e003                   CPX #3                                              ;
  5264  c861 f011                   BEQ .restore4Colours                                ; if (there are 4 colours) then branch
  5265  c863 9020                   BCC .restore2Colours                                ; if (there are 2 colours) then branch
  5266                          .restore16Colours                                       ; there are 16 colours
  5267  c865 8e2003                 STX .vdu19ParameterPhysicalColour                   ; set second parameter
  5268                          -
  5269  c868 2092c8                 JSR .vdu19EntryPoint                                ; VDU 19 - define logical colour
  5270  c86b ce2003                 DEC .vdu19ParameterPhysicalColour                   ; decrement first parameter
  5271  c86e ce1f03                 DEC .vdu19ParameterLogicalColour                    ; and last parameter
  5272  c871 10f5                   BPL -                                               ;
  5273  c873 60                     RTS                                                 ;
  5274                          
  5275                          .restore4Colours
  5276  c874 a207                   LDX #7                                              ; X = 7
  5277  c876 8e2003                 STX .vdu19ParameterPhysicalColour                   ; set first parameter
  5278                          -
  5279  c879 2092c8                 JSR .vdu19EntryPoint                                ; and do VDU 19
  5280  c87c 4e2003                 LSR .vdu19ParameterPhysicalColour                   ;
  5281  c87f ce1f03                 DEC .vdu19ParameterLogicalColour                    ;
  5282  c882 10f5                   BPL -                                               ;
  5283  c884 60                     RTS                                                 ;
  5284                          
  5285                          .restore2Colours
  5286  c885 a207                   LDX #7                                              ; X = 7
  5287  c887 208fc8                 JSR +                                               ; store physical colour and execute VDU 19
  5288  c88a a200                   LDX #0                                              ; X = 0
  5289  c88c 8e1f03                 STX .vdu19ParameterLogicalColour                    ; store it as
  5290                          +
  5291  c88f 8e2003                 STX .vdu19ParameterPhysicalColour                   ; both parameters
  5292                              ; fall through...
  5293                          
  5294                          
  5295                          ; ***************************************************************************************
  5296                          ;
  5297                          ;   VDU 19      Write palette
  5298                          ;
  5299                          ; Map a logical colour to a physical colour
  5300                          ;
  5301                          ;               VDU 19,logical colour,physics colour,0,0,0
  5302                          ;
  5303                          ; Logical colours are numbers stored in memory to represent a colour. Logical colours are
  5304                          ; in the range 0-15.
  5305                          ;
  5306                          ; Physical colours are numbers that represent actual colours:
  5307                          ;
  5308                          ;                 0 = black             8 = flashing black-white
  5309                          ;                 1 = red               9 = flashing red-cyan
  5310                          ;                 2 = green            10 = flashing green-magenta
  5311                          ;                 3 = yellow           11 = flashing yellow-blue
  5312                          ;                 4 = blue             12 = flashing blue-yellow
  5313                          ;                 5 = magenta          13 = flashing magenta-green
  5314                          ;                 6 = cyan             14 = flashing cyan-red
  5315                          ;                 7 = white            15 = flashing white-black
  5316                          ;
  5317                          ; The palette defines which physical colour is displayed for each logical colour.
  5318                          ; The Video ULA hardware stores and manages this palette information.
  5319                          ;
  5320                          ; Flashing colours
  5321                          ; ----------------
  5322                          ; The OS (in the vertical sync interrupt) updates timers to know when to change the current
  5323                          ; appearance of flashing colours. When it's time, the OS signals the VideoULA to flip the
  5324                          ; flashing bit, thereby changing the current appearance.
  5325                          ;
  5326                          ; ***************************************************************************************
  5327                          .vdu19ParameterLogicalColour  = $031F
  5328                          .vdu19ParameterPhysicalColour = $0320
  5329                          
  5330                          .vdu19EntryPoint
  5331  c892 08                     PHP                                                 ; push flags
  5332  c893 78                     SEI                                                 ; disable interrupts
  5333  c894 ad1f03                 LDA .vdu19ParameterLogicalColour                    ; get logical colour
  5334  c897 2d6003                 AND .vduNumberOfLogicalColoursMinusOne              ; AND with number of logical colours
  5335                                                                                  ; less 1 to make legal.
  5336  c89a aa                     TAX                                                 ; store logical colour in X
  5337  c89b ad2003                 LDA .vdu19ParameterPhysicalColour                   ; A=physical colour
  5338                          .writePaletteAX
  5339  c89e 290f                   AND #15                                             ; make legal
  5340  c8a0 9d6f03                 STA .vduColourPaletteStart,X                        ; store physical in colour palette
  5341  c8a3 a8                     TAY                                                 ; remember physical colour in Y
  5342  c8a4 ad6003                 LDA .vduNumberOfLogicalColoursMinusOne              ; number of logical colours less 1
  5343  c8a7 85fa                   STA .tempStoreFA                                    ; store it
  5344  c8a9 c903                   CMP #3                                              ; is it a 4 colour MODE?
  5345  c8ab 08                     PHP                                                 ; save flags
  5346  c8ac 8a                     TXA                                                 ; recall A = logical colour
  5347                          -
  5348  c8ad 6a                     ROR                                                 ; rotate the logical colour (A) into
  5349                                                                                  ; the top bits of .tempStoreFA
  5350  c8ae 66fa                   ROR .tempStoreFA                                    ; rotate the (number of colours
  5351                                                                                  ; in the MODE-1) down by one bit
  5352  c8b0 b0fb                   BCS -                                               ; if (there are more set bits) then
  5353                                                                                  ; branch (loop back)
  5354  c8b2 06fa                   ASL .tempStoreFA                                    ; the final rotate wasn't needed,
  5355                                                                                  ; so shift left to rectify
  5356                                                                                  ; at this point .tempStoreFA holds
  5357                                                                                  ; the logical colour in the top N bits
  5358                                                                                  ; where N is the number of bits
  5359                                                                                  ; required to store a colour in
  5360                                                                                  ; the current MODE.
  5361  c8b4 98                     TYA                                                 ; recall physical colour
  5362  c8b5 05fa                   ORA .tempStoreFA                                    ; OR in the physical colour into
  5363                                                                                  ; the bottom bits
  5364  c8b7 aa                     TAX                                                 ; store value in X. This is working
  5365                                                                                  ; towards being the value to send to
  5366                                                                                  ; the palette register on the Video ULA.
  5367  c8b8 a000                   LDY #0                                              ; Y=0
  5368                          -
  5369  c8ba 28                     PLP                                                 ; recall flags
  5370  c8bb 08                     PHP                                                 ; store flags
  5371  c8bc d00e                   BNE .notFourColourMODE                              ; if (not a four colour MODE, i.e.
  5372                                                                                  ; A !=3 earlier) then branch
  5373                          
  5374                              ; deal with four colour MODEs
  5375  c8be 2960                   AND #%01100000                                      ; Test bits 5 and 6
  5376  c8c0 f009                   BEQ +                                               ; if (both bit are clear) then branch
  5377  c8c2 c960                   CMP #%01100000                                      ;
  5378  c8c4 f005                   BEQ +                                               ; if (both bits are set) then branch
  5379  c8c6 8a                     TXA                                                 ; recall X value.
  5380  c8c7 4960                   EOR #%01100000                                      ; invert bits 5 and 6 (one of which
  5381                                                                                  ; is set and the other clear).
  5382  c8c9 d001                   BNE .notFourColourMODE                              ; ALWAYS branch. A = value to send
  5383                                                                                  ; to palette register of the Video ULA.
  5384                          
  5385                          +
  5386  c8cb 8a                     TXA                                                 ; X=A
  5387                          .notFourColourMODE
  5388  c8cc 2011ea                 JSR .osbyte155Internal                              ; pass data to palette register
  5389  c8cf 98                     TYA                                                 ;
  5390  c8d0 38                     SEC                                                 ;
  5391  c8d1 6d6003                 ADC .vduNumberOfLogicalColoursMinusOne              ;
  5392  c8d4 a8                     TAY                                                 ; Y = Y + number of logical colours - 1
  5393  c8d5 8a                     TXA                                                 ;
  5394  c8d6 6910                   ADC #16                                             ;
  5395  c8d8 aa                     TAX                                                 ; X = X + 16
  5396  c8d9 c010                   CPY #16                                             ;
  5397  c8db 90dd                   BCC -                                               ; if (Y < 16) then branch (loop back)
  5398  c8dd 28                     PLP                                                 ; pull flags twice
  5399  c8de 28                     PLP                                                 ;
  5400  c8df 60                     RTS                                                 ;
  5401                          
  5402                          
  5403                          ; ***************************************************************************************
  5404                          ;
  5405                          ;   OSWORD 12 - Write Palette
  5406                          ;
  5407                          ; On Entry:
  5408                          ;   .oswordX/Y is the address of the five bytes of parameters:
  5409                          ;       byte 0: logical colour
  5410                          ;       byte 1: physical colour
  5411                          ;       byte 2: zero
  5412                          ;       byte 3: zero
  5413                          ;       byte 4: zero
  5414                          ;
  5415                          ; ***************************************************************************************
  5416                          .osword12EntryPoint
  5417  c8e0 08                     PHP                                                 ; push flags
  5418  c8e1 2d6003                 AND .vduNumberOfLogicalColoursMinusOne              ; and with number of logical colours less 1
  5419  c8e4 aa                     TAX                                                 ; X=A
  5420  c8e5 c8                     INY                                                 ; Y=Y+1
  5421  c8e6 b1f0                   LDA (.oswordX),Y                                    ; get physical colour
  5422  c8e8 4c9ec8                 JMP .writePaletteAX                                 ; do VDU19 with parameters in X and A
  5423                          
  5424                          
  5425                          ; ***************************************************************************************
  5426                          ;
  5427                          ;   VDU 22      Select MODE
  5428                          ;
  5429                          ; ***************************************************************************************
  5430                          .vdu22Parameter = .vduQueueEndByte
  5431                          
  5432                          .vdu22EntryPoint
  5433  c8eb ad2303                 LDA .vdu22Parameter                                 ; get parameter
  5434  c8ee 4c33cb                 JMP .setMODE                                        ; change MODE
  5435                          
  5436                          
  5437                          ; ***************************************************************************************
  5438                          ;
  5439                          ;   VDU 23      Define Character
  5440                          ;
  5441                          ; See guide.png
  5442                          ;
  5443                          ; On Entry:
  5444                          ;   A = 0 sets CRTC 6845 register:
  5445                          ;       VDU 23,0,R,X,0,0,0,0,0,0 - program CRTC register R with value V
  5446                          ;       See Chapter 3 section 'CRTC registers'
  5447                          ;   A = 1 turns the cursor on or off:
  5448                          ;       VDU 23,1,0,0,0,0,0,0,0,0 - turn cursor off
  5449                          ;       VDU 23,1,1,0,0,0,0,0,0,0 - turn cursor on
  5450                          ;   A = 32-255 means define character
  5451                          ;
  5452                          ; ***************************************************************************************
  5453                          .vdu23ParameterLogicalColour = .vduQueueStartByte
  5454                          .vdu23Parameter1 = .vduQueueEndByte - 8
  5455                          .vdu23Parameter2 = .vduQueueEndByte - 7
  5456                          .vdu23Parameter3 = .vduQueueEndByte - 6
  5457                          .vdu23Parameter4 = .vduQueueEndByte - 5
  5458                          .vdu23Parameter5 = .vduQueueEndByte - 4
  5459                          .vdu23Parameter6 = .vduQueueEndByte - 3
  5460                          .vdu23Parameter7 = .vduQueueEndByte - 2
  5461                          .vdu23Parameter8 = .vduQueueEndByte - 1
  5462                          .vdu23Parameter9 = .vduQueueEndByte
  5463                          
  5464                          .vdu23EntryPoint
  5465  c8f1 ad1b03                 LDA .vdu23ParameterLogicalColour                    ; get character to define
  5466  c8f4 c920                   CMP #.charSPACE                                     ;
  5467  c8f6 9047                   BCC .vdu23SetCRTCRegisterOrCursorVisibility         ; if (less then SPACE) then branch
  5468                                                                                  ; (it is an instruction to set a CRT
  5469                                                                                  ; register or cursor visibility)
  5470  c8f8 48                     PHA                                                 ; save parameter
  5471  c8f9 4a                     LSR                                                 ; A = A / 32
  5472  c8fa 4a                     LSR                                                 ;
  5473  c8fb 4a                     LSR                                                 ;
  5474  c8fc 4a                     LSR                                                 ;
  5475  c8fd 4a                     LSR                                                 ;
  5476  c8fe aa                     TAX                                                 ; store font zone (1-7) in X
  5477  c8ff bd0dc4                 LDA .fontMaskTable,X                                ; look up single bit representing
  5478                                                                                  ; the font zone (character / 32)
  5479  c902 2c6703                 BIT .vduFontFlags                                   ; font flag
  5480  c905 d020                   BNE +                                               ; if (not zero) then branch (storage
  5481                                                                                  ; area is established already)
  5482  c907 0d6703                 ORA .vduFontFlags                                   ; OR with font flag to set bit
  5483                                                                                  ; found to be 0
  5484  c90a 8d6703                 STA .vduFontFlags                                   ; font flag
  5485  c90d 8a                     TXA                                                 ; get back font zone (1-7)
  5486  c90e 2903                   AND #3                                              ; AND with 3 to clear all but bits
  5487                                                                                  ; 0 and 1 (A = 1, 2, 3)
  5488  c910 18                     CLC                                                 ;
  5489  c911 69bf                   ADC #>.characterDefinitions - 1                     ; A=$C0, $C1, $C2 to select a
  5490                                                                                  ; character page in ROM
  5491  c913 85df                   STA .vduTempStoreDF                                 ; store it in the high byte
  5492  c915 bd6703                 LDA .vduFontZoneAddressesHigh1 - 1,X                ; get font address (high byte)
  5493  c918 85dd                   STA .vduTempStoreDD                                 ; store it in the high byte
  5494  c91a a000                   LDY #0                                              ;
  5495  c91c 84dc                   STY .vduTempStoreDC                                 ; store zero in the low bytes
  5496  c91e 84de                   STY .vduTempStoreDE                                 ;
  5497                          -
  5498  c920 b1de                   LDA (.vduTempStoreDE),Y                             ; copy character definition
  5499  c922 91dc                   STA (.vduTempStoreDC),Y                             ;
  5500  c924 88                     DEY                                                 ;
  5501  c925 d0f9                   BNE -                                               ;
  5502                          +
  5503  c927 68                     PLA                                                 ; get back A
  5504  c928 203ed0                 JSR .getCharacterDefinitionAddress                  ; set up character definition pointers
  5505  c92b a007                   LDY #7                                              ; Y=loop counter
  5506                          -
  5507  c92d b91c03                 LDA .vdu23Parameter2,Y                              ; transfer definition parameters
  5508  c930 91de                   STA (.vduTempStoreDE),Y                             ; to RAM definition
  5509  c932 88                     DEY                                                 ;
  5510  c933 10f8                   BPL -                                               ;
  5511  c935 60                     RTS                                                 ;
  5512                          
  5513  c936 68                     PLA                                                 ; [unused. Was used in MOS 0.92]
  5514                          
  5515                          .exit4
  5516  c937 60                     RTS                                                 ;
  5517                          
  5518                          ; ***************************************************************************************
  5519                          ;
  5520                          ; Plot extension
  5521                          ;
  5522                          ; If calling VDU 25 (PLOT) in a non-graphics mode, or using a plot type that is reserved
  5523                          ; for future expansion, then this routine is called. It calls the VDUV vector which allows
  5524                          ; user programs or Paged ROMs to intercept the call and provide new functionality.
  5525                          ;
  5526                          ; ***************************************************************************************
  5527                          .vduPlotExtension
  5528  c938 ad1f03                 LDA .vdu25Parameter5                                ; A = fifth VDU parameter
  5529  c93b 18                     CLC                                                 ; clear carry
  5530                          -
  5531  c93c 6c2602                 JMP (.vectorVDUV)                                   ; jump via VDUV vector
  5532                          
  5533                          ; ***************************************************************************************
  5534                          ;
  5535                          ; VDU 23 with 0-31 as the next byte
  5536                          ;
  5537                          ; VDU 23,0      - set CRTC Register
  5538                          ; VDU 23,1      - turn cursor on or off
  5539                          ; VDU 23,2-31   - call VDUV extension vector
  5540                          ;
  5541                          ; ***************************************************************************************
  5542                          .vdu23SetCRTCRegisterOrCursorVisibility
  5543  c93f c901                   CMP #1                                              ; does A=1
  5544  c941 9015                   BCC .vdu23CommaZeroSetCRTCRegister                  ; if (A = 0) then branch (set CRTC register)
  5545  c943 d0f7                   BNE -                                               ; if (A != 1) then branch (to VDUV vector)
  5546  c945 2088c5                 JSR .isTextCursorActive                             ; set A=0 if text cursor is active; A=$20 if graphics cursor
  5547  c948 d0ed                   BNE .exit4                                          ; if (graphics cursor is active) then branch (exit)
  5548                          
  5549                              ; handle text cursor...
  5550  c94a a920                   LDA #32                                             ;
  5551  c94c ac1c03                 LDY .vdu23Parameter2                                ; Y = second VDU parameter
  5552  c94f f003                   BEQ .setCursorOnOrOff                               ; if (Y=0) then branch (turn cursor off)
  5553                          
  5554                          .setTextCursor
  5555  c951 ad5f03                 LDA .vduLastCursorStartRegisterValue                ; get last setting of CRTC register
  5556                          
  5557                          .setCursorOnOrOff
  5558  c954 a00a                   LDY #.crtcCursorStartRegister                       ; Y = .crtcCursorStartRegister
  5559  c956 d02d                   BNE .setCRTCRegisterDirect                          ; ALWAYS branch
  5560                          
  5561                          ; ***************************************************************************************
  5562                          .vdu23CommaZeroSetCRTCRegister
  5563  c958 ad1d03                 LDA .vdu23Parameter3                                ; get third parameter (value to write)
  5564  c95b ac1c03                 LDY .vdu23Parameter2                                ; get second parameter (CRTC register to set)
  5565                          .setCRTCRegisterAY
  5566  c95e c007                   CPY #.crtcVerticalSyncPositionRegister              ;
  5567  c960 9023                   BCC .setCRTCRegisterDirect                          ; if (Y < 7) then set register Y with value A directly
  5568  c962 d003                   BNE +                                               ; if (Y > 7) branch
  5569                          
  5570                              ; deal with vertical sync position register
  5571  c964 6d9002                 ADC .vduVerticalAdjust                              ; add screen vertical display
  5572                                                                                  ; adjustment + 1 (carry set)
  5573                          +
  5574  c967 c008                   CPY #.crtcInterlaceAndDelayRegister                 ;
  5575  c969 d007                   BNE +                                               ; if (Y != 8) then branch
  5576                          
  5577                              ; deal with interlace and delay register
  5578  c96b 0900                   ORA #0                                              ; test if bit 7 set
  5579  c96d 3003                   BMI +                                               ; if (bit 7 set) then branch
  5580  c96f 4d9102                 EOR .vduInterlaceValue                              ; set interlace value (0 or 1)
  5581                          
  5582                          +
  5583  c972 c00a                   CPY #.crtcCursorStartRegister                       ;
  5584  c974 d00f                   BNE .setCRTCRegisterDirect                          ; if (Y != 10) then branch - set register Y with value A directly
  5585                          
  5586                              ; deal with cursor start register
  5587  c976 8d5f03                 STA .vduLastCursorStartRegisterValue                ; last setting of CRTC register
  5588  c979 a8                     TAY                                                 ; Y=A
  5589  c97a a5d0                   LDA .vduStatusByte                                  ; VDU status byte
  5590  c97c 2920                   AND #%00100000                                      ; check bit 5 (print at graphics cursor)
  5591  c97e 08                     PHP                                                 ; push flags
  5592  c97f 98                     TYA                                                 ; A = value to set
  5593  c980 a00a                   LDY #.crtcCursorStartRegister                       ; Y=10
  5594  c982 28                     PLP                                                 ; pull flags
  5595  c983 d006                   BNE +                                               ; if (graphics cursor is active) then branch (return)
  5596                              ; fall through...
  5597                          
  5598                          ; ***************************************************************************************
  5599                          .setCRTCRegisterDirect
  5600  c985 8c00fe                 STY .crtcAddressRegister                            ; Y is which CRTC register to write to
  5601  c988 8d01fe                 STA .crtcAddressWrite                               ; write value A into register Y
  5602                          +
  5603  c98b 60                     RTS                                                 ;
  5604                          
  5605                          
  5606                          ; ***************************************************************************************
  5607                          ;
  5608                          ;   VDU 25      Plot
  5609                          ;
  5610                          ; ***************************************************************************************
  5611                          .vdu25Parameter5 = $031F
  5612                          .vdu25EntryPoint
  5613  c98c ae6103                 LDX .vduPixelsPerByteMinusOne                       ; get pixels per byte
  5614  c98f f0a7                   BEQ .vduPlotExtension                               ; if (zero, i.e. no graphics available) then branch (plot extension)
  5615  c991 4c60d0                 JMP .vdu25Plot                                      ; jump to main plot routine
  5616                          
  5617                          ; ***************************************************************************************
  5618                          ;
  5619                          ; Hardware screen scroll up/down
  5620                          ;
  5621                          ; Changes the start address of the display
  5622                          ;
  5623                          ; ***************************************************************************************
  5624                          .hardwareScrollDown
  5625  c994 ae5003                 LDX .vduScreenTopLeftAddressLow                     ; screen top left address low
  5626  c997 ad5103                 LDA .vduScreenTopLeftAddressHigh                    ; screen top left address high
  5627  c99a 20f8cc                 JSR .subtractNumberOfBytesInARowFromAX              ; subtract bytes per character row from this
  5628  c99d b014                   BCS +                                               ; if (no wraparound needed) then branch
  5629                          
  5630  c99f 6d5403                 ADC .vduScreenSizeHighByte                          ; screen RAM size high byte to wrap around
  5631  c9a2 900f                   BCC +                                               ;
  5632                          
  5633                          .hardwareScrollUp
  5634  c9a4 ae5003                 LDX .vduScreenTopLeftAddressLow                     ; screen top left address low
  5635  c9a7 ad5103                 LDA .vduScreenTopLeftAddressHigh                    ; screen top left address high
  5636  c9aa 20d4ca                 JSR .addNumberOfBytesInACharacterRowToAX            ; add bytes per character row
  5637  c9ad 1004                   BPL +                                               ;
  5638                          
  5639  c9af 38                     SEC                                                 ; wrap around
  5640  c9b0 ed5403                 SBC .vduScreenSizeHighByte                          ; screen RAM size high byte
  5641                          +
  5642  c9b3 8d5103                 STA .vduScreenTopLeftAddressHigh                    ; screen top left address high
  5643  c9b6 8e5003                 STX .vduScreenTopLeftAddressLow                     ; screen top left address low
  5644  c9b9 a00c                   LDY #.crtcStartScreenAddressHighRegister            ; Y = value to change screen address
  5645  c9bb d051                   BNE .setHardwareScreenOrCursorAddress               ; ALWAYS branch to set screen address
  5646                          
  5647                          
  5648                          ; ***************************************************************************************
  5649                          ;
  5650                          ;   VDU 26      Reset to default windows
  5651                          ;
  5652                          ; ***************************************************************************************
  5653                          .vdu26EntryPoint
  5654  c9bd a900                   LDA #0                                              ; A=0
  5655  c9bf a22c                   LDX #.vduWorkspaceE - .vduVariablesStart            ; X=loop counter
  5656                          -
  5657  c9c1 9d0003                 STA .vduVariablesStart,X                            ; zero a whole bunch of vdu variables,
  5658  c9c4 ca                     DEX                                                 ; including the text and graphics
  5659  c9c5 10fa                   BPL -                                               ; windows
  5660                          
  5661                              ; use data for current screen mode
  5662  c9c7 ae5503                 LDX .vduCurrentScreenMODE                           ; screen MODE
  5663                          
  5664                              ; reset text window
  5665  c9ca bcefc3                 LDY .textWindowRightColumnTable,X                   ; text window right edge maximum
  5666  c9cd 8c0a03                 STY .vduTextWindowRight                             ; store in the text window right
  5667  c9d0 2088ca                 JSR .calculateBytesPerTextWindowRow                 ; calculate number of bytes in a text
  5668                                                                                  ; window row
  5669  c9d3 bce7c3                 LDY .textWindowBottomRowTable,X                     ; text window bottom edge maximum
  5670  c9d6 8c0903                 STY .vduTextWindowBottom                            ; bottom edge
  5671                          
  5672                              ; reset graphics window
  5673  c9d9 a003                   LDY #3                                              ;
  5674  c9db 8c2303                 STY .vdu24ParameterTopEdgeHigh                      ; top edge high byte    = 3
  5675  c9de c8                     INY                                                 ; Y = 4
  5676  c9df 8c2103                 STY .vdu24ParameterRightEdgeHigh                    ; right edge high byte  = 4
  5677  c9e2 ce2203                 DEC .vdu24ParameterTopEdgeLow                       ; top edge low          = $FF
  5678  c9e5 ce2003                 DEC .vdu24ParameterRightEdgeLow                     ; right edge low        = $FF
  5679                                                                                  ;
  5680                                                                                  ; so now top edge = $03FF = 1023
  5681                                                                                  ; and right edge  = $04FF = 1279
  5682                                                                                  ;
  5683  c9e8 2039ca                 JSR .vdu24EntryPoint                                ; do VDU 24 (define graphics
  5684                                                                                  ; window)
  5685                          
  5686                              ; reset scrolling
  5687  c9eb a9f7                   LDA #%11110111                                      ; }
  5688  c9ed 20a8c5                 JSR .clearVDUStatusByteFlags                        ; } clear bit 3 of .vduStatusByte
  5689  c9f0 ae5003                 LDX .vduScreenTopLeftAddressLow                     ; screen start address low
  5690  c9f3 ad5103                 LDA .vduScreenTopLeftAddressHigh                    ; screen start address high
  5691                          
  5692                              ; reset cursor
  5693                          .setTextCursorCRTCAddress
  5694  c9f6 8e4a03                 STX .vduTextCursorCRTCAddressLow                    ; text cursor CRTC address
  5695  c9f9 8d4b03                 STA .vduTextCursorCRTCAddressHigh                   ; text cursor CRTC address
  5696  c9fc 1004                   BPL .setHardwareCursorAddress                       ; set cursor position
  5697  c9fe 38                     SEC                                                 ; }
  5698  c9ff ed5403                 SBC .vduScreenSizeHighByte                          ; } screen RAM size high byte
  5699                              ; fall through...
  5700                          
  5701                          ; ***************************************************************************************
  5702                          ;
  5703                          ; Set cursor screen address
  5704                          ;
  5705                          ; On Entry:
  5706                          ;       AX holds the screen address
  5707                          ;
  5708                          ; ***************************************************************************************
  5709                          .setHardwareCursorAddress
  5710  ca02 86d8                   STX .vduWriteCursorScreenAddressLow                 ; set screen address of cursor from AX
  5711  ca04 85d9                   STA .vduWriteCursorScreenAddressHigh                ;
  5712  ca06 ae4a03                 LDX .vduTextCursorCRTCAddressLow                    ; text cursor CRTC address
  5713  ca09 ad4b03                 LDA .vduTextCursorCRTCAddressHigh                   ; text cursor CRTC address
  5714  ca0c a00e                   LDY #.crtcCursorPositionHighRegister                ; Y=14
  5715                              ; fall through...
  5716                          
  5717                          ; ***************************************************************************************
  5718                          ;
  5719                          ; Set hardware screen or cursor address
  5720                          ;
  5721                          ; On Entry:
  5722                          ;       The screen address or cursor position address is in AX
  5723                          ;       Y holds either .crtcCursorPositionHighRegister to change the cursor position
  5724                          ;                   or .crtcStartScreenAddressHighRegister to change the screen address
  5725                          ; ***************************************************************************************
  5726                          .setHardwareScreenOrCursorAddress
  5727  ca0e 48                     PHA                                                 ; store A
  5728  ca0f ad5503                 LDA .vduCurrentScreenMODE                           ; screen MODE
  5729  ca12 c907                   CMP #7                                              ; is it MODE 7?
  5730  ca14 68                     PLA                                                 ; restore A
  5731  ca15 b010                   BCS .setCursorPositionMODE7                         ; if (MODE 7 selected) then branch
  5732  ca17 86da                   STX .vduTempStoreDA                                 ; store X
  5733  ca19 4a                     LSR                                                 ; divide X/A by 8
  5734  ca1a 66da                   ROR .vduTempStoreDA                                 ;
  5735  ca1c 4a                     LSR                                                 ;
  5736  ca1d 66da                   ROR .vduTempStoreDA                                 ;
  5737  ca1f 4a                     LSR                                                 ;
  5738  ca20 66da                   ROR .vduTempStoreDA                                 ;
  5739  ca22 a6da                   LDX .vduTempStoreDA                                 ;
  5740  ca24 4c2bca                 JMP .setTwoCRTCRegisters                            ; set cursor position AX
  5741                          
  5742                          .setCursorPositionMODE7
  5743  ca27 e974                   SBC #$74                                            ; MODE 7 subtract $74
  5744  ca29 4920                   EOR #$20                                            ; EOR with $20 (See NAUG Section
  5745                                                                                  ; 13.3.11 - MODE 7 scrolling,
  5746                                                                                  ; Page 200)
  5747                              ; fall through...
  5748                          
  5749                          ; ***************************************************************************************
  5750                          ;
  5751                          ; Write to two sequential registers on the CRTC
  5752                          ;
  5753                          ; On Entry:
  5754                          ;       Y = register number
  5755                          ;       A = First value to write (to register Y)
  5756                          ;       X = Second value to write (to register Y+1)
  5757                          ;
  5758                          ; ***************************************************************************************
  5759                          .setTwoCRTCRegisters
  5760  ca2b 8c00fe                 STY .crtcAddressRegister                            ; set which CRTC register to write into
  5761  ca2e 8d01fe                 STA .crtcAddressWrite                               ; write A into CRTC register
  5762  ca31 c8                     INY                                                 ; increment Y to the next CRTC register
  5763  ca32 8c00fe                 STY .crtcAddressRegister                            ; set which CRTC register to write into
  5764  ca35 8e01fe                 STX .crtcAddressWrite                               ; write X into CRTC register
  5765  ca38 60                     RTS                                                 ;
  5766                          
  5767                          
  5768                          ; ***************************************************************************************
  5769                          ;
  5770                          ;   VDU 24      Define graphics window
  5771                          ;
  5772                          ; ***************************************************************************************
  5773                          .vdu24ParameterLeftEdgeLow      = .vduQueueEndByte - 7
  5774                          .vdu24ParameterLeftEdgeHigh     = .vduQueueEndByte - 6
  5775                          .vdu24ParameterBottomEdgeLow    = .vduQueueEndByte - 5
  5776                          .vdu24ParameterBottomEdgeHigh   = .vduQueueEndByte - 4
  5777                          .vdu24ParameterRightEdgeLow     = .vduQueueEndByte - 3
  5778                          .vdu24ParameterRightEdgeHigh    = .vduQueueEndByte - 2
  5779                          .vdu24ParameterTopEdgeLow       = .vduQueueEndByte - 1
  5780                          .vdu24ParameterTopEdgeHigh      = .vduQueueEndByte
  5781                          
  5782                          .vdu24EntryPoint
  5783  ca39 2081ca                 JSR .exchangeGraphicsCursorPositionWithWorkspaceABCD    ; exchange graphics cursor position with .vduWorkspaceABCD
  5784                                                                                      ; will swap them back at the end
  5785  ca3c a21c                   LDX #.vdu24ParameterLeftEdgeLow - .vduVariablesStart    ; src = parameters
  5786  ca3e a02c                   LDY #.vduWorkspaceE - .vduVariablesStart                ; dest = Workspace EFGH
  5787  ca40 2011d4                 JSR .coordinateSubtraction                              ; EFGH = (width = right - left,
  5788                                                                                      ;         height = top - bottom)
  5789                                                                                      ; Accumulator = height (high byte)
  5790  ca43 0d2d03                 ORA .vduWorkspaceF                                      ; OR with high byte of width
  5791  ca46 3039                   BMI .exchangeGraphicsCursorPositionWithWorkspaceABCD    ; if (either width or height is negative) then branch (to exchange back and exit)
  5792  ca48 a220                   LDX #.vdu24ParameterRightEdgeLow - .vduVariablesStart   ; point X to right edge low
  5793  ca4a 2049d1                 JSR .plotConvertExternalAbsoluteCoordinatesToPixels     ; scale pointers to MODE
  5794  ca4d a21c                   LDX #.vdu24ParameterLeftEdgeLow - .vduVariablesStart    ; point X to left edge low
  5795  ca4f 2049d1                 JSR .plotConvertExternalAbsoluteCoordinatesToPixels     ; scale pointers to MODE
  5796  ca52 ad1f03                 LDA .vdu24ParameterBottomEdgeHigh                       ; check for negative edges
  5797  ca55 0d1d03                 ORA .vdu24ParameterLeftEdgeHigh                         ;
  5798  ca58 3027                   BMI .exchangeGraphicsCursorPositionWithWorkspaceABCD    ; if (negative) then branch (to exchange back and exit)
  5799  ca5a ad2303                 LDA .vdu24ParameterTopEdgeHigh                          ;
  5800  ca5d d022                   BNE .exchangeGraphicsCursorPositionWithWorkspaceABCD    ; if (non zero) then branch (to exchange back and exit)
  5801  ca5f ae5503                 LDX .vduCurrentScreenMODE                               ; get screen MODE
  5802  ca62 ad2103                 LDA .vdu24ParameterRightEdgeHigh                        ; right edge high
  5803  ca65 85da                   STA .vduTempStoreDA                                     ; store it
  5804  ca67 ad2003                 LDA .vdu24ParameterRightEdgeLow                         ; right edge low
  5805  ca6a 46da                   LSR .vduTempStoreDA                                     ;
  5806  ca6c 6a                     ROR                                                     ;
  5807  ca6d 46da                   LSR .vduTempStoreDA                                     ;
  5808  ca6f d010                   BNE .exchangeGraphicsCursorPositionWithWorkspaceABCD    ; if (negative) then branch (to exchange back and exit)
  5809  ca71 6a                     ROR                                                     ;
  5810  ca72 4a                     LSR                                                     ;
  5811  ca73 ddefc3                 CMP .textWindowRightColumnTable,X                       ; compare with text window right hand edge maximum
  5812  ca76 f002                   BEQ +                                                   ; if (equal) then branch
  5813  ca78 1007                   BPL .exchangeGraphicsCursorPositionWithWorkspaceABCD    ; if (non-negative) then branch (to exchange back and exit)
  5814                          +
  5815  ca7a a000                   LDY #.vduGraphicsWindowPixelsLeftLow - .vduVariablesStart ; destination = graphics window extents
  5816  ca7c a21c                   LDX #.vdu24ParameterLeftEdgeLow - .vduVariablesStart    ; source = parameters
  5817  ca7e 207cd4                 JSR .copyEightBytesWithinVDUVariables                   ; copy source to destination
  5818                              ; fall through...
  5819                          
  5820                          ; ***************************************************************************************
  5821                          .exchangeGraphicsCursorPositionWithWorkspaceABCD
  5822  ca81 a210                   LDX #.vduGraphicsCursorPositionXLow - .vduVariablesStart
  5823                                                                                  ; } swap graphics cursor
  5824  ca83 a028                   LDY #.vduWorkspaceA - .vduVariablesStart            ; } position with Workspace
  5825  ca85 4ce6cd                 JMP .exchangeFourBytes                              ; } ABCD
  5826                          
  5827                          ; ***************************************************************************************
  5828                          .calculateBytesPerTextWindowRow
  5829  ca88 c8                     INY                                                 ; }
  5830  ca89 98                     TYA                                                 ; } A = Y + 1
  5831  ca8a a000                   LDY #0                                              ; Y=0
  5832  ca8c 8c4d03                 STY .vduTextWindowWidthInBytesHigh                  ; text window width high (bytes)
  5833  ca8f 8d4c03                 STA .vduTextWindowWidthInBytesLow                   ; text window width low (bytes)
  5834  ca92 ad4f03                 LDA .vduBytesPerCharacter                           ; bytes per character
  5835  ca95 4a                     LSR                                                 ; divide by 2
  5836  ca96 f009                   BEQ +                                               ; if (zero) then branch (exit)
  5837                          -
  5838  ca98 0e4c03                 ASL .vduTextWindowWidthInBytesLow                   ; text window width low (bytes)
  5839  ca9b 2e4d03                 ROL .vduTextWindowWidthInBytesHigh                  ; text window width high (bytes)
  5840  ca9e 4a                     LSR                                                 ; divide by 2
  5841  ca9f 90f7                   BCC -                                               ; if (carry clear) then branch (loop back)
  5842                          +
  5843  caa1 60                     RTS                                                 ;
  5844                          
  5845                          
  5846                          ; ***************************************************************************************
  5847                          ;
  5848                          ;   VDU 29      Set graphics origin
  5849                          ;
  5850                          ; ***************************************************************************************
  5851                          .vdu29ParameterStart = $320
  5852                          
  5853                          .vdu29EntryPoint
  5854  caa2 a220                   LDX #.vdu29ParameterStart - .vduVariablesStart          ; } copy the four bytes from the
  5855  caa4 a00c                   LDY #.vduGraphicsWindowOriginXLow - .vduVariablesStart  ; } vdu queue parameters to the
  5856  caa6 208ad4                 JSR .copyFourBytesWithinVDUVariables                    ; } current graphics origin
  5857  caa9 4cb8d1                 JMP .convertPixelGraphicsCoordinatesToExternal          ; set up external coordinates for graphics
  5858                          
  5859                          
  5860                          ; ***************************************************************************************
  5861                          ;
  5862                          ;   VDU 127     Delete
  5863                          ;
  5864                          ; ***************************************************************************************
  5865                          .vdu127EntryPoint
  5866  caac 20c5c5                 JSR .vdu8EntryPoint                                 ; cursor left
  5867  caaf 2088c5                 JSR .isTextCursorActive                             ; set A=0 if text cursor is active
  5868                                                                                  ;  or A=$20 if graphics cursor
  5869  cab2 d013                   BNE .deleteCharacterAtGraphicsCursor                ; if (graphics cursor active) then branch
  5870  cab4 ae6003                 LDX .vduNumberOfLogicalColoursMinusOne              ; number of logical colours less 1
  5871  cab7 f009                   BEQ .deleteCharacterInMODE7                         ; if (MODE 7) then branch
  5872  cab9 85de                   STA .vduTempStoreDE                                 ; store A (always 0)
  5873  cabb a9c0                   LDA #>.characterDefinitions                         ; A=high byte of characters in ROM
  5874  cabd 85df                   STA .vduTempStoreDF                                 ; store in .vduTempStoreDF (.vduTempStoreDE)
  5875                                                                                  ; now points to the first character
  5876                                                                                  ; definition: the 'space' pattern
  5877  cabf 4cbfcf                 JMP .displayACharacterAtAddress                     ; display a space
  5878                          
  5879                          ; ***************************************************************************************
  5880                          .deleteCharacterInMODE7
  5881  cac2 a920                   LDA #.charSPACE                                     ; }
  5882  cac4 4cdccf                 JMP .displayCharacterMODE7                          ; } display a space
  5883                          
  5884                          ; ***************************************************************************************
  5885                          .deleteCharacterAtGraphicsCursor
  5886  cac7 a97f                   LDA #.charDELETE                                    ; ASCII code for delete
  5887  cac9 203ed0                 JSR .getCharacterDefinitionAddress                  ; set up character definition pointers
  5888  cacc ae5a03                 LDX .vduBackgroundGraphicsColour                    ; background graphics colour
  5889  cacf a000                   LDY #0                                              ; normal GCOL mode
  5890  cad1 4c63cf                 JMP .plotACharacterWithXYAsGraphicsColourAndGCOLMode ; plot character in background colour
  5891                          
  5892                          ; ***************************************************************************************
  5893                          ; On Entry:
  5894                          ;       A = High byte of 16 bit value
  5895                          ;       X = Low byte of 16 bit value
  5896                          .addNumberOfBytesInACharacterRowToAX
  5897  cad4 48                     PHA                                                 ; store A
  5898  cad5 8a                     TXA                                                 ; A=X
  5899  cad6 18                     CLC                                                 ;
  5900  cad7 6d5203                 ADC .vduBytesPerCharacterRowLow                     ; add bytes per character row
  5901  cada aa                     TAX                                                 ; put low byte back into X
  5902  cadb 68                     PLA                                                 ; recall A
  5903  cadc 6d5303                 ADC .vduBytesPerCharacterRowHigh                    ; add bytes per character row high byte (and carry)
  5904  cadf 60                     RTS                                                 ;
  5905                          
  5906                          ; ***************************************************************************************
  5907                          ;
  5908                          ; Paged mode scrolling
  5909                          ;
  5910                          ; When paged mode is enabled, listing lots of text stops scrolling when the screen is full
  5911                          ; until the user presses SHIFT to display the next page of text.
  5912                          ;
  5913                          ; Even without paged mode enabled, holding SHIFT and CTRL will inhibit scrolling (pauses)
  5914                          ; until at least one of the keys is released.
  5915                          ;
  5916                          ; ***************************************************************************************
  5917                          .handleScrollingInPagedMode
  5918  cae0 2014cb                 JSR .clearPagedModeCounter                          ; clear paged mode line counter
  5919                          .handleScrollingInPagedModeInternal
  5920                              ; first check for SHIFT and CTRL pressed together - this loops until at least one key is released
  5921  cae3 20d9e9                 JSR .osbyte118EntryPoint                            ; OSBYTE 118 - set keyboard LEDs based on current keyboard state
  5922  cae6 9002                   BCC +                                               ; if (CTRL not pressed) then branch
  5923  cae8 30f6                   BMI .handleScrollingInPagedMode                     ; if (SHIFT pressed) then branch back
  5924                          +
  5925                          
  5926                              ; check flags for relevant state
  5927  caea a5d0                   LDA .vduStatusByte                                  ; VDU status byte
  5928  caec 4904                   EOR #%00000100                                      ; invert bit 2 (paged scrolling)
  5929  caee 2946                   AND #%01000110                                      ; if (there are 2 cursors, OR paged mode is off, OR not paged scrolling)...
  5930  caf0 d02a                   BNE .exit5                                          ; ...then branch (exit)
  5931                          
  5932                              ; check the paged mode counter to see if it has run out of lines
  5933  caf2 ad6902                 LDA .pagedModeCounter                               ; paged mode counter
  5934  caf5 3022                   BMI .incrementPagedModeAndExit                      ; if (negative) then branch (increment paged mode counter and exit)
  5935                          
  5936                              ; check if we are at the bottom of the screen (exit if not)
  5937  caf7 ad1903                 LDA .vduTextCursorYPosition                         ; current text line
  5938  cafa cd0903                 CMP .vduTextWindowBottom                            ; bottom edge
  5939  cafd 901a                   BCC .incrementPagedModeAndExit                      ; increment line counter and exit
  5940                          
  5941                              ; check if we have shown enough lines to fill the text window vertically
  5942  caff 4a                     LSR                                                 ; }
  5943  cb00 4a                     LSR                                                 ; } A = A / 4
  5944  cb01 38                     SEC                                                 ; set carry
  5945  cb02 6d6902                 ADC .pagedModeCounter                               ; paged mode counter
  5946  cb05 6d0b03                 ADC .vduTextWindowTop                               ; top of text window
  5947  cb08 cd0903                 CMP .vduTextWindowBottom                            ; bottom edge
  5948  cb0b 900c                   BCC .incrementPagedModeAndExit                      ; increment line counter and exit
  5949                          
  5950  cb0d 18                     CLC                                                 ; clear carry
  5951                          -
  5952  cb0e 20d9e9                 JSR .osbyte118EntryPoint                            ; OSBYTE 118 - set keyboard LEDs based on current keyboard state
  5953  cb11 38                     SEC                                                 ; set carry
  5954  cb12 10fa                   BPL -                                               ; if (SHIFT not pressed) then branch (loop back)
  5955                              ; fall through...
  5956                          
  5957                          ; ***************************************************************************************
  5958                          .clearPagedModeCounter
  5959  cb14 a9ff                   LDA #255                                            ;
  5960  cb16 8d6902                 STA .pagedModeCounter                               ; set paged mode counter
  5961                          .incrementPagedModeAndExit
  5962  cb19 ee6902                 INC .pagedModeCounter                               ; increment paged mode counter
  5963                          .exit5
  5964  cb1c 60                     RTS                                                 ;
  5965                          
  5966                          
