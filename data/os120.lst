 19492                          ; ***************************************************************************************
 19493                          ;
 19494                          ; Print the following message
 19495                          ;
 19496                          ; Prints the message at the address on the top of the stack (this is usually the
 19497                          ; return address, so represents the data that follows a JSR to this function).
 19498                          ; The alternative route here is that we fall through from .dontAbortOnError above, which
 19499                          ; has put the appropriate address on the stack.
 19500                          ;
 19501                          ; On returning from this routine, execution continues from the byte directly after the
 19502                          ; message.
 19503                          ;
 19504                          ; On Entry:
 19505                          ;       The top two bytes on the stack hold the address of the message - 1
 19506                          ;       Y = zero means don't actually output the message
 19507                          ;       otherwise print each character of the message using .OSASCI
 19508                          ; On Exit:
 19509                          ;       A = 0
 19510                          ;       Z is clear (not equal to zero)
 19511                          ; ***************************************************************************************
 19512                          .printFollowingMessage
 19513  fa4a 68                     PLA                                                 ; }
 19514  fa4b 85b8                   STA .printMessageAddressLow                         ; } get calling address
 19515  fa4d 68                     PLA                                                 ; } and store it in .printMessageAddressLow/High
 19516  fa4e 85b9                   STA .printMessageAddressHigh                        ; }
 19517  fa50 98                     TYA                                                 ; A=Y (used to set Z flag if Y=0)
 19518  fa51 08                     PHP                                                 ; save Z flag on stack
 19519                          -
 19520  fa52 e6b8                   INC .printMessageAddressLow                         ;
 19521  fa54 d002                   BNE +                                               ;
 19522  fa56 e6b9                   INC .printMessageAddressHigh                        ;
 19523                          +
 19524  fa58 a000                   LDY #0                                              ; Y=0
 19525  fa5a b1b8                   LDA (.printMessageAddressLow),Y                     ; get byte of message to print
 19526  fa5c f00a                   BEQ .printingFinished                               ; if (terminator found) then branch
 19527                                                                                  ; (jump back to calling function after
 19528                                                                                  ; message)
 19529  fa5e 28                     PLP                                                 ; restore flags from stack
 19530  fa5f 08                     PHP                                                 ; save flags on stack again
 19531  fa60 f0f0                   BEQ -                                               ; if (Z=1, i.e. don't output message)
 19532                                                                                  ; then branch (loop back to get next
 19533                                                                                  ; character)
 19534  fa62 20e3ff                 JSR .OSASCI                                         ; print character
 19535  fa65 4c52fa                 JMP -                                               ; jump back to get next character
 19536                          
 19537                          .printingFinished
 19538  fa68 28                     PLP                                                 ; get back flags
 19539  fa69 e6b8                   INC .printMessageAddressLow                         ; increment pointers
 19540  fa6b d002                   BNE +                                               ;
 19541  fa6d e6b9                   INC .printMessageAddressHigh                        ;
 19542                          +
 19543  fa6f 6cb800                 JMP (.printMessageAddressLow)                       ; return control to just after the error message
 19544                          
