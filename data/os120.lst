 19318  f986 6930                   ADC #.charZERO                                      ; A = $30 to $3F
 19319  f988 c93a                   CMP #.charNINE + 1                                  ; }
 19320  f98a 9002                   BCC .writeCharJumper                                ; } if A <= ASC('9') then print
