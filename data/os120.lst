 12067  e176 9018                   BCC .exit17                                         ; } if (free space in buffer is low) then branch (return)
 12068  e178 a220                   LDX #%00100000                                      ; set bit 5 on ACIA control register
 12069                                                                                  ; set 'Request To Send' low (meaning Active)
 12070                          
 12071                          .writeToACIARequestToSend
 12072  e17a a09f                   LDY #%10011111                                      ; Mask for setting bits 5 and 6
 12073                                                                                  ; This writes the 'Request To Send'
 12074                                                                                  ; value.
 12075                              ; fall through...
