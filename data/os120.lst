 18832  f79c 8a                     TXA                                                 ; }
 18833  f79d 48                     PHA                                                 ; }
 18834  f79e 98                     TYA                                                 ; } save X and Y
 18835  f79f 48                     PHA                                                 ; }
 18836  f7a0 2051ee                 JSR .readByteFromROMFSorPHROM                       ; read ROMFS data ROM or PHROM
 18837  f7a3 85bd                   STA .fsCharacterJustReadOrCharToWrite               ; store character just read
 18838  f7a5 a9ff                   LDA #$FF                                            ; Top bit set
 18839  f7a7 85c0                   STA .fsGotACharacterToReadOrWriteFlag               ; note that we have just read a byte
 18840                                                                                  ; set 'flag' to $FF to avoid waiting for
 18841                                                                                  ; byte to be read (c.f. from tape)
 18842  f7a9 68                     PLA                                                 ; }
 18843  f7aa a8                     TAY                                                 ; }
 18844  f7ab 68                     PLA                                                 ; } restore X and Y
 18845  f7ac aa                     TAX                                                 ; }
 18846                          +
