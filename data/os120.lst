 20447                          ;
 20448                          ; ***************************************************************************************
 20449                          .osbyte157EntryPoint
 20450  ffa7 8a                     TXA                                                 ; A=X
 20451  ffa8 b02a                   BCS .OSBPUT                                         ; ALWAYS branch
