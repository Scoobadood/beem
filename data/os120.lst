  1279                                                                                  ; (Read/Write using OSBYTE 220)
  1280                          
  1281                          .functionAndCursorKeyCodes                  = $026D     ; 8 bytes that determine how to interpret special keys:
  1282                          
  1283                              ; byte  range of keys
  1284                              ;  0      $C0-$CF
  1285                              ;  1      $D0-$DF
  1286                              ;  2      $E0-$EF
  1287                              ;  3      $F0-$FF
  1288                              ;  4      $80-$8F  Function keys
  1289                              ;  5      $90-$9F  SHIFT+Function keys
  1290                              ;  6      $A0-$AF  CTRL+Function keys
  1291                              ;  7      $B0-$BF  CTRL+SHIFT+Function keys
  1292                              ;
  1293                              ; 0 = ignore key
  1294                              ; 1 = expand as 'soft' key
  1295                              ; 2-255 = add this to base for 'ASCII' code
  1296                              ;
  1297                              ; note that provision is made for keypad operation
  1298                              ; as codes $C0-$FF cannot be generated from keyboard
  1299                              ; but are recognised by OS
  1300                              ;
  1301                              ; (Read/Write using OSBYTE 221-228)
  1302                          
  1303                          .escapeAction                               = $0275     ; 0 = normal ESCAPE action
  1304                                                                                  ; otherwise ASCII
  1305                                                                                  ; (Read/Write using OSBYTE 229)
  1306                          .escapeEffects                              = $0276     ; 0 = ESCAPE cleared, EXEC file
  1307                                                                                  ; closed, all buffers purged, reset
