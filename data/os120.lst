  5968                          ; ***************************************************************************************
  5969                          ;
  5970                          ; Chapter 6: Changing MODEs
  5971                          ;
  5972                          ; ***************************************************************************************
  5973                          ; ***************************************************************************************
  5974                          
  5975                          ; ***************************************************************************************
  5976                          ;
  5977                          ; Initialise VDU variables and change MODE
  5978                          ;
  5979                          ; This is called at reset time
  5980                          ;
  5981                          ; On Entry:
  5982                          ;       A = screen MODE number
  5983                          ;
  5984                          ; ***************************************************************************************
  5985                          .initialiseVDUVariablesAndSetMODE
  5986  cb1d 48                     PHA                                                 ; save A (screen mode number)
  5987                          
  5988                              ; Clear all VDU variables (0-126)
  5989  cb1e a27f                   LDX #.vduVariablesEnd - .vduVariablesStart          ; loop counter
  5990  cb20 a900                   LDA #0                                              ; A=0
  5991  cb22 85d0                   STA .vduStatusByte                                  ; VDU status byte to set default conditions (zero)
  5992                          -
  5993  cb24 9dff02                 STA .vduVariablesStart-1,X                          ; zero VDU variables (0-126)
  5994  cb27 ca                     DEX                                                 ; with this loop
  5995  cb28 d0fa                   BNE -                                               ;
  5996                          
  5997                              ; implode character definitions
  5998  cb2a 2007cd                 JSR .osbyte20EntryPoint                             ; implode character definitions (A = 0)
  5999  cb2d 68                     PLA                                                 ; get back A (screen mode number)
  6000                          
  6001                              ; Set teletext cursor
  6002  cb2e a27f                   LDX #$7F                                            ; X=$7F
  6003  cb30 8e6603                 STX .vduTeletextCharacterForCursor                  ; set mode 7 cursor character
  6004                              ; fall through...
  6005                          
  6006                          ; ***************************************************************************************
  6007                          ;
  6008                          ; Set MODE
  6009                          ;
  6010                          ; On Entry:
  6011                          ;       A = screen MODE number
  6012                          ;
  6013                          ; ***************************************************************************************
  6014                          .setMODE
  6015  cb33 2c8e02                 BIT .systemAvailableRAM                             ; test available RAM pages ($40 = 16k; $80 = 32k)
  6016  cb36 3002                   BMI +                                               ; if (32k available) then branch
  6017  cb38 0904                   ORA #4                                              ; ensure only modes 4-7 are available
  6018                          +
  6019  cb3a 2907                   AND #7                                              ; X = A AND 7 (to ensure a legal mode)
  6020  cb3c aa                     TAX                                                 ; X = mode
  6021                          
  6022                              ; Set characteristic vdu variables for the new mode
  6023  cb3d 8e5503                 STX .vduCurrentScreenMODE                           ; set screen mode
  6024  cb40 bd14c4                 LDA .numberOfColoursMinusOneInMODETable,X           ; get number of colours -1 in mode from table
  6025  cb43 8d6003                 STA .vduNumberOfLogicalColoursMinusOne              ; set number of logical colours less 1
  6026  cb46 bdffc3                 LDA .bytesPerCharacter,X                            ; get number of bytes /character from table
  6027  cb49 8d4f03                 STA .vduBytesPerCharacter                           ; set bytes per character
  6028  cb4c bd3ac4                 LDA .pixelsPerByteMinusOneInMODETable,X             ; get display mode pixels/byte from table
  6029  cb4f 8d6103                 STA .vduPixelsPerByteMinusOne                       ; set pixels per byte-1
  6030  cb52 d002                   BNE +                                               ; if (in a graphics mode) then branch
  6031  cb54 a907                   LDA #7                                              ; this is a text mode; set A = 7
  6032                          +
  6033  cb56 0a                     ASL                                                 ; A = A * 2
  6034  cb57 a8                     TAY                                                 ; Y = 2 * (pixels per byte-1), index into a table of colour masks
  6035  cb58 b906c4                 LDA .sixteenColourMODEMaskTable - 1,Y               ; mask table
  6036  cb5b 8d6303                 STA .vduColourMaskRight                             ; store as colour mask right
  6037                          -
  6038  cb5e 0a                     ASL                                                 ; shift A left
  6039  cb5f 10fd                   BPL -                                               ; until the top bit becomes set
  6040  cb61 8d6203                 STA .vduColourMaskLeft                              ; store as colour mask left
  6041                          
  6042  cb64 bc40c4                 LDY .screenDisplayMemoryIndexTable,X                ; screen display memory index table
  6043  cb67 8c5603                 STY .vduCurrentScreenMODEGroup                      ; MODE group = screen memory size:
  6044                                                                                  ;       0 = 20k (MODE 0,1,2)
  6045                                                                                  ;       1 = 16k (MODE 3)
  6046                                                                                  ;       2 = 10k (MODE 4,5)
  6047                                                                                  ;       3 = 8k (MODE 6)
  6048                                                                                  ;       4 = 1k (MODE 7)
  6049                          
  6050  cb6a b94fc4                 LDA .systemVIAHardwareScrollTable2,Y                ; get system VIA parameter for setting hardware scrolling value
  6051  cb6d 20f8e9                 JSR .writeAToSystemVIARegisterB                     ; write hardware scrolling value to System VIA
  6052  cb70 b94bc4                 LDA .systemVIAHardwareScrollTable1,Y                ; get system VIA parameter for setting hardware scrolling value
  6053  cb73 20f8e9                 JSR .writeAToSystemVIARegisterB                     ; write hardware scrolling value to System VIA
  6054                          
  6055  cb76 b959c4                 LDA .screenMemorySizeInBytesHigh,Y                  ; screen RAM size high byte table
  6056  cb79 8d5403                 STA .vduScreenSizeHighByte                          ; screen RAM size high byte
  6057                          
  6058  cb7c b95ec4                 LDA .screenMemoryStartHigh,Y                        ; screen ram address high byte
  6059  cb7f 8d4e03                 STA .vduStartScreenAddressHighByte                  ; high byte of screen RAM address
  6060                          
  6061                                                                                  ; A=Y=the screen memory type
  6062  cb82 98                     TYA                                                 ; A = Y           A = 0 1 2 3 4
  6063  cb83 6902                   ADC #2                                              ; A = A + 2       A = 2 3 4 5 6
  6064  cb85 4907                   EOR #7                                              ; A = A EOR 7     A = 5 4 3 2 1
  6065  cb87 4a                     LSR                                                 ; A = A / 2       A = 2 2 1 1 0
  6066                          
  6067  cb88 aa                     TAX                                                 ; X=A Index into multiplication table
  6068                                                                                  ; (0 = MODE 7
  6069                                                                                  ;  1 = MODE 4,5,6
  6070                                                                                  ;  2 = MODE 0,1,2,3)
  6071                          
  6072  cb89 bd66c4                 LDA .multiplicationTabletoUseLow,X                  ; load the low byte of the multiplication table to use
  6073  cb8c 85e0                   STA .vduMultiplicationTableLow                      ; store
  6074  cb8e a9c3                   LDA #>.multiplyBy640Table                           ; high byte of multiplication tables
  6075  cb90 85e1                   STA .vduMultiplicationTableHigh                     ; store. Now (.vduMultiplicationTableLow) points to 640x multiplication table or 40x.
  6076  cb92 bd63c4                 LDA .bytesPerRowLow,X                               ; get number of bytes per row (low byte) from table
  6077                          
  6078  cb95 8d5203                 STA .vduBytesPerCharacterRowLow                     ; store bytes per character row
  6079  cb98 8e5303                 STX .vduBytesPerCharacterRowHigh                    ; bytes per character row (high byte)
  6080  cb9b a943                   LDA #%01000011                                      ;
  6081  cb9d 20a8c5                 JSR .clearVDUStatusByteFlags                        ; clear bits 2,3,4,5,7 in .vduStatusByteFlags:
  6082                                                                                  ; bit 2 = paged scrolling selected
  6083                                                                                  ; bit 3 = software scrolling (text window)
  6084                                                                                  ; bit 4 = not used
  6085                                                                                  ; bit 5 = graphics cursor enabled (VDU 5)
  6086                                                                                  ; bit 7 = VDU disabled
  6087                          
  6088                          
  6089  cba0 ae5503                 LDX .vduCurrentScreenMODE                           ; screen mode
  6090  cba3 bdf7c3                 LDA .videoULAVideoControlRegisterDefaultValuesPerMODE,X ; get video ULA control setting
  6091  cba6 2000ea                 JSR .setVideoULA                                    ; set video ULA using OSBYTE 154
  6092                          
  6093                              ; Set CRTC registers for the current mode
  6094  cba9 08                     PHP                                                 ; push flags
  6095  cbaa 78                     SEI                                                 ; disable interrupts
  6096  cbab be69c4                 LDX .crtcCursorEndRegisterTable,Y                   ; get cursor end register data from table
  6097  cbae a00b                   LDY #11                                             ; Y = 11
  6098                          -
  6099  cbb0 bd6ec4                 LDA .crtcRegisters0to11ForMODEs012,X                ; get entry from CRTC table
  6100  cbb3 205ec9                 JSR .setCRTCRegisterAY                              ; set CRTC Register Y to A
  6101  cbb6 ca                     DEX                                                 ; reduce pointers
  6102  cbb7 88                     DEY                                                 ;
  6103  cbb8 10f6                   BPL -                                               ; if (still >=0) then branch (loop back)
  6104  cbba 28                     PLP                                                 ; pull flags
  6105  cbbb 2039c8                 JSR .vdu20EntryPoint                                ; set default colours
  6106  cbbe 20bdc9                 JSR .vdu26EntryPoint                                ; set default windows
  6107                          
  6108                          .initializeDisplayAndHomeCursor
  6109  cbc1 a200                   LDX #0                                              ; X = 0
  6110  cbc3 ad4e03                 LDA .vduStartScreenAddressHighByte                  ; high byte of screen RAM address
  6111  cbc6 8e5003                 STX .vduScreenTopLeftAddressLow                     ; screen start address low
  6112  cbc9 8d5103                 STA .vduScreenTopLeftAddressHigh                    ; screen start address high
  6113  cbcc 20f6c9                 JSR .setTextCursorCRTCAddress                       ; use X and Y to set new cursor address
  6114  cbcf a00c                   LDY #.crtcStartScreenAddressHighRegister            ;
  6115  cbd1 202bca                 JSR .setTwoCRTCRegisters                            ; set registers 12 and 13 in CRTC
  6116  cbd4 ad5803                 LDA .vduBackgroundTextColour                        ; background text colour
  6117  cbd7 ae5603                 LDX .vduCurrentScreenMODEGroup                      ; MODE group = screen memory size
  6118                                                                                  ; 0=20k (MODE 0,1,2)
  6119                                                                                  ; 1=16k (MODE 3)
  6120                                                                                  ; 2=10k (MODE 4,5)
  6121                                                                                  ; 3=8k (MODE 6)
  6122                                                                                  ; 4=1k (MODE 7)
  6123  cbda bc54c4                 LDY .clearScreenRoutineEntryPointLow,X              ; get section control number
  6124  cbdd 8c5d03                 STY .vduJumpVectorLow                               ; set it in jump vector low
  6125  cbe0 a0cc                   LDY #>.clearScreenRoutineEntryPointMODE012          ; high byte of address of screen clearing routine
  6126  cbe2 8c5e03                 STY .vduJumpVectorHigh                              ; upper byte of link address
  6127  cbe5 a200                   LDX #0                                              ; X = 0
  6128  cbe7 8e6902                 STX .pagedModeCounter                               ; paged mode counter
  6129  cbea 8e1803                 STX .vduTextCursorXPosition                         ; text column
  6130  cbed 8e1903                 STX .vduTextCursorYPosition                         ; current text line
  6131  cbf0 6c5d03                 JMP (.vduJumpVectorLow)                             ; jump indirect - this calls the screen clearing routine
  6132                          
  6133                          ; ***************************************************************************************
  6134                          ;
  6135                          ; OSWORD 10 - Read character definition
  6136                          ;
  6137                          ; On Entry:
  6138                          ;       A          = character to read
  6139                          ;       .oswordX/Y = address of buffer to store the eight bytes of results
  6140                          ; ***************************************************************************************
  6141                          .osword10EntryPoint
  6142  cbf3 203ed0                 JSR .getCharacterDefinitionAddress                  ; set up character definition pointers
  6143  cbf6 a000                   LDY #0                                              ; Y=0
  6144                          -
  6145  cbf8 b1de                   LDA (.vduTempStoreDE),Y                             ; get first byte
  6146  cbfa c8                     INY                                                 ; Y=Y+1
  6147  cbfb 91f0                   STA (.oswordX),Y                                    ; store it in YX
  6148  cbfd c008                   CPY #8                                              ; until Y=8
  6149  cbff d0f7                   BNE -                                               ;
  6150  cc01 60                     RTS                                                 ;
  6151                          
