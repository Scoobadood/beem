  3978                          ; ***************************************************************************************
  3979                          ;
  3980                          ; Pixel tables
  3981                          ;
  3982                          ; A 16 colour MODE (MODE 2) has two pixels per byte. The first table gives the byte
  3983                          ; values required to set each pixel in a byte to white (leaving the remainder black).
  3984                          ; The second table is the equivalent for four colour MODEs (four pixels per byte).
  3985                          ; The third table is the equivalent for two colour MODEs (eight pixels per byte, dual use
  3986                          ; with .fontMaskTable)
  3987                          ;
  3988                          ; ***************************************************************************************
  3989                          .sixteenColourMODEMaskTable
  3990  c407 aa55                   !byte %10101010, %01010101                          ; 2 pixels per byte (MODE 2)
  3991                          
