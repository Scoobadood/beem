  9552                          ;
  9553                          ; OSBYTE 132 - Read HIMEM (start of screen memory)
  9554                          ;
  9555                          ; ***************************************************************************************
  9556                          .osbyte132EntryPoint
  9557  d923 ae5503                 LDX .vduCurrentScreenMODE                           ; get current screen MODE
  9558                              ; fall through...
  9559                          
  9560                          ; ***************************************************************************************
  9561                          ;
  9562                          ; OSBYTE 133 - Read start of screen memory for given MODE
  9563                          ;
  9564                          ; ***************************************************************************************
  9565                          .osbyte133EntryPoint
  9566  d926 8a                     TXA                                                 ; X=MODE number
  9567  d927 2907                   AND #7                                              ; keep it in range 0-7
  9568  d929 a8                     TAY                                                 ; Y=MODE number
  9569  d92a be40c4                 LDX .screenDisplayMemoryIndexTable,Y                ; X = get screen RAM size index
  9570  d92d bd5ec4                 LDA .screenMemoryStartHigh,X                        ; A = high byte of start address
  9571  d930 a200                   LDX #0                                              ; X = 0 (low byte of result)
  9572  d932 2c8e02                 BIT .systemAvailableRAM                             ; get available RAM
  9573  d935 3007                   BMI .returnTheScreenAddress                         ; if (32k available) then branch
  9574  d937 293f                   AND #$3F                                            ; AND A with $3F to bring into memory range for a 16K BBC Micro
  9575  d939 c004                   CPY #4                                              ;
  9576  d93b b001                   BCS .returnTheScreenAddress                         ; if (MODE number >= 4) then branch (to return the value)
  9577  d93d 8a                     TXA                                                 ; return zero (Model A can't display MODEs 0-3)
  9578                          .returnTheScreenAddress
  9579  d93e a8                     TAY                                                 ; Y = high byte of screen address
  9580  d93f 60                     RTS                                                 ;
