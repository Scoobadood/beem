  8089  d3ce a6dc                   LDX .vduTempStoreDC                                 ; Restore X
  8090                          
  8091                          .plotLineLoopLocal
  8092  d3d0 4ce3d2                 JMP .plotLineLoop                                   ; jump back to continue plotting the line
  8093                          
  8094                          
  8095                          ; ***************************************************************************************
  8096                          .moveGraphicsCursorAddressUpOneCharacterCell
  8097  d3d3 38                     SEC                                                 ;
  8098  d3d4 a5d6                   LDA .vduScreenAddressOfGraphicsCursorCellLow        ; }
  8099  d3d6 ed5203                 SBC .vduBytesPerCharacterRowLow                     ; }
  8100  d3d9 85d6                   STA .vduScreenAddressOfGraphicsCursorCellLow        ; } subtract number of bytes per line
  8101  d3db a5d7                   LDA .vduScreenAddressOfGraphicsCursorCellHigh       ; } from address
  8102  d3dd ed5303                 SBC .vduBytesPerCharacterRowHigh                    ; }
  8103  d3e0 cd4e03                 CMP .vduStartScreenAddressHighByte                  ; compare with bottom of screen memory
  8104  d3e3 b003                   BCS +                                               ; if (inside screen RAM) then branch
  8105  d3e5 6d5403                 ADC .vduScreenSizeHighByte                          ; add screen memory size to wrap it
  8106                                                                                  ; around
  8107                          +
  8108  d3e8 85d7                   STA .vduScreenAddressOfGraphicsCursorCellHigh       ; store in current address of graphics
  8109                                                                                  ; cell top line
  8110  d3ea a007                   LDY #7                                              ; Y=7
  8111  d3ec 60                     RTS                                                 ;
  8112                          
  8113                          
  8114                          ; ***************************************************************************************
  8115                          ;
  8116                          ; Update the mask value, and move graphics cursor address on to next cell to the right
  8117                          ;
  8118                          ; On Entry:
  8119                          ;       Carry always SET
  8120                          ;
  8121                          ; ***************************************************************************************
  8122                          .moveGraphicsCursorAddressTotheRightAndUpdateMask
  8123  d3ed ad6203                 LDA .vduColourMaskLeft                              ; get current left colour mask
  8124  d3f0 85d1                   STA .vduCurrentPlotByteMask                         ; store it
  8125  d3f2 a5d6                   LDA .vduScreenAddressOfGraphicsCursorCellLow        ; }
  8126  d3f4 6907                   ADC #7                                              ; } get current graphics cursor
  8127  d3f6 85d6                   STA .vduScreenAddressOfGraphicsCursorCellLow        ; } address and add 8 to move to
  8128  d3f8 9002                   BCC +                                               ; } next cell to the right
  8129  d3fa e6d7                   INC .vduScreenAddressOfGraphicsCursorCellHigh       ; }
  8130                          +
  8131  d3fc 60                     RTS                                                 ;
  8132                          
  8133                          ; ***************************************************************************************
  8134                          ;
  8135                          ; Update the mask value, and move graphics cursor address on to previous cell to the left
  8136                          ;
  8137                          ; On Entry:
  8138                          ;       Carry always SET
  8139                          ;
  8140                          ; ***************************************************************************************
  8141                          .moveGraphicsCursorAddressTotheLeftAndUpdateMask
  8142  d3fd ad6303                 LDA .vduColourMaskRight                             ; get right colour mask
  8143  d400 85d1                   STA .vduCurrentPlotByteMask                         ; store it
  8144  d402 a5d6                   LDA .vduScreenAddressOfGraphicsCursorCellLow        ; A=top line graphics cell low
  8145  d404 d002                   BNE +                                               ; if (not zero) then branch
  8146  d406 c6d7                   DEC .vduScreenAddressOfGraphicsCursorCellHigh       ; decrement high byte
  8147                          +
  8148  d408 e908                   SBC #8                                              ; subtract 8 (carry is always SET)
  8149  d40a 85d6                   STA .vduScreenAddressOfGraphicsCursorCellLow        ; and store in low byte
  8150  d40c 60                     RTS                                                 ;
  8151                          
  8152                          ; ***************************************************************************************
  8153                          ;
  8154                          ; Initialise delta values to (current cursor - params position)
  8155                          ;
  8156                          ; Called at the start of the line drawing, this function takes the current graphics cursor
  8157                          ; position, subtracts the desired graphics cursor position (two 16 bit values on the VDU
  8158                          ; queue), and stores the result in workspace A/B/C/D.
  8159                          ;
  8160                          ; ***************************************************************************************
  8161                          .plotLineInitialiseDeltaValues
  8162  d40d a028                   LDY #.vduPlotLineDeltaXLow - .vduVariablesStart     ; destination: .vduPlotLineDeltaX/Y
  8163  d40f a220                   LDX #.vdu25ParameterXLow - .vduVariablesStart       ; source: four parameters on the VDU queue
  8164                                                                                  ; and the graphics cursor position
  8165                              ; fall through...
  8166                          
  8167                          ; ***************************************************************************************
  8168                          ;
  8169                          ; Coordinate subtraction
  8170                          ;
  8171                          ; On Entry:
  8172                          ;       X = source offset into vdu variables      (we read offsets 0-7)
  8173                          ;       Y = destination offset into vdu variables (we write offsets 0-3)
  8174                          ;
  8175                          ; On Exit:
  8176                          ;   Stores 16 bit width and height based on the difference of four
  8177                          ;   16 bit source coordinates (left, bottom, right, top)
  8178                          ;       width  = right - left
  8179                          ;       height = top - bottom
  8180                          ;   i.e.
  8181                          ;       let src  = .vduVariablesStart + X
  8182                          ;       let dest = .vduVariablesStart + Y
  8183                          ;       dest[0,1] = src[4,5] - src[0,1] = width
  8184                          ;       dest[2,3] = src[6,7] - src[2,3] = height
  8185                          ;
  8186                          ;   A = height (high byte)
  8187                          ;
  8188                          ; ***************************************************************************************
  8189                          .coordinateSubtraction
  8190  d411 2018d4                 JSR +                                               ; first calculate width
  8191  d414 e8                     INX                                                 ; }
  8192  d415 e8                     INX                                                 ; } add 2 to X and Y
  8193  d416 c8                     INY                                                 ; } i.e. move offsets on for Y values
  8194  d417 c8                     INY                                                 ; }
  8195                                                                                  ; finally calculate height
  8196                          +
  8197  d418 38                     SEC                                                 ; set carry
  8198  d419 bd0403                 LDA .vduVariablesStart + 4,X                        ; subtract coordinates
  8199  d41c fd0003                 SBC .vduVariablesStart + 0,X                        ;
  8200  d41f 990003                 STA .vduVariablesStart + 0,Y                        ;
  8201  d422 bd0503                 LDA .vduVariablesStart + 5,X                        ;
  8202  d425 fd0103                 SBC .vduVariablesStart + 1,X                        ;
  8203  d428 990103                 STA .vduVariablesStart + 1,Y                        ;
  8204  d42b 60                     RTS                                                 ;
  8205                          
  8206                          ; ***************************************************************************************
  8207                          ;
  8208                          ; Initialise line drawing variables
  8209                          ;
  8210                          ; Swaps the delta coordinates to make the non-dominant axis first. Stores absolute values of
  8211                          ; the deltas in .vduPlotLineAbsNonDominantAxisDeltaLow/High
  8212                          ;        and in .vduPlotLineAbsDominantAxisDeltaLow/High
  8213                          ; Initialises the loop counter (-ve of the number of pixels to draw along the dominant axis)
  8214                          ; Initialises the error term.
  8215                          ;
  8216                          ; In steps:
  8217                          ;   1. Make sure the dominant axis is stored second, by swapping coordinates if needed.
  8218                          ;   2. Both coordinates are then made positive and stored in:
  8219                          ;           .vduPlotLineAbsNonDominantAxisDeltaLow/High
  8220                          ;           .vduPlotLineAbsDominantAxisDeltaLow/High
  8221                          ;   3. .vduTempStoreDC/DD stores the negative of the number of steps to take along the dominant axis.
  8222                          ;   4. .vduPlotLineErrorTermLow/High stores half .vduPlotLineAbsDominantAxisDelta. This is the error variable.
  8223                          ;
  8224                          ; On Entry:
  8225                          ;       The original signed (dX, dY) delta values are stored at:
  8226                          ;           (.vduPlotLineDeltaXLow/High, .vduPlotLineDeltaYLow/High)
  8227                          ;
  8228                          ; On Exit:
  8229                          ;       .vduPlotLineAbsNonDominantAxisDeltaLow/High initialised
  8230                          ;       .vduPlotLineAbsDominantAxisDeltaLow/High initialised
  8231                          ;       .vduPlotLineErrorTermLow/High initialised
  8232                          ;
  8233                          ; ***************************************************************************************
  8234                          .plotLineInitializeVariables
  8235  d42c a5de                   LDA .vduTempStoreDE                                 ; get the dominant axis (0 or 2)
  8236  d42e d007                   BNE +                                               ; if (Y axis is dominant) then branch
  8237  d430 a228                   LDX #.vduPlotLineDeltaXLow - .vduVariablesStart     ; X is workspace A
  8238  d432 a02a                   LDY #.vduPlotLineDeltaYLow - .vduVariablesStart     ; Y is workspace C
  8239  d434 20decd                 JSR .exchangeTwoVDUBytes                            ; exchange the X and Y variables.
  8240                                                                                  ; So the dominant axis is now the
  8241                                                                                  ; first coordinate.
  8242                          +
  8243  d437 a228                   LDX #.vduPlotLineDeltaXLow - .vduVariablesStart     ; source: .workspaceABCD (the start
  8244                                                                                  ; coordinates)
  8245  d439 a037                   LDY #.vduPlotLineAbsNonDominantAxisDeltaLow - .vduVariablesStart ; destination: absolute
  8246                                                                                  ; deltas in X and Y with the
  8247                                                                                  ; non-dominant axis first
  8248  d43b 208ad4                 JSR .copyFourBytesWithinVDUVariables                ; copy four bytes
  8249  d43e 38                     SEC                                                 ; set carry
  8250  d43f a6de                   LDX .vduTempStoreDE                                 ; get the dominant axis (0 or 2)
  8251  d441 ad3003                 LDA .vduPlotLineTerminationValueLow                 ; }
  8252  d444 fd2c03                 SBC .vduPlotLineCurrentPointXLow,X                  ; }     AY = .vduPlotLineTerminationValue - .vduPlotLineCurrentPointX or Y
  8253  d447 a8                     TAY                                                 ; } ie. AY = finalPoint - start point (in dominant axis)
  8254  d448 ad3103                 LDA .vduPlotLineTerminationValueHigh                ; }
  8255  d44b fd2d03                 SBC .vduPlotLineCurrentPointXHigh,X                 ; }
  8256  d44e 3003                   BMI +                                               ; if (startPoint > finalPoint) then branch
  8257  d450 209bd4                 JSR .negateAY                                       ; negate value stored in A and Y
  8258                          +
  8259  d453 85dd                   STA .vduTempStoreDD                                 ; store high byte of negative value     } this is the -ve of the number of steps we
  8260  d455 84dc                   STY .vduTempStoreDC                                 ; store low byte of negative value      } need to take when plotting the line.
  8261  d457 a235                   LDX #.vduPlotLineErrorTermLow - .vduVariablesStart  ;
  8262                          
  8263                          ; fall through to do:
  8264                          ;   .vduPlotLineAbsDominantAxisDelta    = ABS(.vduPlotLineAbsDominantAxisDelta)
  8265                          ;   .vduPlotLineAbsNonDominantAxisDelta = ABS(.vduPlotLineAbsNonDominantAxisDelta)
  8266                          ;   .vduPlotLineErrorTerm               = .vduPlotLineAbsDominantAxisDelta / 2
  8267                          
  8268                          ; fall through...
  8269                          
  8270                          ; ***************************************************************************************
  8271                          ;
  8272                          ; Line Initialisation
  8273                          ;
  8274                          ; This is used in both line drawing and triangle filling to initialise the variables needed
  8275                          ; to track along the edge. Sets the deltas to absolute values, and initialises an error
  8276                          ; term to half the absolute delta in Y.
  8277                          ;
  8278                          ;   Let src  = .vduVariablesStart + X
  8279                          ;   src[4,5] = ABS(src[4,5])
  8280                          ;   src[2,3] = ABS(src[2,3])
  8281                          ;   src[0,1] = src[4,5] / 2
  8282                          ;
  8283                          ; On Entry:
  8284                          ;       X = source (offset from .vduVariablesStart)
  8285                          ;
  8286                          ; On Exit:
  8287                          ;       AY = absolute value of src[2,3]
  8288                          ;
  8289                          ; ***************************************************************************************
  8290                          .lineInitialisation
  8291  d459 2067d4                 JSR .absoluteValue                                  ; make src[4,5] positive
  8292  d45c 4a                     LSR                                                 ; }
  8293  d45d 9d0103                 STA .vduVariablesStart + 1,X                        ; }
  8294  d460 98                     TYA                                                 ; } src[0,1] = src[4,5] / 2
  8295  d461 6a                     ROR                                                 ; }
  8296  d462 9d0003                 STA .vduVariablesStart,X                            ; }
  8297  d465 ca                     DEX                                                 ; point to src[0,1]
  8298  d466 ca                     DEX                                                 ; and fall through to make src[2,3] positive
  8299                              ; fall through...
  8300                          
  8301                          ; ***************************************************************************************
  8302                          ;
  8303                          ; Absolute value
  8304                          ;
  8305                          ; Make sure that the 16 bit coordinate at (vduVariablesStart + 4 + X)
  8306                          ; is not negative, by negating it if necessary.
  8307                          ;
  8308                          ; On Entry:
  8309                          ;       X is offset to vdu variable i.e.:
  8310                          ;       (vduVariablesStart + 4 + X) has the low byte of the coordinate
  8311                          ;       (vduVariablesStart + 5 + X) has the high byte of the coordinate
  8312                          ;
  8313                          ; On Exit:
  8314                          ;       A is the high byte of the result (also stored in .vduVariablesStart + 5 + X)
  8315                          ;       Y is the low byte of the result  (also stored in .vduVariablesStart + 4 + X)
  8316                          ;       X is preserved
  8317                          ;
  8318                          ; ***************************************************************************************
  8319                          .absoluteValue
  8320  d467 bc0403                 LDY .vduVariablesStart + 4,X                        ;
  8321  d46a bd0503                 LDA .vduVariablesStart + 5,X                        ;
  8322  d46d 100c                   BPL +                                               ; if (A is +ve) then branch (return)
  8323  d46f 209bd4                 JSR .negateAY                                       ; negate AY
  8324  d472 9d0503                 STA .vduVariablesStart + 5,X                        ; store back again
  8325  d475 48                     PHA                                                 ;
  8326  d476 98                     TYA                                                 ;
  8327  d477 9d0403                 STA .vduVariablesStart + 4,X                        ;
  8328  d47a 68                     PLA                                                 ; get back A
  8329                          +
  8330  d47b 60                     RTS                                                 ;
  8331                          
  8332                          ; ***************************************************************************************
  8333                          ;
  8334                          ; Copy eight bytes (four coordinates) of VDU variables
  8335                          ;
  8336                          ; On Entry:
  8337                          ;       X = source (offset from .vduVariablesStart)
  8338                          ;       Y = destination (offset from .vduVariablesStart)
  8339                          ;
  8340                          ; ***************************************************************************************
  8341                          .copyEightBytesWithinVDUVariables
  8342  d47c a908                   LDA #8                                              ; A = 8
  8343  d47e d00c                   BNE .copyABytesWithinVDUVariables                   ; ALWAYS branch - copy 8 bytes
  8344                          
  8345                          ; ***************************************************************************************
  8346                          ; On Entry:
  8347                          ;       X = source (offset from .vduVariablesStart)
  8348                          .copyTwoBytesWithinVDUVariablesToPlotLineTerminationValue
  8349  d480 a030                   LDY #.vduPlotLineTerminationValueLow - .vduVariablesStart ; Y = destination offset from .vduVariablesStart
  8350                              ; fall through...
  8351                          
  8352                          ; ***************************************************************************************
  8353                          ;
  8354                          ; Copy two bytes (one coordinate) of VDU variables
  8355                          ;
  8356                          ; On Entry:
  8357                          ;       X = source (offset from .vduVariablesStart)
  8358                          ;       Y = destination (offset from .vduVariablesStart)
  8359                          ;
  8360                          ; ***************************************************************************************
  8361                          .copyTwoBytesWithinVDUVariables
  8362  d482 a902                   LDA #2                                              ; A = 2
  8363  d484 d006                   BNE .copyABytesWithinVDUVariables                   ; ALWAYS branch - copy 2 bytes
  8364                          
  8365                          ; ***************************************************************************************
  8366                          .copyGraphicsCursorPixelPositionToWorkspaceABCD
  8367  d486 a028                   LDY #.vduWorkspaceA - .vduVariablesStart            ; destination = offset to workspaceA
  8368                              ; fall through...
  8369                          
  8370                          ; ***************************************************************************************
  8371                          ; On Entry:
  8372                          ;       Y = destination (offset from .vduVariablesStart)
  8373                          .copyGraphicsCursorPixelPosition
  8374  d488 a224                   LDX #.vduGraphicsCursorPixelsXLow  - .vduVariablesStart     ; source = offset to graphics cursor position
  8375                              ; fall through...
  8376                          
  8377                          ; ***************************************************************************************
  8378                          ;
  8379                          ; Copy four bytes (e.g. one pair of coordinates) of VDU variables
  8380                          ;
  8381                          ; On Entry:
  8382                          ;       X = source (offset from .vduVariablesStart)
  8383                          ;       Y = destination (offset from .vduVariablesStart)
  8384                          ;
  8385                          ; ***************************************************************************************
  8386                          .copyFourBytesWithinVDUVariables
  8387  d48a a904                   LDA #4                                              ; number of bytes to copy
  8388                              ; fall through...
  8389                          
  8390                          ; ***************************************************************************************
  8391                          ;
  8392                          ; Copy a number of bytes in VDU variables
  8393                          ;
  8394                          ; On Entry:
  8395                          ;       A = number of bytes to copy
  8396                          ;       X = source (offset from .vduVariablesStart)
  8397                          ;       Y = destination (offset from .vduVariablesStart)
  8398                          ;
  8399                          ; ***************************************************************************************
  8400                          .copyABytesWithinVDUVariables
  8401  d48c 85da                   STA .vduTempStoreDA                                 ; store A as a loop counter
  8402                          -
  8403  d48e bd0003                 LDA .vduVariablesStart,X                            ; load value from source address
  8404  d491 990003                 STA .vduVariablesStart,Y                            ; store value in destination address
  8405  d494 e8                     INX                                                 ; move index forwards
  8406  d495 c8                     INY                                                 ; move index forwards
  8407  d496 c6da                   DEC .vduTempStoreDA                                 ; decrement loop counter
  8408  d498 d0f4                   BNE -                                               ; loop back until done
  8409  d49a 60                     RTS                                                 ;
  8410                          
  8411                          
  8412                          ; ***************************************************************************************
  8413                          ;
  8414                          ; Negate the sixteen bit value in A and Y
  8415                          ;
  8416                          ; On Entry:
  8417                          ;       A = high byte
  8418                          ;       Y = low byte
  8419                          ;
  8420                          ; On Exit:
  8421                          ;       A = high byte of negated value
  8422                          ;       Y = low byte of negated value
  8423                          ;       Preserves X
  8424                          ;
  8425                          ; ***************************************************************************************
  8426                          .negateAY
  8427  d49b 48                     PHA                                                 ; save A
  8428  d49c 98                     TYA                                                 ;
  8429  d49d 49ff                   EOR #$FF                                            ;
  8430  d49f a8                     TAY                                                 ; Y=255 - Y
  8431  d4a0 68                     PLA                                                 ; restore A
  8432  d4a1 49ff                   EOR #$FF                                            ; A=255 - A
  8433  d4a3 c8                     INY                                                 ; Y=Y+1 (effectively making Y = 256 - initialY)
  8434  d4a4 d003                   BNE +                                               ; if (Y != 0) then branch (exit)
  8435  d4a6 18                     CLC                                                 ;
  8436  d4a7 6901                   ADC #1                                              ; A+=1
  8437                          +
  8438  d4a9 60                     RTS                                                 ;
  8439                          
  8440                          ; ***************************************************************************************
  8441                          .checkPixelIsBackgroundColour
  8442  d4aa 205dd8                 JSR .checkParameterInBoundsAndSetScreenAddresses    ; check window boundaries and set up screen addresses
  8443  d4ad d008                   BNE .outsideBoundaries                              ; if (outside) then branch
  8444  d4af b1d6                   LDA (.vduScreenAddressOfGraphicsCursorCellLow),Y    ; get byte from current graphics cell
  8445  d4b1 4d5a03                 EOR .vduBackgroundGraphicsColour                    ; compare with current background colour
  8446  d4b4 85da                   STA .vduTempStoreDA                                 ; store it
  8447  d4b6 60                     RTS                                                 ;
  8448                          
  8449                          ; ***************************************************************************************
  8450                          .outsideBoundaries
  8451  d4b7 68                     PLA                                                 ; remove one return address from the
  8452  d4b8 68                     PLA                                                 ; stack to early out of the lateral
  8453                                                                                  ; fill
  8454                          -
  8455  d4b9 ee2603                 INC .vduGraphicsCursorPixelsYLow                    ; increment current graphics cursor y pixel position
  8456  d4bc 4c45d5                 JMP .setNextPixelPosition                           ; exit having pushed the cursor up one
  8457                          
  8458                          ; ***************************************************************************************
  8459                          ;
  8460                          ; Lateral fill left and right
  8461                          ;
  8462                          ; Fill to the left and right of the current parameter coordinate until a non-background
  8463                          ; colour is found. Fills in the foreground colour using the current GCOL mask settings.
  8464                          ;
  8465                          ; ***************************************************************************************
  8466                          .lateralFillLeftRight
  8467  d4bf 20aad4                 JSR .checkPixelIsBackgroundColour                   ; check pixel is background colour
  8468  d4c2 25d1                   AND .vduCurrentPlotByteMask                         ; check just the bits for the current pixel
  8469  d4c4 d0f3                   BNE -                                               ; if (non-background pixel found) then branch
  8470                          
  8471                              ; fill left
  8472  d4c6 a200                   LDX #0                                              ; X=0 (check width in pixels to the left)
  8473  d4c8 2092d5                 JSR .lateralFillGetWidthToWindowEdge                ; Find distance to edge of window:
  8474                                                                                  ; On exit, X and .vduTempStoreDB=negated
  8475                                                                                  ; distance to edge of window
  8476  d4cb f02d                   BEQ .lateralFillLeftDone                            ; if (zero width) then branch
  8477  d4cd ac1a03                 LDY .vduGraphicsCursorVerticalOffsetInCell          ; Y = row within character cell
  8478  d4d0 06d1                   ASL .vduCurrentPlotByteMask                         ; shift mask for next pixel left
  8479  d4d2 b005                   BCS .lateralFillLeftLoop                            ; if (next character cell left reached) then branch
  8480  d4d4 2074d5                 JSR .lateralFillLeftPartialByte                     ; fill the partial first byte
  8481  d4d7 9021                   BCC .lateralFillLeftDone                            ; if (finished) then branch
  8482                          
  8483                          .lateralFillLeftLoop
  8484  d4d9 20fdd3                 JSR .moveGraphicsCursorAddressTotheLeftAndUpdateMask ; move cursor left and reset mask
  8485  d4dc b1d6                   LDA (.vduScreenAddressOfGraphicsCursorCellLow),Y    ; get byte from screen
  8486  d4de 4d5a03                 EOR .vduBackgroundGraphicsColour                    ; EOR with background colour
  8487  d4e1 85da                   STA .vduTempStoreDA                                 ; and store
  8488  d4e3 d012                   BNE .lateralFillLeftNearlyDone                      ; if (not background colour) then branch
  8489                          
  8490                              ; found byte with background colour
  8491  d4e5 38                     SEC                                                 ; set carry
  8492  d4e6 8a                     TXA                                                 ; A=X=negated distance to edge of window (low byte)
  8493  d4e7 6d6103                 ADC .vduPixelsPerByteMinusOne                       ; add pixels/byte (including carry)
  8494  d4ea 9004                   BCC +                                               ; if (carry clear) then branch
  8495  d4ec e6db                   INC .vduTempStoreDB                                 ; increment high byte of distance to left edge of window
  8496  d4ee 1007                   BPL .lateralFillLeftNearlyDone                      ; if (reached edge of window) then branch
  8497                          +
  8498  d4f0 aa                     TAX                                                 ; X=A=negated distance to edge of window (low byte)
  8499                          
  8500                              ; plot a byte in the foreground colour using GCOL options
  8501  d4f1 2004d1                 JSR .plotByte                                       ; plot a byte
  8502                          
  8503                              ; loop back
  8504  d4f4 38                     SEC                                                 ; set carry
  8505  d4f5 b0e2                   BCS .lateralFillLeftLoop                            ; ALWAYS branch (loop back)
  8506                          
  8507                          ; ***************************************************************************************
  8508                          .lateralFillLeftNearlyDone
  8509  d4f7 2074d5                 JSR .lateralFillLeftPartialByte                     ; fill the final pixels in the last (leftmost byte) of the row
  8510                          
  8511                          .lateralFillLeftDone
  8512  d4fa a000                   LDY #0                                              ; Y=0
  8513  d4fc 20acd5                 JSR .lateralFillSetParamAtGivenDistanceFromEdge     ; Restore original position
  8514  d4ff a020                   LDY #.vdu25ParameterXLow - .vduVariablesStart       ;    }
  8515  d501 a224                   LDX #.vduGraphicsCursorPixelsXLow - .vduVariablesStart ; } swap parameter with graphics cursor position
  8516  d503 20e6cd                 JSR .exchangeFourBytes                              ;    }
  8517                          
  8518                              ; fill right
  8519                          .lateralFillRight
  8520  d506 20aad4                 JSR .checkPixelIsBackgroundColour                   ; check screen pixel
  8521  d509 a204                   LDX #4                                              ; X=4 (right hand edge of graphics window)
  8522  d50b 2092d5                 JSR .lateralFillGetWidthToWindowEdge                ; get distance to right hand edge of graphics window
  8523  d50e 8a                     TXA                                                 ; }
  8524  d50f d002                   BNE +                                               ; }
  8525  d511 c6db                   DEC .vduTempStoreDB                                 ; } subtract one from distance to right edge
  8526                          +                                                       ; }
  8527  d513 ca                     DEX                                                 ; }
  8528                          
  8529                          .lateralFillRightFirstByteLoop
  8530  d514 204bd5                 JSR .lateralFillRightPartialByte                    ;
  8531  d517 9027                   BCC .lateralFillRightDone                           ;
  8532                          
  8533                          .lateralFillRightLoop
  8534  d519 20edd3                 JSR .moveGraphicsCursorAddressTotheRightAndUpdateMask ;
  8535  d51c b1d6                   LDA (.vduScreenAddressOfGraphicsCursorCellLow),Y    ; get byte from graphics line
  8536  d51e 4d5a03                 EOR .vduBackgroundGraphicsColour                    ; EOR with background colour
  8537  d521 85da                   STA .vduTempStoreDA                                 ; and store it
  8538  d523 a5dc                   LDA .vduTempStoreDC                                 ;
  8539  d525 d0ed                   BNE .lateralFillRightFirstByteLoop                  ; if (A is not zero) then branch (loop back)
  8540                          
  8541  d527 a5da                   LDA .vduTempStoreDA                                 ; A=.vduTempStoreDA
  8542  d529 d012                   BNE .lateralFillRightNearlyDone                     ; if (A is not zero) then branch
  8543                          
  8544                              ; found byte with background colour
  8545  d52b 38                     SEC                                                 ; }
  8546  d52c 8a                     TXA                                                 ; }
  8547  d52d 6d6103                 ADC .vduPixelsPerByteMinusOne                       ; }
  8548  d530 9004                   BCC +                                               ; }
  8549  d532 e6db                   INC .vduTempStoreDB                                 ; } (X, .vduTempStoreDB) +=
  8550                                                                                  ; } pixels per byte
  8551  d534 1007                   BPL .lateralFillRightNearlyDone                     ; }
  8552                          +                                                       ; }
  8553  d536 aa                     TAX                                                 ; }
  8554                          
  8555                              ; plot a byte in the foreground colour using GCOL options
  8556  d537 2004d1                 JSR .plotByte                                       ; plot a byte
  8557                          
  8558  d53a 38                     SEC                                                 ; set carry
  8559  d53b b0dc                   BCS .lateralFillRightLoop                           ; ALWAYS branch (loop back)
  8560                          
  8561                          ; ***************************************************************************************
  8562                          .lateralFillRightNearlyDone
  8563  d53d 204bd5                 JSR .lateralFillRightPartialByte                    ;
  8564                          
  8565                          .lateralFillRightDone
  8566  d540 a004                   LDY #4                                              ;
  8567  d542 20acd5                 JSR .lateralFillSetParamAtGivenDistanceFromEdge     ;
  8568                              ; fall through...
  8569                          
  8570                          ; ***************************************************************************************
  8571                          .setNextPixelPosition
  8572  d545 20d9d0                 JSR .plotMoveGraphicsCursorInAbsolutePixels         ; set graphics cursor position
  8573  d548 4cb8d1                 JMP .convertPixelGraphicsCoordinatesToExternal      ; scale positions
  8574                          
  8575                          ; ***************************************************************************************
  8576                          .lateralFillRightPartialByte
  8577  d54b a5d1                   LDA .vduCurrentPlotByteMask                         ; get byte mask
  8578  d54d 48                     PHA                                                 ; save it
  8579  d54e 18                     CLC                                                 ; clear carry
  8580  d54f 900f                   BCC .lateralFillRightGetMask                        ; ALWAYS branch
  8581                          
  8582                          ; ***************************************************************************************
  8583                          .lateralFillRightGetMaskLoop
  8584  d551 68                     PLA                                                 ; get back A
  8585  d552 e8                     INX                                                 ; X=X+1
  8586  d553 d004                   BNE +                                               ; if (not zero) then branch
  8587  d555 e6db                   INC .vduTempStoreDB                                 ;
  8588  d557 1016                   BPL .lateralFillSaveMaskAndPlotPoint                ; if (+ve) then branch
  8589                          
  8590                          +
  8591  d559 46d1                   LSR .vduCurrentPlotByteMask                         ; shift mask
  8592  d55b b012                   BCS .lateralFillSaveMaskAndPlotPoint                ; if (carry set) then branch
  8593  d55d 05d1                   ORA .vduCurrentPlotByteMask                         ; OR with mask
  8594  d55f 48                     PHA                                                 ; save result
  8595                              ; fall through...
  8596                          
  8597                          ; ***************************************************************************************
  8598                          .lateralFillRightGetMask
  8599  d560 a5d1                   LDA .vduCurrentPlotByteMask                         ; A=.vduCurrentPlotByteMask
  8600  d562 24da                   BIT .vduTempStoreDA                                 ; test bits of .vduTempStoreDA
  8601  d564 08                     PHP                                                 ; }
  8602  d565 68                     PLA                                                 ; }
  8603  d566 45dc                   EOR .vduTempStoreDC                                 ; } flags = flags EOR .vduTempStoreDC
  8604  d568 48                     PHA                                                 ; }
  8605  d569 28                     PLP                                                 ; }
  8606  d56a f0e5                   BEQ .lateralFillRightGetMaskLoop                    ;
  8607  d56c 68                     PLA                                                 ;
  8608  d56d 45d1                   EOR .vduCurrentPlotByteMask                         ; A=A EOR .vduCurrentPlotByteMask (byte mask)
  8609                          
  8610                          .lateralFillSaveMaskAndPlotPoint
  8611  d56f 85d1                   STA .vduCurrentPlotByteMask                         ; store it
  8612  d571 4cf0d0                 JMP .plotPointWithinBounds                          ; and display a pixel
  8613                          
  8614                          ; ***************************************************************************************
  8615                          .lateralFillLeftPartialByte
  8616  d574 a900                   LDA #0                                              ; A=0
  8617  d576 18                     CLC                                                 ; Clear carry
  8618  d577 900a                   BCC .lateralFillLeftGetMask                         ; ALWAYS branch
  8619                          
  8620                          ; ***************************************************************************************
  8621                          .lateralFillLeftGetMaskLoop
  8622  d579 e8                     INX                                                 ; X=X+1
  8623  d57a d004                   BNE +                                               ; if (X is not zero) then branch
  8624  d57c e6db                   INC .vduTempStoreDB                                 ; inc .vduTempStoreDB
  8625  d57e 10ef                   BPL .lateralFillSaveMaskAndPlotPoint                ; if (+ve) then branch
  8626                          +
  8627  d580 0a                     ASL                                                 ; A=A*2
  8628  d581 b00b                   BCS .lateralFillLeftGotMaskNowPlotPoint             ; if (C set) then branch
  8629                          
  8630                          .lateralFillLeftGetMask
  8631  d583 05d1                   ORA .vduCurrentPlotByteMask                         ; A=A OR (.vduCurrentPlotByteMask)
  8632  d585 24da                   BIT .vduTempStoreDA                                 ;
  8633  d587 f0f0                   BEQ .lateralFillLeftGetMaskLoop                     ;
  8634  d589 45d1                   EOR .vduCurrentPlotByteMask                         ; A=A EOR .vduCurrentPlotByteMask
  8635  d58b 4a                     LSR                                                 ; divide by 2
  8636  d58c 90e1                   BCC .lateralFillSaveMaskAndPlotPoint                ; if (carry clear) then branch
  8637                          
  8638                          .lateralFillLeftGotMaskNowPlotPoint
  8639  d58e 6a                     ROR                                                 ; A=A/2 (final step to get mask)
  8640  d58f 38                     SEC                                                 ; set carry
  8641  d590 b0dd                   BCS .lateralFillSaveMaskAndPlotPoint                ; ALWAYS branch
  8642                          
  8643                          ; ***************************************************************************************
  8644                          ;
  8645                          ; Get width of parameter point to graphics window edge
  8646                          ;
  8647                          ; On Entry:
  8648                          ;       X = 0 (left edge) or 4 (right edge)
  8649                          ;
  8650                          ; On Exit:
  8651                          ;       .vduTempStoreDB is the negation of the width (high byte)
  8652                          ;       X = Y =         the negation of the width (low byte)
  8653                          ;       A = 0 (and Z=0) if there is zero width
  8654                          ;
  8655                          ; ***************************************************************************************
  8656                          .lateralFillGetWidthToWindowEdge
  8657  d592 bd0003                 LDA .vduGraphicsWindowPixelsLeftLow,X               ; }
  8658  d595 38                     SEC                                                 ; }
  8659  d596 ed2003                 SBC .vdu25ParameterXLow                             ; }
  8660  d599 a8                     TAY                                                 ; } AY = window left/right - paramX
  8661  d59a bd0103                 LDA .vduGraphicsWindowPixelsLeftHigh,X              ; }
  8662  d59d ed2103                 SBC .vdu25ParameterXHigh                            ; }
  8663                          
  8664  d5a0 3003                   BMI +                                               ; }
  8665  d5a2 209bd4                 JSR .negateAY                                       ; } make sure AY is negative
  8666                          +
  8667  d5a5 85db                   STA .vduTempStoreDB                                 ; store A (high coordinate)
  8668  d5a7 98                     TYA                                                 ; A = low coordinate
  8669  d5a8 aa                     TAX                                                 ; X = low coordinate
  8670  d5a9 05db                   ORA .vduTempStoreDB                                 ; A = low OR high coordinate (checking for zero width?)
  8671  d5ab 60                     RTS                                                 ;
  8672                          
  8673                          ; ***************************************************************************************
  8674                          ;
  8675                          ; Set parameter X coordinate to the given distance from the left/right edge of the window
  8676                          ;
  8677                          ; On Entry:
  8678                          ;       X, .vduTempStoreDB is negated distance to left/right edge of window
  8679                          ;       Y is 0 (left edge of graphics window)
  8680                          ;         or 4 (right edge of graphics window)
  8681                          ;
  8682                          ; ***************************************************************************************
  8683                          .lateralFillSetParamAtGivenDistanceFromEdge
  8684  d5ac 84da                   STY .vduTempStoreDA                                 ; Y=.vduTempStoreDA
  8685  d5ae 8a                     TXA                                                 ; A=X
  8686  d5af a8                     TAY                                                 ; Y=A=X
  8687  d5b0 a5db                   LDA .vduTempStoreDB                                 ; A=.vduTempStoreDB
  8688  d5b2 3002                   BMI +                                               ; if (-ve) then branch
  8689  d5b4 a900                   LDA #0                                              ; A=0
  8690                          
  8691                              ; at this point AY = width to add to edge of window
  8692                              ; but if we are looking at the left edge, then negate AY first
  8693                          +
  8694  d5b6 a6da                   LDX .vduTempStoreDA                                 ; X=.vduTempStoreDA
  8695  d5b8 d003                   BNE +                                               ; if (X is not zero) then branch
  8696  d5ba 209bd4                 JSR .negateAY                                       ; negate
  8697                          +
  8698  d5bd 48                     PHA                                                 ; }
  8699  d5be 18                     CLC                                                 ; }
  8700  d5bf 98                     TYA                                                 ; }
  8701  d5c0 7d0003                 ADC .vduGraphicsWindowPixelsLeftLow,X               ; } paramX = AY + window left/right edge
  8702  d5c3 8d2003                 STA .vdu25ParameterXLow                             ; }
  8703  d5c6 68                     PLA                                                 ; }
  8704  d5c7 7d0103                 ADC .vduGraphicsWindowPixelsLeftHigh,X              ; }
  8705  d5ca 8d2103                 STA .vdu25ParameterXHigh                            ; }
  8706  d5cd 60                     RTS                                                 ;
  8707                          
  8708                          
  8709                          ; ***************************************************************************************
  8710                          ;
  8711                          ; OSWORD 13 - Read last two graphic cursor positions
  8712                          ;
  8713                          ; On Entry:
  8714                          ;       .oswordX/Y is the address of the eight bytes of parameters for the result
  8715                          ;
  8716                          ; On Exit:
  8717                          ;       The eight bytes at .oswordX/Y hold the result:
  8718                          ;           byte 0: Previous X (low byte)
  8719                          ;           byte 1: Previous X (high byte)
  8720                          ;           byte 2: Previous Y (low byte)
  8721                          ;           byte 3: Previous Y (high byte)
  8722                          ;           byte 4: Current X (low byte)
  8723                          ;           byte 5: Current X (high byte)
  8724                          ;           byte 6: Current Y (low byte)
  8725                          ;           byte 7: Current Y (high byte)
  8726                          ;
  8727                          ; ***************************************************************************************
  8728                          .osword13EntryPoint
  8729  d5ce a903                   LDA #3                                              ; A=3 (offset into oswordX block)
  8730  d5d0 20d5d5                 JSR +                                               ;
  8731  d5d3 a907                   LDA #7                                              ; A=7 (offset into oswordX block)
  8732                          +
  8733  d5d5 48                     PHA                                                 ; Save A
  8734  d5d6 20e2cd                 JSR .exchangeGraphicsCursorWithOldPosition          ; exchange old graphics cursor position with current
  8735  d5d9 20b8d1                 JSR .convertPixelGraphicsCoordinatesToExternal      ; convert to external coordinates
  8736  d5dc a203                   LDX #3                                              ; X=3
  8737  d5de 68                     PLA                                                 ; save A
  8738  d5df a8                     TAY                                                 ; Y=A
  8739                          -
  8740  d5e0 bd1003                 LDA .vduGraphicsCursorPositionXLow,X                ; get graphics coordinate
  8741  d5e3 91f0                   STA (.oswordX),Y                                    ; store it in OS buffer
  8742  d5e5 88                     DEY                                                 ; decrement Y and X
  8743  d5e6 ca                     DEX                                                 ;
  8744  d5e7 10f7                   BPL -                                               ; if (+ve) then branch (loop back)
  8745  d5e9 60                     RTS                                                 ;
  8746                          
  8747                          
  8748                          ; ***************************************************************************************
  8749                          ;
  8750                          ; Fill triangle
  8751                          ;
  8752                          ; A filled triangle is drawn. It is drawn in rows from the bottom of the triangle to the top.
  8753                          ;
  8754                          ; Here we define the 'main line' as the edge of the triangle from the bottommost vertex
  8755                          ; to the topmost vertex. The other two edges are the lower and upper 'minor lines'.
  8756                          ;
  8757                          ; The triangle is drawn in two 'halves'. The first 'half' is for the rows of lower minor line,
  8758                          ; and the second 'half' is for the rows of upper minor line. See the diagram below.
  8759                          ;
  8760                          ; On Entry:
  8761                          ;       .vdu25ParameterLow/High             }
  8762                          ;       .vduGraphicsCursorPixels            } three points that define the triangle
  8763                          ;       .vduOldGraphicsCursorPixels         }
  8764                          ;
  8765                          ; ***************************************************************************************
  8766                          .plotFillTriangle
  8767                              ; store variables
  8768  d5ea a220                   LDX #.vdu25ParameterXLow - .vduVariablesStart              ; X = source: parameter
  8769  d5ec a03e                   LDY #.vduPlotTriStorageForCoordinates - .vduVariablesStart ; Y = destination: storage
  8770  d5ee 207cd4                 JSR .copyEightBytesWithinVDUVariables               ; remember the parameter position and
  8771                                                                                  ; the current graphics cursor
  8772                                                                                  ; position.
  8773                          
  8774                              ; sort the three points of the triangle into order vertically
  8775  d5f1 2032d6                 JSR .sortParameterPointAndOldPosition                     ; }
  8776  d5f4 a214                   LDX #.vduOldGraphicsCursorPixelsXLow - .vduVariablesStart ; }
  8777  d5f6 a024                   LDY #.vduGraphicsCursorPixelsXLow - .vduVariablesStart    ; } sort positions by Y
  8778  d5f8 2036d6                 JSR .sortCoordinatesXY                                    ; } coordinate
  8779  d5fb 2032d6                 JSR .sortParameterPointAndOldPosition                     ; }
  8780                          
  8781                              ; The three points of the triangle (now sorted from lowest to highest) are:
  8782                              ;
  8783                              ;                                               ##  <-.vduGraphicsCursorPixels
  8784                              ;                                             ###      /|\
  8785                              ;                                           ##  #       |
  8786                              ;                     upper minor line->  ##   #        |
  8787                              ;                                       ##     #        | second 'half' of triangle
  8788                              ;                                     ##      #         | to draw
  8789                              ;                                   ##        #         |
  8790                              ;                                 ##         #         \|/
  8791                              ; .vduOldGraphicsCursorPixels->  #           #         /|\
  8792                              ;                                 #         #           |
  8793                              ;                                 #         #  <-main   |
  8794                              ;                                  #       #     line   |
  8795                              ;                                  #       #            |
  8796                              ;               lower minor line->  #     #             | first 'half' of triangle
  8797                              ;                                   #     #             | to draw
  8798                              ;                                    #   #              |
  8799                              ;                                    #   #              |
  8800                              ;                                     # #               |
  8801                              ;                                     # #               |
  8802                              ;                                      #               \|/
  8803                              ;                                      #  <-.vdu25Parameter
  8804                              ;
  8805                          
  8806                              ; get the dX, dY for the main line
  8807  d5fe a220                   LDX #.vdu25ParameterXLow - .vduVariablesStart       ; X = source (parameter and graphics
  8808                                                                                  ;             cursor)
  8809                                                                                  ;  offset 0,1,2,3 = parameter
  8810                                                                                  ;  offset 4,5,6,7 = graphics cursor
  8811  d600 a02a                   LDY #.vduPlotTriMainLineDeltaXLow - .vduVariablesStart ; Y = destination (main line delta)
  8812  d602 2011d4                 JSR .coordinateSubtraction                          ; maindelta = (graphics cursor-param)
  8813                          
  8814  d605 ad2b03                 LDA .vduPlotTriMainLineDeltaXHigh                   ;
  8815  d608 8d3203                 STA .vduPlotTriMainLineXDirectionFlag               ; store high byte of delta X to
  8816                                                                                  ; use as a flag when updating our
  8817                                                                                  ; position.
  8818                                                                                  ; See .fillTriangleUpdateLinePosition
  8819                          
  8820                              ; initialise variables for the main line
  8821  d60b a228                   LDX #.vduPlotTriMainLineErrorTermLow - .vduVariablesStart ;
  8822  d60d 2059d4                 JSR .lineInitialisation                             ; Initialise variables for the main
  8823                                                                                  ; line. This makes the deltas positive
  8824                                                                                  ; and initialises the error term.
  8825                          
  8826                              ; copy .vdu25Parameter to current main edge point
  8827  d610 a02e                   LDY #.vduPlotTriMainLineCurrentPointXLow - .vduVariablesStart ; }
  8828  d612 20ded0                 JSR .copyParameterPointToDestinationY                         ; } main edge point = parameter point
  8829                          
  8830                              ; swap graphics cursor points
  8831  d615 20e2cd                 JSR .exchangeGraphicsCursorWithOldPosition          ;
  8832                          
  8833                              ; fill the bottom half of the triangle
  8834  d618 18                     CLC                                                 ; clear carry
  8835  d619 2058d6                 JSR .plotFillTriangleHalf                           ; fill bottom 'half' of triangle
  8836                          
  8837                              ; swap graphics cursor points back
  8838  d61c 20e2cd                 JSR .exchangeGraphicsCursorWithOldPosition          ;
  8839                          
  8840                              ; swap parameter point with old graphics cursor
  8841  d61f a220                   LDX #.vdu25ParameterXLow - .vduVariablesStart       ;
  8842  d621 20e4cd                 JSR .exchangeOldGraphicsCursorPositionWithVariableX ;
  8843                          
  8844                              ; Now our triangle looks like this:
  8845                              ;                                               ##  <-.vduGraphicsCursorPixels
  8846                              ;                                             ###      /|\
  8847                              ;                                           ##  #       |
  8848                              ;                     upper minor line->  ##   #        |
  8849                              ;                                       ##     #        | second 'half' of triangle
  8850                              ;                                     ##      #         | to draw
  8851                              ;                                   ##        #         |
  8852                              ;                                 ##         #         \|/
  8853                              ;             .vdu25Parameter->  #############         /|\
  8854                              ;                                 ###########           |
  8855                              ;                                 ###########  <-main   |
  8856                              ;                                  #########     line   |
  8857                              ;                                  #########            |
  8858                              ;               lower minor line->  #######             | first 'half' of triangle
  8859                              ;                                   #######             | is filled
  8860                              ;                                    #####              |
  8861                              ;                                    #####              |
  8862                              ;                                     ###               |
  8863                              ;                                     ###               |
  8864                              ;                                      #               \|/
  8865                              ;                                      #  <-.vduOldGraphicsCursorPixels
  8866                              ;
  8867                              ; It is now half filled, and the parameters of the vertices have been swapped ready for
  8868                              ; filling the second half.
  8869                          
  8870                              ; fill the top half of the triangle
  8871  d624 38                     SEC                                                 ; set carry
  8872  d625 2058d6                 JSR .plotFillTriangleHalf                           ; fill top 'half' of triangle
  8873                          
  8874                              ; restore parameter point and graphics cursor variables back to where they started.
  8875  d628 a23e                   LDX #.vduPlotTriStorageForCoordinates - .vduVariablesStart ; X = source
  8876  d62a a020                   LDY #.vdu25ParameterXLow - .vduVariablesStart              ; Y = destination
  8877  d62c 207cd4                 JSR .copyEightBytesWithinVDUVariables               ; restore original parameter position
  8878                                                                                  ; and graphics cursor position
  8879                          
  8880                              ; move the graphics cursor to the new parameter point, and return
  8881  d62f 4cd9d0                 JMP .plotMoveGraphicsCursorInAbsolutePixels         ;
  8882                          
  8883                          
  8884                          ; ***************************************************************************************
  8885                          ;
  8886                          ; Sort the parameter point and the old graphics cursor point, sorting by Y coordinate
  8887                          ;
  8888                          ; if (parameter point is higher or level with old graphics cursor) then swap points in place
  8889                          ;
  8890                          ; ***************************************************************************************
  8891                          .sortParameterPointAndOldPosition
  8892  d632 a220                   LDX #.vdu25ParameterXLow - .vduVariablesStart               ; } Sort paramX and old
  8893  d634 a014                   LDY #.vduOldGraphicsCursorPixelsXLow - .vduVariablesStart   ; } graphics position X
  8894                              ; fall through...
  8895                          
  8896                          ; ***************************************************************************************
  8897                          ;
  8898                          ; Sort one point with another, sorting by Y coordinate
  8899                          ;
  8900                          ; given two pairs of coordinates (one indexed by register X the other by register Y), sort
  8901                          ; them by their Y coordinates (lowest first)
  8902                          ;
  8903                          ; if (point X is higher or level with point Y) then swap points in place
  8904                          ;
  8905                          ; ***************************************************************************************
  8906                          .sortCoordinatesXY
  8907  d636 bd0203                 LDA .vduVariablesStart + 2,X                        ; Y coordinate low byte
  8908  d639 d90203                 CMP .vduVariablesStart + 2,Y                        ; Y coordinate low byte
  8909  d63c bd0303                 LDA .vduVariablesStart + 3,X                        ; Y coordinate high byte
  8910  d63f f90303                 SBC .vduVariablesStart + 3,Y                        ; Y coordinate high byte
  8911  d642 3013                   BMI .exit10                                         ; if (Y coordinates of variable indexed by Y > Y coordinate of variable indexed by X) then branch (return)
  8912  d644 4ce6cd                 JMP .exchangeFourBytes                              ; swap coordinates
  8913                          
  8914                          
  8915                          ; ***************************************************************************************
  8916                          ;
  8917                          ; OSBYTE 134 - Read text cursor position
  8918                          ;
  8919                          ; ***************************************************************************************
  8920                          .osbyte134EntryPoint
  8921  d647 ad1803                 LDA .vduTextCursorXPosition                         ; read current text cursor X position
  8922  d64a 38                     SEC                                                 ; }
  8923  d64b ed0803                 SBC .vduTextWindowLeft                              ; } subtract text window left position
  8924  d64e aa                     TAX                                                 ; X = text cursor X - text window left
  8925  d64f ad1903                 LDA .vduTextCursorYPosition                         ; get current text cursor Y position
  8926  d652 38                     SEC                                                 ; }
  8927  d653 ed0b03                 SBC .vduTextWindowTop                               ; } subtract text window top position
  8928  d656 a8                     TAY                                                 ; Y = text cursor Y - text window top
  8929                          .exit10
  8930  d657 60                     RTS                                                 ;
  8931                          
  8932                          
  8933                          ; ***************************************************************************************
  8934                          ;
  8935                          ; Fill half a triangle
  8936                          ;
  8937                          ; Draws rows of a triangle from bottom to top following the main line and the minor line
  8938                          ; as edges, until we reach the top of the minor line. See .plotFillTriangle. The minor line
  8939                          ; starts at the parameter point and moves up the screen to the current graphics point.
  8940                          ;
  8941                          ; On Entry:
  8942                          ;       Carry clear = first half of triangle is being drawn
  8943                          ;       Carry set = second half of triangle is being drawn
  8944                          ;
  8945                          ; ***************************************************************************************
  8946                          .plotFillTriangleHalf
  8947  d658 08                     PHP                                                 ; store flags
  8948                          
  8949                              ; find the dX, dY for the minor line
  8950  d659 a220                   LDX #.vdu25ParameterXLow - .vduVariablesStart           ; X = src (offset 4=graphics cursor)
  8951  d65b a035                   LDY #.vduPlotTriMinorLineDeltaXLow - .vduVariablesStart ; Y = destination (minor delta)
  8952  d65d 2011d4                 JSR .coordinateSubtraction                          ; minor delta = graphics cursor - param
  8953                          
  8954                              ; Get and store the sign of the delta in X, so we know which way to update in X later.
  8955                              ; See .fillTriangleUpdateLinePosition.
  8956  d660 ad3603                 LDA .vduPlotTriMinorLineDeltaXHigh                  ; get high byte of deltaX
  8957  d663 8d3d03                 STA .vduPlotTriMinorLineXDirectionFlag              ; store as flag
  8958                          
  8959                              ; initialise the minor line variables:
  8960                              ;       .vduPlotTriMinorLineDeltaX = ABS(.vduPlotTriMinorLineDeltaX)
  8961                              ;       .vduPlotTriMinorLineDeltaY = ABS(.vduPlotTriMinorLineDeltaY)
  8962                              ;       .vduPlotTriMinorLineErrorTerm = .vduPlotTriMinorLineDeltaY / 2
  8963  d666 a233                   LDX #.vduPlotTriMinorLineErrorTermLow - .vduVariablesStart ;
  8964  d668 2059d4                 JSR .lineInitialisation
  8965                          
  8966                              ; initialise current point on the minor line
  8967  d66b a039                   LDY #.vduPlotTriMinorLineCurrentPointXLow - .vduVariablesStart ;
  8968  d66d 20ded0                 JSR .copyParameterPointToDestinationY               ; current minor line point = parameter point
  8969                          
  8970                              ; calculate triangle fill 'height' = parameter point Y - graphics cursor height
  8971                              ; this is actually the negative of the height to fill, which we use as a loop counter
  8972  d670 38                     SEC                                                 ; }
  8973  d671 ad2203                 LDA .vdu25ParameterYLow                             ; }
  8974  d674 ed2603                 SBC .vduGraphicsCursorPixelsYLow                    ; }
  8975  d677 8d1b03                 STA .vduTriangleFillHeightLow                       ; }
  8976  d67a ad2303                 LDA .vdu25ParameterYHigh                            ; } height = paramY - cursorY
  8977  d67d ed2703                 SBC .vduGraphicsCursorPixelsYHigh                   ; }
  8978  d680 8d1c03                 STA .vduTriangleFillHeightHigh                      ; }
  8979  d683 0d1b03                 ORA .vduTriangleFillHeightLow                       ; check number of rows to draw
  8980  d686 f017                   BEQ +                                               ; if (no rows to draw) then branch (finish up)
  8981                          
  8982                              ; loop to fill each row (.vduTriangleFillHeight is the loop counter, counting up)
  8983                          .plotFillTriangleHalfLoop
  8984  d688 20a2d6                 JSR .fillRowLeftToRightBetweenMainAndMinorLines     ; fill one row
  8985                          
  8986                              ; update the minor line position
  8987  d68b a233                   LDX #.vduPlotTriMinorLineErrorTermLow - .vduVariablesStart  ;
  8988  d68d 2074d7                 JSR .fillTriangleUpdateLinePosition                         ;
  8989                          
  8990                              ; update the main line position
  8991  d690 a228                   LDX #.vduPlotTriMainLineErrorTermLow - .vduVariablesStart   ;
  8992  d692 2074d7                 JSR .fillTriangleUpdateLinePosition                         ;
  8993                          
  8994                              ; increment the loop counter until we hit zero
  8995  d695 ee1b03                 INC .vduTriangleFillHeightLow                       ; update loop counter (low)
  8996  d698 d0ee                   BNE .plotFillTriangleHalfLoop                       ; if (counter not done yet) then branch (loop back and do it again)
  8997  d69a ee1c03                 INC .vduTriangleFillHeightHigh                      ; increment loop counter (high)
  8998  d69d d0e9                   BNE .plotFillTriangleHalfLoop                       ; if (counter not done yet) then branch (loop back and do it again)
  8999                          
  9000                              ; finish up
  9001                          +
  9002  d69f 28                     PLP                                                 ; pull flags
  9003  d6a0 90b5                   BCC .exit10                                         ; if (carry clear) then branch (exit)
  9004                          
  9005                              ; At this point carry is set (we are drawing the top half of the triangle). We draw the
  9006                              ; final row at top of the triangle...
  9007                          
  9008                          .fillRowLeftToRightBetweenMainAndMinorLines
  9009  d6a2 a239                   LDX #.vduPlotTriMinorLineCurrentPointXLow - .vduVariablesStart  ;
  9010  d6a4 a02e                   LDY #.vduPlotTriMainLineCurrentPointXLow - .vduVariablesStart   ;
  9011                              ; fall through...
  9012                          
  9013                          ; ***************************************************************************************
  9014                          ;
  9015                          ; Fill a single horizontal row
  9016                          ;
  9017                          ; Used as part of clearing the graphics window or filling a triangle.
  9018                          ;
  9019                          ; On Entry:
  9020                          ;       X = offset into VDU variables for one extreme graphics pixel X coordinate
  9021                          ;       Y = offset into VDU variables for the other extreme graphics pixel X coordinate
  9022                          ;
  9023                          ; ***************************************************************************************
  9024                          .fillRow
  9025  d6a6 86de                   STX .vduTempStoreDE                                 ;
  9026  d6a8 bd0003                 LDA .vduVariablesStart,X                            ; }
  9027  d6ab d90003                 CMP .vduVariablesStart,Y                            ; }
  9028  d6ae bd0103                 LDA .vduVariablesStart + 1,X                        ; } if (leftmost <= rightmost) then branch
  9029  d6b1 f90103                 SBC .vduVariablesStart + 1,Y                        ; }
  9030  d6b4 3006                   BMI +                                               ; }
  9031                          
  9032  d6b6 98                     TYA                                                 ; }
  9033  d6b7 a4de                   LDY .vduTempStoreDE                                 ; }
  9034  d6b9 aa                     TAX                                                 ; } swap X and Y so (leftmost < rightmost)
  9035  d6ba 86de                   STX .vduTempStoreDE                                 ; }
  9036                          +
  9037  d6bc 84df                   STY .vduTempStoreDF                                 ; .vduTempStoreDF=offset to leftmost coordinate
  9038  d6be b90003                 LDA .vduVariablesStart,Y                            ;
  9039  d6c1 48                     PHA                                                 ;
  9040  d6c2 b90103                 LDA .vduVariablesStart + 1,Y                        ;
  9041  d6c5 48                     PHA                                                 ; push graphics window left edge coordinate
  9042  d6c6 a6df                   LDX .vduTempStoreDF                                    ; check leftmost coordinate
  9043  d6c8 200fd1                 JSR .checkPointXIsWithinGraphicsWindow              ; check window bounds
  9044  d6cb f00d                   BEQ +                                               ; if (within bounds) then branch
  9045                          
  9046                              ; out of bounds. Work out what to do.
  9047  d6cd c902                   CMP #2                                              ; }
  9048  d6cf d03d                   BNE .donePlottingPoints                             ; } if (reason for being out of bounds
  9049                                                                                  ; } is not just that it's too far
  9050                                                                                  ; } right) then branch (finish up)
  9051                          
  9052                              ; out of bounds (point is right of the right hand edge of the graphics window)
  9053  d6d1 a204                   LDX #.vduGraphicsWindowPixelsRightLow - .vduVariablesStart ; source = right edge of graphics window
  9054  d6d3 a4df                   LDY .vduTempStoreDF                                 ; destination = leftmost pixel coordinate
  9055  d6d5 2082d4                 JSR .copyTwoBytesWithinVDUVariables                 ; copy coordinate
  9056  d6d8 a6df                   LDX .vduTempStoreDF                                 ; X = offset to leftmost pixel coordinate
  9057                          +
  9058  d6da 2064d8                 JSR .setScreenAddress                               ; set a screen address
  9059  d6dd a6de                   LDX .vduTempStoreDE                                 ; X=offset to rightmost pixel X coordinate
  9060  d6df 200fd1                 JSR .checkPointXIsWithinGraphicsWindow              ; check window bounds
  9061                          
  9062  d6e2 4a                     LSR                                                 ; A = reason for being offscreen / 2
  9063                                                                                  ; (checks for offscreen to the right / up / down)
  9064  d6e3 d029                   BNE .donePlottingPoints                             ; if (point is offscreen to the right, up or down) then branch (finish up)
  9065  d6e5 9002                   BCC +                                               ; if (not outside bounds to the left of the graphics window) then branch
  9066                          
  9067                              ; out of bounds (point is left of the graphics window left edge)
  9068  d6e7 a200                   LDX #.vduGraphicsWindowPixelsLeftLow - .vduVariablesStart  ; outside the left edge, leftmost = left edge instead.
  9069                          +
  9070  d6e9 a4df                   LDY .vduTempStoreDF                                 ; Y = offset to leftmost pixel coordinate
  9071  d6eb 38                     SEC                                                 ;
  9072  d6ec b90003                 LDA .vduVariablesStart,Y                            ; }
  9073  d6ef fd0003                 SBC .vduVariablesStart,X                            ; }
  9074  d6f2 85dc                   STA .vduTempStoreDC                                 ; } tempStoreDC/DD = width of row to fill (rightmost - leftmost)
  9075  d6f4 b90103                 LDA .vduVariablesStart + 1,Y                        ; }
  9076  d6f7 fd0103                 SBC .vduVariablesStart + 1,X                        ; }
  9077  d6fa 85dd                   STA .vduTempStoreDD                                 ; }
  9078                          
  9079                              ; First calculate leftmost byte to write
  9080  d6fc a900                   LDA #0                                              ;
  9081                          -
  9082  d6fe 0a                     ASL                                                 ; shift current mask left
  9083  d6ff 05d1                   ORA .vduCurrentPlotByteMask                         ; OR in the mask for a pixel
  9084  d701 a4dc                   LDY .vduTempStoreDC                                 ; } get low byte (as decremented by .calculateLeftmostByte)
  9085  d703 d014                   BNE .calculateLeftmostByte                          ; } check to see if we are done yet (check if width = 0)
  9086  d705 c6dd                   DEC .vduTempStoreDD                                 ; } decrement high byte if needed
  9087  d707 1010                   BPL .calculateLeftmostByte                          ; } if (width > 0, i.e. not done yet) then branch
  9088                          
  9089                              ; we get here if width is now zero, i.e. the leftmost byte is all we needed to draw
  9090  d709 85d1                   STA .vduCurrentPlotByteMask                         ;
  9091  d70b 20f0d0                 JSR .plotPointWithinBounds                          ; display final byte
  9092                          
  9093                          .donePlottingPoints
  9094                              ; we get here when we are done drawing all the pixels
  9095  d70e a6df                   LDX .vduTempStoreDF                                 ; restore X = offset to leftmost coordinate
  9096  d710 68                     PLA                                                 ; pull A
  9097  d711 9d0103                 STA .vduVariablesStart + 1,X                        ; restore left edge of graphics window
  9098  d714 68                     PLA                                                 ; pull A
  9099  d715 9d0003                 STA .vduVariablesStart,X                            ; restore left edge of graphics window
  9100  d718 60                     RTS                                                 ;
  9101                          
  9102                          ; ***************************************************************************************
  9103                          ;
  9104                          ; Calculate leftmost byte
  9105                          ;
  9106                          ; ***************************************************************************************
  9107                          .calculateLeftmostByte
  9108  d719 c6dc                   DEC .vduTempStoreDC                                 ; decrement width
  9109  d71b aa                     TAX                                                 ; check the pixel mask
  9110  d71c 10e0                   BPL -                                               ; loop back until mask has bit set in bit 7
  9111                          
  9112  d71e 85d1                   STA .vduCurrentPlotByteMask                         ; store the full mask
  9113  d720 20f0d0                 JSR .plotPointWithinBounds                          ; display a point (write leftmost byte to screen)
  9114                          
  9115  d723 a6dc                   LDX .vduTempStoreDC                                 ; }
  9116  d725 e8                     INX                                                 ; } increment width (was decremented
  9117  d726 d002                   BNE +                                               ; } one too many times)
  9118  d728 e6dd                   INC .vduTempStoreDD                                 ; }
  9119                          
  9120                              ; we are going to write a line of completely filled bytes.
  9121                              ; first calculate the number of bytes we need to fill (= width in pixels / pixels per byte)
  9122                          +
  9123  d72a 8a                     TXA                                                 ; A = X = width low byte
  9124  d72b 48                     PHA                                                 ; Push width (low)
  9125  d72c 46dd                   LSR .vduTempStoreDD                                 ; }
  9126  d72e 6a                     ROR                                                 ; } divide .vduTempStoreDD (high byte) and Accumulator (low byte) by two
  9127  d72f ac6103                 LDY .vduPixelsPerByteMinusOne                       ; get number of pixels/byte
  9128  d732 c003                   CPY #3                                              ; check for four colour MODEs
  9129  d734 f005                   BEQ +                                               ; if (four colour MODE) then branch (only divide by 2 once more)
  9130  d736 9006                   BCC .finishedGettingByteCount                       ; if (>four colour mode, i.e. MODE 2) then branch
  9131                          
  9132                              ; two colour mode
  9133  d738 46dd                   LSR .vduTempStoreDD                                 ; }
  9134  d73a 6a                     ROR                                                 ; } divide .vduTempStoreDD (high byte) and Accumulator (low byte) by two
  9135                          
  9136                              ; four colour mode
  9137                          +
  9138  d73b 46dd                   LSR .vduTempStoreDD                                 ; }
  9139  d73d 4a                     LSR                                                 ; } divide .vduTempStoreDD (high byte) and Accumulator (low byte) by two
  9140                          
  9141                          
  9142                              ; finished getting the number of bytes to fill. At this point the accumulator holds the
  9143                              ; number of filled bytes we need to draw
  9144                          .finishedGettingByteCount
  9145  d73e ac1a03                 LDY .vduGraphicsCursorVerticalOffsetInCell          ; Y=line in current graphics cell containing current point
  9146  d741 aa                     TAX                                                 ; X=number of bytes to fill
  9147  d742 f00f                   BEQ .finalByte                                      ; if (no full bytes to write) then branch (plot final byte)
  9148                          
  9149                              ; loop to fill all the complete bytes we can
  9150                          .loopPlotBytes
  9151  d744 98                     TYA                                                 ; }
  9152  d745 38                     SEC                                                 ; }
  9153  d746 e908                   SBC #8                                              ; } Y=Y-8, move to next cell left
  9154  d748 a8                     TAY                                                 ; }
  9155                          
  9156  d749 b002                   BCS +                                               ;
  9157  d74b c6d7                   DEC .vduScreenAddressOfGraphicsCursorCellHigh       ; decrement high byte of current graphics cursor
  9158                          +
  9159  d74d 2004d1                 JSR .plotByte                                       ; display a filled byte
  9160  d750 ca                     DEX                                                 ;
  9161  d751 d0f1                   BNE .loopPlotBytes                                  ; if (more bytes to fill) then branch (loop back)
  9162                          
  9163                              ; now we may need to plot some pixels into the final byte
  9164                          .finalByte
  9165  d753 68                     PLA                                                 ; restore pixel width
  9166  d754 2d6103                 AND .vduPixelsPerByteMinusOne                       ; check modulo pixels per byte
  9167  d757 f0b5                   BEQ .donePlottingPoints                             ; if (no remainder, i.e. no more pixels to write) then branch
  9168  d759 aa                     TAX                                                 ; remainder = loop counter
  9169  d75a a900                   LDA #0                                              ; A=0
  9170                          
  9171                          -
  9172  d75c 0a                     ASL                                                 ; shift A
  9173  d75d 0d6303                 ORA .vduColourMaskRight                             ; OR with right colour mask
  9174  d760 ca                     DEX                                                 ;
  9175  d761 d0f9                   BNE -                                               ; if (not done shifting the right colour mask) then branch (loop back)
  9176                          
  9177  d763 85d1                   STA .vduCurrentPlotByteMask                         ; store as byte mask
  9178  d765 98                     TYA                                                 ; }
  9179  d766 38                     SEC                                                 ; }
  9180  d767 e908                   SBC #8                                              ; } Y=Y-8
  9181  d769 a8                     TAY                                                 ; }
  9182  d76a b002                   BCS +                                               ; if (carry set) then branch
  9183  d76c c6d7                   DEC .vduScreenAddressOfGraphicsCursorCellHigh       ; decrement byte of top line off current graphics cursor cell
  9184                          +
  9185  d76e 20f3d0                 JSR .plotPointWithinBoundsAtY                       ; display final point
  9186  d771 4c0ed7                 JMP .donePlottingPoints                             ; jump to next point
  9187                          
  9188                          ; ***************************************************************************************
  9189                          ;
  9190                          ; Update one edge when filling a triangle
  9191                          ;
  9192                          ; Update the variables of one edge, looping if needed to move the position up by one row.
  9193                          ; We update either the 'main line' or the 'minor line'. See .plotFillTriangle.
  9194                          ;
  9195                          ; On Entry:
  9196                          ;       X = .vduPlotTriMainLineErrorTermLow  - .vduVariablesStart    to update the main edge
  9197                          ;       X = .vduPlotTriMinorLineErrorTermLow - .vduVariablesStart    to update the minor edge
  9198                          ;
  9199                          ; Offsets 0-10 from X are used in the code below and refer to:
  9200                          ;
  9201                          ;       0,1 = error term
  9202                          ;       2,3 = delta X
  9203                          ;       4,5 = delta Y
  9204                          ;       6,7 = current point X
  9205                          ;       8,9 = current point Y
  9206                          ;       10  = X direction flag (top bit set means decrement X, otherwise increment X)
  9207                          ;
  9208                          ; See .vduPlotTriMainLineErrorTermLow for the variables.
  9209                          ;
  9210                          ; ***************************************************************************************
  9211                          .fillTriangleUpdateLinePosition
  9212  d774 fe0803                 INC .vduVariablesStart + 8,X                        ; }
  9213  d777 d003                   BNE +                                               ; } Increment current Y position
  9214  d779 fe0903                 INC .vduVariablesStart + 9,X                        ; }
  9215                          +
  9216  d77c 38                     SEC                                                 ; }
  9217  d77d bd0003                 LDA .vduVariablesStart,X                            ; }
  9218  d780 fd0203                 SBC .vduVariablesStart + 2,X                        ; }
  9219  d783 9d0003                 STA .vduVariablesStart,X                            ; } error -= delta X
  9220  d786 bd0103                 LDA .vduVariablesStart + 1,X                        ; }
  9221  d789 fd0303                 SBC .vduVariablesStart + 3,X                        ; }
  9222  d78c 9d0103                 STA .vduVariablesStart + 1,X                        ; }
  9223  d78f 1030                   BPL .exit11                                         ; if (error >=0) then branch (exit)
  9224                          
  9225                          .fillTriangleUpdatePositionLoop
  9226  d791 bd0a03                 LDA .vduVariablesStart + 10,X                       ;
  9227  d794 300b                   BMI .fillTriangleMoveLeft                           ; if (X direction flag set) then branch
  9228                          
  9229                          .fillTriangleMoveRight
  9230  d796 fe0603                 INC .vduVariablesStart + 6,X                        ; }
  9231  d799 d011                   BNE .updateErrorTerm                                ; } increment current X
  9232  d79b fe0703                 INC .vduVariablesStart + 7,X                        ; }
  9233  d79e 4cacd7                 JMP .updateErrorTerm                                ; jump forward
  9234                          
  9235                          .fillTriangleMoveLeft
  9236  d7a1 bd0603                 LDA .vduVariablesStart + 6,X                        ; }
  9237  d7a4 d003                   BNE +                                               ; }
  9238  d7a6 de0703                 DEC .vduVariablesStart + 7,X                        ; } decrement current X
  9239                          +                                                       ; }
  9240  d7a9 de0603                 DEC .vduVariablesStart + 6,X                        ; }
  9241                          
  9242                          .updateErrorTerm
  9243  d7ac 18                     CLC                                                 ; }
  9244  d7ad bd0003                 LDA .vduVariablesStart,X                            ; }
  9245  d7b0 7d0403                 ADC .vduVariablesStart+4,X                          ; }
  9246  d7b3 9d0003                 STA .vduVariablesStart,X                            ; } error += deltaY
  9247  d7b6 bd0103                 LDA .vduVariablesStart+1,X                          ; }
  9248  d7b9 7d0503                 ADC .vduVariablesStart+5,X                          ; }
  9249  d7bc 9d0103                 STA .vduVariablesStart+1,X                          ; }
  9250  d7bf 30d0                   BMI .fillTriangleUpdatePositionLoop                 ; if (still on same row) then branch (loop back)
  9251                          
  9252                          .exit11
  9253  d7c1 60                     RTS                                                 ;
  9254                          
