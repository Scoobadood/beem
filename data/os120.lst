 15867  ed2b e90c                   SBC #12                                             ; subtract 12 for each octave
 15868  ed2d d0f5                   BNE -                                               ; if (not zero) then branch (loop back)
 15869                          
 15870                              ; at this point .soundPitchLow defines the Octave (0-5)
 15871                              ; A = the semitone within the octave
