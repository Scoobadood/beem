 19553  fa7a 8a                     TXA                                                 ; A = filename length
 19554  fa7b f003                   BEQ +                                               ; if (zero length) then branch (exit)
 19555  fa7d bdb203                 LDA .fsFilename,X                                   ; A = filename byte
 19556                          +
 19557  fa80 60                     RTS                                                 ;
 19558                          
 19559                          .checkCharacter
 19560  fa81 20e3e4                 JSR .isLetter                                       ; set carry if byte in A is NOT a letter
 19561  fa84 5db203                 EOR .fsFilename,X                                   ; compare with filename character
 19562  fa87 b002                   BCS +                                               ; if (carry set, i.e. not a letter) then branch
 19563  fa89 29df                   AND #$DF                                            ; convert to upper case
 19564                          +
 19565  fa8b f0e7                   BEQ .checkNextCharacter                             ; if (zero, i.e. filename characters match) then branch (check the next character)
 19566                          .exit34
 19567  fa8d 60                     RTS                                                 ;
