  9497                          ; ***************************************************************************************
  9498                          .splitIntoTwoCursors
  9499  d8ce 48                     PHA                                                 ; Push A
  9500  d8cf a9a0                   LDA #$A0                                            ; A=$A0
  9501  d8d1 ae6a02                 LDX .twosComplimentOfNumberOfBytesInVDUQueue        ; X=number of items in VDU queue
  9502  d8d4 d040                   BNE .pullAndReturn2                                 ; if (not 0) then branch
  9503  d8d6 24d0                   BIT .vduStatusByte                                  ; check VDU status byte
  9504  d8d8 d03c                   BNE .pullAndReturn2                                 ; if (either VDU is disabled, or plot to graphics cursor enabled) then branch (exit)
  9505  d8da 7019                   BVS +                                               ; if (cursor editing mode enabled) then branch
  9506  d8dc ad5f03                 LDA .vduLastCursorStartRegisterValue                ; get CRTC register start setting
  9507  d8df 299f                   AND #%10011111                                      ; clear bits 5 and 6
  9508  d8e1 0940                   ORA #%01000000                                      ; set bit 6 to modify last cursor size setting
  9509  d8e3 2054c9                 JSR .setCursorOnOrOff                               ; change cursor format
  9510  d8e6 a218                   LDX #.vduTextCursorXPosition - .vduVariablesStart          ; source = text cursor
  9511  d8e8 a064                   LDY #.vduTextInputCursorXCoordinate - .vduVariablesStart   ; destination = text input cursor
  9512  d8ea 2082d4                 JSR .copyTwoBytesWithinVDUVariables                 ; set text input cursor from text output cursor
  9513  d8ed 207acd                 JSR .restoreWriteCursor                             ; modify character at cursor position
  9514  d8f0 a902                   LDA #2                                              ;
  9515  d8f2 209dc5                 JSR .setVDUStatusByteFlags                          ; bit 1 of VDU status is set to bar scrolling
  9516                          +
  9517  d8f5 a9bf                   LDA #%10111111                                      ;
  9518  d8f7 20a8c5                 JSR .clearVDUStatusByteFlags                        ; bit 6 of VDU status (separated cursors) is set to zero
  9519  d8fa 68                     PLA                                                 ; Pull A
  9520  d8fb 297f                   AND #%01111111                                      ; clear high bit (7)
  9521  d8fd 20c0c4                 JSR .vduChrEntryPoint                               ; call VDU routine
  9522  d900 a940                   LDA #%01000000                                      ; set bit six (separate cursors)
  9523  d902 4c9dc5                 JMP .setVDUStatusByteFlags                          ; set separated cursors and return
  9524                          
  9525                          ; ***************************************************************************************
  9526                          .readCharacterFromScreenAndCursorRight
  9527  d905 a920                   LDA #%00100000                                      ; A=$20
  9528  d907 24d0                   BIT .vduStatusByte                                  ;
  9529  d909 50c0                   BVC .zeroAReturn                                    ; if (bit 6 clear; not in cursor editing mode) then branch (exit)
  9530  d90b d0be                   BNE .zeroAReturn                                    ; if (bit 5 set; graphics cursor enabled) then branch (exit)
  9531  d90d 20c2d7                 JSR .osbyte135EntryPoint                            ; read a character from the screen
  9532  d910 f005                   BEQ .exit12                                         ; if (A = 0, i.e. failed to read) then branch (exit)
  9533  d912 48                     PHA                                                 ; store A
  9534  d913 2064c6                 JSR .vdu9EntryPoint                                 ; perform cursor right
  9535                          .pullAndReturn2
  9536  d916 68                     PLA                                                 ; restore A
  9537                          .exit12
  9538  d917 60                     RTS                                                 ;
