 17835  f37e 48                     PHA                                                 ; save A on stack
 17836  f37f f02d                   BEQ .finishReadingBlockAndContinue                  ; if (A == 0, i.e. match anything) then branch
 17837  f381 2072fa                 JSR .compareFilenames                               ; check filename header block matches searched Fn
 17838  f384 d016                   BNE .messageAndFinishBlock                          ; if (filenames don't match) then branch
 17839  f386 a930                   LDA #%00110000                                      ;
 17840  f388 25bb                   AND .tapeCurrentOptionsByte                         ; check bits 4/5 of current options,
 17841                                                                                  ; checking for 'ignore errors'
 17842  f38a f00e                   BEQ .pullAAndReturn                                 ; if (ignore errors) then branch
 17843  f38c adc603                 LDA .fsBlockNumberLow                               ; block number
 17844  f38f c5b6                   CMP .nextBlockNumberLow                             ; next block number low
 17845  f391 d009                   BNE .messageAndFinishBlock                          ;
 17846  f393 adc703                 LDA .fsBlockNumberHigh                              ; block number high
 17847  f396 c5b7                   CMP .nextBlockNumberHigh                            ; next block number high
 17848  f398 d002                   BNE .messageAndFinishBlock                          ;
 17849                          
 17850                          .pullAAndReturn
 17851  f39a 68                     PLA                                                 ; get back A
 17852  f39b 60                     RTS                                                 ;
 17853                          
 17854                          .messageAndFinishBlock
 17855  f39c ad4702                 LDA .tapeOrROMSwitch                                ; filing system flag 0=tape; 2=ROMFS
 17856  f39f f00d                   BEQ .finishReadingBlockAndContinue                  ; if (tape filing system active) then branch
 17857                          
 17858                          .skipMessaging
 17859  f3a1 20adee                 JSR .setROMOrPHROMAddress                           ; set ROM address
 17860                          
 17861                          .resetBlockNumberAndContinue
 17862  f3a4 a9ff                   LDA #$FF                                            ; A=$FF to reset block number
 17863  f3a6 8dc603                 STA .fsBlockNumberLow                               ; block number low
 17864  f3a9 8dc703                 STA .fsBlockNumberHigh                              ; block number high
 17865  f3ac d0c2                   BNE .searchForBlockLoop                             ; ALWAYS branch
 17866                          
 17867                          ; ***************************************************************************************
 17868                          ;
 17869                          ; Finish reading block and continue
 17870                          ;
 17871                          ; On Entry:
 17872                          ;       V set means reset file system state (occurs when reading the last block of a ROMFS file)
 17873                          ;
 17874                          ; ***************************************************************************************
 17875                          .finishReadingBlockAndContinue
 17876  f3ae 5005                   BVC +                                               ; if (V clear) then branch
 17877  f3b0 a9ff                   LDA #$FF                                            ; A=$FF (searching)
 17878  f3b2 20d7f7                 JSR .setCharAThenProgressState4OrReset              ; update to progress state 4 (if block length > 0)
 17879                          +
 17880  f3b5 a200                   LDX #0                                              ; X=0
 17881  f3b7 20d9f9                 JSR .checkForChecksumError                          ; report 'Data?' if necessary
 17882  f3ba ad4702                 LDA .tapeOrROMSwitch                                ; get current filing system
 17883  f3bd f004                   BEQ +                                               ; if (tape filing system) then branch
 17884  f3bf 24bb                   BIT .tapeCurrentOptionsByte                         ; check current options (bit 6)
 17885  f3c1 50de                   BVC .skipMessaging                                  ; if (no long messages) then branch (back)
 17886                          +
 17887  f3c3 2cca03                 BIT .fsBlockFlagByte                                ; block flag
 17888  f3c6 30dc                   BMI .resetBlockNumberAndContinue                    ; if (-ve) then branch
 17889  f3c8 10a6                   BPL .searchForBlockLoop                             ; ALWAYS branch (loop back and do it again)
