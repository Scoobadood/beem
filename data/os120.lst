  6256                          .executeRequiredVDUFunction
  6257  ccf5 6c5d03                 JMP (.vduJumpVectorLow)                             ; loop back (using the jump vector
  6258                                                                                  ; set up previously) to the
  6259                                                                                  ; appropriate address for the current
  6260                                                                                  ; MODE.
