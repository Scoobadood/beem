 18848                              ; fall through...
 18849                          
 18850                          ; ***************************************************************************************
 18851                          ;
 18852                          ; Update CRC
 18853                          ;
 18854                          ; A cyclic redundancy check is updated one byte at a time.
 18855                          ;
 18856                          ; Pseudo-code is as follows. HL = high and low bytes of the CRC. A = byte on input.
 18857                          ;
 18858                          ;   H = A EOR H
 18859                          ;   FOR X = 1 TO 8
 18860                          ;       Carry=bit 7 of H
 18861                          ;       IF (Carry = 1) THEN HL=HL EOR $0810
 18862                          ;       HL=(HL*2 + Carry) AND $FFFF
 18863                          ;   NEXT X
 18864                          ;
 18865                          ; On Entry:
 18866                          ;       A = byte just written or read
 18867                          ;       Preserves A, X and Y
 18868                          ;
 18869                          ; ***************************************************************************************
 18870                          .updateCRC
 18871  f7b0 08                     PHP                                                 ; save flags on stack
 18872  f7b1 48                     PHA                                                 ; save A on stack
 18873  f7b2 38                     SEC                                                 ; } Set top bit of CRC bit counter
 18874  f7b3 66cb                   ROR .tapeCRCBitCounter                              ; } This acts as a loop counter
 18875                          
 18876  f7b5 45bf                   EOR .tapeChecksumHigh                               ; }
 18877  f7b7 85bf                   STA .tapeChecksumHigh                               ; } H = A EOR H
 18878                          -
 18879  f7b9 a5bf                   LDA .tapeChecksumHigh                               ;
 18880  f7bb 2a                     ROL                                                 ; Carry = bit 7 (A = A * 2)
 18881  f7bc 900c                   BCC +                                               ;
 18882  f7be 6a                     ROR                                                 ; A = A / 2 = H
 18883                          
 18884  f7bf 4908                   EOR #$08                                            ; }
 18885  f7c1 85bf                   STA .tapeChecksumHigh                               ; }
 18886  f7c3 a5be                   LDA .tapeChecksumLow                                ; } HL=HL EOR $0810
 18887  f7c5 4910                   EOR #$10                                            ; }
 18888  f7c7 85be                   STA .tapeChecksumLow                                ; }
 18889  f7c9 38                     SEC                                                 ; set carry flag
 18890                          
 18891                          +
 18892  f7ca 26be                   ROL .tapeChecksumLow                                ; }
 18893  f7cc 26bf                   ROL .tapeChecksumHigh                               ; } HL=(HL*2 + Carry) AND &FFFF
 18894                          
 18895  f7ce 46cb                   LSR .tapeCRCBitCounter                              ; shift loop counter right
 18896  f7d0 d0e7                   BNE -                                               ; if (eight bits not processed) then branch
 18897                          
 18898  f7d2 68                     PLA                                                 ; get back A
 18899  f7d3 28                     PLP                                                 ; get back flags
 18900                          .exit32
 18901  f7d4 60                     RTS                                                 ;
 18902                          
 18903                          ; ***************************************************************************************
 18904                          ;
 18905                          ; Set state ready for loading block data (or reset)
 18906                          ;
 18907                          ; Set the character just read to zero, and the progress state to 4.
 18908                          ; Together this signifies we are ready to load block data.
 18909                          ; If V is clear, then we instead reset to progress state zero.
 18910                          ;
 18911                          ; On Entry:
 18912                          ;       If V clear, then reset to state zero
 18913                          ;       otherwise set to state 4, ready to read the block data bytes
 18914                          ;
 18915                          ; ***************************************************************************************
 18916                          .setStateForLoadingBlockDataOrReset
 18917  f7d5 a900                   LDA #0                                              ; A=0
 18918                              ; fall through...
 18919                          
 18920                          ; ***************************************************************************************
 18921                          ;
 18922                          ; Set state ready for loading block data or searching (or reset state)
 18923                          ;
 18924                          ; Store the character just read. If all is well (V set and non-zero block length), then
 18925                          ; progress state is set to 4. Otherwise we revert back to progress state zero.
 18926                          ;
 18927                          ; On Entry:
 18928                          ;       A is $FF when searching, $00 when loading
 18929                          ;       V clear means reset progress state to zero
 18930                          ;       .fsBlockLengthLow/High holds the block length
 18931                          ;
 18932                          ; ***************************************************************************************
 18933                          .setCharAThenProgressState4OrReset
 18934  f7d7 85bd                   STA .fsCharacterJustReadOrCharToWrite               ; store character just read
 18935  f7d9 a200                   LDX #0                                              ; X=0
 18936  f7db 86bc                   STX .fsTempStorage                                  ;
 18937  f7dd 500a                   BVC +                                               ;
 18938  f7df adc803                 LDA .fsBlockLengthLow                               ; block length
 18939  f7e2 0dc903                 ORA .fsBlockLengthHigh                              ; block length high
 18940  f7e5 f002                   BEQ +                                               ; if (block length is zero) then branch
 18941  f7e7 a204                   LDX #4                                              ; X=4 (block length not zero)
 18942                          +
 18943  f7e9 86c2                   STX .fsReadProgressState                            ; save progress state
 18944  f7eb 60                     RTS                                                 ;
