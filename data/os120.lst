  1217                                                                                  ; (Read/Write using OSBYTE 194, but prefer OSBYTE 9)
  1218                          .videoULASecondFlashingColourInterval       = $0253     ; number of frames to spend on the second flashing colour
  1219                                                                                  ; (Read/Write using OSBYTE 195, but prefer OSBYTE 10)
