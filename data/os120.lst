  3933                          ; ***************************************************************************************
  3934                          ;
  3935                          ; Video Control Register of the VideoULA
  3936                          ;
  3937                          ; bit
  3938                          ;   0 - Flash colour select (which of the flashing colours is displayed)
  3939                          ;   1 - Teletext select
  3940                          ;   2 - } These two bits determine the number of characters per row
  3941                          ;   3 - } from this table:
  3942                          ;       %00 = 10 characters per row
  3943                          ;       %01 = 20 characters per row
  3944                          ;       %10 = 40 characters per row
  3945                          ;       %11 = 80 characters per row
  3946                          ;   4 - CRTC clock rate select:
  3947                          ;        %0 = low frequency clock for MODEs 4-7
  3948                          ;        %1 = high frequency clock for MODEs 0-3
  3949                          ;   5 - } These two bits determine the width of cursor in bytes
  3950                          ;   6 - } from this table:
  3951                          ;       %00 = 1 (MODEs 0,3,4,6)
  3952                          ;       %01 = - undefined
  3953                          ;       %10 = 2 (MODEs 1,5,7)
  3954                          ;       %11 = 4 (MODE 2)
  3955                          ;   7 - Master cursor width. If set, causes a larger cursor to be displayed
  3956                          ;
  3957                          ; ***************************************************************************************
  3958                          .videoULAVideoControlRegisterDefaultValuesPerMODE
  3959  c3f7 9c                     !byte %10011100                                     ; MODE 0
  3960  c3f8 d8                     !byte %11011000                                     ; MODE 1
  3961  c3f9 f4                     !byte %11110100                                     ; MODE 2
  3962  c3fa 9c                     !byte %10011100                                     ; MODE 3
  3963  c3fb 88                     !byte %10001000                                     ; MODE 4
  3964  c3fc c4                     !byte %11000100                                     ; MODE 5
  3965  c3fd 88                     !byte %10001000                                     ; MODE 6
  3966  c3fe 4b                     !byte %01001011                                     ; MODE 7
  3967                          
  3968                          .bytesPerCharacter
  3969  c3ff 08                     !byte 8                                             ; MODE 0
  3970  c400 10                     !byte 16                                            ; MODE 1
  3971  c401 20                     !byte 32                                            ; MODE 2
  3972  c402 08                     !byte 8                                             ; MODE 3
  3973  c403 08                     !byte 8                                             ; MODE 4
  3974  c404 10                     !byte 16                                            ; MODE 5
  3975  c405 08                     !byte 8                                             ; MODE 6
  3976  c406 01                     !byte 1                                             ; MODE 7
