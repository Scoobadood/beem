   792                          ; ***************************************************************************************
   793                          ;
   794                          ; Memory addresses
   795                          ;
   796                          ; For the remainder of this chapter all constants refer to addresses in memory.
   797                          ;
   798                          ; See ram.png
   799                          ;
   800                          ; ***************************************************************************************
   801                          
   802                          ; ***************************************************************************************
   803                          ;
   804                          ; Zero Page Addresses ($00B0-$00FF)
   805                          ;
   806                          ; ***************************************************************************************
   807                          .fileWorkspaceA                             = $B0       ; }
   808                          .fileWorkspaceB                             = $B1       ; } workspace values are used while we
   809                          .fileWorkspaceC                             = $B2       ; } load or save to the tape or ROM
   810                          .fileWorkspaceD                             = $B3       ; } file system. They hold different
   811                          .fileWorkspaceE                             = $B4       ; } values when saving vs. loading.
   812                          .fileWorkspaceF                             = $B5       ; } See uses below.
   813                          .fileWorkspaceG                             = $B6       ; }
   814                          .fileWorkspaceH                             = $B7       ; }
   815                          
   816                          ; when loading from tape or ROM we store the load address, current and next block numbers:
   817                          .loadAddressLow                             = .fileWorkspaceA ;
   818                          .loadAddressMid1                            = .fileWorkspaceB ;
   819                          .loadAddressMid2                            = .fileWorkspaceC ;
   820                          .loadAddressHigh                            = .fileWorkspaceD ;
   821                          
   822                          .currentBlockNumberLow                      = .fileWorkspaceE ;
   823                          .currentBlockNumberHigh                     = .fileWorkspaceF ;
   824                          
   825                          .nextBlockNumberLow                         = .fileWorkspaceG ;
   826                          .nextBlockNumberHigh                        = .fileWorkspaceH ;
   827                          
   828                          ; when saving to tape we store the current start address and end address:
   829                          .tapeSaveStartAddressLow                    = .fileWorkspaceA ;
   830                          .tapeSaveStartAddressMid1                   = .fileWorkspaceB ;
   831                          .tapeSaveStartAddressMid2                   = .fileWorkspaceC ;
   832                          .tapeSaveStartAddressHigh                   = .fileWorkspaceD ;
   833                          
   834                          .tapeSaveEndAddressLow                      = .fileWorkspaceE ;
   835                          .tapeSaveEndAddressMid1                     = .fileWorkspaceF ;
   836                          .tapeSaveEndAddressMid2                     = .fileWorkspaceG ;
   837                          .tapeSaveEndAddressHigh                     = .fileWorkspaceH ;
   838                          
   839                          
   840                          .printMessageAddressLow                     = $B8       ; } stores either the address of an
   841                          .printMessageAddressHigh                    = $B9       ; } error routine, or the return
   842                                                                                  ; } address after printing a message.
   843                          
   844                          .currentBlockHasDataErrorFlag               = $BA       ; set to $FF if the header of the
   845                                                                                  ; current block was read OK, but there
   846                                                                                  ; has been a data checksum error when
   847                                                                                  ; reading the actual data from the
   848                                                                                  ; current block. Otherwise $00.
   849                                                                                  ; Used to know whether to display the
   850                                                                                  ; 'Rewind tape' message.
   851                                                                                  ; See .postFileError.
   852                          .tapeCurrentOptionsByte                     = $BB       ; current options for the tape
   853                                                                                  ; filing system. See .tapeOptionsByte
   854                                                                                  ; below.
   855                                                                                  ;
   856                                                                                  ; options are in the top four bits:
   857                                                                                  ;   bit 4 = Abort bit
   858                                                                                  ;   bit 5 = Retry bit
   859                                                                                  ;   bit 6 }
   860                                                                                  ;   bit 7 } Message type:
   861                                                                                  ;
   862                                                                                  ;       00 = no messages
   863                                                                                  ;       10 = short messages
   864                                                                                  ;       11 = long messages
   865                                                                                  ;
   866                                                                                  ; Bits   Errors     Message Type
   867                                                                                  ; --------------------------------
   868                                                                                  ; 0000   Ignore     no messages
   869                                                                                  ; 0001   Abort      no messages
   870                                                                                  ; 0010   Retry      no messages
   871                                                                                  ; 1000   Ignore     short messages
   872                                                                                  ; 1001   Abort      short messages
   873                                                                                  ; 1010   Retry      short messages
   874                                                                                  ; 1100   Ignore     long messages
   875                                                                                  ; 1101   Abort      long messages
   876                                                                                  ; 1110   Retry      long messages
   877                          
   878                          .fsTempStorage                              = $BC       ; temporary storage used by filing
   879                                                                                  ; system routines
   880                          .fsCharacterJustReadOrCharToWrite           = $BD       ;
   881                          .tapeChecksumLow                            = $BE       ; }
   882                          .tapeChecksumHigh                           = $BF       ; } CRC checksum
   883                          .fsGotACharacterToReadOrWriteFlag           = $C0       ; the top bit is set when a byte of
   884                                                                                  ; data from tape or ROM has (a) been
   885                                                                                  ; read or (b) is ready to write to
   886                                                                                  ; tape, and is ready to be processed.
   887                                                                                  ; The value of the byte is stored in
   888                                                                                  ; .fsCharacterJustReadOrCharToWrite
   889                          .checksumIsValidFlag                        = $C1       ; non-zero value indicates an error
   890                          .fsReadProgressState                        = $C2       ; current state of reading from tape
   891                                                                                  ; or ROM filing system (0-5)
   892                                                                                  ; See .postReadByte
   893                          .tapeCurrentFileHandle                      = $C3       ; handle for currently open file
   894                          .tapeLastBputValue                          = $C4       ; Last byte BPUT, see .osbputEntryPoint
   895                          
   896                          .unusedC5                                   = $C5       ; [unused]
   897                          
   898                          .tapeBaudRate                               = $C6       ; current cassette baud rate:
   899                                                                                  ; 5 for 1200 baud
   900                                                                                  ; 6 for 300 baud
   901                          .tapeInterBlockGap                          = $C7       ; current duration (in tenths of a
   902                                                                                  ; second) of the gap between blocks
   903                                                                                  ; of data when saving to tape.
   904                          .osfileBlockAddressLow                      = $C8       ; } Address of parameter block for
   905                          .osfileBlockAddressHigh                     = $C9       ; } OSFILE
   906                          .tapeSendingFlag                            = $CA       ; non-zero = currently sending to tape
   907                          .tapeCRCBitCounter                          = $CB       ; loop counter when calculating CRC
   908                          .tapeFileLengthLow                          = $CC       ; } temporarily stores the file length
   909                          .tapeFileLengthHigh                         = $CD       ; } before writing it into the OSFILE
   910                                                                                  ; } parameter block
   911                          
   912                          .unusedCE                                   = $CE       ; [unused]
   913                          .unusedCF                                   = $CF       ; [unused]
   914                          
   915                          .vduStatusByte                              = $D0       ; Each bit holds part the VDU status:
   916                                                                                  ; bit 0 = printer enable
   917                                                                                  ; bit 1 = scrolling disabled
   918                                                                                  ; bit 2 = paged scrolling selected
   919                                                                                  ; bit 3 = software scrolling (text window)
   920                                                                                  ; bit 4 = not used
   921                                                                                  ; bit 5 = graphics cursor enabled (VDU 5)
   922                                                                                  ; bit 6 = separated cursors
   923                                                                                  ; bit 7 = VDU disabled
   924                          .vduCurrentPlotByteMask                     = $D1       ; bits to write a pixel within a byte
   925                          
   926                          .vduTextColourByteOR                        = $D2       ; } bytes to implement current foreground
   927                          .vduTextColourByteEOR                       = $D3       ; } and background text colours
   928                          
   929                          .vduGraphicsColourByteOR                    = $D4       ; } bytes to implement current GCOL
   930                          .vduGraphicsColourByteEOR                   = $D5       ; } mode and graphics colours
   931                          
   932                          .vduScreenAddressOfGraphicsCursorCellLow    = $D6       ; } address of the top of the cell
   933                          .vduScreenAddressOfGraphicsCursorCellHigh   = $D7       ; } on screen containing the graphics
   934                                                                                  ; } cursor position
   935                          
   936                          .vduWriteCursorScreenAddressLow             = $D8       ; } address of the top of the cell
   937                          .vduWriteCursorScreenAddressHigh            = $D9       ; } on screen for the write cursor
   938                          
   939                          .vduTempStoreDA                             = $DA       ; }
   940                          .vduTempStoreDB                             = $DB       ; }
   941                          .vduTempStoreDC                             = $DC       ; } store for temporary values,
   942                          .vduTempStoreDD                             = $DD       ; } used in multiple VDU related
   943                          .vduTempStoreDE                             = $DE       ; } functions.
   944                          .vduTempStoreDF                             = $DF       ; }
   945                          
   946                          .vduMultiplicationTableLow                  = $E0       ; stores which multiplication table
   947                          .vduMultiplicationTableHigh                 = $E1       ; to use
   948                          .fsStatusByte                               = $E2       ; bit 0  input file open
   949                                                                                  ; bit 1  output file open
   950                                                                                  ; bit 2  not used
   951                                                                                  ; bit 3  current CATalogue status
   952                                                                                  ; bit 4  not used
   953                                                                                  ; bit 5  not used
   954                                                                                  ; bit 6  EOF reached
   955                                                                                  ; bit 7  EOF warning given
   956                          
   957                          .tapeOptionsByte                            = $E3       ; options for the tape filing
   958                                                                                  ; system
   959                                                                                  ;
   960                                                                                  ; we store two sets of options, one
   961                                                                                  ; for LOAD and SAVE operations on a
   962                                                                                  ; whole file (top four bits), and
   963                                                                                  ; the other for 'sequential access'
   964                                                                                  ; byte by byte (lower four bits).
   965                                                                                  ;
   966                                                                                  ; Only one of these two sets of
   967                                                                                  ; options is active at one time.
   968                                                                                  ; These are stored in the top
   969                                                                                  ; four bits of .tapeCurrentOptionsByte.
   970                                                                                  ; See .tapeCurrentOptionsByte.
   971                                                                                  ;
   972                                                                                  ;   bit 0/4 = Abort bit
   973                                                                                  ;   bit 1/5 = Retry bit
   974                                                                                  ;   bit 2/6 }
   975                                                                                  ;   bit 3/7 } Message type:
   976                                                                                  ;
   977                                                                                  ;       00 = no messages
   978                                                                                  ;       10 = short messages
   979                                                                                  ;       11 = long messages
   980                                                                                  ;
   981                                                                                  ; Bits   Errors     Message Type
   982                                                                                  ; --------------------------------
   983                                                                                  ; 0000   Ignore     no messages
   984                                                                                  ; 0001   Abort      no messages
   985                                                                                  ; 0010   Retry      no messages
   986                                                                                  ; 1000   Ignore     short messages
   987                                                                                  ; 1001   Abort      short messages
   988                                                                                  ; 1010   Retry      short messages
   989                                                                                  ; 1100   Ignore     long messages
   990                                                                                  ; 1101   Abort      long messages
   991                                                                                  ; 1110   Retry      long messages
   992                          
   993                          .stringInputOptions                         = $E4       ; When parsing an input string
   994                                                                                  ; bit 7 = double-quote character found at start
   995                                                                                  ; bit 6 = space character is not a terminator
   996                                                                                  ; See .gsinitEntryPoint
   997                          .starCommandYParameter                      = $E4
   998                          .stringInputPlingFlag                       = $E5       ; When parsing an input string
   999                                                                                  ; $80 if previous character is '!'
  1000                                                                                  ; $00 otherwise
  1001                          .starCommandXParameter                      = $E5
  1002                          .readCharacterTimedFlag                     = $E6       ; 0 means read key instantly
  1003                                                                                  ; 255 means read key timed
  1004                          .tempWorkspaceE6                            = $E6       ; general workspace
  1005                          .currentStringPointer                       = $E6       ; offset within command string
  1006                          
  1007                          .autorepeatCountdownTimer                   = $E7
  1008                          .osword0BufferAddressLow                    = $E8       ; reading line of input by OSWORD 0
  1009                          .osword0BufferAddressHigh                   = $E9       ;
  1010                          .rs423TimeoutCounter                        = $EA       ;  1: the tape FS has control
  1011                                                                                  ;  0: RS-423 in control, timed out
  1012                                                                                  ; <0: RS-423 in control, not timed out
  1013                          .tapeCritical                               = $EB       ; bit 7 set while doing a BGET/BPUT
  1014                                                                                  ;   (other bits are ignored)
  1015                          
  1016                          .keyPressedInternalTable                    = $EC       ; start of two byte table of keys
  1017                          .lastKeyPressedInternal                     = $EC       ; see table below
  1018                          .firstKeyPressedInternal                    = $ED       ; see table below
  1019                          
  1020                              ; Situation              .lastKeyPressedInternal    .firstKeyPressedInternal
  1021                              ; -------------------------------------------------------------------------
  1022                              ; no keys pressed        $00                        $00
  1023                              ; one key pressed        first key number           $00
  1024                              ; two keys pressed       second key  number         first key number
  1025                              ; second key released    $00                        first key number
  1026                          
  1027                          .keyToIgnoreWhenScanningWithOSBYTE121or122  = $EE       ; See .scanKeyboard
  1028                          
  1029                          .osbyteA                                    = $EF       ; }
  1030                          .oswordA                                    = $EF       ; } stores register values when
  1031                          .osbyteX                                    = $F0       ; } calling OSBYTE and OSWORD
  1032                          .oswordX                                    = $F0       ; }
  1033                          .stackPointerLastBRK                        = $F0       ; stores the stack pointer on a BRK instruction
  1034                          .osbyteY                                    = $F1       ; } stores register values when
  1035                          .oswordY                                    = $F1       ; } calling OSBYTE and OSWORD
  1036                          
  1037                          .stringInputBufferAddressLow                = $F2       ; } Start address of input string
  1038                          .stringInputBufferAddressHigh               = $F3       ; }
  1039                          
  1040                          .currentlySelectedROM                       = $F4       ; current Paged ROM selected
  1041                          .currentSpeechPHROMOrROMNumber              = $F5       ; if bit 7 set:
  1042                                                                                  ;   ROM number for Speech PHROM ($F0-$FF)
  1043                                                                                  ; if bit 7 clear:
  1044                                                                                  ;   ROM number for current ROMFS ($00-$0F)
  1045                          
  1046                          .romAddressLow                              = $F6       ;
  1047                          .romAddressHigh                             = $F7       ;
  1048                          
  1049                          .unusedF8                                   = $F8       ; [unused]
  1050                          .unusedF9                                   = $F9       ; [unused]
  1051                          
  1052                          .tempStoreFA                                = $FA       ; }
  1053                          .tempStoreFB                                = $FB       ; } General purpose temporary store
  1054                          
  1055                          .interruptAccumulator                       = $FC       ; used during IRQ processing to
  1056                                                                                  ; remember the accumulator and also
  1057                                                                                  ; used during a reset (before
  1058                                                                                  ; IRQs are enabled)
  1059                          
  1060                          .languageVersionString                      = $FD       ; offset to language ROM version string
  1061                                                                                  ;                 (- multiple uses)
  1062                          .displayStringAddressLow                    = $FD       ;                 (- multiple uses)
  1063                          .brkAddressLow                              = $FD       ; } address after (- multiple uses)
  1064                          .brkAddressHigh                             = $FE       ; } last BRK      (- multiple uses)
  1065                          .displayStringAddressHigh                   = $FE       ;                 (- multiple uses)
  1066                          
  1067                          .escapeFlag                                 = $FF       ; the ESCAPE flag
  1068                                                                                  ; this is set when an ESCAPE character
  1069                                                                                  ; (normally .charESCAPE) is entered
  1070                                                                                  ; into an input buffer.
  1071                                                                                  ; It should be acknowledged using
  1072                                                                                  ; OSBYTE 126. This tells the second
  1073                                                                                  ; processor of the event and clears
  1074                                                                                  ; the flag.
