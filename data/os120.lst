  6875                          ; ***************************************************************************************
  6876                          .displayACharacterAtAddress
  6877  cfbf ae6003                 LDX .vduNumberOfLogicalColoursMinusOne              ; number of logical colours less 1
  6878  cfc2 a5d0                   LDA .vduStatusByte                                  ; VDU status byte
  6879  cfc4 2920                   AND #$20                                            ; and check bit 5 (printing at graphics cursor)
  6880  cfc6 d095                   BNE .plotACharacterAtGraphicsCursor                 ; if (set) then branch
  6881  cfc8 a007                   LDY #7                                              ; Y=7
  6882  cfca e003                   CPX #3                                              ;
  6883  cfcc f020                   BEQ .displayACharacter4ColourMODE                   ; if (X = 3) then branch to handle 4 colour MODEs
  6884  cfce b04e                   BCS .displayACharacter16ColourMODE                  ; if (X > 3) then branch to deal with 16 colours
  6885                          
  6886                              ; display a character in a 2 colour MODE
  6887                          -
  6888  cfd0 b1de                   LDA (.vduTempStoreDE),Y                             ; get pattern byte
  6889  cfd2 05d2                   ORA .vduTextColourByteOR                            ; adjust for current foreground and background colour
  6890  cfd4 45d3                   EOR .vduTextColourByteEOR                           ; adjust for current foreground and background colour
  6891  cfd6 91d8                   STA (.vduWriteCursorScreenAddressLow),Y             ; write to screen
  6892  cfd8 88                     DEY                                                 ; Y=Y-1
  6893  cfd9 10f5                   BPL -                                               ; if (still +ve) then branch (loop back)
  6894  cfdb 60                     RTS                                                 ;
  6895                          
  6896                          ; ***************************************************************************************
  6897                          .displayCharacterMODE7
  6898  cfdc a002                   LDY #2                                              ; Y=2, loop counter/index into the teletext conversion table
  6899                          -
  6900  cfde d9b6c4                 CMP .teletextCharacterConversionTable,Y             ; compare with teletext conversion table
  6901  cfe1 f006                   BEQ .convertMODE7Character                          ; if (found character to convert) then branch
  6902  cfe3 88                     DEY                                                 ; Y=Y-1
  6903  cfe4 10f8                   BPL -                                               ; loop back until done
  6904                          .writeByteToMODE7Screen
  6905  cfe6 81d8                   STA (.vduWriteCursorScreenAddressLow,X)             ; write byte to screen
  6906  cfe8 60                     RTS                                                 ;
  6907                          
  6908                          ; ***************************************************************************************
  6909                          .convertMODE7Character
  6910  cfe9 b9b7c4                 LDA .teletextCharacterConversionTable + 1,Y         ; convert with teletext conversion table
  6911  cfec d0f8                   BNE .writeByteToMODE7Screen                         ; ALWAYS branch back to write it
  6912                          
  6913                          ; ***************************************************************************************
  6914                          .displayACharacter4ColourMODE
  6915  cfee b1de                   LDA (.vduTempStoreDE),Y                             ; get pattern byte
  6916  cff0 48                     PHA                                                 ; save it
  6917  cff1 4a                     LSR                                                 ; move high nybble to low
  6918  cff2 4a                     LSR                                                 ;
  6919  cff3 4a                     LSR                                                 ;
  6920  cff4 4a                     LSR                                                 ;
  6921  cff5 aa                     TAX                                                 ; X=A
  6922  cff6 bd1fc3                 LDA .fourColourMODEByteMaskTable,X                  ; convert 4 bits of the character
  6923                                                                                  ; definition into bytes to write
  6924                                                                                  ; to the screen
  6925  cff9 05d2                   ORA .vduTextColourByteOR                            ; adjust for current foreground and background colour
  6926  cffb 45d3                   EOR .vduTextColourByteEOR                           ; adjust for current foreground and background colour
  6927  cffd 91d8                   STA (.vduWriteCursorScreenAddressLow),Y             ; write to screen
  6928  cfff 98                     TYA                                                 ; A=Y
  6929  d000 18                     CLC                                                 ; clear carry
  6930  d001 6908                   ADC #8                                              ; add 8 to move screen RAM pointer 8 bytes
  6931  d003 a8                     TAY                                                 ; Y=A
  6932  d004 68                     PLA                                                 ; get back A
  6933  d005 290f                   AND #%00001111                                      ; clear high nybble
  6934  d007 aa                     TAX                                                 ; X=A
  6935  d008 bd1fc3                 LDA .fourColourMODEByteMaskTable,X                  ; 4 colour MODE byte mask look up table
  6936  d00b 05d2                   ORA .vduTextColourByteOR                            ; adjust for current foreground and background colour
  6937  d00d 45d3                   EOR .vduTextColourByteEOR                           ; adjust for current foreground and background colour
  6938  d00f 91d8                   STA (.vduWriteCursorScreenAddressLow),Y             ; write to screen
  6939  d011 98                     TYA                                                 ; A=Y
  6940  d012 e908                   SBC #8                                              ; A=A-9
  6941  d014 a8                     TAY                                                 ; Y=A
  6942  d015 10d7                   BPL .displayACharacter4ColourMODE                   ; if (not negative) then branch (loop back)
  6943                          .exit9
  6944  d017 60                     RTS                                                 ;
  6945                          
  6946                          ; ***************************************************************************************
  6947                          .nextPatternByte
  6948  d018 98                     TYA                                                 ; Y=Y-$21
  6949  d019 e921                   SBC #$21                                            ;
  6950  d01b 30fa                   BMI .exit9                                          ; if (Y is negative) then branch (return)
  6951  d01d a8                     TAY                                                 ; A=Y
  6952                              ; fall through...
  6953                          
  6954                          ; ***************************************************************************************
  6955                          .displayACharacter16ColourMODE
  6956  d01e b1de                   LDA (.vduTempStoreDE),Y                             ; get pattern byte
  6957  d020 85dc                   STA .vduTempStoreDC                                 ; store it
  6958  d022 38                     SEC                                                 ; set carry
  6959                          .iloop
  6960  d023 a900                   LDA #0                                              ; A=0
  6961  d025 26dc                   ROL .vduTempStoreDC                                 ; carry now occupies bit 0 of DC
  6962  d027 f0ef                   BEQ .nextPatternByte                                ; when DC=0 again branch to deal
  6963                                                                                  ; with next pattern byte
  6964  d029 2a                     ROL                                                 ; get bit 7 from .vduTempStoreDC into A bit 0
  6965  d02a 06dc                   ASL .vduTempStoreDC                                 ; rotate again to get second
  6966  d02c 2a                     ROL                                                 ; bit into A
  6967  d02d aa                     TAX                                                 ; and store result in X
  6968  d02e bd2fc3                 LDA .sixteenColourMODEByteMaskTable,X               ; convert two bits of the character
  6969                                                                                  ; definition into bytes to write
  6970                                                                                  ; to the screen
  6971  d031 05d2                   ORA .vduTextColourByteOR                            ; adjust for current foreground and background colour
  6972  d033 45d3                   EOR .vduTextColourByteEOR                           ; adjust for current foreground and background colour
  6973  d035 91d8                   STA (.vduWriteCursorScreenAddressLow),Y             ; and store result
  6974  d037 18                     CLC                                                 ; }
  6975  d038 98                     TYA                                                 ; }
  6976  d039 6908                   ADC #8                                              ; } Y=Y+8 moving screen RAM pointer on 8 bytes
  6977  d03b a8                     TAY                                                 ; }
  6978  d03c 90e5                   BCC .iloop                                          ; branch back to deal with next bit pair
  6979                              ; fall through...
  6980                          
  6981                          
  6982                          ; ***************************************************************************************
  6983                          ;
  6984                          ; Get character definition address
  6985                          ;
  6986                          ; On Entry:
  6987                          ;       A is the ascii code for a printable character 32-255 (bit pattern abcdefgh)
  6988                          ; On Exit:
  6989                          ;       .vduTempStoreDE/F is the address of the character definition either from the default
  6990                          ;                      ROM characters or the soft character definitions
  6991                          ; ***************************************************************************************
  6992                          .getCharacterDefinitionAddress
  6993  d03e 0a                     ASL                                                 ; bcdefgh0  C=a
  6994  d03f 2a                     ROL                                                 ; cdefgh0a  C=b
  6995  d040 2a                     ROL                                                 ; defgh0ab  C=c
  6996  d041 85de                   STA .vduTempStoreDE                                 ; save this pattern (defgh0ab)
  6997  d043 2903                   AND #%00000011                                      ; 000000ab
  6998  d045 2a                     ROL                                                 ; 00000abc  C=0
  6999  d046 aa                     TAX                                                 ; X = soft font zone (1 - 7)
  7000  d047 2903                   AND #%00000011                                      ; A = 000000bc (1 - 3)
  7001  d049 69bf                   ADC #>.characterDefinitions - 1                     ; A = high byte of character definitions ($C0, $C1, $C2)
  7002  d04b a8                     TAY                                                 ; Y = high byte of ROM address of character
  7003  d04c bd0dc4                 LDA .fontMaskTable,X                                ; get single bit set depending on X (1-7)
  7004  d04f 2c6703                 BIT .vduFontFlags                                   ; test font flags to see if there are soft character definitions
  7005  d052 f003                   BEQ +                                               ; if (hard character definitions) then branch
  7006  d054 bc6703                 LDY .vduFontZoneAddressesHigh1 - 1,X                ; get high byte from table for soft character definitions
  7007                          +
  7008  d057 84df                   STY .vduTempStoreDF                                 ; store Y in high byte of address
  7009  d059 a5de                   LDA .vduTempStoreDE                                 ; get back pattern (defgh0ab)
  7010  d05b 29f8                   AND #%11111000                                      ; defgh000
  7011  d05d 85de                   STA .vduTempStoreDE                                 ; and store it. This is 8 times the
  7012                                                                                  ; ASCII character giving the low
  7013                                                                                  ; byte of the address
  7014  d05f 60                     RTS                                                 ;
  7015                          
  7016                          
  7017                          ; ***************************************************************************************
  7018                          ; ***************************************************************************************
  7019                          ;
  7020                          ; Chapter 8: PLOT
  7021                          ;
  7022                          ; ***************************************************************************************
  7023                          ; ***************************************************************************************
  7024                          
  7025                          ; ***************************************************************************************
  7026                          ;
  7027                          ; Plot routine
  7028                          ;
  7029                          ; See plot.png
  7030                          ; The plot routine is a multi-purpose tool for drawing graphics. It renders points,
  7031                          ; lines, dotted lines, filled triangles, and single horizontal line fills. It can also just
  7032                          ; move the current graphics cursor position. The lower three bits of the plot type hold plot
  7033                          ; options:
  7034                          ;
  7035                          ; Plot Options:
  7036                          ;   0         Move relative to last point
  7037                          ;   1         Draw relative to last point in foreground colour
  7038                          ;   2         Draw relative to last point in inverse colour
  7039                          ;   3         Draw relative to last point in background colour
  7040                          ;   4         Move absolute
  7041                          ;   5         Draw absolute in foreground colour
  7042                          ;   6         Draw absolute in inverse colour
  7043                          ;   7         Draw absolute in background colour
  7044                          ;
  7045                          ; ---------------------------------------------------------------------------------------
  7046                          ; PLOT TYPE   RANGE IN BINARY      BITS3-6    DESCRIPTION
  7047                          ; RANGE       abcdefgh-abcdefgh    bcde
  7048                          ; ---------------------------------------------------------------------------------------
  7049                          ; 0-7         00000000-00000111    0000       Move/Draw line with standard options 0-7
  7050                          ; 8-15        00001000-00001111    0001       As 0-7 but with the last point in a line omitted
  7051                          ;                                             when plotting with GCOL mode 3 (EOR) or 4
  7052                          ;                                             (INVERT)
  7053                          ; 16-23       00010000-00010111    0010       As 0-7 but with a dotted line
  7054                          ; 24-31       00011000-00011111    0011       As 0-7 but with a dotted line and the last point
  7055                          ;                                             in a line omitted when plotting with GCOL mode 3
  7056                          ;                                             (EOR) or 4 (INVERT)
  7057                          ; 32-39       00100000-00100111    0100       RESERVED for future expansion
  7058                          ; 40-47       00101000-00101111    0101       RESERVED for future expansion
  7059                          ; 48-55       00110000-00110111    0110       RESERVED for future expansion
  7060                          ; 56-63       00111000-00111111    0111       RESERVED for future expansion
  7061                          ; 64-71       01000000-01000111    1000       As 0-7 but only a single point is plotted
  7062                          ; 72-79       01001000-01001111    1001       As 0-7 but fill one line horizontally left and
  7063                          ;                                             right
  7064                          ; 80-87       01010000-01010111    1010       As 0-7 but fill a triangle
  7065                          ; 88-95       01011000-01011111    1011       As 0-7 but fill one line horizontally right
  7066                          ; 96-103      01100000-01100111    1100       RESERVED for future expansion
  7067                          ; 104-111     01101000-01101111    1101       RESERVED for future expansion
  7068                          ; 112-119     01110000-01110111    1110       RESERVED for future expansion
  7069                          ; 120-127     01111000-01111111    1111       RESERVED for future expansion
  7070                          ; 128-255     10000000-11111111    xxxx       RESERVED for future expansion
  7071                          ; ---------------------------------------------------------------------------------------
  7072                          ;
  7073                          ; Coordinate Systems
  7074                          ;
  7075                          ; The standard graphics coordinate system ranges from (0,0) at the bottom left of the screen
  7076                          ; to (1280 x 1024) at the top right. This coordinate range represents the entire screen
  7077                          ; regardless of the actual number of pixels available on screen.
  7078                          ;
  7079                          ; The graphics window origin can be changed to specify where a pixel drawn at (0,0) actually
  7080                          ; appears on the screen. This is a translation of the coordinate system.
  7081                          ;
  7082                          ; These resolution independent coordinates are called 'external' coordinates in this document.
  7083                          ;
  7084                          ; When calling the OS, external coordinates can optionally be specified 'relative' to the last
  7085                          ; point plotted. Coordinates are also always specified relative to the current graphics window
  7086                          ; origin. When translated into full screen coordinates these are known here as 'absolute'
  7087                          ; coordinates.
  7088                          ;
  7089                          ; Within OS routines absolute coordinates are scaled down to a pixel based scale. These are
  7090                          ; called 'pixel' coordinates. Pixel coordinates are never 'relative' coordinates in the sense
  7091                          ; above, but that doesn't stop OS routines temporarily storing the difference between two
  7092                          ; pixel based coordinates as part of its calculations of course.
  7093                          ;
  7094                          ; Conversions between the coordinate systems are done via:
  7095                          ;
  7096                          ;       .plotConvertExternalAbsoluteCoordinatesToPixels
  7097                          ;       .plotConvertExternalRelativeCoordinatesToPixels
  7098                          ;       .convertPixelGraphicsCoordinatesToExternal
  7099                          ;
  7100                          ; ***************************************************************************************
  7101                          .vdu25ParameterPlotType = .vduQueueEndByte - 4
  7102                          .vdu25ParameterXLow     = .vduQueueEndByte - 3
  7103                          .vdu25ParameterXHigh    = .vduQueueEndByte - 2
  7104                          .vdu25ParameterYLow     = .vduQueueEndByte - 1
  7105                          .vdu25ParameterYHigh    = .vduQueueEndByte
  7106                          .vdu25Plot
  7107  d060 a220                   LDX #.vdu25ParameterXLow - .vduVariablesStart       ; X is offset to X Coordinate (low)
  7108  d062 204dd1                 JSR .plotConvertExternalRelativeCoordinatesToPixels ; translate coordinates
  7109                          
  7110  d065 ad1f03                 LDA .vdu25ParameterPlotType                         ; get plot type
  7111  d068 c904                   CMP #4                                              ; check for plot type four (move absolute)
  7112  d06a f06d                   BEQ .plotMoveGraphicsCursorInAbsolutePixels         ; if (plot type is four) then branch (move absolute)
  7113  d06c a005                   LDY #5                                              ; Y=5
  7114  d06e 2903                   AND #3                                              ; mask only bits 0 and 1
  7115  d070 f00e                   BEQ +                                               ; if (result is 0) then branch (it's a move operation)
  7116  d072 4a                     LSR                                                 ; check bit zero
  7117  d073 b003                   BCS .plotWithGraphicsColour                         ; if (plot option needs foreground or background graphics colour) then branch
  7118  d075 88                     DEY                                                 ; Y=4 ('inverse' plot option)
  7119  d076 d008                   BNE +                                               ; ALWAYS branch. The logic inverse colour must be wanted
  7120                          
  7121                          ; ***************************************************************************************
  7122                          ;
  7123                          ; Plot with graphics character
  7124                          ;
  7125                          ; On Entry:
  7126                          ;       A=0 it's a foreground colour
  7127                          ;       A=1 it's a background colour
  7128                          ;
  7129                          ; ***************************************************************************************
  7130                          .plotWithGraphicsColour
  7131  d078 aa                     TAX                                                 ;
  7132  d079 bc5b03                 LDY .vduForegroundGCOLMode,X                        ; get foreground or background graphics PLOT mode (into Y)
  7133  d07c bd5903                 LDA .vduForegroundGraphicsColour,X                  ; }
  7134  d07f aa                     TAX                                                 ; } get foreground or background graphics colour (into X)
  7135                          +
  7136  d080 20b3d0                 JSR .setGraphicsColourMaskXY                        ; set up colour masks in .vduGraphicsColourByteOR/EOR
  7137                          
  7138  d083 ad1f03                 LDA .vdu25ParameterPlotType                         ; get plot type
  7139  d086 3023                   BMI .plotExtensionLocal                             ; if (128-255) then branch (it's RESERVED for future expansion)
  7140                          
  7141                              ; deal with plot 0-127
  7142  d088 0a                     ASL                                                 ; bcdefgh0
  7143  d089 103b                   BPL .plotType0to63                                  ; if (bit 7 is now 0, i.e. plot type is 0-63) then branch
  7144                          
  7145                              ; deal with plot 64-127
  7146  d08b 29f0                   AND #%11110000                                      ; bcde0000
  7147  d08d 0a                     ASL                                                 ; cde00000
  7148  d08e f046                   BEQ .plotPointAndMove                               ; if (zero) then branch (plot type 64-71 was called, single point plot)
  7149                          
  7150                              ; deal with plot 72-127
  7151  d090 4940                   EOR #%01000000                                      ; cDe00000 (inverted bit d)
  7152  d092 f014                   BEQ .plotFillTriangleLocal                          ; if (bit 'D' clear; i.e. bit 'd' set) then branch (plot type 80-87, fill triangle)
  7153                          
  7154                              ; deal with plot 72-79 or 88-127
  7155  d094 48                     PHA                                                 ; push cDe00000
  7156  d095 20dcd0                 JSR .copyPlotParametersToGraphicsCursorPixelPosition ; copy parameters, setting XY in current graphics
  7157                                                                                  ; coordinates
  7158  d098 68                     PLA                                                 ; get back cDe00000
  7159  d099 4960                   EOR #%01100000                                      ; cdE00000 (invert bit D back to d, and invert bit e)
  7160  d09b f011                   BEQ .storeAndLateralFillLeftRight                   ; if (cdE00000 == 00000000) (ie.
  7161                                                                                  ; cde == 001) then branch (type
  7162                                                                                  ; is 72-79, it's a lateral fill
  7163                                                                                  ; left/right)
  7164                          
  7165                              ; deal with plot 88-127
  7166  d09d c940                   CMP #%01000000                                      ; if (cdE00000 == 01000000) (ie.
  7167                                                                                  ; cde == 011) then type is 88-95
  7168                                                                                  ; (it's a lateral fill right)
  7169  d09f d00a                   BNE .plotExtensionLocal                             ; otherwise branch (RESERVED for
  7170                                                                                  ; future expansion)
  7171                          
  7172                              ; deal with plot 88-95
  7173                          .plotLateralFillRight                                   ;
  7174  d0a1 a902                   LDA #2                                              ; A=2
  7175  d0a3 85dc                   STA .vduTempStoreDC                                 ; .vduTempStoreDC = 2
  7176  d0a5 4c06d5                 JMP .lateralFillRight                               ; lateral fill right
  7177                          
  7178                          ; ***************************************************************************************
  7179                          .plotFillTriangleLocal
  7180  d0a8 4cead5                 JMP .plotFillTriangle                               ; to fill triangle routine
  7181                          
  7182                          ; ***************************************************************************************
  7183                          .plotExtensionLocal
  7184  d0ab 4c38c9                 JMP .vduPlotExtension                               ; VDU extension access entry
  7185                          
  7186                          ; ***************************************************************************************
  7187                          .storeAndLateralFillLeftRight
  7188  d0ae 85dc                   STA .vduTempStoreDC                                 ; .vduTempStoreDC = 0
  7189  d0b0 4cbfd4                 JMP .lateralFillLeftRight                           ; lateral fill left and right
  7190                          
  7191                          ; ***************************************************************************************
  7192                          ;
  7193                          ; Set graphics colour and GCOL mode bytes
  7194                          ;
  7195                          ; When writing graphics pixels to the screen, two bytes are used to adjust the byte to write
  7196                          ; based on the current colour and GCOL mode.
  7197                          ; This routine sets these two bytes .vduGraphicsColourByteOR and .vduGraphicsColourByteEOR
  7198                          ;
  7199                          ; GCOL Mode
  7200                          ; ---------
  7201                          ; 0 = Normal Mode: Sets the pixel to the current colour
  7202                          ; 1 =     OR Mode: Sets the pixel to the current colour  OR-ed with the colour on screen
  7203                          ; 2 =    AND Mode: Sets the pixel to the current colour AND-ed with the colour on screen
  7204                          ; 3 =    EOR Mode: Sets the pixel to the current colour EOR-ed with the colour on screen
  7205                          ; 4 = Invert Mode: Inverts the colour already on screen
  7206                          ;
  7207                          ; Suppose 'C' is the byte that when written to the screen sets each pixel of the byte to
  7208                          ; the current graphics colour.
  7209                          ;
  7210                          ; Then the two bytes are set as follows:
  7211                          ;       ------------------------------------------------------------------------
  7212                          ;       0=Normal Mode  | .vduGraphicsColourByteOR  = (C OR $FF) EOR $00 = $FF
  7213                          ;                      | .vduGraphicsColourByteEOR = (C OR $00) EOR $FF = C EOR $FF
  7214                          ;       ------------------------------------------------------------------------
  7215                          ;       1=OR Mode      | .vduGraphicsColourByteOR  = (C OR $00) EOR $00 = C
  7216                          ;                      | .vduGraphicsColourByteEOR = (C OR $FF) EOR $FF = 0
  7217                          ;       ------------------------------------------------------------------------
  7218                          ;       2=AND Mode     | .vduGraphicsColourByteOR  = (C OR $00) EOR $FF = C EOR $FF
  7219                          ;                      | .vduGraphicsColourByteEOR = (C OR $00) EOR $FF = C EOR $FF
  7220                          ;       ------------------------------------------------------------------------
  7221                          ;       3=EOR Mode     | .vduGraphicsColourByteOR  = (C OR $FF) EOR $FF = 0
  7222                          ;                      | .vduGraphicsColourByteEOR = (C OR $00) EOR $00 = C
  7223                          ;       ------------------------------------------------------------------------
  7224                          ;       4=Invert Mode  | .vduGraphicsColourByteOR  = (C OR $FF) EOR $FF = 0
  7225                          ;                      | .vduGraphicsColourByteEOR = (C OR $FF) EOR $00 = $FF
  7226                          ;       ------------------------------------------------------------------------
  7227                          ;
  7228                          ; When writing a pixel, start with a byte 'B', just the bits required to set one pixel to
  7229                          ; white. Then the pixel is written like so:
  7230                          ;
  7231                          ;            temp = (B AND .vduGraphicsColourByteOR) OR (current screen byte)
  7232                          ; new screen byte = (.vduGraphicsColourByteEOR AND B) EOR temp
  7233                          ;
  7234                          ; [A quirk: This routine is called with Y=5 for a relative move PLOT operation, but as
  7235                          ;           there's nothing to draw, the results are unused in this case.]
  7236                          ;
  7237                          ; On Entry:
  7238                          ;       X = colour byte to set
  7239                          ;       Y = GCOL Mode (0=Normal, 1=OR, 2=AND, 3=EOR, 4=Invert)
  7240                          ;
  7241                          ; On Exit:
  7242                          ;       .vduGraphicsColourByteOR / EOR hold the appropriate mask values
  7243                          ;
  7244                          ; ***************************************************************************************
  7245                          .setGraphicsColourMaskXY
  7246  d0b3 8a                     TXA                                                 ; A=X
  7247  d0b4 191cc4                 ORA .gcolPlotOptionsTable,Y                         ; OR with GCOL plot options table byte
  7248  d0b7 591dc4                 EOR .gcolPlotOptionsTable + 1,Y                     ; EOR with following byte
  7249  d0ba 85d4                   STA .vduGraphicsColourByteOR                        ; and store it
  7250  d0bc 8a                     TXA                                                 ; A=X
  7251  d0bd 191bc4                 ORA .gcolPlotOptionsTable - 1,Y                     ;
  7252  d0c0 5920c4                 EOR .gcolPlotOptionsTable + 4,Y                     ;
  7253  d0c3 85d5                   STA .vduGraphicsColourByteEOR                       ; masks are stored in .vduGraphicsColourByteOR/EOR
  7254  d0c5 60                     RTS                                                 ;
  7255                          
  7256                          ; ***************************************************************************************
  7257                          ; Continue processing of a PLOT command, where the plot type is in the range 0-63
  7258                          .plotType0to63
  7259  d0c6 0a                     ASL                                                 ; cdefgh00
  7260  d0c7 30e2                   BMI .plotExtensionLocal                             ; if (options are in range 32-63) then branch (not implemented)
  7261  d0c9 0a                     ASL                                                 ; defgh000
  7262  d0ca 0a                     ASL                                                 ; efgh0000
  7263  d0cb 1003                   BPL +                                               ; if (still +ve; type is 0-7 or 16-23) then branch (skips plot point)
  7264                          
  7265  d0cd 20ebd0                 JSR .plotPoint                                      ; type is 8-15 or 24-31. We want to
  7266                                                                                  ; omit the last point when drawing
  7267                                                                                  ; in invert mode, so we do this by
  7268                                                                                  ; displaying a point, which will get
  7269                                                                                  ; inverted (erased) again in the
  7270                                                                                  ; normal course of drawing the line.
  7271                          +
  7272  d0d0 20edd1                 JSR .plotLine                                       ; draw a line or dotted line
  7273  d0d3 4cd9d0                 JMP .plotMoveGraphicsCursorInAbsolutePixels         ; move the graphics cursor
  7274                          
  7275                          ; ***************************************************************************************
  7276                          ; Plot a single point and move the graphics cursor position
  7277                          .plotPointAndMove
  7278  d0d6 20ebd0                 JSR .plotPoint                                      ; display a point
  7279                              ; fall through...
  7280                          
  7281                          ; ***************************************************************************************
  7282                          ; Move the current graphics cursor position, to new absolute pixel coordinates given by
  7283                          ; the vdu25Parameters.
  7284                          .plotMoveGraphicsCursorInAbsolutePixels
  7285  d0d9 20e2cd                 JSR .exchangeGraphicsCursorWithOldPosition          ; swap current and last graphics
  7286                                                                                  ; position. The current position
  7287                                                                                  ; becomes the previous position.
  7288                              ; fall through...
  7289                          
  7290                          ; ***************************************************************************************
  7291                          .copyPlotParametersToGraphicsCursorPixelPosition
  7292  d0dc a024                   LDY #.vduGraphicsCursorPixelsXLow - .vduVariablesStart ; destination is the graphics cursor position in pixels
  7293                              ; fall through...
  7294                          
  7295                          ; ***************************************************************************************
  7296                          .copyParameterPointToDestinationY
  7297  d0de a220                   LDX #.vdu25ParameterXLow - .vduVariablesStart       ; source is the position coordinate on the VDU queue
  7298  d0e0 4c8ad4                 JMP .copyFourBytesWithinVDUVariables                ; copy four bytes
  7299                          
  7300                          ; ***************************************************************************************
  7301                          ;
  7302                          ; Plot one pixel of a character
  7303                          ;
  7304                          ; See Characters.png
  7305                          ; When drawing a character at the graphics cursor, this draws an individual pixel
  7306                          ; of that character. It uses the current graphics cursor position as the position to plot.
  7307                          ;
  7308                          ; Each pixel is tested to see if it's within the bounds of the current graphics window,
  7309                          ; so characters can be partially drawn.
  7310                          ; ***************************************************************************************
  7311                          .plotAPixelInACharacter
  7312  d0e3 a224                   LDX #.vduGraphicsCursorPixelsXLow - .vduVariablesStart  ;
  7313  d0e5 205fd8                 JSR .checkPointXInBoundsAndSetScreenAddresses       ; calculate position
  7314  d0e8 f006                   BEQ .plotPointWithinBounds                          ; if (within bounds) then branch
  7315  d0ea 60                     RTS                                                 ;
  7316                          
  7317                          ; ***************************************************************************************
  7318                          ;
  7319                          ; Plots a single point
  7320                          ;
  7321                          ; This checks the point against the graphics window, gets the screen address details, then
  7322                          ; renders the pixel by writing to the screen address, applying the colour masks and plot type.
  7323                          ;
  7324                          ; On Entry:
  7325                          ;       X holds the offset into the VDU variables for four bytes holding the position to plot
  7326                          ;       at.
  7327                          ;
  7328                          ; ***************************************************************************************
  7329                          .plotPoint
  7330  d0eb 205dd8                 JSR .checkParameterInBoundsAndSetScreenAddresses    ; check in bounds and set up screen addresses
  7331  d0ee d013                   BNE +                                               ; if (A is not zero) then branch (return)
  7332                          .plotPointWithinBounds
  7333  d0f0 ac1a03                 LDY .vduGraphicsCursorVerticalOffsetInCell          ; get current graphics scan line
  7334                          .plotPointWithinBoundsAtY
  7335  d0f3 a5d1                   LDA .vduCurrentPlotByteMask                         ;
  7336  d0f5 25d4                   AND .vduGraphicsColourByteOR                        ;
  7337  d0f7 11d6                   ORA (.vduScreenAddressOfGraphicsCursorCellLow),Y    ;
  7338  d0f9 85da                   STA .vduTempStoreDA                                 ;
  7339  d0fb a5d5                   LDA .vduGraphicsColourByteEOR                       ;
  7340  d0fd 25d1                   AND .vduCurrentPlotByteMask                         ;
  7341  d0ff 45da                   EOR .vduTempStoreDA                                 ;
  7342  d101 91d6                   STA (.vduScreenAddressOfGraphicsCursorCellLow),Y    ; put it back again
  7343                          +
  7344  d103 60                     RTS                                                 ;
  7345                          
  7346                          ; ***************************************************************************************
  7347                          ;
  7348                          ; Plots a filled whole byte (as part of a lateral fill)
  7349                          ;
  7350                          ; On Entry:
  7351                          ;       Y is the vertical offset within a character cell (0-7)
  7352                          ; ***************************************************************************************
  7353                          .plotByte
  7354  d104 b1d6                   LDA (.vduScreenAddressOfGraphicsCursorCellLow),Y    ;
  7355  d106 05d4                   ORA .vduGraphicsColourByteOR                        ;
  7356  d108 45d5                   EOR .vduGraphicsColourByteEOR                       ;
  7357  d10a 91d6                   STA (.vduScreenAddressOfGraphicsCursorCellLow),Y    ;
  7358  d10c 60                     RTS                                                 ;
  7359                          
  7360                          
  7361                          ; ***************************************************************************************
  7362                          ;
  7363                          ; Check that the graphics cursor is within the graphics window
  7364                          ;
  7365                          ; On Exit:
  7366                          ;   .vduTempStoreDA is zero if the point is within the graphics window, or the four low bits
  7367                          ;                indicate which regions failed:
  7368                          ;
  7369                          ;       %0000   success (point is within window)
  7370                          ;       %0001   graphics cursor X is left of  the left   edge of the graphics window
  7371                          ;       %0010   graphics cursor X is right of the right  edge of the graphics window
  7372                          ;       %0100   graphics cursor Y is below    the bottom edge of the graphics window
  7373                          ;       %1000   graphics cursor Y is above    the top    edge of the graphics window
  7374                          ;
  7375                          ; ***************************************************************************************
  7376                          .checkGraphicsCursorIsWithinGraphicsWindow
  7377  d10d a224                   LDX #.vduGraphicsCursorPixelsXLow - .vduVariablesStart ; X is the offset to check the graphics cursor
  7378                          .checkPointXIsWithinGraphicsWindow
  7379  d10f a000                   LDY #0                                              ;
  7380  d111 84da                   STY .vduTempStoreDA                                 ; .vduTempStoreDA is initialised to zero (stores the error code)
  7381  d113 a002                   LDY #2                                              ; Y is the index to check the vertical bounds of the graphics window
  7382  d115 2028d1                 JSR .checkPointIsWithinWindowHorizontalOrVertical   ; check graphics cursor is within window vertically
  7383  d118 06da                   ASL .vduTempStoreDA                                 ; } Shift up error results two bits to make room for the next horizontal test results
  7384  d11a 06da                   ASL .vduTempStoreDA                                 ; }
  7385  d11c ca                     DEX                                                 ;
  7386  d11d ca                     DEX                                                 ; reduce index by two to check the X position
  7387  d11e a000                   LDY #0                                              ; Y is the index to check the horizontal bounds of the graphics window
  7388  d120 2028d1                 JSR .checkPointIsWithinWindowHorizontalOrVertical   ; check graphics cursor is within window horizontally
  7389  d123 e8                     INX                                                 ; }
  7390  d124 e8                     INX                                                 ; } Restore X to initial value
  7391  d125 a5da                   LDA .vduTempStoreDA                                 ; A = error code (0,1,2,4,5,6,8,9,10) depending on which bounds are exceeded
  7392  d127 60                     RTS                                                 ;
  7393                          
  7394                          
  7395                          ; ***************************************************************************************
  7396                          ;
  7397                          ; Check coordinate of a point is in the window bounds (horizontal or vertical)
  7398                          ;
  7399                          ; On Entry:
  7400                          ;       X is the offset to the coordinate to check minus two bytes
  7401                          ;       Y is the offset to the second variable to check (0 for horizontal or 2 for vertical)
  7402                          ; On Exit:
  7403                          ;       .vduTempStoreDA is the error code (0 = no error, 1 = first check failed, 2 = second check
  7404                          ;       failed)
  7405                          ;       Zero flag set if no error
  7406                          ; ***************************************************************************************
  7407                          .checkPointIsWithinWindowHorizontalOrVertical
  7408  d128 bd0203                 LDA .vduVariablesStart + 2,X                        ; } Subtract two sixteen bit variables, compare the results.
  7409  d12b d90003                 CMP .vduVariablesStart + 0,Y                        ; } if var[X+2,X+3] < var[Y,Y+1] then error
  7410  d12e bd0303                 LDA .vduVariablesStart + 3,X                        ; }
  7411  d131 f90103                 SBC .vduVariablesStart + 1,Y                        ; }
  7412  d134 3010                   BMI .oneError                                       ; branch if error
  7413                          
  7414  d136 b90403                 LDA .vduVariablesStart + 4,Y                        ; } Subtract two sixteen bit variables, compare the results.
  7415  d139 dd0203                 CMP .vduVariablesStart + 2,X                        ; } if var[Y+4,Y+5] < var[X+2,X+3] then error
  7416  d13c b90503                 LDA .vduVariablesStart + 5,Y                        ; }
  7417  d13f fd0303                 SBC .vduVariablesStart + 3,X                        ; }
  7418  d142 1004                   BPL +                                               ; if (no violation) then branch (exit)
  7419  d144 e6da                   INC .vduTempStoreDA                                 ; increment error code
  7420                          .oneError
  7421  d146 e6da                   INC .vduTempStoreDA                                 ; increment error code
  7422                          +
  7423  d148 60                     RTS                                                 ;
  7424                          
  7425                          
  7426                          ; ***************************************************************************************
  7427                          ;
  7428                          ; Convert external absolute coordinates to pixels
  7429                          ;
  7430                          ; Convert external, absolute coordinates to pixels (horizontal and vertical)
  7431                          ;
  7432                          ; On Entry:
  7433                          ;       X is the offset in vdu variables to the coordinate to convert
  7434                          ;
  7435                          ; ***************************************************************************************
  7436                          .plotConvertExternalAbsoluteCoordinatesToPixels
  7437  d149 a9ff                   LDA #$FF                                            ; A=$FF to ensure absolute coordinates
  7438  d14b d003                   BNE +                                               ; ALWAYS branch
  7439                          
  7440                          
  7441                          ; ***************************************************************************************
  7442                          ;
  7443                          ; Convert external relative coordinates to pixels
  7444                          ;
  7445                          ; Convert pair of external coordinates to pixels (horizontal and vertical)
  7446                          ;
  7447                          ; On Entry:
  7448                          ;       X is the offset in vdu variables to the coordinate to convert
  7449                          ;
  7450                          ; ***************************************************************************************
  7451                          .plotConvertExternalRelativeCoordinatesToPixels
  7452  d14d ad1f03                 LDA .vdu25ParameterPlotType                                     ; get first parameter in plot
  7453                          +
  7454  d150 85da                   STA .vduTempStoreDA                                             ; store in .vduTempStoreDA
  7455  d152 a002                   LDY #2                                                          ; Y=2 (for vertical
  7456                                                                                              ; coordinate)
  7457  d154 2076d1                 JSR .convertExternalRelativeCoordinateToAbsoluteAndDivideByTwo  ; convert
  7458  d157 20add1                 JSR .signedDivideCoordinateByTwo                                ; divide by 2 again to
  7459                                                                                              ; convert 1023 to 0-255
  7460                                                                                              ; for pixels
  7461  d15a a000                   LDY #0                                                          ; Y=0 (for horizontal
  7462                                                                                              ; coordinate)
  7463  d15c ca                     DEX                                                             ;
  7464  d15d ca                     DEX                                                             ; X-=2
  7465  d15e 2076d1                 JSR .convertExternalRelativeCoordinateToAbsoluteAndDivideByTwo  ; convert
  7466                          
  7467  d161 ac6103                 LDY .vduPixelsPerByteMinusOne                       ; get number of pixels per byte (-1)
  7468                                                                                  ;     7 for MODE 0
  7469                                                                                  ;     3 for MODE 1
  7470                                                                                  ;     1 for MODE 2
  7471                                                                                  ;     0 for MODE 3
  7472                                                                                  ;     7 for MODE 4
  7473                                                                                  ;     3 for MODE 5
  7474                                                                                  ;     0 for MODE 6
  7475                                                                                  ;     0 for MODE 7
  7476                          
  7477  d164 c003                   CPY #3                                              ;
  7478  d166 f005                   BEQ +                                               ; if (MODE 1 or 5) then branch (divide by 2)
  7479  d168 b006                   BCS .doneDividing                                   ; if (MODE 0 or 4) then branch (no division needed)
  7480  d16a 20add1                 JSR .signedDivideCoordinateByTwo                    ; if (MODE 2,3,6 or 7) then divide by 4
  7481                                                                                  ;                   (divide by two twice)
  7482                          +
  7483  d16d 20add1                 JSR .signedDivideCoordinateByTwo                    ; divide by 2
  7484                          .doneDividing
  7485  d170 ad5603                 LDA .vduCurrentScreenMODEGroup                      ; MODE group
  7486  d173 d038                   BNE .signedDivideCoordinateByTwo                    ; if (MODEs 3-7) then branch (divide by 2 again)
  7487  d175 60                     RTS                                                 ;
  7488                          
  7489                          ; ***************************************************************************************
  7490                          ;
  7491                          ; Converts the vdu queue parameter to absolute coordinates and divides by two
  7492                          ;
  7493                          ; On Entry:
  7494                          ;       X               is the offset to the vdu queue parameter coordinate to convert
  7495                          ;       Y               is 0 or 2 for the horizontal or vertical cursor coordinates
  7496                          ;       .vduTempStoreDA is the plot type (to check for relative coordinate conversion)
  7497                          ;
  7498                          ; ***************************************************************************************
  7499                          .convertExternalRelativeCoordinateToAbsoluteAndDivideByTwo
  7500  d176 18                     CLC                                                 ; clear carry
  7501  d177 a5da                   LDA .vduTempStoreDA                                 ; get .vduTempStoreDA
  7502  d179 2904                   AND #4                                              ; }
  7503  d17b f009                   BEQ .addPreviousCoordinate                          ; } if (relative coordinates) then branch (add previous coordinate)
  7504  d17d bd0203                 LDA .vduGraphicsWindowPixelsBottomLow,X             ; get coordinate
  7505  d180 48                     PHA                                                 ;
  7506  d181 bd0303                 LDA .vduGraphicsWindowPixelsBottomHigh,X            ;
  7507  d184 900e                   BCC .addGraphicsOrigin                              ; ALWAYS branch
  7508                          
  7509                          .addPreviousCoordinate
  7510  d186 bd0203                 LDA .vduGraphicsWindowPixelsBottomLow,X             ; get coordinate
  7511  d189 791003                 ADC .vduGraphicsCursorPositionXLow,Y                ; add cursor position
  7512  d18c 48                     PHA                                                 ; save it
  7513  d18d bd0303                 LDA .vduGraphicsWindowPixelsBottomHigh,X            ;
  7514  d190 791103                 ADC .vduGraphicsCursorPositionXHigh,Y               ; add cursor
  7515  d193 18                     CLC                                                 ; clear carry
  7516                          
  7517                          .addGraphicsOrigin
  7518  d194 991103                 STA .vduGraphicsCursorPositionXHigh,Y               ; save new cursor
  7519  d197 790d03                 ADC .vduGraphicsWindowOriginXHigh,Y                 ; add graphics origin
  7520  d19a 9d0303                 STA .vduGraphicsWindowPixelsBottomHigh,X            ; store it
  7521  d19d 68                     PLA                                                 ; get back low byte
  7522  d19e 991003                 STA .vduGraphicsCursorPositionXLow,Y                ; save it in new cursor low
  7523  d1a1 18                     CLC                                                 ; clear carry
  7524  d1a2 790c03                 ADC .vduGraphicsWindowOriginXLow,Y                  ; add to graphics orgin
  7525  d1a5 9d0203                 STA .vduGraphicsWindowPixelsBottomLow,X             ; store it
  7526  d1a8 9003                   BCC .signedDivideCoordinateByTwo                    ; if (carry clear) then branch (skip over next statement)
  7527  d1aa fe0303                 INC .vduGraphicsWindowPixelsBottomHigh,X            ; increment high byte
  7528                              ; fall through...
  7529                          
  7530                          ; ***************************************************************************************
  7531                          ;
  7532                          ; Divides the signed 16 bit coordinate value by two
  7533                          ;
  7534                          ; On Entry:
  7535                          ;       X is the offset to the coordinate from .vduGraphicsWindowPixelsBottomLow
  7536                          ;
  7537                          ; ***************************************************************************************
  7538                          .signedDivideCoordinateByTwo
  7539  d1ad bd0303                 LDA .vduGraphicsWindowPixelsBottomHigh,X            ; get high byte
  7540  d1b0 0a                     ASL                                                 ;
  7541  d1b1 7e0303                 ROR .vduGraphicsWindowPixelsBottomHigh,X            ; divide by 2
  7542  d1b4 7e0203                 ROR .vduGraphicsWindowPixelsBottomLow,X             ;
  7543  d1b7 60                     RTS                                                 ;
  7544                          
  7545                          ; ***************************************************************************************
  7546                          ;
  7547                          ; Convert pixel coordinates to external absolute coordinates
  7548                          ;
  7549                          ; ***************************************************************************************
  7550                          .convertPixelGraphicsCoordinatesToExternal
  7551  d1b8 a010                   LDY #.vduGraphicsCursorPositionXLow - .vduVariablesStart ; destination: graphics cursor in external coordinates
  7552  d1ba 2088d4                 JSR .copyGraphicsCursorPixelPosition                ; source is graphics cursor in pixel coordinates.
  7553                                                                                  ; copy pixel coordinates to external coordinates.
  7554  d1bd a202                   LDX #2                                              ; X=2 (offset to update the vertical coordinate)
  7555  d1bf a002                   LDY #2                                              ; Y=2 (shift twice to multiply by four)
  7556  d1c1 20d5d1                 JSR +                                               ; multiply .vduGraphicsCursorPositionY by 4 and subtract graphics origin
  7557                                                                                  ; this is the external Y coordinate.
  7558  d1c4 a200                   LDX #0                                              ; X=0 (offset to update the horizontal coordinate)
  7559  d1c6 a004                   LDY #4                                              ; Y=4
  7560  d1c8 ad6103                 LDA .vduPixelsPerByteMinusOne                       ; get number of pixels/byte
  7561                          -
  7562  d1cb 88                     DEY                                                 ; Y=Y-1
  7563  d1cc 4a                     LSR                                                 ; divide by 2
  7564  d1cd d0fc                   BNE -                                               ; if (result not 0) then branch (loop back)
  7565                          
  7566                              ; Pixels                                     Number of
  7567                              ; per byte   Screen     Y       MODE       multiplication
  7568                              ; minus one   MODE     Now      group      steps (#shifts)
  7569                              ; --------------------------------------------------------
  7570                              ;    7       MODE 0     1         0              1  (x1)
  7571                              ;    3       MODE 1     2         0              2  (x2)
  7572                              ;    1       MODE 2     3         0              3  (x4)
  7573                              ;    0       MODE 3     -         1              -
  7574                              ;    7       MODE 4     1         2              2  (x2)
  7575                              ;    3       MODE 5     2         2              3  (x4)
  7576                              ;    0       MODE 6     -         3              -
  7577                              ;    0       MODE 7     -         4              -
  7578                              ; --------------------------------------------------------
  7579                          
  7580  d1cf ad5603                 LDA .vduCurrentScreenMODEGroup                      ; MODE group
  7581  d1d2 f001                   BEQ +                                               ; if (zero) then branch
  7582  d1d4 c8                     INY                                                 ; Y holds the number of multiplication steps (1, 2 or 3)
  7583                          +
  7584                          -
  7585  d1d5 1e1003                 ASL .vduGraphicsCursorPositionXLow,X                ; } multiply coordinate by 2
  7586  d1d8 3e1103                 ROL .vduGraphicsCursorPositionXHigh,X               ; }
  7587  d1db 88                     DEY                                                 ; Y-Y-1
  7588  d1dc d0f7                   BNE -                                               ; if (Y != 0) then branch (do it again)
  7589                          
  7590  d1de 38                     SEC                                                 ; set carry
  7591  d1df 20e3d1                 JSR +                                               ; do one coordinate
  7592  d1e2 e8                     INX                                                 ; increment X
  7593                          +
  7594  d1e3 bd1003                 LDA .vduGraphicsCursorPositionXLow,X                ; get current graphics position in external coordinates
  7595  d1e6 fd0c03                 SBC .vduGraphicsWindowOriginXLow,X                  ; subtract origin
  7596  d1e9 9d1003                 STA .vduGraphicsCursorPositionXLow,X                ; store in graphics cursor position
  7597  d1ec 60                     RTS                                                 ;
  7598                          
  7599                          
  7600                          ; ***************************************************************************************
  7601                          ;
  7602                          ; Plot a line or a dotted line
  7603                          ;
  7604                          ; Bresenham's line drawing algorithm is used.
  7605                          ; See https://en.wikipedia.org/wiki/Bresenham%27s_line_algorithm
  7606                          ;
  7607                          ; In the enclosed BASIC program, we sketch out the ideas behind the assembly that follows.
  7608                          ; The code plots a bunch of random lines on the screen using standard OS line drawing, then
  7609                          ; undraws the same set of lines using a BASIC routine that mimics the OS code. The process
  7610                          ; is slow (it's written in unoptimised BASIC) but it unplots the exact same pixels
  7611                          ; as the OS routine. See lines.ssd.
  7612                          ;
  7613                          ; ***************************************************************************************
  7614                          .plotLine
  7615  d1ed 200dd4                 JSR .plotLineInitialiseDeltaValues                  ;
  7616                          
  7617                          ; Now we have set the delta values:
  7618                          ;
  7619                          ;   Set .vduPlotLineDeltaX = graphics cursorX - parameterX  (lets call this dX)
  7620                          ;   Set .vduPlotLineDeltaY = graphics cursorY - parameterY  (lets call this dY)
  7621                          ;
  7622                          ; At this point, the values in .vduPlotLineDeltaX/Y are the delta in pixels for the line.
  7623                          ; The values are 16 bit signed integers. Positive values are to the left and down on screen,
  7624                          ; like so:
  7625                          ;
  7626                          ;                                         |
  7627                          ;                                         |
  7628                          ;                                         |
  7629                          ;                       dX /______________|_____________
  7630                          ;                          \           ###|<-(current graphics
  7631                          ;                                   ###   |   cursor position)
  7632                          ;                                ###      |
  7633                          ;                             ###         |
  7634                          ;        (new parameter -> ###           \|/
  7635                          ;           coordinates)                 dY
  7636                          ;
  7637                          ;
  7638                          ; Now calculate the dominant axis, i.e. which of dx and dy has the largest magnitude.
  7639                          
  7640  d1f0 ad2b03                 LDA .vduPlotLineDeltaYHigh                          ;
  7641  d1f3 4d2903                 EOR .vduPlotLineDeltaXHigh                          ; check high bytes for different sign bit in dX/dY
  7642  d1f6 300f                   BMI .sectionB                                       ; if (result -ve; then deltas are different in sign) then branch later
  7643                          
  7644                          ; -------------SECTION A-------------
  7645                          ; dX and dY have the same sign
  7646  d1f8 ad2a03                 LDA .vduPlotLineDeltaYLow                           ; }
  7647  d1fb cd2803                 CMP .vduPlotLineDeltaXLow                           ; } if (dY >= dX) then A = dY - dX
  7648  d1fe ad2b03                 LDA .vduPlotLineDeltaYHigh                          ; }               else A = dY - dX - 1
  7649  d201 ed2903                 SBC .vduPlotLineDeltaXHigh                          ; }
  7650                                                                                  ; } Result: A is positive if dY > dX, A is negative if dY < dX, otherwise A = 0.
  7651                                                                                  ; }    i.e. A is SIGN(dY - dX), C = carry of difference (^)
  7652                          ; ----------SECTION A ENDS-----------
  7653  d204 4c14d2                 JMP .plotLineGotDeltas                              ;
  7654                          
  7655                          .sectionB
  7656                          ; -------------SECTION B-------------
  7657                          ; dX and dY have different signs
  7658  d207 ad2803                 LDA .vduPlotLineDeltaXLow                           ; } A = (dX + dY) (high byte)
  7659  d20a 18                     CLC                                                 ; } (where deltas are different in sign, so really a subtraction)
  7660  d20b 6d2a03                 ADC .vduPlotLineDeltaYLow                           ; }
  7661  d20e ad2903                 LDA .vduPlotLineDeltaXHigh                          ; } Result: A is positive if (dX > -dY), A is negative if dX < -dY, otherwise A = 0
  7662  d211 6d2b03                 ADC .vduPlotLineDeltaYHigh                          ; }    i.e. A is SIGN(dX - dY), C = carry of difference
  7663                          ; ----------SECTION B ENDS-----------
  7664                          
  7665                          
  7666                          ; Table of examples (Part 1)
  7667                          ;         A=   B=  C=  D=           --------SECTION A---------- ----------SECTION B----------
  7668                          ;         dX   dX  dY  dY   signs   Carry= Result                Carry=   Result
  7669                          ;  dX dY  Low  Hi Low  Hi  differ?  (C>=A) D-B-(1-Carry)       (A+C)>255  (B+D+Carry)
  7670                          ; -------------------------------------------------------------------------------------------
  7671                          ;  3   1  $03 $00 $01 $00     no      0    $FF (Result Carry=0)     -     -
  7672                          ;  1   3  $01 $00 $03 $00     no      1    $00 (Result Carry=1)     -     -
  7673                          ; -3   1  $FD $FF $01 $00     yes     -     -                       0     $FF (Result Carry=0)
  7674                          ; -1   3  $FF $FF $03 $00     yes     -     -                       1     $00 (Result Carry=1)
  7675                          ;  3  -1  $03 $00 $FF $FF     yes     -     -                       1     $00 (Result Carry=1)
  7676                          ;  1  -3  $01 $00 $FD $FF     yes     -     -                       0     $FF (Result Carry=0)
  7677                          ; -3  -1  $FD $FF $FF $FF     no      1    $00 (Result Carry=1)     -     -
  7678                          ; -1  -3  $FF $FF $FD $FF     no      0    $FF (Result Carry=0)     -     -
  7679                          ; --------------------------------------------------------------------------------------------
  7680                          
  7681                          .plotLineGotDeltas
  7682                              ; based on the calculations just done, we work out the dominant axis, X=0 for the X-axis
  7683                              ; being dominant (dX being at least as large in magnitude as dY), X=2 for the Y-axis
  7684                              ; (dY being larger).
  7685  d214 6a                     ROR                                                 ; make top bit of A = 'result carry'
  7686                                                                                  ; from above
  7687  d215 a200                   LDX #0                                              ; X = 0
  7688  d217 4d2b03                 EOR .vduPlotLineDeltaYHigh                          ; check if carry from result above has
  7689                                                                                  ; same sign as workspaceD
  7690  d21a 1002                   BPL +                                               ; if (dY has same sign as A) then branch (with X=0)
  7691  d21c a202                   LDX #2                                              ; X=2
  7692                          +
  7693  d21e 86de                   STX .vduTempStoreDE                                 ; store X: 0 means dx is the
  7694                                                                                  ; dominant axis, at least as large
  7695                                                                                  ; in magnitude as dy; 2 means dy is
  7696                                                                                  ; dominant
  7697                          
  7698  d220 bdaac4                 LDA .vduPlotLineRoutineAddresses,X                  ; } set up the address of one of two
  7699  d223 8d5d03                 STA .vduJumpVectorLow                               ; } line drawing routines into
  7700  d226 bdabc4                 LDA .vduPlotLineRoutineAddresses+1,X                ; } .vduJumpVectorLow/High (based on
  7701  d229 8d5e03                 STA .vduJumpVectorHigh                              ; } X=0 or 2)
  7702                          
  7703  d22c bd2903                 LDA .vduPlotLineDeltaXHigh,X                        ; choose which side of the line
  7704                                                                                  ; dY = -dX to draw on. (values $00
  7705                                                                                  ; or $FF)
  7706                          
  7707                          ; Table of examples (Part 2)
  7708                          ;            carry flag
  7709                          ;  dX dY   EOR top bit of D   .vduTempStoreDE  .vduPlotLineDeltaXHigh,X
  7710                          ; -------------------------------------------------------------
  7711                          ;  3   1    0 EOR 0 = 0       0                $00
  7712                          ;  1   3    1 EOR 0 = 1       2 (Y dominant)   $00
  7713                          ; -3   1    0 EOR 0 = 0       0                $FF (dy < -dx)
  7714                          ; -1   3    1 EOR 0 = 1       2 (Y dominant)   $00
  7715                          ;  3  -1    1 EOR 1 = 0       0                $00
  7716                          ;  1  -3    0 EOR 1 = 1       2 (Y dominant)   $FF (dy < -dx)
  7717                          ; -3  -1    1 EOR 1 = 0       0                $FF (dy < -dx)
  7718                          ; -1  -3    0 EOR 1 = 1       2 (Y dominant)   $FF (dy < -dx)
  7719                          ; -------------------------------------------------------------
  7720                          
  7721  d22f 1004                   BPL +                                                   ; if (dY >=-dX) then branch  (start drawing from the new parameter position)
  7722  d231 a224                   LDX #.vduGraphicsCursorPixelsXLow - .vduVariablesStart  ; source: current graphics cursor    (start drawing from current cursor position)
  7723  d233 d002                   BNE .parametersSet                                      ; ALWAYS branch
  7724                          
  7725                          +
  7726  d235 a220                   LDX #.vdu25ParameterXLow - .vduVariablesStart       ; source: vdu queue parameters (start drawing from new cursor position)
  7727                          .parametersSet
  7728                              ;
  7729                              ; The line's start point is the point furthest left (when X is the dominant axis) or
