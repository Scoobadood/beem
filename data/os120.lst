  4080                          .screenDisplayMemoryIndexTable
  4081  c440 00                     !byte 0                                             ; MODE 0
  4082                          
  4083                              ; Sound pitch offsets table: Notes played on different sound channels are offset in pitch
  4084                              ; slightly from each other (perhaps to reduce phase shift effects when the same note is
  4085                              ; played on two or more different channels). This is four bytes long (in the middle of
  4086                              ; the previous table!).
  4087                          .soundPitchOffsetByChannelTable                         ; Dual use:
  4088                                                                                  ; screen memory   sound pitch offsets
  4089                                                                                  ; -----------------------------------
  4090  c441 00                     !byte 0                                             ; MODE 1          Channel 0
  4091  c442 00                     !byte 0                                             ; MODE 2          Channel 1
  4092  c443 01                     !byte 1                                             ; MODE 3          Channel 2
  4093  c444 02                     !byte 2                                             ; MODE 4          Channel 3
  4094                          
  4095  c445 02                     !byte 2                                             ; MODE 5
  4096  c446 03                     !byte 3                                             ; MODE 6
  4097                                                                                  ; Overflow: the first byte of the next
  4098                                                                                  ; table is accessed for:
  4099                                                                                  ; MODE 7 - next byte, value 4
  4100                          
