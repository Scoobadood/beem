 20480                          ; ***************************************************************************************
 20481                          ;
 20482                          ; Default vector table pointer
 20483                          ;
 20484                          ; User programs can read these locations to find the default handler addresses.
 20485                          ; It is not well documented (it's not in the NAUG), but it does appear in the Electron
 20486                          ; Advanced User Guide section 6.11. It is not used by this ROM. New in MOS 1.20.
 20487                          ;
 20488                          ; The original source code has the cryptic comment "security copy of indirection data"
 20489                          ;
 20490                          ; ***************************************************************************************
 20491  ffb6 36                     !byte .defaultVectorTableEnd - .defaultVectorTable  ; length of table         [unused]
 20492  ffb7 40d9                   !word .defaultVectorTable                           ; table of addresses - the
 20493                                                                                  ; default vector routines [unused]
 20494                          
 20495                          ; ***************************************************************************************
 20496                          ;
 20497                          ; Operating System function calls
 20498                          ;
 20499                          ; Historical note: The Acorn System 2 began the practice of placing entry points like
 20500                          ; these at the high end of the ROM, (mostly) spaced three bytes apart so that each can
 20501                          ; jump directly back into the ROM or through a vector, and still be called as if they
 20502                          ; were subroutines. This practice protected user programs from breaking when the MOS was
 20503                          ; revised, since it meant there were reliable addresses to call. Though System 2, and
 20504                          ; similarly the Atom, have a slightly smaller set of entry points, so addresses are not
 20505                          ; the same (OSWRCH is at $FFF4 on the System 2 and Atom, not $FFEE as here), the basic
 20506                          ; design is identical. System 2 and the Atom both perform the CR/LF manoeuvre below in
 20507                          ; which OSASCI, OSNEWL and OSWRCH are combined.
 20508                          ;
 20509                          ; ***************************************************************************************
 20510                          .OSRDRM
 20511  ffb9 4c0bdc                 JMP .osrdrmEntryPoint                               ; get a byte from sideways ROM [new in MOS 1.20]
 20512                          .VDUCHR
 20513  ffbc 4cc0c4                 JMP .vduChrEntryPoint                               ; output a character to screen
 20514                          .OSEVEN
 20515  ffbf 4c94e4                 JMP .eventEntryPoint                                ; generate an EVENT
 20516                          .GSINIT
 20517  ffc2 4c1eea                 JMP .gsinitEntryPoint                               ; initialise for parsing a string
 20518                          .GSREAD
 20519  ffc5 4c2fea                 JMP .gsreadEntryPoint                               ; parse character from string
 20520                          .NVRDCH
 20521  ffc8 4cc5de                 JMP .osrdchEntryPoint                               ; non vectored .OSRDCH
 20522                          .NVWRCH
 20523  ffcb 4ca4e0                 JMP .oswrchEntryPoint                               ; non vectored .OSWRCH
 20524                          .OSFIND
 20525  ffce 6c1c02                 JMP (.vectorFINDV)                                  ; open or close a file
 20526                          .OSGBPB
 20527  ffd1 6c1a02                 JMP (.vectorGBPBV)                                  ; transfer data to or from a file
 20528                          .OSBPUT
 20529  ffd4 6c1802                 JMP (.vectorBPUTV)                                  ; save a byte to file
 20530                          .OSBGET
 20531  ffd7 6c1602                 JMP (.vectorBGETV)                                  ; get a byte from file
 20532                          .OSARGS
 20533  ffda 6c1402                 JMP (.vectorARGSV)                                  ; read or write file arguments
 20534                          .OSFILE
 20535  ffdd 6c1202                 JMP (.vectorFILEV)                                  ; read or write a file
 20536                          .OSRDCH
 20537  ffe0 6c1002                 JMP (.vectorRDCHV)                                  ; get byte from current input stream
 20538                          .OSASCI
 20539  ffe3 c90d                   CMP #.charRETURN                                    ; output byte, expanding carriage
 20540  ffe5 d007                   BNE .OSWRCH                                         ; returns to CR/LF ($0A,$0D)
 20541                          .OSNEWL
 20542  ffe7 a90a                   LDA #.charLINEFEED                                  ; output a CR/LF to VDU stream
 20543  ffe9 20eeff                 JSR .OSWRCH                                         ;
 20544  ffec a90d                   LDA #.charRETURN                                    ;
 20545                          .OSWRCH
 20546  ffee 6c0e02                 JMP (.vectorWRCHV)                                  ; output a character (to the screen
 20547                                                                                  ; and/or other output streams)
 20548                          .OSWORD
 20549  fff1 6c0c02                 JMP (.vectorWORDV)                                  ; perform operation with data from
 20550                                                                                  ; a parameter table
 20551                          .OSBYTE
 20552  fff4 6c0a02                 JMP (.vectorBYTEV)                                  ; perform operation with three
 20553                                                                                  ; parameters <A>,<X>,<Y>
 20554                                                                                  ; (equivalent to BASIC's *FX command)
 20555                          .OSCLI
 20556  fff7 6c0802                 JMP (.vectorCLIV)                                   ; pass string to command line
 20557                                                                                  ; interpreter
 20558                          
 20559                          
 20560                          ; ***************************************************************************************
 20561                          ;
 20562                          ; 6502 Vectors
 20563                          ;
 20564                          ; See 6502.png
 20565                          ;
 20566                          ; Finally the last 6 bytes are designated (by the design of the 6502 chip) to contain the
 20567                          ; addresses of the routines that handle an NMI, a RESET and an IRQ condition.
 20568                          ;
 20569                          ; ***************************************************************************************
 20570                          * = $FFFA
 20571  fffa 000d                   !word .nmiEntryPoint                                ; NMI   address
 20572  fffc cdd9                   !word .resetEntryPoint                              ; RESET address
 20573  fffe 1cdc                   !word .irqEntryPoint                                ; IRQ   address
