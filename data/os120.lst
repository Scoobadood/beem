 12107                          ; ***************************************************************************************
 12108                          ;
 12109                          ; OSBYTE 123 - Warn OS about printer going dormant
 12110                          ;
 12111                          ; This call is used by the User Print Routine to indicate to the MOS that it has finished
 12112                          ; its task (The User Print Routine is selected by *FX 5,3).
 12113                          ;
 12114                          ; ***************************************************************************************
 12115                          .osbyte123EntryPoint
 12116  e197 6ed202                 ROR .printerBufferEmptyFlag                         ; mark printer buffer empty (clear top bit)
 12117                          -
 12118  e19a 60                     RTS                                                 ;
 12119                          
 12120                          ; ***************************************************************************************
 12121                          ; Signal to the printer that there's at least one character in the printer buffer, at a
 12122                          ; rate of 100Hz until the printer driver deals with it.
 12123                          .printerServiceCallIfNotEmpty
 12124  e19b 2cd202                 BIT .printerBufferEmptyFlag                         ; check printer buffer empty flag
 12125  e19e 30fa                   BMI -                                               ; if (buffer is empty) then branch (exit)
 12126  e1a0 a900                   LDA #0                                              ; A=0 (100Hz update when printer is active and buffer is not empty)
 12127                              ; fall through...
 12128                          
 12129                          ; ***************************************************************************************
 12130                          ;
 12131                          ; Econet / User printer routines
 12132                          ;
 12133                          ; See NAUG Section 24.2.4, Page 424 for more detail on reason codes
 12134                          ;
 12135                          ; On Entry:
 12136                          ;       A = reason code
 12137                          ;           0 means 100Hz update
 12138                          ;           1 means become active, since printer buffer is no longer empty
 12139                          ;           2 means VDU 2 happened (disable printer output)
 12140                          ;           3 means VDU 3 happened (enable printer output)
 12141                          ;           5 means select new printer driver (entry via OSBYTE 5 to .selectPrinterType)
 12142                          ;
 12143                          .printerServiceCall
 12144  e1a2 a203                   LDX #.bufferNumberPrinter                           ; X=printer buffer number
 12145                          .selectPrinterType
 12146  e1a4 ac8502                 LDY .printerDestination                             ; Y=printer destination (*FX 5 value)
 12147  e1a7 207ee5                 JSR .netvJumper                                     ; let network have a look (should respond if Y=4 for net printer)
 12148  e1aa 6c2202                 JMP (.vectorUPTV)                                   ; let user printer routine have a look (can respond if Y=3, or 5-255 for user printer)
 12149                          
 12150                          
 12151                          ; ***************************************************************************************
 12152                          ;
 12153                          ; Flushes the given buffer
 12154                          ;
 12155                          ; For buffer numbers, see .bufferNumberKeyboard.
 12156                          ;
 12157                          ; On Entry:
 12158                          ;       X=buffer number
 12159                          ;
 12160                          ; ***************************************************************************************
 12161                          .flushBufferX
 12162  e1ad 18                     CLC                                                 ; clear carry
 12163                          
 12164                          .flushSoundBufferX
 12165  e1ae 48                     PHA                                                 ; save A
 12166  e1af 08                     PHP                                                 ; save flags
 12167  e1b0 78                     SEI                                                 ; disable interrupts
 12168  e1b1 b008                   BCS .flushNonSoundBufferX                           ; if (carry set on entry) then branch
 12169  e1b3 bdade9                 LDA .bufferTypeAndSerialBaudRatesTable,X            ; carry clear so get byte from table
 12170  e1b6 1003                   BPL .flushNonSoundBufferX                           ; if (not sound buffer) then branch
 12171  e1b8 20a2ec                 JSR .clearSoundChannelBuffer                        ; clear sound buffer
 12172                          
 12173                          .flushNonSoundBufferX
 12174  e1bb 38                     SEC                                                 ; set carry
 12175  e1bc 7ecf02                 ROR .bufferEmptyFlags,X                             ; rotate buffer flag to show buffer empty
 12176  e1bf e002                   CPX #2                                              ;
 12177  e1c1 b008                   BCS .skipInputBufferHandling                        ; if (X > 1) then branch (it's not an input buffer)
 12178                          
 12179  e1c3 a900                   LDA #0                                              ; this is an input buffer
 12180  e1c5 8d6802                 STA .softKeyStringLength                            ; reset length of the *KEY string
 12181                                                                                  ; currently being decoded (to stop
 12182                                                                                  ; decoding a soft key, which would
 12183                                                                                  ; otherwise add more characters into
 12184                                                                                  ; the input buffer)
 12185  e1c8 8d6a02                 STA .twosComplimentOfNumberOfBytesInVDUQueue        ; reset length of VDU queue
 12186                          
 12187                          .skipInputBufferHandling
 12188  e1cb 203be7                 JSR .purgeBuffer                                    ; purge buffer
 12189  e1ce 28                     PLP                                                 ; restore flags
 12190  e1cf 68                     PLA                                                 ; restore A
 12191  e1d0 60                     RTS                                                 ;
 12192                          
 12193                          
 12194                          ; ***************************************************************************************
 12195                          ;
 12196                          ; Count or Purge Buffer (CNPV) - Default Entry Point
 12197                          ;
 12198                          ; On Entry:
 12199                          ;       X = buffer to access
 12200                          ;       if V set then purge buffer (else count buffer)
 12201                          ;       for count buffer: if C set then get bytes free
 12202                          ;                                  else get bytes used
 12203                          ;
 12204                          ; ***************************************************************************************
 12205                          .cnpEntryPoint
 12206  e1d1 5007                   BVC .countBuffer                                    ; if (V clear) then branch (count buffer)
 12207  e1d3 bdd802                 LDA .bufferStartIndices,X                           ; purge buffer by setting
 12208  e1d6 9de102                 STA .bufferEndIndices,X                             ; end of buffer = start of buffer
 12209  e1d9 60                     RTS                                                 ;
 12210                          
 12211                          .countBuffer
 12212  e1da 08                     PHP                                                 ; push flags
 12213  e1db 78                     SEI                                                 ; disable interrupts
 12214  e1dc 08                     PHP                                                 ; push flags
 12215  e1dd 38                     SEC                                                 ; set carry
 12216  e1de bde102                 LDA .bufferEndIndices,X                             ; get end of buffer
 12217  e1e1 fdd802                 SBC .bufferStartIndices,X                           ; subtract start of buffer
 12218  e1e4 b004                   BCS +                                               ; if (carry set) then branch
 12219  e1e6 38                     SEC                                                 ; set carry
 12220  e1e7 fd47e4                 SBC .emptyBufferStartOffset,X                       ; subtract buffer start offset (i.e. add buffer length)
 12221                          +
 12222  e1ea 28                     PLP                                                 ; pull flags
 12223  e1eb 9006                   BCC +                                               ; if (carry clear) then branch (to tidy up and exit)
 12224  e1ed 18                     CLC                                                 ; clear carry
 12225  e1ee 7d47e4                 ADC .emptyBufferStartOffset,X                       ; adc to get bytes used
 12226  e1f1 49ff                   EOR #$FF                                            ; and invert to get space left
 12227                          +
 12228  e1f3 a000                   LDY #0                                              ; Y=0
 12229  e1f5 aa                     TAX                                                 ; X=A
 12230  e1f6 28                     PLP                                                 ; get back flags
 12231  e1f7 60                     RTS                                                 ;
 12232                          
 12233                          ; ***************************************************************************************
 12234                          ;
 12235                          ; Adds a byte to a buffer.
 12236                          ;
 12237                          ; On failure (e.g. the buffer is full), flash the keyboard lights and keep trying
 12238                          ;
 12239                          ; On Entry:
 12240                          ;       A = byte to write
 12241                          ;       X = buffer to write into
 12242                          ;
 12243                          ; On Exit:
 12244                          ;       Carry clear if successful
 12245                          ;
 12246                          ; ***************************************************************************************
 12247                          .addByteToBuffer
 12248  e1f8 78                     SEI                                                 ; prevent interrupts
 12249  e1f9 20b0e4                 JSR .insJumper                                      ; enter a byte in buffer X
 12250  e1fc 900f                   BCC .exit18                                         ; if (successful) then branch (exit)
 12251  e1fe 20eae9                 JSR .turnOnKeyboardLightsAndTestEscape              ; switch on both keyboard lights
 12252                          
 12253  e201 08                     PHP                                                 ; push flags
 12254  e202 48                     PHA                                                 ; push A
 12255  e203 20ebee                 JSR .keyboardIndicators                             ; switch off unselected LEDs
 12256  e206 68                     PLA                                                 ; recall A
 12257  e207 28                     PLP                                                 ; recall flags
 12258                          
 12259  e208 3003                   BMI .exit18                                         ; if (return is -ve, i.e. Escape pressed) then branch (exit)
 12260  e20a 58                     CLI                                                 ; allow interrupts
 12261  e20b b0eb                   BCS .addByteToBuffer                                ; if (byte didn't enter buffer) then branch (go back and try again)
 12262                          .exit18
 12263  e20d 60                     RTS                                                 ;
 12264                          
