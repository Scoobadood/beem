  1221                                                                                  ; (Read/write using OSBYTE 196, but prefer OSBYTE 11)
  1222                          .keyboardAutoRepeatRate                     = $0255     ; keyboard autorepeat rate in centi-seconds
  1223                                                                                  ; (Read/write using OSBYTE 197, but prefer OSBYTE 12)
  1224                          .execFileHandle                             = $0256     ; file handle of open EXEC file or zero if none open
  1225                                                                                  ; (Read/Write using OSBYTE 198)
  1226                          .spoolFileHandle                            = $0257     ; file handle of open SPOOL file or zero if none open
  1227                                                                                  ; (Read/Write using OSBYTE 199)
  1228                          .escapeAndBreakEffect                       = $0258     ; bit 0 set disables ESCAPE
  1229                                                                                  ; bit 1 set clears memory on BREAK
  1230                                                                                  ; (Read/write using OSBYTE 200)
  1231                          .keyboardDisableFlag                        = $0259     ; 0=Normal
  1232                                                                                  ; otherwise ignore all keys except ESCAPE
  1233                                                                                  ; (Read/Write using OSBYTE 201)
  1234                          .keyboardStatusFlags                        = $025A     ; bit 3 = 1 means SHIFT pressed
  1235                                                                                  ; bit 4 = 0 means CAPS LOCK engaged
  1236                                                                                  ; bit 5 = 0 means SHIFT LOCK engaged
  1237                                                                                  ; bit 6 = 1 means CTRL pressed
  1238                                                                                  ; bit 7 = 1 means SHIFT enabled
  1239                                                                                  ; (Read/Write using OSBYTE 202)
