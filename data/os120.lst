 19857                          ; ***************************************************************************************
 19858                          ;
 19859                          ; Check file is open
 19860                          ;
 19861                          ; On Entry:
 19862                          ;       A = 1 means check file is open for reading (check bit 0 of tape status byte)
 19863                          ;       A = 2 means check file is open for writing (check bit 1 of tape status byte)
 19864                          ;       A = 3 means check file is open for reading or writing
 19865                          ;       Y = file handle ('channel')
 19866                          ;
 19867                          ; On Exit:
 19868                          ;       If file is not open then a 'Channel' error occurs
 19869                          ;
 19870                          ; ***************************************************************************************
 19871                          .checkFileIsOpen
 19872  fb9c 85bc                   STA .fsTempStorage                                  ; remember action type (1-3)
 19873  fb9e 98                     TYA                                                 ; A=Y=channel:
 19874                                                                                  ;   1 = input file on tape
 19875                                                                                  ;   2 = output file on tape
 19876                                                                                  ;   3 = input file from ROMFS
 19877                          
 19878  fb9f 4d4702                 EOR .tapeOrROMSwitch                                ; EOR with filing system flag
 19879  fba2 a8                     TAY                                                 ; Y=A
 19880                                                                                  ; now, Y = 1 for input
 19881                                                                                  ;      Y = 2 for output
 19882  fba3 a5e2                   LDA .fsStatusByte                                   ; tape / ROM FS status byte
 19883  fba5 25bc                   AND .fsTempStorage                                  ; file status or temporary store
 19884  fba7 4a                     LSR                                                 ; set carry if open for input
 19885  fba8 88                     DEY                                                 ; Y = Y - 1
 19886  fba9 f004                   BEQ +                                               ; if (checking open for input) then branch
 19887  fbab 4a                     LSR                                                 ; set carry if open for output
 19888  fbac 88                     DEY                                                 ; Y = Y - 1
 19889  fbad d002                   BNE .channelError                                   ; if (not checking open for output) then branch
 19890                          +
 19891  fbaf b04d                   BCS .exit36                                         ; if (file is open as expected) then branch (exit)
 19892                          
 19893                          .channelError
 19894  fbb1 00                     BRK                                                 ;
 19895  fbb2 de                     !byte $DE                                           ; error number
