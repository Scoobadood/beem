 19899                          ; ***************************************************************************************
 19900                          ; See NAUG Section 18.8, Page 340
 19901                          .startSendToSecondProcessor
 19902  fbbb a901                   LDA #1                                              ; A=1 (Multiple single byte transfer:
 19903                                                                                  ; main processor to second processor)
 19904                          .secondProcessorTransfer
 19905  fbbd 20d3fb                 JSR .checkLoadAddressIsForSecondProcessor           ; check if load address is valid
 19906  fbc0 f03c                   BEQ .exit36                                         ; if (load address is for main processor) then branch (exit)
 19907  fbc2 8a                     TXA                                                 ; A=1
 19908  fbc3 a2b0                   LDX #<.loadAddressLow                               ; }
 19909  fbc5 a000                   LDY #>.loadAddressLow                               ; } set up parameter block address
 19910                          .secondProcessorCall
 19911  fbc7 48                     PHA                                                 ; save A=1 on stack
 19912  fbc8 a9c0                   LDA #.tubeClaimReasonCode + .tubeCallerIDCassetteFS ; Claim the Tube, caller is the
 19913                                                                                  ; Cassette Filing System
 19914                          -
 19915  fbca 200604                 JSR .tubeTransferData                               ; call out to Tube
 19916  fbcd 90fb                   BCC -                                               ; keep trying to claim until claim is done
 19917  fbcf 68                     PLA                                                 ; pull A=1 (Multiple single byte
 19918                                                                                  ; transfer: main processor to second
 19919                                                                                  ; processor)
 19920  fbd0 4c0604                 JMP .tubeTransferData                               ;
 19921                          
 19922                          ; ***************************************************************************************
 19923                          ;
 19924                          ; Check load address for destination
 19925                          ;
 19926                          ; Check the top two bytes of the 32 bit load address. If they are both $FF, then it is for
 19927                          ; the main processor and we return with Z set. If the Tube is not present, then we also
 19928                          ; return with Z set. Otherwise it's for the Tube, we return with Z clear.
 19929                          ;
 19930                          ; On Exit:
 19931                          ;       Z set if load address is for the second processor
 19932                          ;       X is value of A on entry
 19933                          ;
 19934                          ; ***************************************************************************************
 19935                          .checkLoadAddressIsForSecondProcessor
 19936  fbd3 aa                     TAX                                                 ; X=A
 19937  fbd4 a5b2                   LDA .loadAddressMid2                                ; current load address high word
 19938  fbd6 25b3                   AND .loadAddressHigh                                ; current load address high word
 19939  fbd8 c9ff                   CMP #$FF                                            ;
 19940  fbda f005                   BEQ +                                               ; if ($FF, i.e. it's for base processor) then branch
 19941  fbdc ad7a02                 LDA .tubePresentFlag                                ; $FF if Tube is present
 19942  fbdf 2980                   AND #%10000000                                      ; Set bit 7 alone if Tube is present
 19943                          +
 19944  fbe1 60                     RTS                                                 ;
 19945                          
 19946                          ; ***************************************************************************************
 19947                          ; This routine is actually a bugfix. Commented from the original source code:
 19948                          ;
 19949                          ; BUGFIX
 19950                          ;
 19951                          ; When the 6850 counter divide bits are reset, it is possible for the SERPROC to get out
 19952                          ; of synch. for a few bits. This has the effect of corrupting the first character of the
 19953                          ; first block of a SAVE, or the first character of ANY block during sequential access
 19954                          ; (since the 6850 is reset for every block during putbytes).
 19955                          ;
 19956                          ; The cure is to write a dummy byte to tape at the start of a SAVE, and at the start of
 19957                          ; every block during putbytes. This must be done by polling, since there must be a period
 19958                          ; of high-tone after the dummy byte, which is difficult to accomplish if the 6850 is
 19959                          ; interrupting all the time. BUGFIX is thus called after the SERPROC is set and before the
 19960                          ; 6850 is set to interrupt during a block write operation.
 19961                          ;
 19962                          ; ["SERPROC" refers to .serialULAControlRegister, and "BUGFIX" is this routine]
 19963                          ;
 19964                          ; ***************************************************************************************
 19965                          .setupForCassetteWrite
 19966  fbe2 a985                   LDA #%10000101                                      ; } switch on the cassette motor and relay
 19967  fbe4 8d10fe                 STA .serialULAControlRegister                       ; } and set 300 baud
 19968  fbe7 2046fb                 JSR .resetACIA                                      ; reset ACIA
 19969  fbea a910                   LDA #%00010000                                      ; } even parity
 19970                                                                                  ; } 2 stop bits
 19971                                                                                  ; } 8 bit word
 19972                                                                                  ; } 'Request To Send' ('RTS') low (active)
 19973                                                                                  ; } disable interrupts
 19974  fbec 2063fb                 JSR .setACIA6850ControlRegister                     ; set ACIA to tape filing system baud rate
 19975                          
 19976                          -
 19977  fbef 2095f9                 JSR .checkForEscapeDuringCassetteOperation          ; check for ESCAPE
 19978  fbf2 ad08fe                 LDA .acia6850StatusRegister                         ; read ACIA status register
 19979  fbf5 2902                   AND #%00000010                                      ; check bit 1 (transmit interrupt generated)
 19980  fbf7 f0f6                   BEQ -                                               ; if (bit 1 clear, i.e. transmit
 19981                                                                                  ; interrupt generated) then branch
 19982                                                                                  ; (loop back and try again)
 19983                          
 19984  fbf9 a9aa                   LDA #%10101010                                      ; A=$AA
 19985  fbfb 8d09fe                 STA .acia6850DataRegister                           ; send byte to tape
 19986                          .exit36
 19987  fbfe 60                     RTS                                                 ;
 19988                          
 19989  fbff 00                     !byte 0                                             ; [unused]
